  },
  {
   "key": "3386753803197767684",
   "en": "Cover me, V. Eye glued to your scope.",
   "ro": "Acoperă-mă, V. Ochiul lipit de lunetă."
  },
  {
   "key": "3386753804808380424",
   "en": "Focus. Don’t let me out of your sight.",
   "ro": "Concentrează-te. Nu mă pierde din vedere."
  },
  {
   "key": "3386773520654426120",
   "en": "Need you to cover me.",
   "ro": "Am nevoie să mă acoperi."
  },
  {
   "key": "3386773523422666760",
   "en": "Watch my six.",
   "ro": "Păzește-mi spatele."
  },
  {
   "key": "3405784264385810432",
   "en": "You there?",
   "ro": "Ești acolo?"
  },
  {
   "key": "3405784264419364872",
   "en": "Hello, V?",
   "ro": "Alo, V?"
  },
  {
   "key": "3405784264503250952",
   "en": "Let's go, V.",
   "ro": "Hai, V."
  },
  {
   "key": "3405784264603914248",
   "en": "Here they come.",
   "ro": "Iată-i că vin."
