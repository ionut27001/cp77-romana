   "ro": "Oooff!"
  },
  {
   "key": "3386734539380252680",
   "en": "Ugh... Goddamn...",
   "ro": "Ugh... Fir-ar..."
  },
  {
   "key": "3386734645865242632",
   "en": "Aughh... Shit... not good...",
   "ro": "Aughh... Căcat... nu e bine..."
  },
  {
