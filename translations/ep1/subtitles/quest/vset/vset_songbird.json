  },
  {
   "key": "3405702548589694984",
   "en": "Shit, they just keep coming!",
   "ro": "Rahat, tot vin!"
  },
  {
   "key": "3405702548640026632",
   "en": "Fuck, where’d they pull that from?",
   "ro": "Pula mea, de unde dracului au scos-o?"
  },
  {
   "key": "3405702548707135492",
   "en": "Look alive, V! They didn’t come to play!",
