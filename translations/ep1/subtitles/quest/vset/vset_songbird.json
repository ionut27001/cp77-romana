  {
   "key": "3405702542935773192",
   "en": "Oh, you had other plans?",
   "ro": "Oh, aveai alte planuri?"
  },
  {
   "key": "3405702542986104832",
   "en": "OK... Guess it can wait.",
   "ro": "OK... Cred că poate aștepta."
  },
  {
   "key": "3405702543069990920",
   "en": "Glad you’re here.",
   "ro": "Mă bucur că ești aici."
  },
  {
   "key": "3405702543120322568",
   "en": "Anyway, as we were saying...",
   "ro": "Oricum, cum ziceam..."
  },
  {
   "key": "3405702543153877000",
   "en": "Need me to repeat?",
   "ro": "Vrei să repet?"
  },
  {
   "key": "3405702543204208648",
   "en": "V, what’s going on?",
   "ro": "V, ce se întâmplă?"
  },
  {
   "key": "3405702543506198536",
   "en": "Hey there.",
   "ro": "Salut."
  },
  {
   "key": "3405702543539752968",
   "en": "Hey, V.",
   "ro": "Hei, V."
  },
  {
   "key": "3405702543858520072",
   "en": "The hell?",
   "ro": "Ce dracu'?"
  },
  {
   "key": "3405702543925628936",
   "en": "What's your deal?",
   "ro": "Ce problemă ai?"
  },
  {
   "key": "3405702544059846664",
   "en": "Hey! You hear me?",
   "ro": "Hei! Mă auzi?"
  },
  {
   "key": "3405702544093401096",
   "en": "V, you alive?",
   "ro": "V, ești în viață?"
  },
  {
   "key": "3405702544177287176",
   "en": "This way.",
   "ro": "Pe aici."
  },
  {
   "key": "3405702544294727688",
   "en": "All right, let's roll.",
   "ro": "Bine, hai să mergem."
  },
  {
   "key": "3405702544395390976",
   "en": "We’ll zero you!",
   "ro": "Te lichidăm!"
  },
  {
   "key": "3405702544613494792",
   "en": "Don’t stand a chance!",
   "ro": "Nu ai nicio șansă!"
  },
  {
   "key": "3405702544647049224",
   "en": "You’re dead meat!",
   "ro": "Ești mort!"
  },
  {
   "key": "3405702544865153032",
   "en": "That’s all of them.",
   "ro": "Asta e tot."
  },
  {
   "key": "3405702544898707464",
   "en": "Ptfu. All I gotta say.",
   "ro": "Ptfu. Asta am de zis."
  },
  {
   "key": "3405702544982593544",
   "en": "Easy as pie. Should do this more often.",
   "ro": "Ușor ca plăcinta. Ar trebui să fac asta mai des."
  },
  {
   "key": "3405702545066479624",
   "en": "V, you’re bleeding!",
   "ro": "V, sângerezi!"
  },
  {
   "key": "3405702545150365696",
   "en": "Lookin’ a little rough, V!",
   "ro": "Arăți cam rău, V!"
  },
  {
   "key": "3405702545200697352",
   "en": "V, watch out!",
   "ro": "V, atenție!"
  },
  {
   "key": "3405702546979082248",
   "en": "Motherfuckers!",
   "ro": "Pizda mă-sii!"
  },
  {
   "key": "3405702547046191112",
   "en": "V! Gimme a hand!",
   "ro": "V! Dă-mi o mână!"
  },
  {
   "key": "3405702547113299976",
   "en": "The bastards won’t let up!",
   "ro": "Nemernicii nu se lasă!"
