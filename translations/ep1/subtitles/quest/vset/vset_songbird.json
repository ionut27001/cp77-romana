  {
   "key": "3405702547331403776",
   "en": "Grenade, watch out!",
   "ro": "Granată, atenție!"
  },
  {
   "key": "3405702547381735432",
   "en": "They're comin’ in hot!",
   "ro": "Vin în forță!"
  },
  {
   "key": "3405702547448844296",
   "en": "Hah! Try again, gonk!",
   "ro": "Ha! Încearcă din nou, fraiere!"
  },
  {
   "key": "3405702547499175944",
   "en": "You're dead, assholes!",
   "ro": "Sunteți morți, nemernicilor!"
