  {
   "key": "3405702547163631624",
   "en": "Shit, not now!",
   "ro": "Căcat, nu acum!"
  },
  {
   "key": "3405702547213963272",
   "en": "Need to reload! Cover me!",
   "ro": "Trebuie să reîncarc! Acoperă-mă!"
  },
  {
   "key": "3405702547264294920",
   "en": "Runnin’ on empty!",
   "ro": "Am rămas pe uscat!"
