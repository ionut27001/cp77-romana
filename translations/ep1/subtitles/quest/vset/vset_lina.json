{
 "depot": "ep1\\localization\\en-us\\subtitles\\quest\\vset\\vset_lina.json",
 "entries": [
  {
   "key": "3384022889447870472",
   "en": "Well hello there, cutie.",
   "ro": "Bună, drăguțule."
  },
  {
   "key": "3384022889481424904",
   "en": "Hey!",
   "ro": "Hei!"
  },
  {
   "key": "3384022889649197064",
   "en": "Where are you going?",
   "ro": "Unde te duci?"
  },
  {
   "key": "3384022889699528712",
   "en": "Like talking to a wall…",
   "ro": "Parcă vorbesc cu un perete…"
  },
  {
   "key": "3384022889833746436",
   "en": "So great to have you back…",
   "ro": "Ce bine că te-ai întors…"
  },
  {
   "key": "3384022889867300872",
   "en": "Oh, now you want to talk?",
   "ro": "Oh, acum vrei să vorbești?"
  },
  {
   "key": "3384022889917632520",
   "en": "Hey, eyes up!",
   "ro": "Hei, ochii sus!"
  },
  {
   "key": "3384022889967964160",
   "en": "Struck by my beauty?",
   "ro": "Te-a lovit frumusețea mea?"
  },
  {
   "key": "3384022890420949000",
   "en": "Hands to yourself.",
   "ro": "Mâinile la tine."
  },
  {
   "key": "3384022890504835080",
   "en": "You can look, but you can't touch.",
   "ro": "Poți să te uiți, dar nu poți să atingi."
  }
 ]
}
