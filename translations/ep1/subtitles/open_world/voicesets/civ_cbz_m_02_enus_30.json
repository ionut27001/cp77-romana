{
 "depot": "ep1\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_cbz_m_02_enus_30.json",
 "entries": [
  {
   "key": "3115846222609969160",
   "en": "We know each other?...",
   "ro": "Ne cunoaștem?..."
  },
  {
   "key": "3115846222660300808",
   "en": "You look kinda… familiar.",
   "ro": "Pari cam… cunoscut."
  },
  {
   "key": "3115846222777741312",
   "en": "The hell?",
   "ro": "Ce dracu'?"
  },
  {
   "key": "3115846222828072968",
   "en": "What is it with you, idiot?!",
   "ro": "Ce-i cu tine, idiotule?!"
  },
  {
   "key": "3115846222911959048",
   "en": "It's me. Wassup?",
   "ro": "Sunt eu. Ce mai zici?"
  },
  {
   "key": "3115846223012622344",
   "en": "Grab us a pizza, yeah…? Nah, thin crust this time. Nearly shit myself after the one last week.",
   "ro": "Ia-ne o pizza, da…? Nu, de data asta cu blat subțire. Aproape că m-am căcat pe mine după aia de săptămâna trecută."
  },
  {
   "key": "3115846223062953992",
   "en": "Yo, you ordered that pizza…? Okay, get me the thick crust one, changed my mind… What? I'm hungry, man!",
   "ro": "Hei, ai comandat pizza aia…? Bine, ia-mi-o pe cea cu blat gros, m-am răzgândit… Ce? Mi-e foame, frate!"
  },
  {
   "key": "3115846223163617288",
   "en": "Yeah, later.",
   "ro": "Da, mai târziu."
  },
  {
   "key": "3115846223482384392",
   "en": "S-someone opened fire!",
   "ro": "C-cineva a deschis focul!"
  },
  {
   "key": "3115846223515938824",
   "en": "Cyberpsycho!",
   "ro": "Cyberpsycho!"
  },
  {
   "key": "3115846223683710984",
   "en": "P-p-p-please…!",
   "ro": "T-t-te rog…!"
  },
  {
   "key": "3115846223734042632",
   "en": "Have mercy…",
   "ro": "Ai milă…"
  },
  {
   "key": "3115846223935369224",
   "en": "Leave. Me. Alone!",
   "ro": "Lasă-mă. În. Pace!"
  },
  {
   "key": "3115846223985700872",
   "en": "The hell you want from me?!",
   "ro": "Ce dracu' vrei de la mine?!"
  },
  {
   "key": "3115846224153473032",
   "en": "You fucked in the head?!",
   "ro": "Ești dus cu pluta?!"
  },
  {
   "key": "3115846224203804680",
   "en": "You're lucky I don't have time for this!",
   "ro": "Noroc că n-am timp pentru asta!"
  },
  {
   "key": "3115846224338022408",
   "en": "Optics! Fuckin' use 'em!",
   "ro": "Optică! Folosește-le, pula mea!"
  },
  {
   "key": "3115846224354799624",
   "en": "No! Ride was brand new…",
   "ro": "Nu! Mașina era nouă de tot…"
  },
  {
   "key": "3266711036784865284",
   "en": "W-whaddya want?!",
   "ro": "C-ce vrei?!"
  },
  {
   "key": "3266711036818419712",
   "en": "What'd I ever do to you?!",
   "ro": "Ce ți-am făcut vreodată?!"
  },
  {
   "key": "3266711036851974144",
   "en": "Quit it!",
   "ro": "Lasă-o baltă!"
  },
  {
   "key": "3266711036885528580",
   "en": "You high? Or plain stupid?",
   "ro": "Ești high? Sau doar prost?"
  }
 ]
}
