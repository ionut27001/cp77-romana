 "entries": [
  {
   "key": "3334767210568159240",
   "en": "Walking calms your nerves?",
   "ro": "Mersul te calmează?"
  },
  {
   "key": "3334767210601713672",
   "en": "You looking for something?",
   "ro": "Cauți ceva?"
  },
  {
   "key": "3334767210685599752",
   "en": "Glad to have you back.",
   "ro": "Mă bucur că te-ai întors."
  },
  {
   "key": "3334767210719154176",
   "en": "Thought you were off and away.",
   "ro": "Credeam că ai plecat."
  },
  {
   "key": "3334767210752708612",
   "en": "It's your decision.",
   "ro": "E decizia ta."
  },
  {
   "key": "3334767210769485832",
   "en": "Think it through.",
   "ro": "Gândește-te bine."
  },
  {
   "key": "3334767211054698504",
   "en": "Just go already.",
   "ro": "Pleacă odată."
  },
  {
   "key": "3373964188935843840",
   "en": "What more do you want? Just go!",
   "ro": "Ce mai vrei? Pleacă!"
  },
  {
   "key": "3373964408432160768",
   "en": "You psycho – you'll regret this!",
   "ro": "Ești nebună – o să regreți!",
   "ro_m": "Ești nebun – o să regreți!"
  }
 ]
