 "entries": [
  {
   "key": "3334565704778715144",
   "en": "'Kay, yeah, just turn your back on me.",
   "ro": "'Kay, da, întoarce-mi spatele."
  },
  {
   "key": "3334565704812269576",
   "en": "Hey, what gives?",
   "ro": "Hei, ce se întâmplă?"
  },
  {
   "key": "3334565704896155652",
   "en": "Came back. Good.",
   "ro": "Te-ai întoarsă. Bine.",
   "ro_m": "Te-ai întors. Bine."
  },
  {
   "key": "3334565704912932872",
   "en": "Thought you wouldn't be back.",
   "ro": "Credeam că nu te mai întorci."
  },
  {
   "key": "3334565704946487304",
   "en": "You hear me?",
   "ro": "Mă auzi?"
  },
  {
   "key": "3334565704980041736",
   "en": "Hey, say somethin'.",
   "ro": "Hei, zici ceva."
  },
  {
   "key": "3334565705248477192",
   "en": "Eh, yeah...?",
   "ro": "Eh, da...?"
  },
  {
   "key": "3334565705282031624",
   "en": "That D.A.'s got my son. Go to the Heavy Hearts, talk to her.",
   "ro": "Procurorul ăla mi-a luat fiul. Du-te la Heavy Hearts, vorbește cu ea."
  },
  {
   "key": "3334565705449803784",
   "en": "Ey, watch it, all right?",
   "ro": "Hei, ai grijă, bine?"
  },
  {
   "key": "3334565705483358216",
   "en": "Sorry.",
   "ro": "Scuze."
  }
 ]
