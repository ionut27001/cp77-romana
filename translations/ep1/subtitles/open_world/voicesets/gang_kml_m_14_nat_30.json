  {
   "key": "3267768162605133832",
   "en": "Yo, what's poppin'?",
   "ro": "Yo, ce se întâmplă?"
  },
  {
   "key": "3267768162705797128",
   "en": "Y'gotta check in the Black Sapphire… Uh-huh, heard we got our hands on some new chrome… Hahaha!... Nah, man, it's pretty good…",
   "ro": "Trebuie să dai o tură pe la Black Sapphire… Uh-huh, am auzit că am pus mâna pe niște chrome nou… Hahaha!... Nu, frate, e tare bun…"
  },
  {
   "key": "3267768162739351560",
   "en": "Generator? How the fuck should I know?... Nah, but I might know a guy… Sending you his detes… Yeah…",
   "ro": "Generator? De unde pula mea să știu?... Nu, dar poate cunosc un tip… Îți trimit ce am despre el… Da…"
  },
  {
   "key": "3267768162907123720",
