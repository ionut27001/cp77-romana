 "entries": [
  {
   "key": "3115836196143034376",
   "en": "Don't think I know ya.",
   "ro": "Nu cred că te cunosc."
  },
  {
   "key": "3115836196176588808",
   "en": "Uh, hi…?",
   "ro": "Uh, salut…?"
  },
  {
   "key": "3115836196310806536",
   "en": "Watch where you're walkin'!",
   "ro": "Uită-te pe unde mergi!"
  },
  {
   "key": "3115836196394692616",
   "en": "Ouch! Hey!",
   "ro": "Aoleu! Hei!"
  },
  {
   "key": "3115836196512133128",
   "en": "Yeah? It's me.",
   "ro": "Da? Eu sunt."
  },
  {
   "key": "3115836196629573640",
   "en": "Oh, come on, don't waste time on Scavs… They got somethin' interestin'? Hah, nah. Yeah, see what I mean?",
   "ro": "Hai, nu mai pierde timpul cu hienele… Au ceva interesant? Hah, nu. Da, știi ce zic?"
  },
  {
   "key": "3115836196679905288",
   "en": "Heh, oh so what're they gonna do…? Oh, o-okay, right, they're gonna scare him away. Okay, good. Could use a break…",
   "ro": "Heh, deci ce-or să facă…? A, o-okay, bine, o să-l sperie. Bine. Mi-ar prinde bine o pauză…"
  },
  {
   "key": "3115836196780568584",
   "en": "Mhm. Mhm, yeah, okay. Bye.",
   "ro": "Mhm. Mhm, da, bine. Pa."
  },
  {
   "key": "3115836197049004040",
   "en": "Jesus Christ! Heeelp!",
   "ro": "Doamne! Ajutor!"
  },
  {
   "key": "3115836197082558472",
   "en": "Run! Run, ya'll!",
   "ro": "Fugiți! Fugiți, măi!"
  },
  {
   "key": "3115836197267107848",
   "en": "No! No, no, no, no, no…!",
   "ro": "Nu! Nu, nu, nu, nu, nu…!"
  },
  {
   "key": "3115836197350993928",
   "en": "Was just… p-please!",
   "ro": "Eram doar… t-te rog!"
  },
  {
   "key": "3115836197501988864",
   "en": "Can ya kindly fuck right off?",
   "ro": "Te poți căra dracului, te rog?"
  },
  {
   "key": "3115836197535543304",
   "en": "You stalkin' me?",
   "ro": "Mă urmărești?"
  },
  {
   "key": "3115836197669761032",
   "en": "Got a brain? Act like it!",
   "ro": "Ai creier? Comportă-te ca atare!"
  },
  {
   "key": "3115836197686538248",
   "en": "Fuckin' psycho!",
   "ro": "Nebun nenorocit!"
  },
  {
   "key": "3115836197854310408",
   "en": "Oh, come the fuck on! Jesus!",
   "ro": "Oh, hai, pula mea! Doamne!"
  },
  {
   "key": "3115836197904642048",
   "en": "Hey!",
   "ro": "Hei!"
  },
  {
   "key": "3266676774606008320",
   "en": "You're goin' down, bitch!",
   "en_m": "You're goin' down, sucker!",
   "ro": "O să cazi, curvo!",
   "ro_m": "O să cazi, fraierule!"
  },
  {
   "key": "3266677108942368768",
   "en": "Fuck you want?!",
   "ro": "Ce vrei, pula mea?!"
  },
  {
   "key": "3266677313590849536",
   "en": "Fuck yourself!",
   "ro": "Du-te-n pula mea!"
  },
  {
   "key": "3266695553125773312",
   "en": "You're fuckin' done!",
   "ro": "Ești terminată!",
   "ro_m": "Ești terminat!"
