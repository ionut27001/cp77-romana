   "en": "Over and out.",
   "ro": "Terminat."
  },
  {
   "key": "3267740291589271560",
   "en": "This gotta be checked out.",
   "ro": "Asta trebuie verificată."
  },
  {
   "key": "3267740291622825992",
   "en": "Heard that?",
   "ro": "Ai auzit?"
  },
  {
   "key": "3267740291689934856",
   "en": "Check that out. Go.",
   "ro": "Verifică acolo. Du-te."
