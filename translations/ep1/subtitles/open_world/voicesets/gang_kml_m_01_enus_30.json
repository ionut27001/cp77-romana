   "ro": "Jos arma, acum!"
  },
  {
   "key": "3267740288653258760",
   "en": "Weapon holstered, do it!",
   "ro": "Pune arma în toc, acum!"
  },
  {
   "key": "3267740288988803080",
   "en": "Smart.",
   "ro": "Inteligent."
  },
  {
   "key": "3267740289072689160",
   "en": "And don't make any sudden moves.",
   "ro": "Și fără mișcări bruște."
  },
  {
   "key": "3267740289374679048",
   "en": "Hmm?",
   "ro": "Hmm?"
  },
  {
   "key": "3267740289458565128",
   "en": "Securing the perimeter…",
   "ro": "Securizez perimetrul…"
  },
  {
   "key": "3267740289626337288",
   "en": "Area secure.",
   "ro": "Zonă securizată."
  },
  {
   "key": "3267740289693446144",
   "en": "False alarm…",
   "ro": "Alarmă falsă…"
  },
  {
   "key": "3267740289844441096",
   "en": "Come out, let's talk!",
   "ro": "Ieși afară, hai să vorbim!"
  },
  {
   "key": "3267740289911549960",
   "en": "Better cooperate!",
   "ro": "Mai bine cooperezi!"
  },
  {
   "key": "3267740290045767680",
   "en": "Corpse here! One of ours!",
   "ro": "Cadavru aici! Unul de-al nostru!"
  },
  {
   "key": "3267740290129653768",
   "en": "Copy!",
   "ro": "Recepționat!"
  },
  {
   "key": "3267740290280648712",
   "en": "Contact!",
   "ro": "Contact!"
  },
  {
   "key": "3267740290347757576",
   "en": "Bein' attacked!",
   "ro": "Sunt atacat!"
  },
  {
   "key": "3267740290448420872",
   "en": "Blow you to pieces!",
   "ro": "Te fac bucăți!"
  },
  {
   "key": "3267740290599415816",
   "en": "Forward!",
   "ro": "Înainte!"
  },
  {
   "key": "3267740290632970248",
   "en": "Enemy in sight!",
   "ro": "Inamic în vizor!"
  },
  {
   "key": "3267740290767187976",
   "en": "Protect the wounded for fuck's sake!",
   "ro": "Protejați răniții, pula mea!"
  },
  {
   "key": "3267740290851074048",
   "en": "Positions! Hold 'em goddammit!",
   "ro": "Poziții! Țineți-le, mama dracului!"
  },
  {
   "key": "3267740291002069000",
   "en": "Watch it.",
   "ro": "Atenție."
  },
  {
   "key": "3267740291035623432",
   "en": "You tryna piss me off?",
   "ro": "Vrei să mă enervezi?"
  },
  {
   "key": "3267740291102732296",
   "en": "Yes?",
   "ro": "Da?"
  },
  {
   "key": "3267740291186618376",
   "en": "Got some men lined up for the op… Uh-huh... Yeah… No, no fresh blood, only the best… Where?... Right, we'll be there.",
   "ro": "Am niște oameni pregătiți pentru operație… Aha... Da… Nu, nu recruți noi, doar cei mai buni… Unde?... Bine, ajungem acolo."
  },
  {
   "key": "3267740291220172808",
   "en": "Mhm… I see… Yeah… We'll do it, don't worry… Not a problem.",
   "ro": "Mhm… Înțeleg… Da… O să facem, nu-ți face griji… Nu-i problemă."
  },
  {
   "key": "3267740291304058888",
   "en": "Surround them!",
   "ro": "Înconjurați-i!"
  },
  {
   "key": "3267740291371167752",
   "en": "Affirmative!",
   "ro": "Afirmativ!"
  },
  {
   "key": "3267740291421499400",
   "en": "Get down, 'nade in sight!",
   "ro": "La pământ, grenadă în vizor!"
  },
  {
