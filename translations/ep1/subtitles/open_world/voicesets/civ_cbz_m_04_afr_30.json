{
 "depot": "ep1\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_cbz_m_04_afr_30.json",
 "entries": [
  {
   "key": "3115855843588370440",
   "en": "Hello!",
   "ro": "Salut!"
  },
  {
   "key": "3115855843638702088",
   "en": "You not from here. Clearly.",
   "ro": "Nu ești de aici. E clar."
  },
  {
   "key": "3115855843772919816",
   "en": "You dare?!",
   "ro": "Îndrăznești?!"
  },
  {
   "key": "3115855843840028672",
   "en": "Something wrong with your head?",
   "ro": "Ai ceva la cap?"
  },
  {
   "key": "3115855843923914760",
   "en": "How it's going?",
   "ro": "Ce faci?"
  },
  {
   "key": "3115855844007800840",
   "en": "A job is a job… Not flashy, but it pays bills… yes, night shifts are the worst…",
   "ro": "O treabă e o treabă… Nu e spectaculoasă, dar plătește facturile… da, turele de noapte sunt cele mai nasoale…"
  },
  {
   "key": "3115855844041355272",
   "en": "Yes, I am OK… Just very tired… My eyelids feel very heavy all the time…",
   "ro": "Da, sunt ok… Doar tare obosit… Mereu îmi cad pleoapele…"
  },
  {
   "key": "3115855844108464132",
   "en": "Love you.",
   "ro": "Te iubesc."
  },
  {
   "key": "3115855844343345160",
   "en": "Sweet Jesus, save me!",
   "ro": "Doamne, Dumnezeule, salvează-mă!"
  },
  {
   "key": "3115855844376899592",
   "en": "They're shooting! Take cover!",
   "ro": "Trag! La adăpost!"
  },
  {
   "key": "3115855844511117320",
   "en": "Don't… Please… Don't do this…",
   "ro": "Nu… Te rog… Nu face asta…"
  },
  {
   "key": "3115855844544671752",
   "en": "I don't even know who you are…",
   "ro": "Nici nu știu cine ești…"
  },
  {
   "key": "3115855844712443912",
   "en": "Huh? You are following me?",
   "ro": "Ha? Mă urmărești?"
  },
  {
   "key": "3115855844762775560",
   "en": "You hunting me?",
   "ro": "Mă vânezi?"
  },
  {
   "key": "3115855844913770504",
   "en": "Why you no let me pass, man?!",
   "ro": "De ce nu mă lași să trec, mă?!"
  },
  {
   "key": "3115855844964102144",
   "en": "Who taught you to drive?!",
   "ro": "Cine te-a învățat să conduci?!"
  },
  {
   "key": "3115855845081542664",
   "en": "Get your brain checked!",
   "ro": "Du-te să-ți verifici creierul!"
  },
  {
   "key": "3115855845115097096",
   "en": "Had a nice ride. Not anymore…",
   "ro": "Aveam o plimbare plăcută. Nu mai…"
  },
  {
   "key": "3266738802439811076",
   "en": "This really what you want?",
   "ro": "Chiar asta vrei?"
  },
  {
   "key": "3266738802456588292",
   "en": "I will not go down easy!",
   "ro": "Nu mă las ușor!"
  },
  {
   "key": "3266738802490142724",
   "en": "Hey, hey! Easy, friend!",
   "ro": "Hei, hei! Ușor, prietene!"
  },
  {
   "key": "3266738802506919940",
   "en": "Leave me!",
   "ro": "Lasă-mă!"
  }
 ]
}
