{
 "depot": "ep1\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_kml_m_05_afr_30.json",
 "entries": [
  {
   "key": "3267749837808398336",
   "en": "Not in the mood for chatting.",
   "ro": "Nu am chef de vorbă."
  },
  {
   "key": "3267749837825175560",
   "en": "You lost, girl?",
   "en_m": "You lost, boy?",
   "ro": "Te-ai rătăcit, fată?",
   "ro_m": "Te-ai rătăcit, băiete?"
  },
  {
   "key": "3267749837925838856",
   "en": "Step back or I'll open fire!",
   "ro": "Dă-te înapoi sau deschid focul!"
  },
  {
   "key": "3267749837959393288",
   "en": "This is BARGHEST ground, leave or die!",
   "ro": "Aici e teritoriul BARGHEST, pleacă sau mori!"
  },
  {
   "key": "3267749838043279368",
   "en": "Watch where you point that thing.",
   "ro": "Ai grijă unde îndrepți chestia aia."
  },
  {
   "key": "3267749838076833800",
   "en": "You gonked? Put that away.",
   "ro": "Ești țicnit? Pune-o la loc."
  },
  {
   "key": "3267749838160719880",
   "en": "Don't make me repeat myself.",
   "ro": "Nu mă face să mă repet."
  },
  {
   "key": "3267749838194274312",
   "en": "Come on. Give me a reason. Disobey me.",
   "ro": "Hai. Dă-mi un motiv. Nu mă asculta."
  },
  {
   "key": "3267749838278160392",
   "en": "Finally seein' sense.",
   "ro": "În sfârșit înțelegi."
  },
  {
   "key": "3267749838311714824",
   "en": "So you live to see another day.",
   "ro": "Deci mai trăiești să vezi o altă zi."
  },
  {
   "key": "3267749838395600904",
   "en": "Searching the perimeter.",
   "ro": "Caut pe perimetru."
  },
  {
   "key": "3267749838429155336",
   "en": "I'll look for intruders.",
   "ro": "Caut intruși."
  },
  {
   "key": "3267749838513041416",
   "en": "Area secure.",
   "ro": "Zonă securizată."
  },
  {
   "key": "3267749838546595848",
   "en": "No anomalies detected.",
   "ro": "Nicio anomalie detectată."
  },
  {
   "key": "3267749838630481928",
   "en": "Come out… I'm waiting.",
   "ro": "Ieși… Te aștept."
  },
  {
   "key": "3267749838664036360",
   "en": "Come out, come out wherever you are!...",
   "ro": "Ieși, ieși, oriunde ai fi!..."
  },
  {
   "key": "3267749838731145224",
   "en": "We got a corpse on our hands!",
   "ro": "Avem un cadavru pe cap!"
  },
  {
   "key": "3267749838781476872",
   "en": "Fine, I'll check it out.",
   "ro": "Bine, mă duc să verific."
  },
  {
   "key": "3267749838865362952",
   "en": "Enemy contact, opening fire!",
   "ro": "Contact inamic, deschid focul!"
  },
  {
   "key": "3267749838915694592",
   "en": "For fuck's sake!",
   "ro": "Pula mea, pe bune!"
  },
  {
   "key": "3267749838982803456",
   "en": "Eat this, sucker!",
   "ro": "Ia asta, fraierule!"
  },
  {
   "key": "3267749839049912328",
   "en": "Never mess with BARGHEST!",
   "ro": "Nu te pune cu BARGHEST!"
  },
  {
   "key": "3267749839083466760",
   "en": "Terminate the target!",
   "ro": "Elimină ținta!"
  },
  {
   "key": "3267749839167352840",
   "en": "Regroup, squad!",
   "ro": "Regrupați-vă, echipă!"
  },
  {
   "key": "3267749839200907272",
   "en": "To me! Keep the pressure on!",
   "ro": "La mine! Țineți presiunea!"
  },
  {
   "key": "3267749839284793352",
   "en": "Stupid move.",
   "ro": "Mutare proastă."
  },
  {
   "key": "3267749839318347784",
   "en": "Better watch it.",
   "ro": "Mai bine ai grijă."
  },
  {
   "key": "3267749839368679432",
   "en": "Yes?",
   "ro": "Da?"
  },
  {
   "key": "3267749839452565512",
   "en": "Yes, I understand… We'll handle the hostiles… Of course… Copy that…",
   "ro": "Da, am înțeles… Ne ocupăm de ăia… Sigur… Am priceput…"
  },
  {
   "key": "3267749839486119944",
   "en": "Where?... How many?... Uh-huh… what firepower we talkin'?... OK, one squad should be enough…",
   "ro": "Unde?... Câți?... Hm-hm… Cu ce fel de armament avem de-a face?... OK, o echipă ar trebui să ajungă…"
  },
  {
   "key": "3267749839570006024",
   "en": "Take the flank!",
   "ro": "Ia flancul!"
  },
  {
   "key": "3267749839637114888",
   "en": "Flankin' 'em right now!",
   "ro": "Îi iau pe flanc acum!"
  },
  {
   "key": "3267749839737778184",
   "en": "Explosives, watch out!",
   "ro": "Explozive, atenție!"
  },
  {
   "key": "3267749839788109832",
   "en": "Over and out.",
   "ro": "Terminat."
  },
  {
   "key": "3267749839922327560",
   "en": "Let's see what that was.",
   "ro": "Hai să vedem ce a fost."
  },
  {
   "key": "3267749839955881992",
   "en": "Better have a look around, yeah?",
   "ro": "Mai bine aruncăm o privire în jur, da?"
  },
  {
   "key": "3267749840022990856",
   "en": "After you, I'll cover our rear.",
   "ro": "După tine, acopăr spatele."
  },
  {
   "key": "3267749840073322500",
   "en": "Down with the cunt!",
   "ro": "Jos cu pizda!"
  },
  {
   "key": "3267749841113509892",
   "en": "Agh, to hell with ya'll!",
   "ro": "Agh, la naiba cu voi toți!"
  },
  {
   "key": "3267749841180618756",
   "en": "Matter of time now!",
   "ro": "E doar o chestiune de timp acum!"
  },
  {
   "key": "3267749841247727620",
   "en": "Still breathin'… Alarm!",
   "ro": "Încă respiră… Alarmă!"
  },
  {
   "key": "3267749841281282052",
   "en": "Glitchy-ass implants…",
   "ro": "Implanturi cu glitch-uri…"
  },
  {
   "key": "3267749841398722560",
   "en": "You bored or somethin'? Dismissed.",
   "ro": "Te plictisești sau ceva? Concediat."
  },
  {
   "key": "3267749841583271940",
   "en": "Fuckin' rookies! Look for cover!",
   "ro": "Recruți nenorociți! Căutați adăpost!"
  },
  {
   "key": "3267749841650380804",
   "en": "Just you and me! Let's dance!",
   "ro": "Doar tu și cu mine! Hai să dansăm!"
  },
  {
   "key": "3267749841717489668",
   "en": "Not gonna die like the others! Bring it!",
   "ro": "Nu o să mor ca ceilalți! Dă-i bătaie!"
  },
  {
   "key": "3267749841969147908",
   "en": "Yes!",
   "ro": "Da!"
  },
  {
   "key": "3267749842036256768",
   "en": "A hit!",
   "ro": "Lovitură!"
  },
  {
   "key": "3267749842204028932",
   "en": "She's going down! Pathetic!",
   "en_m": "He's going down! Pathetic!",
   "ro": "E terminată! Patetic!",
   "ro_m": "E terminat! Patetic!"
  },
  {
   "key": "3267749842271137792",
   "en": "This is the end!",
   "ro": "Asta e sfârșitul!"
  },
  {
   "key": "3267749842355023876",
   "en": "Enemy behind cover!",
   "ro": "Inamic în spatele adăpostului!"
  },
  {
   "key": "3267749842438909956",
   "en": "Maintain the barrage, reloading!",
   "ro": "Mențineți barajul, reîncarc!"
  },
  {
   "key": "3267749842522796032",
   "en": "Cyberattack!",
   "ro": "Ciberatac!"
  },
  {
   "key": "3267749842573127684",
   "en": "Ughh… I'm better now.",
   "ro": "Ughh… Mă simt mai bine acum."
  },
  {
   "key": "3267749842640236544",
   "en": "Optics down! Repeat, optics down!",
   "ro": "Optică căzută! Repet, optică căzută!"
  },
  {
   "key": "3267749842690568196",
   "en": "Hacker!",
   "ro": "Hacker!"
  },
  {
   "key": "3267749842740899844",
   "en": "Aaaaahhhh…",
   "ro": "Aaaaahhhh…"
  },
  {
   "key": "3267749842824785920",
   "en": "Need more men! Now!",
   "ro": "Am nevoie de mai mulți oameni! Acum!"
  },
  {
   "key": "3267749842891894788",
   "en": "Lemme see you bleed!",
   "ro": "Vreau să te văd sângerând!"
  },
  {
   "key": "3267749842959003652",
   "en": "Close contact!",
   "ro": "Contact apropiat!"
  },
  {
   "key": "3267749843042889732",
   "en": "Time for heavy guns, move!",
   "ro": "E timpul pentru arme grele, mișcați!"
  },
  {
   "key": "3267749843109998596",
   "en": "Get a grip you dumb fucks!",
   "ro": "Revino-ți, tâmpiților!"
  }
 ]
}
