{
 "depot": "ep1\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_cbz_f_06_ind_30.json",
 "entries": [
  {
   "key": "3115842103820218376",
   "en": "Hey, beautiful!",
   "en_m": "Hey, handsome!",
   "ro": "Hei, frumoaso!",
   "ro_m": "Hei, frumosule!"
  },
  {
   "key": "3115842103853772808",
   "en": "What a nice day.",
   "ro": "Ce zi frumoasă."
  },
  {
   "key": "3115842104004767752",
   "en": "Watch how you walk!",
   "ro": "Uită-te pe unde mergi!"
  },
  {
   "key": "3115842104055099400",
   "en": "Pissing me off, man…",
   "ro": "Mă calci pe nervi, frate…"
  },
  {
   "key": "3115842104138985480",
   "en": "Oh. Hey.",
   "ro": "Oh. Salut."
  },
  {
   "key": "3115842104273203208",
   "en": "They stormed his place… Thought they made up, but you know… Just the way it is… We aren't together anymore, so…",
   "ro": "Au dat buzna la el… Credeam că s-au împăcat, dar știi tu… Așa e viața… Nu mai suntem împreună, așa că…"
  },
  {
   "key": "3115842104323534856",
   "en": "It's still very sore… Got those new pills, take them with an inhaler and that helps… Mmm, just have to be clever, not overdo it…",
   "ro": "Încă mă doare rău… Am luat pastilele alea noi, le iau cu inhalatorul și ajută… Mmm, trebuie doar să fiu cu capul pe umeri, să nu exagerez…"
  },
  {
   "key": "3115842104373866504",
   "en": "OK, see you tomorrow.",
   "ro": "OK, ne vedem mâine."
  },
  {
   "key": "3115842104709410824",
   "en": "Watch out, people!",
   "ro": "Atenție, lume!"
  },
  {
   "key": "3115842104759742472",
   "en": "What… What's going on?!",
   "ro": "Ce… Ce se întâmplă?!"
  },
  {
   "key": "3115842104910737416",
   "en": "I'll do anything, anything, just let me go!...",
   "ro": "Fac orice, orice, doar lasă-mă să plec!..."
  },
  {
   "key": "3115842104944291848",
   "en": "I… I can't!",
   "ro": "Eu… Nu pot!"
  },
  {
   "key": "3115842105095286792",
   "en": "Please… Go away!",
   "ro": "Te rog… Pleacă!"
  },
  {
   "key": "3115842105128841224",
   "en": "Leave me alone or I'll scream!",
   "ro": "Lasă-mă în pace sau strig!"
  },
  {
   "key": "3115842105246281736",
   "en": "What the hell?!",
   "ro": "Ce dracu'?!"
  },
  {
   "key": "3115842105279836168",
   "en": "Oh, shit! Close one…",
   "ro": "Ah, căcat! A fost aproape…"
  },
  {
   "key": "3115842105464385544",
   "en": "You even have a license?!",
   "ro": "Ai și permis?!"
  },
  {
   "key": "3115842105497939976",
   "en": "Dumb fuck!",
   "ro": "Tâmpitule!"
  },
  {
   "key": "3266697550403006468",
   "en": "Gonna regret this!",
   "ro": "O să regreți asta!"
  },
  {
   "key": "3266697550453338116",
   "en": "I'll kill you dead!",
   "ro": "Te omor de tot!"
  },
  {
   "key": "3266697550486892548",
   "en": "What's wrong with you?!",
   "ro": "Ce-i cu tine?!"
  },
  {
   "key": "3266697550520446980",
   "en": "Hope you get stabbed!",
   "ro": "Sper să te înjunghie!"
  }
 ]
}
