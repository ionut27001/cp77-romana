 "entries": [
  {
   "key": "3115838588154605576",
   "en": "Please, keep your distance!",
   "ro": "Te rog, păstrează distanța!"
  },
  {
   "key": "3115838588188160008",
   "en": "Good day, no?",
   "ro": "Bună ziua, nu?"
  },
  {
   "key": "3115838588255268872",
   "en": "Do not touch me!",
   "ro": "Nu mă atinge!"
  },
  {
   "key": "3115838588288823304",
   "en": "Are you stupid?!",
   "ro": "Ești prost?!"
  },
  {
   "key": "3115838588339154952",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "3115838588423041032",
   "en": "You asked me to program daemon, so daemon is done… Hhmph... Don't care… You want to talk, talk to my friends…",
   "ro": "Mi-ai cerut să programez daemonul, așa că daemonul e gata… Hhmph... Nu-mi pasă… Vrei să vorbești, vorbește cu prietenii mei…"
  },
  {
   "key": "3115838588456595464",
   "en": "I do not deal with this anymore… No, don't want money, hear…? No… Uh huh… Still no…",
   "ro": "Nu mă mai ocup de asta… Nu, nu vreau bani, auzi…? Nu… Uh huh… Tot nu…"
  },
  {
   "key": "3115838588506927112",
   "en": "OK. Bye.",
   "ro": "OK. Pa."
  },
  {
   "key": "3115838588741808136",
   "en": "Run! Everybody - run!",
   "ro": "Fugiți! Toată lumea - fugiți!"
  },
  {
   "key": "3115838588775362568",
   "en": "What is this?!",
   "ro": "Ce-i asta?!"
  },
  {
   "key": "3115838588892803080",
   "en": "No! Mercy!",
   "ro": "Nu! Milă!"
  },
  {
   "key": "3115838588943134728",
   "en": "God, please help me!",
   "ro": "Doamne, ajută-mă!"
  },
  {
   "key": "3115838589110906888",
   "en": "What do you want?",
   "ro": "Ce vrei?"
  },
  {
   "key": "3115838589144461320",
   "en": "Leave me alone!",
   "ro": "Lasă-mă în pace!"
  },
  {
   "key": "3115838589329010688",
   "en": "What are you doing?!",
   "ro": "Ce faci?!"
  },
  {
   "key": "3115838589362565128",
   "en": "Are you trying to kill me?!",
   "ro": "Încerci să mă omori?!"
  },
  {
   "key": "3115838589547114504",
   "en": "Idiot!",
   "ro": "Idiotule!"
  },
  {
   "key": "3115838589597446152",
   "en": "Do you not have a brain?!",
   "ro": "N-ai creier?!"
  },
  {
   "key": "3266696753015484420",
   "en": "Now I'm angry!",
   "ro": "Acum sunt furioasă!",
   "ro_m": "Acum sunt furios!"
  },
  {
   "key": "3266696753032261636",
   "en": "I'll kill you!",
   "ro": "Te omor!"
  },
  {
   "key": "3266696753065816068",
   "en": "Back away, now!",
   "ro": "Dă-te înapoi, acum!"
  },
  {
   "key": "3266696753099370500",
   "en": "Go away, or else!",
   "ro": "Pleacă, altfel!"
  }
 ]
