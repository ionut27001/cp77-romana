 "depot": "ep1\\localization\\en-us\\subtitles\\open_world\\voicesets\\vset_sts_ep1_01_odel.json",
 "entries": [
  {
   "key": "3334480595035688968",
   "en": "I wasn't finished.",
   "ro": "Nu terminasem."
  },
  {
   "key": "3334480595069243400",
   "en": "I'm not done speaking.",
   "ro": "Nu am terminat de vorbit."
  },
  {
   "key": "3334480595153129480",
   "en": "You're back? Good.",
   "ro": "Te-ai întors? Bine."
  },
  {
   "key": "3334480595186683912",
   "en": "Have something to say?",
   "ro": "Ai ceva de spus?"
  },
  {
   "key": "3334480595203461128",
   "en": "I'll wait...",
   "ro": "O să aștept..."
  },
  {
   "key": "3334480595237015560",
   "en": "Let's not waste time.",
   "ro": "Să nu pierdem vremea."
  },
  {
   "key": "3334480595505451016",
   "en": "Good to see you.",
   "ro": "Mă bucur să te văd."
  },
  {
   "key": "3334480595539005448",
   "en": "We meet again.",
   "ro": "Ne întâlnim din nou."
  },
  {
   "key": "3334480595706777608",
   "en": "Easy now.",
   "ro": "Ușor acum."
  },
  {
   "key": "3334480595740332040",
   "en": "Careful, please.",
   "ro": "Atenție, te rog."
  }
 ]
}
