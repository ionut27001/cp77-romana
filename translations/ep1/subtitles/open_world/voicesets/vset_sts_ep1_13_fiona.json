 "entries": [
  {
   "key": "3334677280395431944",
   "en": "Let's keep this professional.",
   "ro": "Hai să păstrăm lucrurile profesionale."
  },
  {
   "key": "3334677280428986376",
   "en": "Allow me to finish, please.",
   "ro": "Lasă-mă să termin, te rog."
  },
  {
   "key": "3334677280496095240",
   "en": "Let's not make this any longer than it needs to be, shall we?",
   "ro": "Hai să nu ne întindem mai mult decât trebuie, da?"
  },
  {
   "key": "3334677280529649672",
   "en": "It's an uncomfortable situation. Let's not prolong it.",
   "ro": "E o situație neplăcută. Hai să n-o prelungim."
  },
  {
   "key": "3334677280563204104",
   "en": "Well then?",
   "ro": "Ei, și?"
  },
  {
   "key": "3334677280596758536",
   "en": "I'm listening.",
   "ro": "Ascult."
  },
  {
   "key": "3334677280865193992",
   "en": "Just leave, please.",
   "ro": "Pleacă, te rog."
  },
  {
   "key": "3334677281066520584",
   "en": "Please be careful.",
   "ro": "Ai grijă, te rog."
  }
 ]
