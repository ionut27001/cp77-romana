{
 "depot": "ep1\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_kml_m_08_chn_30.json",
 "entries": [
  {
   "key": "3267752624520753160",
   "en": "Got nothing to say to you.",
   "ro": "N-am nimic de spus ție."
  },
  {
   "key": "3267752624537530376",
   "en": "Leave Dogtown as soon as you get a chance.",
   "ro": "Pleacă din Dogtown când ai ocazia."
  },
  {
   "key": "3267752624621416456",
   "en": "Step back, civilian.",
   "ro": "Fă un pas înapoi, civilule."
  },
  {
   "key": "3267752624654970888",
   "en": "No, no, no. Back away. Now.",
   "ro": "Nu, nu, nu. Dă-te înapoi. Acum."
  },
  {
   "key": "3267752624738856968",
   "en": "Lower your weapon!",
   "ro": "Jos arma!"
  },
  {
   "key": "3267752624772411400",
   "en": "Put. That thing. Away!",
   "ro": "Pune. Chestia aia. La loc!"
  },
  {
   "key": "3267752624856297480",
   "en": "I'm talkin' to you!",
   "ro": "Cu tine vorbesc!"
  },
  {
   "key": "3267752624873074696",
   "en": "Obey immediately!",
   "ro": "Ascultă imediat!"
  },
  {
   "key": "3267752624973737992",
   "en": "Very good.",
   "ro": "Foarte bine."
  },
  {
   "key": "3267752625007292424",
   "en": "That's right, no sudden moves. Go.",
   "ro": "Așa, fără mișcări bruste. Du-te."
  },
  {
   "key": "3267752625091178504",
   "en": "I have a bad feeling.",
   "ro": "Am un sentiment rău."
  },
  {
   "key": "3267752625141510152",
   "en": "Don't like this at all.",
   "ro": "Nu-mi place deloc."
  },
  {
   "key": "3267752625275727880",
   "en": "Hm. Area secure.",
   "ro": "Hm. Zonă securizată."
  },
  {
   "key": "3267752625326059528",
   "en": "No threats to report.",
   "ro": "Nicio amenințare de raportat."
  },
  {
   "key": "3267752625426722824",
   "en": "Come out. Let's talk. Promise.",
   "ro": "Ieși. Hai să vorbim. Promit."
  },
  {
   "key": "3267752625460277252",
   "en": "Come out, dammit!",
   "ro": "Ieși afară, naiba!"
  },
  {
   "key": "3267752625510608904",
   "en": "Shit. Got a body here, people!",
   "ro": "Rahat. Avem un cadavru aici, oameni buni!"
  },
  {
   "key": "3267752625560940552",
   "en": "Understood.",
   "ro": "Înțeles."
  },
  {
   "key": "3267752625678381064",
   "en": "Ambush! Defend yourselves!",
   "ro": "Ambuscadă! Apărați-vă!"
  },
  {
   "key": "3267752625728712712",
   "en": "Got a troublemaker here!",
   "ro": "Avem un derbedeu aici!"
  },
  {
   "key": "3267752625812598792",
   "en": "'Nade!",
   "ro": "Grenadă!"
  },
  {
   "key": "3267752625946816512",
   "en": "Hit them from all sides!",
   "ro": "Atacați-i din toate părțile!"
  },
  {
   "key": "3267752625997148168",
   "en": "Duck, cover, fire!",
   "ro": "Jos, adăpost, foc!"
  },
  {
   "key": "3267752626097811464",
   "en": "Disengage! Regroup!",
   "ro": "Dezangajați! Reagrupați!"
  },
  {
   "key": "3267752626131365896",
   "en": "Looks like we got hostiles, boys!",
   "ro": "Se pare că avem inamici, băieți!"
  },
  {
   "key": "3267752626265583624",
   "en": "Move it.",
   "ro": "Mișcă-te."
  },
  {
   "key": "3267752626299138056",
   "en": "Don't test me.",
   "ro": "Nu mă testa."
  },
  {
   "key": "3267752626383024128",
   "en": "Hey, what's new?",
   "ro": "Hei, ce mai e nou?"
  },
  {
   "key": "3267752626466910216",
   "en": "I do know a guy who knows a guy… Mhm, yeah, friend from the past, way back… 'Course I trust him… Mhm…",
   "ro": "Știu un tip care știe un tip… Mhm, da, un prieten de demult… Sigur că am încredere în el… Mhm…"
  },
  {
   "key": "3267752626500464648",
   "en": "Sure… So you got a fight brewin'?... Mh, could take some time off… Yeah, cool…",
   "ro": "Sigur… Deci se pregătește o bătaie?... Mh, pot să iau o pauză… Da, mișto…"
  },
  {
   "key": "3267752626584350728",
   "en": "Her flank's exposed!",
   "ro": "Flancul ei e expus!"
  },
  {
   "key": "3267752626651459592",
   "en": "Flanking!",
   "ro": "Flancare!"
  },
  {
   "key": "3267752626718568456",
   "en": "Grenade, duck!",
   "ro": "Granată, jos!"
  },
  {
   "key": "3267752626768900104",
   "en": "Thanks. Stay in touch.",
   "ro": "Mulțumesc. Ține legătura."
  },
  {
   "key": "3267752626919895048",
   "en": "Hey, you. With me.",
   "ro": "Hei, tu. Cu mine."
  },
  {
   "key": "3267752626987003912",
   "en": "I'll lead. Secure our back.",
   "ro": "Eu conduc. Asigură spatele."
  },
  {
   "key": "3267752627104444424",
   "en": "Investigate the perimeter.",
   "ro": "Investigați perimetrul."
  },
  {
   "key": "3267752627137998856",
   "en": "Stick to your training for fuck's sake!",
   "ro": "Țineți-vă de antrenament, pula mea!"
  },
  {
   "key": "3267752628211740676",
   "en": "Stand your ground! Do not retreat!",
   "ro": "Țineți poziția! Nu vă retrageți!"
  },
  {
   "key": "3267752628295626752",
   "en": "Good! No mercy!",
   "ro": "Bine! Fără milă!"
  },
  {
   "key": "3267752628396290052",
   "en": "Got a live one… everybody, code red!",
   "ro": "Avem unul viu… toată lumea, cod roșu!"
  },
  {
   "key": "3267752628429844484",
   "en": "Stupid… Goddamn… piece of…",
   "ro": "Prost… afurisit… porcărie…"
  },
  {
   "key": "3267752628547284996",
   "en": "Didn't call for you. Back to your post.",
   "ro": "Nu te-am chemat. Înapoi la post."
  },
  {
   "key": "3267752628715057156",
   "en": "Don't get distracted or you'll end up like them!",
   "ro": "Nu vă mai distrageți, că o să ajungeți ca ei!"
  },
  {
   "key": "3267752628815720452",
   "en": "Won't go down so easily!",
   "ro": "Nu cad așa ușor!"
  },
  {
   "key": "3267752628882829316",
   "en": "BARGHEEEEST!",
   "ro": "BARGHEEEEST!"
  },
  {
   "key": "3267752629084155908",
   "en": "Hit confirmed!",
   "ro": "Lovitură confirmată!"
  },
  {
   "key": "3267752629134487556",
   "en": "She's getting sloppy! Finish her!",
   "en_m": "He's getting sloppy! Finish him!",
   "ro": "Devine neglijentă! Termin-o!",
   "ro_m": "Devine neglijent! Termină-l!"
  },
  {
   "key": "3267752629302259716",
   "en": "Enemy losing strength!",
   "ro": "Inamicul pierde forță!"
  },
  {
   "key": "3267752629369368580",
   "en": "She's mine!",
   "en_m": "He's mine!",
   "ro": "E a mea!",
   "ro_m": "E al meu!"
  },
  {
   "key": "3267752629419700228",
   "en": "Smoke her out!",
   "en_m": "Smoke him out!",
   "ro": "Scoate-o din ascunzătoare!",
   "ro_m": "Scoate-l din ascunzătoare!"
  },
  {
   "key": "3267752629486809092",
   "en": "New magazine!",
   "ro": "Revistă nouă!"
  },
  {
   "key": "3267752629553917956",
   "en": "Watch your implants, we got a netrunner here!",
   "ro": "Atenție la implanturi, avem un netrunner aici!"
  },
  {
   "key": "3267752629621026820",
   "en": "Ahh... I'm good now!...",
   "ro": "Ahh... Sunt bine acum!..."
  },
  {
   "key": "3267752629688135684",
   "en": "Optics… failing!",
   "ro": "Optica… cedează!"
  },
  {
   "key": "3267752629755244548",
   "en": "Reinforce your ICE!",
   "ro": "Întăriți-vă ICE-ul!"
  },
  {
   "key": "3267752629822353412",
   "en": "Feeling… powerful…",
   "ro": "Mă simt… puternic…"
  },
  {
   "key": "3267752629889462276",
   "en": "Need reinforcements, ASAP!",
   "ro": "Am nevoie de întăriri, ASAP!"
  },
  {
   "key": "3267752629939793924",
   "en": "C'mon, let's see you dance!",
   "ro": "Hai, să te văd dansând!"
  },
  {
   "key": "3267752630006902788",
   "en": "Got a little somethin' for you!",
   "ro": "Am ceva mic pentru tine!"
  },
  {
   "key": "3267752630074011652",
   "en": "That one's gonna hurt…",
   "ro": "Aia o să doară…"
  },
  {
   "key": "3267752630157897732",
   "en": "Medic!",
   "ro": "Medic!"
  }
 ]
}
