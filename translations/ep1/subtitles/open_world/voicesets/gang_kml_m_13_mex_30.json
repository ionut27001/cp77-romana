{
 "depot": "ep1\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_kml_m_13_mex_30.json",
 "entries": [
  {
   "key": "3267767442711572488",
   "en": "You want biz, go bother some scavs.",
   "ro": "Vrei afaceri, du-te să deranjezi niște hiene."
  },
  {
   "key": "3267767442745126920",
   "en": "Place isn't safe for people like you.",
   "ro": "Locul ăsta nu e sigur pentru oameni ca tine."
  },
  {
   "key": "3267767442845790216",
   "en": "Go away.",
   "ro": "Pleacă."
  },
  {
   "key": "3267767442879344648",
   "en": "Out of here. Now.",
   "ro": "Afară. Acum."
  },
  {
   "key": "3267767442963230728",
   "en": "Think real hard about this.",
   "ro": "Gândește-te bine la asta."
  },
  {
   "key": "3267767442996785160",
   "en": "Wavin' that thing around? Unwise.",
   "ro": "Fluturi chestia aia? Neînțelept."
  },
  {
   "key": "3267767443080671240",
   "en": "Warning you.",
   "ro": "Te avertizez."
  },
  {
   "key": "3267767443114225672",
   "en": "Back off while you can.",
   "ro": "Dă-te înapoi cât încă poți."
  },
  {
   "key": "3267767443198111752",
   "en": "Thanks for cooperating. Now go, before I change my mind.",
   "ro": "Mersi că ai cooperat. Acum dispari, până nu mă răzgândesc."
  },
  {
   "key": "3267767443248443392",
   "en": "You lookin' for applause? Buzz off, kid.",
   "ro": "Cauți aplauze? Valea, puștiule."
  },
  {
   "key": "3267767443349106696",
   "en": "Hmmm?",
   "ro": "Hmmm?"
  },
  {
   "key": "3267767443382661128",
   "en": "Something's off.",
   "ro": "Ceva nu e în regulă."
  },
  {
   "key": "3267767443466547208",
   "en": "Hm. Weird.",
   "ro": "Hm. Ciudat."
  },
  {
   "key": "3267767443500101640",
   "en": "Looks like all's in order.",
   "ro": "Se pare că totul e în regulă."
  },
  {
   "key": "3267767443600764936",
   "en": "Come out. Let's end this.",
   "ro": "Ieși. Să terminăm odată."
  },
  {
   "key": "3267767443634319368",
   "en": "Come to papa.",
   "ro": "Vino la tata."
  },
  {
   "key": "3267767443701428232",
   "en": "Found a dead one. Watch out!",
   "ro": "Am găsit un mort. Atenție!"
  },
  {
   "key": "3267767443768537088",
   "en": "Roger.",
   "ro": "Am înțeles."
  },
  {
   "key": "3267767443869200392",
   "en": "Attack! Alarm!",
   "ro": "Atac! Alarmă!"
  },
  {
   "key": "3267767443902754824",
   "en": "Take positions, people!",
   "ro": "Luați poziții, oameni buni!"
  },
  {
   "key": "3267767443969863688",
   "en": "Out of the way, grenade!",
   "ro": "Din cale, granată!"
  },
  {
   "key": "3267767444070526984",
   "en": "Wanna see them bullets flyin'!",
   "ro": "Vrei să vezi gloanțele zburând!"
  },
  {
   "key": "3267767444120858632",
   "en": "All firearms on target!",
   "ro": "Toate armele pe țintă!"
  },
  {
   "key": "3267767444204744712",
   "en": "Feed her some lead!",
   "en_m": "Feed him some lead!",
   "ro": "Dă-i niște plumb!"
  },
  {
   "key": "3267767444238299144",
   "en": "Attack, after me!",
   "ro": "Atac, după mine!"
  },
  {
   "key": "3267767444322185224",
   "en": "Step carefully.",
   "ro": "Pași cu grijă."
  },
  {
   "key": "3267767444355739656",
   "en": "Fuck's sake…",
   "ro": "Pula mea…"
  },
  {
   "key": "3267767444422848520",
   "en": "It's me.",
   "ro": "Sunt eu."
  },
  {
   "key": "3267767444506734600",
   "en": "Lost one man… Not sure, could've deserted, maybe a hangover, or got shivved… This fucking place…",
   "ro": "Am pierdut un om… Nu sunt sigur, poate a dezertat, poate e mahmur, sau l-au înjunghiat… Locul ăsta nenorocit…"
  },
  {
   "key": "3267767444540289032",
   "en": "Fresh blood?... Get a few people now and again, usually gangoons… Fuck knows… Yeah…",
   "ro": "Sânge proaspăt?... Mai vine câte unul din când în când, de obicei gangsteri… Habar n-am… Da…"
  },
  {
   "key": "3267767444624175112",
   "en": "Now, she's exposed!",
   "en_m": "Now, he's exposed!",
   "ro": "Acum e expusă!",
   "ro_m": "Acum e expus!"
  },
  {
   "key": "3267767444691283976",
   "en": "Gonna hit them from the side!",
   "ro": "O să-i lovesc din lateral!"
  },
  {
   "key": "3267767444758392840",
   "en": "Cover your ears!",
   "ro": "Acoperiți-vă urechile!"
  },
  {
   "key": "3267767444791947272",
   "en": "Be seein' ya.",
   "ro": "Ne vedem."
  },
  {
   "key": "3267767444926165000",
   "en": "Cover me, let's check it out.",
   "ro": "Acoperă-mă, hai să vedem."
  },
  {
   "key": "3267767444959719432",
   "en": "A threat?",
   "ro": "O amenințare?"
  },
  {
   "key": "3267767445010051080",
   "en": "Secure the place.",
   "ro": "Asigurați locul."
  },
  {
   "key": "3267767445043605512",
   "en": "Barrage! Fire at will!",
   "ro": "Baraj! Foc la discreție!"
  },
  {
   "key": "3267767445966352388",
   "en": "Shit's sake!...",
   "ro": "La naiba!..."
  },
  {
   "key": "3267767446016684036",
   "en": "Full speed ahead!",
   "ro": "Viteză maximă înainte!"
  },
  {
   "key": "3267767446100570116",
   "en": "Body found! Still breathing!",
   "ro": "Corp găsit! Încă respiră!"
  },
  {
   "key": "3267767446117347332",
   "en": "Did the lights go out…?",
   "ro": "S-au stins luminile…?"
  },
  {
   "key": "3267767446234787844",
   "en": "What's with the crowd? Disperse.",
   "ro": "Ce e cu mulțimea? Dispersați-vă."
  },
  {
   "key": "3267767446419337220",
   "en": "Bodies piling!",
   "ro": "Se adună cadavre!"
  },
  {
   "key": "3267767446469668868",
   "en": "Come on…",
   "ro": "Hai…"
  },
  {
   "key": "3267767446536777732",
   "en": "You killed 'em all!...",
   "ro": "I-ai omorât pe toți!..."
  },
  {
   "key": "3267767446704549892",
   "en": "She's taking damage!",
   "en_m": "He's taking damage!",
   "ro": "Primește daune!"
  },
  {
   "key": "3267767446771658756",
   "en": "Target wounded!",
   "ro": "Ținta rănită!"
  },
  {
   "key": "3267767446989762564",
   "en": "She can't keep this up! Fire!",
   "en_m": "He can't keep this up! Fire!",
   "ro": "Nu poate ține ritmul ăsta! Foc!"
  },
  {
   "key": "3267767447056871428",
   "en": "Lemme handle this!",
   "ro": "Mă ocup eu!"
  },
  {
   "key": "3267767447123980292",
   "en": "Fire from all sides, she's behind cover!",
   "en_m": "Fire from all sides, he's behind cover!",
   "ro": "Foc din toate părțile, e în spatele adăpostului!"
  },
  {
   "key": "3267767447174311940",
   "en": "Reloading, keep 'em busy!",
   "ro": "Reîncarc, țineți-i ocupați!"
  },
  {
   "key": "3267767447241420804",
   "en": "Mind control!",
   "ro": "Control mental!"
  },
  {
   "key": "3267767447308529668",
   "en": "It's me, back to my senses!",
   "ro": "Sunt eu, mi-am revenit!"
  },
  {
   "key": "3267767447358861316",
   "en": "I'm blinded!",
   "ro": "Sunt oarbă!",
   "ro_m": "Sunt orb!"
  },
  {
   "key": "3267767447425970180",
   "en": "Netrunner!",
   "ro": "Netrunner!"
  },
  {
   "key": "3267767447476301828",
   "en": "Yessss!...",
   "ro": "Daaaa!..."
  },
  {
   "key": "3267767447543410692",
   "en": "Need backup! I repeat, need backup!",
   "ro": "Am nevoie de întăriri! Repet, am nevoie de întăriri!"
  },
  {
   "key": "3267767447593742340",
   "en": "Now you're mine!",
   "ro": "Acum ești a mea!",
   "ro_m": "Acum ești al meu!"
  },
  {
   "key": "3267767447644073988",
   "en": "Got a lil' treat for ya!",
   "ro": "Am o mică surpriză pentru tine!"
  },
  {
   "key": "3267767447711182852",
   "en": "Say your prayers!",
   "ro": "Spune-ți rugăciunile!"
  },
  {
   "key": "3267767447761514500",
   "en": "We losin' soldiers here!",
   "ro": "Pierdem soldați aici!"
  },
  {
   "key": "3804648607017058320",
   "en": "Did the lights go out…?",
   "ro": "S-au stins luminile…?"
  },
  {
   "key": "3804655112650997776",
   "en": "Hmmm?",
   "ro": "Hmmm?"
  },
  {
   "key": "3804657696426147856",
   "en": "Come out. Let's end this.",
   "ro": "Ieși. Să terminăm odată."
  }
 ]
}
