  {
   "key": "1730403913504088064",
   "en": "You're in a cornfield. Tall green plants as far as the eye can see.",
   "ro": "Ești într-un lan de porumb. Plante verzi înalte cât vezi cu ochii."
  },
  {
   "key": "1730403913504088076",
   "en": "The sun is in your eyes, bright, blinding. The stalks of corn part as you walk forward.",
   "ro": "Soarele îți bate în ochi, strălucitor, orbitor. Firele de porumb se despart pe măsură ce mergi înainte."
  },
  {
   "key": "1730403913504088088",
   "en": "You come across a clearing left by an automated combine in its wake.",
   "ro": "Dai peste o poiană lăsată în urma unei combine automate."
  },
  {
   "key": "1730403913554419712",
   "en": "Arasaka.",
   "ro": "Arasaka."
  },
  {
   "key": "1730403913587974144",
   "en": "The city.",
   "ro": "Orașul."
  },
  {
   "key": "1730403913638305792",
   "en": "Nothing comes to mind.",
   "ro": "Nu-mi vine nimic în minte."
  },
  {
   "key": "1730403913671860224",
   "en": "Rebellion.",
   "ro": "Rebeliune."
  },
  {
   "key": "1730403913705414656",
   "en": "Death.",
   "ro": "Moarte."
  },
  {
   "key": "1730403913738969088",
   "en": "The future.",
   "ro": "Viitorul."
  },
  {
   "key": "1730403913806077952",
   "en": "\"The heat's made your mouth dry and sticky. You spot a rodents' nest at your feet.\"",
   "ro": "„Căldura ți-a uscat gura și ți-a făcut-o lipicioasă. Zărești un cuib de rozătoare la picioarele tale.”"
  },
  {
   "key": "1730403913839632388",
   "en": "The machine has torn through the soft soil. You spot blind, newborn field mice around their mother. The machine has left her sliced in two.",
   "ro": "Utilajul a brăzdat pământul moale. Vezi pui de șoarece de câmp, orbi, nou-născuți, lângă mama lor. Utilajul a tăiat-o în două."
  },
  {
   "key": "1730403913839632400",
   "en": "They lie in perfect symmetry, a tiny rodent rosette. Your mouth begins to water.",
   "ro": "Sunt aranjați perfect simetric, ca o rozetă minusculă. Ți se face gura apă."
  },
  {
   "key": "1730403913856409600",
   "en": "\"A shadow gradually covers the ground. The first raincloud of the year.\"",
   "ro": "„O umbră acoperă treptat pământul. Primul nor de ploaie al anului.”"
  },
  {
   "key": "1730403913889964032",
   "en": "Right. Enough.",
   "ro": "Bine. Destul."
  },
  {
   "key": "1730403914309394432",
   "en": "[Jack in]",
   "ro": "[Conectează-te]"
  },
  {
   "key": "1730403914359726080",
   "en": "Higher-order representation formation – initiating test.",
   "ro": "Formarea reprezentărilor de ordin superior – inițiere test."
  },
  {
   "key": "1730403914997260288",
   "en": "Next test. Please connect your personal link.",
   "ro": "Următorul test. Te rog, conectează-ți legătura personală."
  },
  {
   "key": "1730403915953561600",
   "en": "Please step onto the treadmill.",
   "ro": "Te rog, urcă pe banda de alergare."
  },
  {
   "key": "1730403916071002112",
   "en": "Personal link.",
   "ro": "Legătură personală."
  },
  {
   "key": "1730403916138110976",
   "en": "[Jack in]",
   "ro": "[Conectează-te]"
  },
  {
   "key": "1730403916188442624",
   "en": "Really aced it last time, didn't I?",
   "ro": "Data trecută mi-a ieșit de minune, nu?"
  },
  {
   "key": "1730403916272328704",
   "en": "Slow walk.",
   "ro": "Mergi încet."
  },
  {
   "key": "1730403916322660352",
   "en": "Nope. Not doing it.",
   "ro": "Nu. Nu fac."
  },
  {
   "key": "1730403916372992000",
   "en": "Not bad so far, huh?",
   "ro": "Nu-i rău până acum, nu?"
  },
  {
   "key": "1730403916406546432",
   "en": "No. No point to this.",
   "ro": "Nu. N-are rost."
  },
  {
   "key": "1730403916607873024",
   "en": "The tests are necessary, they must be performed.",
   "ro": "Testele-s necesare, trebuie făcute."
  },
  {
   "key": "1730403916658204672",
   "en": "Try a little faster.",
   "ro": "Încearcă puțin mai repede."
  },
  {
   "key": "1730403916658204680",
   "en": "Accelerate by three.",
   "ro": "Accelerează cu trei."
  },
  {
   "key": "1730403916859531264",
   "en": "I... I can't. Gotta stop.",
   "ro": "Eu... nu mai pot. Trebuie să mă opresc."
  },
  {
   "key": "1730403916976971776",
   "en": "[Disconnect and stand]",
   "ro": "[Deconectează-te și ridică-te]"
  },
  {
   "key": "1731534439074394112",
   "en": "Stop treadmill.",
   "ro": "Oprește banda de alergat."
  },
  {
   "key": "1731538952665591824",
   "en": "Communications have been unlocked. You may now phone home. Earth.",
   "ro": "Comunicațiile au fost deblocate. Acum poți suna acasă. Pe Pământ."
  },
  {
   "key": "1731538952665591840",
   "en": "Testing concluded for today.",
   "ro": "Testele s-au terminat pentru azi."
  },
  {
   "key": "1731638061099724800",
   "en": "[Stand]",
   "ro": "[Ridică-te]"
  },
  {
   "key": "1731879734913556480",
   "en": "The heat has made your mouth dry and sticky. You spot a rodents' nest at your feet.",
   "ro": "Căldura ți-a uscat gura și ți-a lăsat-o lipicioasă. Vezi un cuib de rozătoare chiar lângă picioare."
  },
  {
   "key": "1731880946547318784",
   "en": "\"The heat's made your mouth dry...\"",
   "ro": "„Căldura ți-a uscat gura...”"
  },
  {
   "key": "1731909262394286080",
   "en": "A shadow gradually falls over the ground. The first raincloud of the year.",
   "ro": "O umbră cade treptat peste pământ. Primul nor de ploaie al anului."
  },
  {
   "key": "1737610241595105280",
   "en": "Hm.",
   "ro": "Hm."
  },
  {
   "key": "1741588737833644032",
