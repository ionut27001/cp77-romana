   "ro": "Nu ești cea mai coordonată, nu?",
   "ro_m": "Nu ești cel mai coordonat, nu?"
  },
  {
   "key": "1966178957326688260",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1966178957343465476",
   "en": "Fall asleep on me?",
   "ro": "Ai adormit pe mine?"
  },
  {
   "key": "2251900238529519616",
