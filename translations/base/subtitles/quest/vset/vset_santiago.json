 "entries": [
  {
   "key": "1796870622898274308",
   "en": "Ready or not, here they come!",
   "ro": "Gata sau nu, iată-i că vin!"
  },
  {
   "key": "1796870622931828736",
   "en": "Let's finish this quick.",
   "ro": "Hai să terminăm repede."
  },
  {
   "key": "1796870622965383172",
   "en": "Get clear!",
   "ro": "La adăpost!"
  },
  {
   "key": "1796870623032492036",
   "en": "I'll cover you!",
   "ro": "Te acopăr!"
  },
  {
   "key": "1796870623082823684",
   "en": "You're dead, corpo-scum!",
   "ro": "Ești mort, scursură de corpo!"
