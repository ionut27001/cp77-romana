  {
   "key": "1796870623183486976",
   "en": "We're just warming up!",
   "ro": "Doar ne încălzim!"
  },
  {
   "key": "1796870623217041412",
   "en": "Oh, that's how we're gonna play it?!",
   "ro": "A, așa o să jucăm?!"
  },
  {
   "key": "1796870623250595844",
