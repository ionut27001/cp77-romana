  },
  {
   "key": "1796870623720357892",
   "en": "What  – can't make up your mind?",
   "ro": "Ce – nu te poți hotărî?"
  },
  {
   "key": "1796870623955238916",
   "en": "What's up?",
   "ro": "Ce faci?"
  },
  {
   "key": "1796870624005570564",
   "en": "Johnny Silverhand. The one and only.",
   "ro": "Johnny Silverhand. Unicul și inegalabilul."
  },
  {
   "key": "1796870624139788292",
   "en": "Tryna get a kick outta me?",
   "ro": "Vrei să te distrezi pe seama mea?"
  },
  {
   "key": "1796870624173342724",
   "en": "What  – your ego need more space?",
   "ro": "Ce – egoul tău are nevoie de mai mult spațiu?"
