  },
  {
   "key": "1796870623317704708",
   "en": "Hands... off!",
   "ro": "Mâinile... jos!"
  },
  {
   "key": "1796870623502254084",
   "en": "Got a few minutes to kill.",
   "ro": "Am câteva minute de omorât."
  },
  {
   "key": "1796870623535808516",
   "en": "Talk later, sure.",
   "ro": "Vorbim mai târziu, sigur."
  },
  {
