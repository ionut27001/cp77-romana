{
 "depot": "base\\localization\\en-us\\subtitles\\quest\\q115\\q115_05_halo_jump.json",
 "entries": [
  {
   "key": "1663332564398379008",
   "en": "Dammit!",
   "ro": "La naiba!"
  },
  {
   "key": "1663334703208206336",
   "en": "Hey! They got a lock on us!",
   "ro": "Hei! Ne-au luat în vizor!"
  },
  {
   "key": "1663339340783030272",
   "en": "Engine's been hit!",
   "ro": "Motorul a fost lovit!"
  },
  {
   "key": "1663340247457337344",
   "en": "Get us outta here!",
   "ro": "Scoate-ne de-aici!"
  },
  {
   "key": "1663346791074893824",
   "en": "Fuck!",
   "ro": "Futu-i!"
  },
  {
   "key": "1663517908846645248",
   "en": "I just... can't believe we're actually doing this!",
   "ro": "Nu-mi vine să cred că chiar facem asta!"
  },
  {
   "key": "1663518224711290884",
   "en": "Memories flooding back?",
   "ro": "Ți-au revenit amintirile?"
  },
  {
   "key": "1663518366646538240",
   "en": "Don't tell me you've got doubts.",
   "ro": "Nu-mi spune că ai dubii."
  },
  {
   "key": "1663519064545169408",
   "en": "Just like old times, yeah?",
   "ro": "Ca pe vremuri, nu?"
  },
  {
   "key": "1663519126822195200",
   "en": "Oh, don't tell me doubt's creepin' in!",
   "ro": "Ei, nu-mi spune că te apucă îndoielile!"
  },
  {
   "key": "1663519553164808192",
   "en": "Won't lie, it has. But that doesn't matter now.",
   "ro": "N-o să mint, da. Dar acum nu mai contează."
  },
  {
   "key": "1663531473913647104",
   "en": "Know what I like most about Night City?",
   "ro": "Știi ce-mi place cel mai mult la Night City?"
  },
  {
   "key": "1663531675743555584",
   "en": "What'd that be?",
   "ro": "Ce anume?"
  },
  {
   "key": "1663539644434616320",
   "en": "Take a look!",
   "ro": "Uită-te!"
  },
  {
   "key": "1663542902670626816",
   "en": "No idea how this's gonna end, but lemme tell ya, it'll be one loud morning!",
   "ro": "N-am idee cum o să se termine, da' îți zic că o să fie o dimineață gălăgioasă!"
  },
  {
   "key": "1663542961508323328",
   "en": "Where no one can make you do shit!",
   "ro": "Unde nimeni nu te poate sili să faci un căcat!"
  },
  {
   "key": "1663565375919230976",
   "en": "Hahahaha!",
   "ro": "Hahahaha!"
  },
  {
   "key": "1663566154969255936",
   "en": "We make the rules!",
   "ro": "Noi facem regulile!"
  },
  {
   "key": "1664501507343388672",
   "en": "See that?",
   "ro": "Vezi?"
  },
  {
   "key": "1664501600154947584",
   "en": "One day you're in the gutter, the next – you got the whole city at your feet!",
   "ro": "Într-o zi ești în șanț, a doua ai tot orașul la picioare!"
  },
  {
   "key": "1664506376762560512",
   "en": "The whole fuckin' city!",
   "ro": "Tot orașul dracului!"
  },
  {
   "key": "1664512117271564288",
   "en": "Jesus, it's so beautiful...!",
   "ro": "Doamne, e atât de frumos...!"
  },
  {
   "key": "1664515235099054080",
   "en": "Whoa! Was that the Juroujin?!",
   "ro": "Uau! Aia a fost Juroujin?!"
  },
  {
   "key": "1664528336913567744",
   "en": "Shit!",
   "ro": "Căcat!"
  },
  {
   "key": "1670501910103068672",
   "en": "Not even those motherfuckers!",
   "ro": "Nici măcar nenorociții ăia!"
  },
  {
   "key": "1670504335165755392",
   "en": "And one!",
   "ro": "Și unu!"
  },
  {
   "key": "1702500684027269120",
   "en": "Make a wish.",
   "ro": "Fă o dorință."
  },
  {
   "key": "1702536018320560128",
   "en": "What do we do?",
   "ro": "Ce facem?"
  },
  {
   "key": "1702536925095530496",
   "en": "Stick to the plan!",
   "ro": "Ține-te de plan!"
  },
  {
   "key": "1803796829818458112",
   "en": "Weyland! Take us up!",
   "ro": "Weyland! Du-ne sus!"
  },
  {
   "key": "1803802815912349696",
   "en": "Copy that!",
   "ro": "Am înțeles!"
  },
  {
   "key": "1803816955397672960",
   "en": "Rogue!",
   "ro": "Rogue!"
  },
  {
   "key": "1803817015795650560",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1803817085303656448",
   "en": "You're pretty damn quiet.",
   "ro": "Ești tare tăcută.",
   "ro_m": "Ești tare tăcut."
  },
  {
   "key": "1803817215763288064",
   "en": "Everything chill?",
   "ro": "Totul ok, calmă?",
   "ro_m": "Totul ok, calm?"
  },
  {
   "key": "1803822583398666240",
   "en": "Time we gave this city another wake-up call!",
   "ro": "E timpul să-i mai dăm orașului ăsta o trezire!"
  },
  {
   "key": "1803840192831688704",
   "en": "Just like old times.",
   "ro": "Ca pe vremuri."
  },
  {
   "key": "1803948103096471552",
   "en": "About to get even prettier, too…!",
   "ro": "Și mai frumos o să fie...!"
  },
  {
   "key": "1803948792153509888",
   "en": "The hell you say? You two take a puff and not share with me?!",
   "ro": "Ce, mă, serios? Voi doi trageți un fum și nu-mi dați și mie?!"
  },
  {
   "key": "1803949590497333248",
   "en": "Haha, I wish, Squama!",
   "ro": "Haha, aș vrea, Squama!"
  },
  {
   "key": "1803950475227041792",
   "en": "Eyes on the sky, everybody!",
   "ro": "Ochi pe cer, toată lumea!"
  },
  {
   "key": "1803959899509362688",
   "en": "Cunningham makes her entrance in three, two…",
   "ro": "Cunningham își face intrarea în trei, doi…"
  },
  {
   "key": "2028765418212892676",
   "en": "No goin' back!",
   "ro": "Fără întoarcere!"
  },
  {
   "key": "2028766345271517184",
   "en": "Too late! Time to delta's passed! Gotta improvise!",
   "ro": "Prea târziu, n-avem cum s-o tăiem! Trebuie să improvizăm!"
  },
  {
   "key": "2028767693287268384",
   "en": "I'm losing control!",
   "ro": "Pierd controlul!"
  },
  {
   "key": "2028767693304045592",
   "en": "Weyland! Get us to the top floors!",
   "ro": "Weyland! Du-ne la etajele de sus!"
  },
  {
   "key": "2047315525882273796",
   "en": "[Get  in]",
   "ro": "[Intră]"
  },
  {
   "key": "2239350275020529664",
   "en": "Not this time, honey!",
   "ro": "Nu de data asta, dragă!"
  }
 ]
}
