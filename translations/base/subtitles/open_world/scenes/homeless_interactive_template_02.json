{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\scenes\\homeless_interactive_template_02.json",
 "entries": [
  {
   "key": "2444842312082001924",
   "en": "All right, just this once.",
   "ro": "Bine, doar de data asta."
  },
  {
   "key": "2444848248364339220",
   "en": "Spare a veteran some change?",
   "ro": "Nu-mi dai și mie niște mărunțiș? Sunt veteran."
  },
  {
   "key": "2444849036121739292",
   "en": "Here, all yours.",
   "ro": "Poftim, tot al tău."
  },
  {
   "key": "2444849036138516480",
   "en": "Knew I saw good in you. God bless.",
   "ro": "Știam eu că e ceva bun în tine. Dumnezeu să te ajute!"
  },
  {
   "key": "2444925756753448960",
   "en": "'Course, here you go.",
   "ro": "Sigur, poftim."
  },
  {
   "key": "2444926906126962688",
   "en": "Sure, why not?",
   "ro": "Sigur, de ce nu?"
  },
  {
   "key": "2444927452661551104",
   "en": "Here, all yours.",
   "ro": "Poftim, tot al tău."
  },
  {
   "key": "2444932501982810112",
   "en": "It's your lucky day. Here.",
   "ro": "Ai noroc azi. Poftim."
  },
  {
   "key": "2444946329495801856",
   "en": "Here, no need to thank me.",
   "ro": "Poftim, nu-i nevoie să mulțumești."
  },
  {
   "key": "3231806875005165568",
   "en": "Here you go.",
   "ro": "Poftim."
  },
  {
   "key": "3485411265939902464",
   "en": "Here. Take it..",
   "ro": "Poftim. Ia-o.."
  },
  {
   "key": "3485413274759860224",
   "en": "You sure…? Looks like it's worth… well, a ton…",
   "ro": "Ești sigur…? Pare că valorează… păi, o grămadă…"
  },
  {
   "key": "3485413793880477696",
   "en": "Meh, not worth a damn to me anymore. Do what you will with it.",
   "ro": "Meh, nu mai face doi bani pentru mine. Fă ce vrei cu ea."
  },
  {
   "key": "3485414980683960320",
   "en": "[Give medal] How about this instead?",
   "ro": "[Dă medalia] Ce zici de asta în schimb?"
  }
 ]
