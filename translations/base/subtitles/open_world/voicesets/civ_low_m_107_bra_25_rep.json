  },
  {
   "key": "1896754083081494532",
   "en": "This will end badly!",
   "ro": "O să se termine prost!"
  },
  {
   "key": "1896754083131826180",
   "en": "I knew you'd make a right choice.",
   "ro": "Știam că o să alegi bine."
  },
  {
   "key": "1896754083165380608",
   "en": "Good. Very good.",
   "ro": "Bine. Foarte bine."
  },
  {
   "key": "1896754083215712260",
   "en": "What now?",
   "ro": "Ce acum?"
  },
  {
   "key": "1896754083232489476",
   "en": "Is that someone... ?",
   "ro": "E cineva... ?"
  },
  {
   "key": "1896754083299598340",
   "en": "I was certain I heard someone.",
   "ro": "Eram sigur că am auzit pe cineva."
  },
  {
   "key": "1896754083316375556",
   "en": "I'm imagining things.",
   "ro": "Îmi imaginez lucruri."
  },
  {
   "key": "1896754083383484420",
   "en": "You're here. Right?",
   "ro": "Ești aici, da?"
  },
  {
   "key": "1896754083417038852",
   "en": "Why you hidin'?",
   "ro": "De ce te ascunzi?"
  },
  {
   "key": "1896754083484147716",
   "en": "Why?",
   "ro": "De ce?"
  },
  {
   "key": "1896754083517702148",
   "en": "Hey!",
   "ro": "Hei!"
  },
  {
   "key": "1896754083568033796",
   "en": "It's me.",
   "ro": "Sunt eu."
  },
  {
   "key": "1896754083618365444",
   "en": "Yeah… 'Cause I lost again… Yeah… It's all a big con.",
   "ro": "Da… Pentru că am pierdut iar… Da… E toată chestia o mare țeapă."
  },
  {
   "key": "1896754083651919876",
   "en": "It's always the same guys… No lottery there… Uh-huh… I guess…! Fuckin' cheaters!",
   "ro": "Mereu aceiași tipi… Acolo nu e nicio loterie… Mhm… Cred…! Trișorii dracului!"
  },
  {
   "key": "1896754083685474308",
   "en": "Keep in touch.",
   "ro": "Ține legătura."
  },
  {
   "key": "1896754083719028740",
   "en": "What's going on?",
   "ro": "Ce se întâmplă?"
  },
  {
   "key": "1896754084138459136",
   "en": "Over here! Hurry!",
   "ro": "Aici! Grăbește-te!"
  },
  {
   "key": "1896754084155236356",
   "en": "Do something!",
   "ro": "Fă ceva!"
  },
  {
   "key": "1896754084272676868",
   "en": "No! Noooo!",
   "ro": "Nu! Nuuuu!"
  },
  {
   "key": "1896754084289454084",
   "en": "Let me live!",
   "ro": "Lasă-mă să trăiesc!"
  },
  {
   "key": "1896754084390117380",
   "en": "For what?",
   "ro": "Pentru ce?"
  },
  {
   "key": "1896754084423671812",
   "en": "I'm nobody!",
   "ro": "Sunt nimeni!"
  },
  {
   "key": "1896754084507557892",
   "en": "Fuck off. I got enough problems.",
   "ro": "Du-te dracu'. Am destule probleme."
  },
  {
