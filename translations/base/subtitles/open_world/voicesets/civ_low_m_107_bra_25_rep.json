  {
   "key": "1896754082813059076",
   "en": "Hehh, what'll it be…?",
   "ro": "Hehh, ce-o să fie…?"
  },
  {
   "key": "1896754082846613504",
   "en": "What? Uh, I don't get it.",
   "ro": "Ce? Uh, nu înțeleg."
  },
  {
   "key": "1896754082896945156",
   "en": "Just what are you doing here?",
   "ro": "Ce cauți aici?"
  },
  {
