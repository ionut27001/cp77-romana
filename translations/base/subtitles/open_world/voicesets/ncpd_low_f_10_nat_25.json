{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_low_f_10_nat_25.json",
 "entries": [
  {
   "key": "1864659872703438852",
   "en": "Could do curry today.",
   "ro": "Azi mi-ar merge un curry."
  },
  {
   "key": "1864659872720216068",
   "en": "Could go for somethin' sweet, actually.",
   "ro": "Aș mânca ceva dulce, de fapt."
  },
  {
   "key": "1864659872753770500",
   "en": "Come on – move back!",
   "ro": "Hai, dați-vă înapoi!"
  },
  {
   "key": "1864659872770547716",
   "en": "Yeah, yeah, yeah, back it up.",
   "ro": "Da, da, da, dați-vă înapoi."
  },
  {
   "key": "1864659872820879364",
   "en": "Holster that!",
   "ro": "Pune arma la loc!"
  },
  {
   "key": "1864659872837656580",
   "en": "What?! Think you can do whatever you want?!",
   "ro": "Ce?! Crezi că poți face ce vrei?!"
  },
  {
   "key": "1864659872871211012",
   "en": "I gotta beat some sense into you?",
   "ro": "Trebuie să-ți bat mintea în cap?"
  },
  {
   "key": "1864659872887988232",
   "en": "Think we can't do shit? We sure can!",
   "ro": "Crezi că nu putem face nimic? Ba putem!"
  },
  {
   "key": "1864659872938319876",
   "en": "Get out.",
   "ro": "Ieși afară."
  },
  {
   "key": "1864659872955097092",
   "en": "Bye bye!",
   "ro": "Pa, pa!"
  },
  {
   "key": "1864659873005428740",
   "en": "Can't catch a fuckin' break...",
   "ro": "Nu prind o pauză, pula mea..."
  },
  {
   "key": "1864659873022205956",
   "en": "Another problem?",
   "ro": "Încă o problemă?"
  },
  {
   "key": "1864659873055760388",
   "en": "Phew. Enough of that.",
   "ro": "Pfui. Destul cu asta."
  },
  {
   "key": "1864659873072537604",
   "en": "All right. Girl's gotta eat.",
   "ro": "Bine. Fata trebuie să mănânce."
  },
  {
   "key": "1864659873122869252",
   "en": "Come on! Let's finish this!",
   "ro": "Hai! Să terminăm odată!"
  },
  {
   "key": "1864659873139646468",
   "en": "Come out! I'm hungry over here!",
   "ro": "Ieși! Mi-e foame aici!"
  },
  {
   "key": "1864659873173200900",
   "en": "Holy shit!",
   "ro": "Ce căcat!"
  },
  {
   "key": "1864659873189978116",
   "en": "OK.",
   "ro": "OK."
  },
  {
   "key": "1864659873240309764",
   "en": "Officer under fire!",
   "ro": "Ofițer sub foc!"
  },
  {
   "key": "1864659873257086980",
   "en": "NCPD! NCPD!",
   "ro": "NCPD! NCPD!"
  },
  {
   "key": "1864659873290641412",
   "en": "Take that!",
   "ro": "Ia asta!"
  },
  {
   "key": "1864659873340973060",
   "en": "Get her! Fight!",
   "en_m": "Get him! Fight!",
   "ro": "Prinde-o! Luptă!",
   "ro_m": "Prinde-l! Luptă!"
  },
  {
   "key": "1864659873525522436",
   "en": "Come on! Let's see what you got!",
   "ro": "Hai! Să vedem ce poți!"
  },
  {
   "key": "1864659873575854084",
   "en": "What in the hell!",
   "ro": "Ce naiba?!"
  },
  {
   "key": "1864659873592631300",
   "en": "This is not what they promised!",
   "ro": "Asta nu e ce au promis!"
  },
  {
   "key": "1864659873626185732",
   "en": "What? Huh?",
   "ro": "Ce? Ha?"
  },
  {
   "key": "1864659873642962948",
   "en": "'Ey!",
   "ro": "Hei!"
  },
  {
   "key": "1864659873676517380",
   "en": "Hey.",
   "ro": "Hei."
  },
  {
   "key": "1864659873726849028",
   "en": "Sure... Yeah, I could eat, too... Again? Nah, let's do something else...",
   "ro": "Sigur... Da, și eu aș mânca ceva... Iar? Nu, hai să facem altceva..."
  },
  {
   "key": "1864659873743626244",
   "en": "What's up...? Mhm... Sure... Yeah, let's meet there...",
   "ro": "Ce mai faci...? Mhm... Sigur... Da, ne vedem acolo..."
  },
  {
   "key": "1864659873793957892",
   "en": "Run! Book it!",
   "ro": "Fugiți! Dispăreți!"
  },
  {
   "key": "1864659873827512324",
   "en": "Yep! On it!",
   "ro": "Da! Mă ocup!"
  },
  {
   "key": "1864659873844289540",
   "en": "Get out! Run!",
   "ro": "Ieșiți! Fugiți!"
  },
  {
   "key": "1864659873877843968",
   "en": "See ya.",
   "ro": "Ne vedem."
  },
  {
   "key": "1864659873894621188",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1864659873928175620",
   "en": "C'mere, c'mon.",
   "ro": "Vino aici, hai."
  },
  {
   "key": "1864659873944952836",
   "en": "We better check it out.",
   "ro": "Mai bine verificăm."
  },
  {
   "key": "1864659873978507268",
   "en": "Be right behind you.",
   "ro": "Vin imediat în urma ta."
  },
  {
   "key": "1864659873995284484",
   "en": "Ain't nobody gonna do it for us!",
   "ro": "Nimeni nu o să facă asta pentru noi!"
  },
  {
   "key": "1864659874028838916",
   "en": "Argh... ech... ech... no... no... no...",
   "ro": "Argh... ech... ech... nu... nu... nu..."
  },
  {
   "key": "1867721688283209728",
   "en": "I dunno, I don't care... Wait, why you mad now?... Oh, yeah, we could go there...",
   "ro": "Nu știu, nu-mi pasă... Stai, de ce ești supărată acum?... A, da, am putea merge acolo...",
   "ro_m": "Nu știu, nu-mi pasă... Stai, de ce ești supărat acum?... A, da, am putea merge acolo..."
  },
  {
   "key": "1867722045604356096",
   "en": "All right... OK... I know, I know...",
   "ro": "Bine... OK... Știu, știu..."
  }
 ]
}
