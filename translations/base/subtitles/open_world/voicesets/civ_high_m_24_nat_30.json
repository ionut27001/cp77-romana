{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_24_nat_30.json",
 "entries": [
  {
   "key": "1948841681351647232",
   "en": "Where are we going?",
   "ro": "Unde mergem?"
  },
  {
   "key": "1948841681368424452",
   "en": "I don't do autographs.",
   "ro": "Nu dau autografe."
  },
  {
   "key": "1948841681418756100",
   "en": "Outsiders are not welcome here!",
   "ro": "Străinii nu sunt bineveniți aici!"
  },
  {
   "key": "1948841681435533316",
   "en": "Get out of here. Now! Go, go!",
   "ro": "Plecați de aici. Acum! Haide, haide!"
  },
  {
   "key": "1948841681485864964",
   "en": "What... what're you doing?!",
   "ro": "Ce... ce faci?!"
  },
  {
   "key": "1948841681502642180",
   "en": "No… You can't do this!",
   "ro": "Nu… Nu poți face asta!"
  },
  {
   "key": "1948841681552973828",
   "en": "They will shoot you! Beware!",
   "ro": "Te vor împușca! Ferește-te!"
  },
  {
   "key": "1948841681569751044",
   "en": "You must leave! Do you understand?",
   "ro": "Trebuie să pleci! Înțelegi?"
  },
  {
   "key": "1948841681620082692",
   "en": "Ah, yes. That's better.",
   "ro": "Ah, da. Așa e mai bine."
  },
  {
   "key": "1948841681636859908",
   "en": "Violence is never the answer.",
   "ro": "Violența nu e niciodată soluția."
  },
  {
   "key": "1948841681687191556",
   "en": "Well I'll be…!",
   "ro": "Măi să fie…!"
  },
  {
   "key": "1948841681703968772",
   "en": "What do I make of this?",
   "ro": "Ce să înțeleg din asta?"
  },
  {
   "key": "1948841681771077636",
   "en": "Nobody… too bad.",
   "ro": "Nimeni… păcat."
  },
  {
   "key": "1948841681787854852",
   "en": "I was hoping something would happen.",
   "ro": "Speram să se întâmple ceva."
  },
  {
   "key": "1948841681854963716",
   "en": "I will find you.",
   "ro": "O să te găsesc."
  },
  {
   "key": "1948841681871740932",
   "en": "You're in here, right?",
   "ro": "Ești aici, nu?"
  },
  {
   "key": "1948841681922072580",
   "en": "What the…?!",
   "ro": "Ce naiba…?!"
  },
  {
   "key": "1948841681922072596",
   "en": "Do you know who I am?",
   "ro": "Știi cine sunt?"
  },
  {
   "key": "1948841681955627012",
   "en": "What do you mean, no?!",
   "ro": "Ce vrei să spui, nu?!"
  },
  {
   "key": "1948841682005958660",
   "en": "Betrayal…! Limit ME…? Me…?! Yeah? Do you know a better…?",
   "ro": "Trădare…! Să mă limitezi pe MINE…? Pe mine…?! Da? Știi tu unul mai bun…?"
  },
  {
   "key": "1948841682039513092",
   "en": "Gotta be epic… With lasers… The public'll lose it… Yeah… I promise.",
   "ro": "Trebuie să fie epic… Cu lasere… Publicul o să înnebunească… Da… Promit."
  },
  {
   "key": "1948841682073067524",
   "en": "The show of the century.",
   "ro": "Spectacolul secolului."
  },
  {
   "key": "1948841682089844740",
   "en": "Interesting…",
   "ro": "Interesant…"
  },
  {
   "key": "1948841682442166276",
   "en": "Stop her!",
   "en_m": "Stop him!",
   "ro": "Opriți-o!",
   "ro_m": "Opriți-l!"
  },
  {
   "key": "1948841682458943492",
   "en": "Quickly! Before she does something!",
   "en_m": "Quickly! Before he does something!",
   "ro": "Repede! Înainte ca ea să facă ceva!",
   "ro_m": "Repede! Înainte ca el să facă ceva!"
  },
  {
   "key": "1948841682559606788",
   "en": "Save me!",
   "ro": "Salvează-mă!"
  },
  {
   "key": "1948841682593161220",
   "en": "She'll kill me! Murderer!",
   "en_m": "He'll kill me! Murderer!",
   "ro": "O să mă omoare! Criminalule!"
  },
  {
   "key": "1948841682677047300",
   "en": "What… what are you doing?",
   "ro": "Ce… ce faci?"
  },
  {
   "key": "1948841682693824516",
   "en": "You cannot kill me! Not me!",
   "ro": "Nu mă poți omorî! Nu pe mine!"
  },
  {
   "key": "1948841682777710596",
   "en": "Leave me alone. I'm here as a private citizen.",
   "ro": "Lasă-mă în pace. Sunt aici ca cetățean privat."
  },
  {
   "key": "1948841682794487812",
   "en": "You can talk to my agent on business matters.",
   "ro": "Poți vorbi cu agentul meu, dacă e vorba de afaceri."
  }
 ]
}
