 "entries": [
  {
   "key": "1955981657382100996",
   "en": "What do I do?",
   "ro": "Ce fac?"
  },
  {
   "key": "1955981657398878212",
   "en": "Fuck this country!",
   "ro": "Bag pula-n țara asta!"
  },
  {
   "key": "1955981657449209860",
   "en": "What's your deal?!",
   "ro": "Ce vrei de fapt?!"
  },
  {
   "key": "1955981657465987076",
   "en": "Watch it!",
   "ro": "Ai grijă!"
  },
  {
   "key": "1955981657499541508",
   "en": "No, pleeease!",
   "ro": "Nu, te roooog!"
  },
  {
   "key": "1955981657549873156",
   "en": "You have to…! I'm a subscriber…! What… What do you mean no…? But… it must be a mistake…! I swear!",
   "ro": "Trebuie să…! Sunt abonat…! Cum adică nu…? Dar… trebuie să fie o greșeală…! Jur!"
  },
  {
   "key": "1955981657566650372",
   "en": "But… But… I'll die otherwise…! You have to take me in…! Do you hear me…?!",
   "ro": "Dar… Dar… Altfel mor…! Trebuie să mă primești…! Mă auzi…?!"
  },
  {
   "key": "1955981657600204804",
   "en": "Hello? Hello!",
   "ro": "Alo? Alo!"
  },
  {
   "key": "1955981657767976964",
   "en": "Aaaahhh!",
   "ro": "Aaaahhh!"
  },
  {
   "key": "1955981657784754180",
   "en": "MaxTac! Call in MaxTac!",
   "ro": "MaxTac! Cheamă MaxTac!"
  },
  {
   "key": "1955981657935749124",
   "en": "Just let me live!",
   "ro": "Lasă-mă să trăiesc!"
  },
  {
   "key": "1955981657969303556",
   "en": "I don't deserve this!",
   "ro": "Nu merit asta!"
  },
  {
   "key": "1955981658137075712",
   "en": "Can you just leave me alone?",
   "ro": "Poți să mă lași în pace?"
  },
  {
   "key": "1955981658153852932",
   "en": "Mind your business!",
   "ro": "Vezi-ți de treabă!"
  }
 ]
