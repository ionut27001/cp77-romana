 "entries": [
  {
   "key": "1946157007185240068",
   "en": "What is this now?",
   "ro": "Ce-i asta acum?"
  },
  {
   "key": "1946157007218794500",
   "en": "Hehh please leave me in peace.",
   "ro": "Hehh, te rog, lasă-mă în pace."
  },
  {
   "key": "1946157007285903364",
   "en": "Do you know who I am?",
   "ro": "Știi cine sunt?"
  },
  {
   "key": "1946157007302680580",
   "en": "What is the meaning of this?",
   "ro": "Ce înseamnă asta?"
  },
  {
   "key": "1946157007336235012",
   "en": "Daaaarling! How ARE you?",
   "ro": "Daaaarling! Cum mai ești?"
  },
  {
   "key": "1946157007403343876",
   "en": "No… Already…? At such a young age…? Ah, congratulations… I'm shocked. Shocked!",
   "ro": "Nu… Deja…? La vârsta asta…? Ah, felicitări… Sunt șocată. Chiar șocată!"
  },
  {
   "key": "1946157007420121092",
   "en": "Mine…? Heh, in school…? But my husband has already arranged an internship for him… I won't tell you where!",
   "ro": "Al meu…? Heh, la școală…? Dar soțul meu i-a și aranjat un stagiu… Nu-ți spun unde!"
  },
  {
   "key": "1946157007453675524",
   "en": "Until next time.",
   "ro": "Până data viitoare."
  },
  {
   "key": "1946157007604670464",
   "en": "Holy mother of god!",
   "ro": "Doamne, Dumnezeule!"
  },
  {
   "key": "1946157007621447684",
   "en": "Somebody, please help me!",
   "ro": "Cineva, ajută-mă, te rog!"
  },
  {
   "key": "1946157007722110980",
   "en": "You cannot do this!",
   "ro": "Nu poți face asta!"
  },
  {
   "key": "1946157007738888196",
   "en": "Get away from me!",
   "ro": "Pleacă de lângă mine!"
  },
  {
   "key": "1946157007822774276",
   "en": "This is an outrage.",
   "ro": "E scandalos."
  },
  {
   "key": "1946157007856328708",
   "en": "Please leave me alone!",
   "ro": "Lasă-mă în pace, te rog!"
  }
 ]
