 "entries": [
  {
   "key": "1896722962352447492",
   "en": "Everything all right?",
   "ro": "E totul bine?"
  },
  {
   "key": "1896722962386001924",
   "en": "It looks like rain.",
   "ro": "Pare că plouă."
  },
  {
   "key": "1896722962436333572",
   "en": "You should not be here.",
   "ro": "Nu ar trebui să fii aici."
  },
  {
   "key": "1896722962469888004",
   "en": "Please, leave this place.",
   "ro": "Te rog, pleacă de aici."
  },
  {
   "key": "1896722962536996868",
   "en": "Put that away!",
   "ro": "Pune asta la loc!"
  },
  {
   "key": "1896722962553774084",
   "en": "This is not the time nor the place!",
   "ro": "Nu e nici timpul, nici locul!"
  },
  {
   "key": "1896722962620882944",
   "en": "I'm warning you! They are coming now!",
   "ro": "Te avertizez! Vin acum!"
  },
  {
   "key": "1896722962637660164",
   "en": "Go away before I call security!",
   "ro": "Pleacă înainte să chem securitatea!"
  },
  {
   "key": "1896722962704769028",
   "en": "Thank you.",
   "ro": "Mulțumesc."
  },
  {
   "key": "1896722962721546244",
   "en": "That would be better.",
   "ro": "Așa ar fi mai bine."
  },
  {
   "key": "1896722962805432324",
   "en": "<kiroshi l=\"jpn\" o=\"今のは…？\" t=\"What the...?\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"jpn\" o=\"今のは…？\" t=\"Ce naiba...?\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1896722962838986756",
   "en": "Should I call for help?",
   "ro": "Ar trebui să chem ajutor?"
  },
  {
   "key": "1896722962889318404",
   "en": "I did what I could.",
   "ro": "Am făcut ce am putut."
  },
  {
   "key": "1896722962922872836",
   "en": "Everything is fine.",
   "ro": "Totul e bine."
  },
  {
   "key": "1896722962973204484",
   "en": "Who are you?",
   "ro": "Cine ești?"
  },
  {
   "key": "1896722963006758916",
   "en": "Come out!",
   "ro": "Ieși afară!"
  },
  {
   "key": "1896722963073867780",
   "en": "No problem.",
   "ro": "Nicio problemă."
  },
  {
   "key": "1896722963090644996",
   "en": "Oof!",
   "ro": "Uf!"
  },
  {
   "key": "1896722963140976644",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1896722963224862724",
   "en": "Ah… Thank you for your concern… No… They don't want anything to do with me… It is all right.",
   "ro": "Ah… Mersi că te interesezi… Nu… Nu vor să aibă nimic de-a face cu mine… E okay."
  },
  {
   "key": "1896722963258417156",
   "en": "It is how it is… And you…? Huh? Uh-huh… Tomorrow…? Got it.",
   "ro": "Așa e… Și tu…? Hm? Uh-huh… Mâine…? Am înțeles."
  },
  {
   "key": "1896722963308748804",
   "en": "Goodbye.",
   "ro": "La revedere."
  },
  {
   "key": "1896722963325526020",
   "en": "That's troubling…",
   "ro": "E îngrijorător…"
  },
  {
   "key": "1896722963761733632",
   "en": "Help! Over here!",
   "ro": "Ajutor! Aici!"
  },
  {
   "key": "1896722963778510852",
   "en": "Over here!",
   "ro": "Aici!"
  },
  {
   "key": "1896722963912728580",
   "en": "Police!",
   "ro": "Poliția!"
  },
  {
   "key": "1896722963929505796",
   "en": "Attack! Again!",
   "ro": "Atac! Din nou!"
  },
  {
   "key": "1896722964030169092",
   "en": "Please! Have mercy!",
   "ro": "Te rog! Milă!"
  },
  {
   "key": "1896722964063723524",
   "en": "Why do you do this?",
   "ro": "De ce faci asta?"
  },
  {
   "key": "1896722964164386820",
   "en": "Excuse me, do I know you?",
   "ro": "Scuză-mă, te cunosc?"
  },
  {
   "key": "1896722964181164036",
   "en": "Please leave me be.",
   "ro": "Te rog, lasă-mă în pace."
  }
 ]
