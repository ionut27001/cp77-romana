{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_f_21_jap_50.json",
 "entries": [
  {
   "key": "1953234495871164420",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1953234495887941636",
   "en": "What is going on here?",
   "ro": "Ce se întâmplă aici?"
  },
  {
   "key": "1953234495938273284",
   "en": "Go back to your sewer.",
   "ro": "Înapoi în canalul tău."
  },
  {
   "key": "1953234495955050500",
   "en": "You have no right to be here.",
   "ro": "Nu ai niciun drept să fii aici."
  },
  {
   "key": "1953234496005382148",
   "en": "You are making it worse for yourself. Put that away.",
   "ro": "Nu te mai băga-n belele. Pune-o jos."
  },
  {
   "key": "1953234496022159364",
   "en": "This will solve nothing. Holster your weapon.",
   "ro": "Asta nu rezolvă nimic. Pune arma la loc."
  },
  {
   "key": "1953234496072491012",
   "en": "Do you crave pain? Get out of here! Now!",
   "ro": "Vrei durere? Ieși de aici! Acum!"
  },
  {
   "key": "1953234496106045440",
   "en": "Are you a Trauma subscriber? You better be.",
   "ro": "Ești abonat la Trauma? Mai bine să fii."
  },
  {
   "key": "1953234496139599876",
   "en": "I see we understand each other.",
   "ro": "Văd că ne înțelegem."
  },
  {
   "key": "1953234496173154308",
   "en": "Well. This was productive.",
   "ro": "Ei bine. Asta a fost productiv."
  },
  {
   "key": "1953234496223485956",
   "en": "Huh? Hm.",
   "ro": "Huh? Hm."
  },
  {
   "key": "1953234496257040388",
   "en": "I see a light…",
   "ro": "Văd o lumină…"
  },
  {
   "key": "1953234496324149252",
   "en": "Hm. She must be gone.",
   "en_m": "Hm. He must be gone.",
   "ro": "Hm. Trebuie că a plecat."
  },
  {
   "key": "1953234496340926468",
   "en": "Cannot do this alone. Ah well.",
   "ro": "Nu pot face asta singur. Ei bine."
  },
  {
   "key": "1953234496391258116",
   "en": "I know you are here!",
   "ro": "Știu că ești aici!"
  },
  {
   "key": "1953234496408035332",
   "en": "Sooner or later I will find you.",
   "ro": "Mai devreme sau mai târziu te găsesc."
  },
  {
   "key": "1953234496458366980",
   "en": "Absolutely out of line.",
   "ro": "Total inadmisibil."
  },
  {
   "key": "1953234496475144196",
   "en": "You will pay!",
   "ro": "O să plătești!"
  },
  {
   "key": "1953234496508698628",
   "en": "Hello? Speaking.",
   "ro": "Alo? La telefon."
  },
  {
   "key": "1953234496559030276",
   "en": "It must be obvious.",
   "ro": "Trebuie să fie evident."
  },
  {
   "key": "1953234496575807492",
   "en": "By all means.",
   "ro": "Desigur."
  },
  {
   "key": "1953234496626139140",
   "en": "<mothertongue l=\"jpn\" m=\"Jaa mata.\" b=\"Yes, I will call you back. \" a=\"\"/>",
   "ro": "<mothertongue l=\"jpn\" m=\"Jaa mata.\" b=\"Da, te sun înapoi. \" a=\"\"/>"
  },
  {
   "key": "1953234496642916356",
   "en": "I'll be damned…",
   "ro": "Ia te uită…"
  },
  {
   "key": "1953234496995237892",
   "en": "To me! To me, now!",
   "ro": "La mine! La mine, acum!"
  },
  {
   "key": "1953234497028792324",
   "en": "Hey! Hey! Help!",
   "ro": "Hei! Hei! Ajutor!"
  },
  {
   "key": "1953234497213341700",
   "en": "Aaaahhh! Aaahhhh!",
   "ro": "Aaaahhh! Aaahhhh!"
  },
  {
   "key": "1953234497230118916",
   "en": "Save yourselves!",
   "ro": "Salvați-vă!"
  },
  {
   "key": "1953234497314004996",
   "en": "No, no! Please!",
   "ro": "Nu, nu! Te rog!"
  },
  {
   "key": "1953234497330782212",
   "en": "Don't do this!",
   "ro": "Nu face asta!"
  },
  {
   "key": "1953234497414668292",
   "en": "Well, what do you want?!",
   "ro": "Ei bine, ce vrei?!"
  },
  {
   "key": "1953234497448222724",
   "en": "Stop following me!",
   "ro": "Nu mă mai urmări!"
  }
 ]
}
