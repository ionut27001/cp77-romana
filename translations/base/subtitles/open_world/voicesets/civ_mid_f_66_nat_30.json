{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_f_66_nat_30.json",
 "entries": [
  {
   "key": "1954556457243418628",
   "en": "Pff, it's all a façade…",
   "ro": "Pff, totul e o fațadă…"
  },
  {
   "key": "1954556457276973060",
   "en": "A war is coming. I feel it.",
   "ro": "Vine un război. Simt asta."
  },
  {
   "key": "1954556457327304704",
   "en": "Ugh, why?!",
   "ro": "Uf, de ce?!"
  },
  {
   "key": "1954556457344081924",
   "en": "Uh, personal space please?!",
   "ro": "Uh, spațiu personal, te rog?!"
  },
  {
   "key": "1954556457377636356",
   "en": "I told you.",
   "ro": "Ți-am spus."
  },
  {
   "key": "1954556457411190788",
   "en": "Frustrated with the uniform in the package… That's the job… I warned you, dad warned you.",
   "ro": "Frustrat de uniforma din pachet… Asta e treaba… Te-am zis, și tata ți-a zis."
  },
  {
   "key": "1954556457444745220",
   "en": "I won't tell you it'll be good… You know it… Your choice… The corp woulda been better.",
   "ro": "Nu-ți spun că o să fie bine… Știi și tu… Alegerea ta… Corporația ar fi fost mai bună."
  },
  {
   "key": "1954556457478299652",
   "en": "Think about it. Really.",
   "ro": "Gândește-te. Serios."
  },
  {
   "key": "1954556457629294596",
   "en": "Get me a gun!",
   "ro": "Dă-mi o armă!"
  },
  {
   "key": "1954556457646071812",
   "en": "Don't provoke her!",
   "en_m": "Don't provoke him!",
   "ro": "Nu o provoca!",
   "ro_m": "Nu-l provoca!"
  },
  {
   "key": "1954556457729957888",
   "en": "My brother's a cop!",
   "ro": "Fratele meu e polițist!"
  },
  {
   "key": "1954556457746735108",
   "en": "My family will avenge me!",
   "ro": "Familia mea mă va răzbuna!"
  },
  {
   "key": "1954556457813843972",
   "en": "Hehh, as if I didn’t have enough problems.",
   "ro": "Hehh, parcă n-aș fi avut destule probleme."
  },
  {
   "key": "1954556457847398404",
   "en": "I ain't signin' anything!",
   "ro": "Nu semnez nimic!"
  }
 ]
}
