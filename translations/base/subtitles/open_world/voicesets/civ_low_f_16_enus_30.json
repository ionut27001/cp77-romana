{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_f_16_enus_30.json",
 "entries": [
  {
   "key": "1908072368855064580",
   "en": "You want somethin'?",
   "ro": "Vrei ceva?"
  },
  {
   "key": "1908072368888619008",
   "en": "Uhh, have we met?",
   "ro": "Uhh, ne-am mai întâlnit?"
  },
  {
   "key": "1908072368955727876",
   "en": "Don't know you. Don't want you here.",
   "ro": "Nu te cunosc. Nu te vreau aici."
  },
  {
   "key": "1908072368972505092",
   "en": "Go back to your own neighborhood.",
   "ro": "Întoarce-te în cartierul tău."
  },
  {
   "key": "1908072369056391172",
   "en": "You gonk-shit crazy? That goes back – now!",
   "ro": "Ești fraier nebun? Aia se întoarce – acum!"
  },
  {
   "key": "1908072369073168388",
   "en": "This isn't fucking funny! Stash it back!",
   "ro": "Nu-i deloc amuzant! Pune-l înapoi!"
  },
  {
   "key": "1908072369140277252",
   "en": "My partners'll kill if you they see you here.",
   "ro": "Partenerii mei te omoară dacă te văd aici."
  },
  {
   "key": "1908072369173831680",
   "en": "It's not worth it. Just turn around and leave, OK?",
   "ro": "Nu merită. Dă-te-n spate și pleacă, ok?"
  },
  {
   "key": "1908072369240940548",
   "en": "That's what I'm talking about.",
   "ro": "Despre asta vorbeam."
  },
  {
   "key": "1908072369257717764",
   "en": "Took you long enough.",
   "ro": "Ți-a luat destul de mult."
  },
  {
   "key": "1908072369324826624",
   "en": "What the fuck...?",
   "ro": "Ce pula mea...?"
  },
  {
   "key": "1908072369341603844",
   "en": "What in the fuck...",
   "ro": "Ce dracu'..."
  },
  {
   "key": "1908072369425489924",
   "en": "I'm losing my mind...",
   "ro": "Îmi pierd mințile..."
  },
  {
   "key": "1908072369459044352",
   "en": "I could've sworn...!",
   "ro": "Aș fi putut jura...!"
  },
  {
   "key": "1908072369509376004",
   "en": "Helloo? Anyone there...?",
   "en_m": "Shit, he disappeared...",
   "ro": "Alooo? E cineva aici...?",
   "ro_m": "Căcat, a dispărut..."
  },
  {
   "key": "1908072369526153220",
   "en": "There's someone here...",
   "ro": "E cineva aici..."
  },
  {
   "key": "1908072369593262084",
   "en": "Agh, get fucked, why don't you?",
   "ro": "Agh, du-te-n pula mea, de ce nu?"
  },
  {
   "key": "1908072369610039300",
   "en": "Watch where you're going! Fuck!",
   "ro": "Uită-te pe unde mergi! Futu-i!"
  },
  {
   "key": "1908072369643593732",
   "en": "Oh, hey!",
   "ro": "Oh, salut!"
  },
  {
   "key": "1908072369710702596",
   "en": "I'll give it back, I swear. Tomorrow, latest.",
   "ro": "Îl dau înapoi, jur. Mâine, cel târziu."
  },
  {
   "key": "1908072369744257028",
   "en": "You'll get your eddies, I promise",
   "ro": "O să-ți iei eddies-urile, promit."
  },
  {
   "key": "1908072369777811460",
   "en": "Mhm. Of course. Later.",
   "ro": "Mhm. Sigur. Mai târziu."
  },
  {
   "key": "1908072369794588676",
   "en": "Oh, shit!",
   "ro": "Ah, căcat!"
  },
  {
   "key": "1908072370197241860",
   "en": "Hey! Get your asses over here!",
   "ro": "Hei! Mișcați-vă încoace!"
  },
  {
   "key": "1908072370230796292",
   "en": "Shoot her!",
   "en_m": "Shoot him!",
   "ro": "Împușc-o!",
   "ro_m": "Împușcă-l!"
  },
  {
   "key": "1908072370348236804",
   "en": "Agh! Aaargh!",
   "ro": "Agh! Aaargh!"
  },
  {
   "key": "1908072370381791232",
   "en": "Help!",
   "ro": "Ajutor!"
  },
  {
   "key": "1908072370482454532",
   "en": "Don't shoot!",
   "ro": "Nu trage!"
  },
  {
   "key": "1908072370516008964",
   "en": "Leave me alone! Please!",
   "ro": "Lasă-mă în pace! Te rog!"
  },
  {
   "key": "1908072370616672260",
   "en": "Pff! You couldn't afford me.",
   "ro": "Pff! Nu ți-ai permite."
  },
  {
   "key": "1908072370650226692",
   "en": "Isn't it time you fucked off?",
   "ro": "Nu-i timpul să te duci dracu'?"
  }
 ]
}
