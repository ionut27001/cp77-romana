{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_high_m_05_jap_30_big.json",
 "entries": [
  {
   "key": "1897900868055343108",
   "en": "Out of my sight.",
   "ro": "Dispari din fața mea."
  },
  {
   "key": "1897900868072120324",
   "en": "What?",
   "ro": "Ce?"
  },
  {
   "key": "1897900868139229188",
   "en": "Turn back immediately!",
   "ro": "Întoarce-te imediat!"
  },
  {
   "key": "1897900868172783620",
   "en": "This area is restricted! Move back!",
   "ro": "Zona asta e restricționată! Dă-te înapoi!"
  },
  {
   "key": "1897900868223115268",
   "en": "You'll want to put that away.",
   "ro": "Mai bine ai pune asta deoparte."
  },
  {
   "key": "1897900868256669700",
   "en": "Mhm. That was a mistake.",
   "ro": "Mhm. A fost o greșeală."
  },
  {
   "key": "1897900868323778564",
   "en": "Are you refusing to cooperate?",
   "ro": "Refuzi să cooperezi?"
  },
  {
   "key": "1897900868357332996",
   "en": "Idiots like you never get it.",
   "ro": "Proștii ca tine nu înțeleg niciodată."
  },
  {
   "key": "1897900868407664644",
   "en": "Mm-hmm.",
   "ro": "Mm-hmm."
  },
  {
   "key": "1897900868441219076",
   "en": "Good enough.",
   "ro": "Destul de bine."
  },
  {
   "key": "1897900868491550724",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1897900868525105152",
   "en": "Hmm…",
   "ro": "Hmm…"
  },
  {
   "key": "1897900868575436804",
   "en": "Nothing to worry about.",
   "ro": "Nimic de îngrijorat."
  },
  {
   "key": "1897900868608991236",
   "en": "Clear.",
   "ro": "Curat."
  },
  {
   "key": "1897900868676100100",
   "en": "We find you no matter what.",
   "ro": "Te găsim noi, orice ar fi."
  },
  {
   "key": "1897900868692877316",
   "en": "It's only a matter of time!",
   "ro": "E doar o chestiune de timp!"
  },
  {
   "key": "1897900868743208964",
   "en": "We have a problem.",
   "ro": "Avem o problemă."
  },
  {
   "key": "1897900868776763396",
   "en": "Done.",
   "ro": "Gata."
  },
  {
   "key": "1897900868860649476",
   "en": "Contact!",
   "ro": "Contact!"
  },
  {
   "key": "1897900868877426692",
   "en": "I need backup here!",
   "ro": "Am nevoie de întăriri aici!"
  },
  {
   "key": "1897900868927758340",
   "en": "Explosion!",
   "ro": "Explozie!"
  },
  {
   "key": "1897900868978089988",
   "en": "Concentrate your minds!",
   "ro": "Concentrați-vă!"
  },
  {
   "key": "1897900868994867204",
   "en": "Regroup!",
   "ro": "Regrupați-vă!"
  },
  {
   "key": "1897900869061976068",
   "en": "Not bad, I dare say!",
   "ro": "Nu-i rău, aș zice!"
  },
  {
   "key": "1897900869095530500",
   "en": "Where are my damn reinforcements!?",
   "ro": "Unde dracu' sunt întăririle mele!?"
  },
  {
   "key": "1897900869145862148",
   "en": "Watch where you step!",
   "ro": "Uită-te unde calci!"
  },
  {
   "key": "1897900869162639364",
   "en": "What is your problem?!",
   "ro": "Ce problemă ai?!"
  },
  {
   "key": "1897900869212971012",
   "en": "Hello.",
   "ro": "Salut."
  },
  {
   "key": "1897900869280079872",
   "en": "Could still change… Heard there's some shake-ups happening upstairs.",
   "ro": "Încă se mai poate schimba... Am auzit că se fac niște schimbări sus."
  },
  {
   "key": "1897900869296857092",
   "en": "You can let him go… They came to an understanding… Yeah, we got the money.",
   "ro": "Poți să-i dai drumul... S-au înțeles... Da, avem banii."
  },
  {
   "key": "1897900869363965956",
   "en": "Take her from all sides!",
   "en_m": "Take him from all sides!",
   "ro": "Încercuiți-o!",
   "ro_m": "Încercuiți-l!"
  },
  {
   "key": "1897900869397520388",
   "en": "Here!",
   "ro": "Aici!"
  },
  {
   "key": "1897900869447852036",
   "en": "Grenade! Grenade!",
   "ro": "Grenadă! Grenadă!"
  },
  {
   "key": "1897900869464629252",
   "en": "See you.",
   "ro": "Ne vedem."
  },
  {
   "key": "1897900869514960896",
   "en": "Leave it to me.",
   "ro": "Lasă pe mine."
  },
  {
   "key": "1897900869582069764",
   "en": "Come. Cover me.",
   "ro": "Vino. Acoperă-mă."
  },
  {
   "key": "1897900869615624196",
   "en": "Be on high alert. Let's go.",
   "ro": "Fii cu ochii-n patru. Hai."
  },
  {
   "key": "1897900869665955844",
   "en": "Go. And make it quick.",
   "ro": "Du-te. Și fă-o repede."
  },
  {
   "key": "1897900869699510276",
   "en": "I want laser-focus!",
   "ro": "Vreau concentrare maximă!"
  },
  {
   "key": "1897900869733064708",
   "en": "Argh... Kkh... Kkh.",
   "ro": "Argh... Kkh... Kkh."
  },
  {
   "key": "1897910204743819264",
   "en": "As usual. You keep giving orders and pretend not to see--... Yeah, man.",
   "ro": "Ca de obicei. Tot dai ordine și te prefaci că nu vezi--... Da, frate."
  },
  {
   "key": "1897910524668551168",
   "en": "Wherever you want, as long as it's in town… Fine.",
   "ro": "Unde vrei tu, numai să fie în oraș... Bine."
  },
  {
   "key": "1959046384177946628",
   "en": "How very, very rude...",
   "ro": "Foarte, foarte nepoliticos..."
  },
  {
   "key": "1959046384228278276",
   "en": "I really don't like repeating myself.",
   "ro": "Chiar nu-mi place să mă repet."
  },
  {
   "key": "1959046384245055492",
   "en": "Is there a problem?",
   "ro": "E vreo problemă?"
  }
 ]
