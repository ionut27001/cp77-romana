{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_f_53_chn_30.json",
 "entries": [
  {
   "key": "1922560670668693508",
   "en": "What do you want, friend?",
   "ro": "Ce vrei, prietene?"
  },
  {
   "key": "1922560670685470724",
   "en": "You have nothing better to do?",
   "ro": "N-ai nimic mai bun de făcut?"
  },
  {
   "key": "1922560670752579588",
   "en": "What you doing here?",
   "ro": "Ce cauți aici?"
  },
  {
   "key": "1922560670769356804",
   "en": "This is no place for you!",
   "ro": "Nu e locul tău aici!"
  },
  {
   "key": "1922560670836465668",
   "en": "What is that for?",
   "ro": "La ce îți trebuie?"
  },
  {
   "key": "1922560670853242884",
   "en": "If they see you with that…",
   "ro": "Dacă te văd cu aia…"
  },
  {
   "key": "1922560670937128964",
   "en": "You can still stop, you know!",
   "ro": "Mai poți să te oprești, știi!"
  },
  {
   "key": "1922560670953906180",
   "en": "Just leave! Please!",
   "ro": "Pleacă! Te rog!"
  },
  {
   "key": "1922560671021015040",
   "en": "Good… good.",
   "ro": "Bine… bine."
  },
  {
   "key": "1922560671054569472",
   "en": "I'm so relieved.",
   "ro": "Ce ușurare."
  },
  {
   "key": "1922560671121678336",
   "en": "Am I imagining things?",
   "ro": "Îmi imaginez lucruri?"
  },
  {
   "key": "1922560671155232772",
   "en": "Was there someone...?",
   "ro": "A fost cineva...?"
  },
  {
   "key": "1922560671205564420",
   "en": "Guess it's nothing.",
   "ro": "Probabil nu e nimic."
  },
  {
   "key": "1922560671239118852",
   "en": "She musta got scared.",
   "en_m": "He musta got scared.",
   "ro": "Probabil s-a speriat."
  },
  {
   "key": "1922560671306227716",
   "en": "Maybe somewhere here…?",
   "ro": "Poate undeva aici…?"
  },
  {
   "key": "1922560671339782148",
   "en": "I'm sure there's someone...",
   "ro": "Sunt sigură că e cineva..."
  },
  {
   "key": "1922560671406891012",
   "en": "Huh…?",
   "ro": "Hm…?"
  },
  {
   "key": "1922560671440445440",
   "en": "Hey! Wait!",
   "ro": "Hei! Stai!"
  },
  {
   "key": "1922560671490777092",
   "en": "Yes? What's going on?",
   "ro": "Da? Ce se întâmplă?"
  },
  {
   "key": "1922560671541108740",
   "en": "Mh... I do it… Ye-Yes, tomorrow… No, no, no time yet… Mh, yes, yes… Of course.",
   "ro": "Mh... O fac… Da-Da, mâine… Nu, nu, nu e timp încă… Mh, da, da… Sigur."
  },
  {
   "key": "1922560671574663172",
   "en": "No…! No no, n-not me…! Maybe the new guy…? Because… He was acting strange.",
   "ro": "Nu…! Nu nu, n-am fost eu…! Poate noul ăla…? Că… Se purta ciudat."
  },
  {
   "key": "1922560671608217604",
   "en": "Mh, yes, I understand.",
   "ro": "Mh, da, înțeleg."
  },
  {
   "key": "1922560671641772036",
   "en": "That's not right...",
   "ro": "Nu e în regulă..."
  },
  {
   "key": "1922560672077979652",
   "en": "Quickly! Over here!",
   "ro": "Repede! Aici!"
  },
  {
   "key": "1922560672094756868",
   "en": "Do something about her!",
   "en_m": "Do something about him!",
   "ro": "Fă ceva cu ea!",
   "ro_m": "Fă ceva cu el!"
  },
  {
   "key": "1922560672212197376",
   "en": "What is happening?",
   "ro": "Ce se întâmplă?"
  },
  {
   "key": "1922560672228974596",
   "en": "Crazy fool!",
   "ro": "Nebuno!",
   "ro_m": "Nebunule!"
  },
  {
   "key": "1922560672396746752",
   "en": "So many plans!",
   "ro": "Atâtea planuri!"
  },
  {
   "key": "1922560672413523972",
   "en": "Why? Why? Why?",
   "ro": "De ce? De ce? De ce?"
  },
  {
   "key": "1922560672530964484",
   "en": "What you want?",
   "ro": "Ce vrei?"
  },
  {
   "key": "1922560672564518916",
   "en": "No time for fools.",
   "ro": "N-am timp de proști."
  },
  {
   "key": "1958924669821165568",
   "en": "Wait, what? You're just gonna leave?",
   "ro": "Stai, ce? Pleci pur și simplu?"
  },
  {
   "key": "1958924669888274436",
   "en": "Thought you wouldn't come back. So, I was saying...",
   "ro": "Credeam că nu mai vii. Deci, ziceam..."
  },
  {
   "key": "1958924669905051652",
   "en": "You're making this awkward.",
   "ro": "Facă situația asta stânjenitoare."
  }
 ]
}
