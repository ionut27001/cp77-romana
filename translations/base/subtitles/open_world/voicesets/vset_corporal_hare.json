{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\vset_corporal_hare.json",
 "entries": [
  {
   "key": "1966091431967227904",
   "en": "Aaaaagh!",
   "ro": "Aaaaagh!"
  },
  {
   "key": "1966091432017559556",
   "en": "I'll put you down like a dog.",
   "ro": "Te pun la pământ ca pe un câine."
  },
  {
   "key": "1966091432084668420",
   "en": "Nooo!",
   "ro": "Nuuu!"
  },
  {
   "key": "1966091432151777284",
   "en": "You're killing yourself!",
   "ro": "Te sinucizi!"
  },
  {
   "key": "1966091432168554500",
   "en": "G-gotta fight to the death! Aaargghh!",
   "ro": "T-trebuie să lupt până la moarte! Aaargghh!"
  },
  {
   "key": "1966091432235663364",
   "en": "No no no no! This isn't happening!",
   "ro": "Nu, nu, nu, nu! Nu se poate!"
  },
  {
   "key": "1966091432252440580",
   "en": "W-what? What is this?!",
   "ro": "C-ce? Ce-i asta?!"
  },
  {
   "key": "1966091432302772228",
   "en": "Ufff!",
   "ro": "Ufff!"
  },
  {
   "key": "1966091432336326660",
   "en": "I'll end you, you pathetic excuse for a human being!",
   "ro": "Te termin, nenorocitule, rușinea omenirii!"
  },
  {
   "key": "1966091432386658308",
   "en": "Aaarghh...ahhh..khe...khee...",
   "ro": "Aaarghh...ahhh..khe...khee..."
  },
  {
   "key": "1966091432604762112",
   "en": "Listen to me!",
   "ro": "Ascultă-mă!"
  },
  {
   "key": "1966091432621539332",
   "en": "You're just like the rest of 'em!",
   "ro": "Ești la fel ca restul!"
  },
  {
   "key": "1966091432688648196",
   "en": "So what now?",
   "ro": "Și acum ce?"
  },
  {
   "key": "1966091432705425412",
   "en": "And?",
   "ro": "Și?"
  },
  {
   "key": "1966091432738979844",
   "en": "Faster, come on!",
   "ro": "Mai repede, hai!"
  },
  {
   "key": "1966091432755757060",
   "en": "Let's go, double-time!",
   "ro": "Hai, în pas alergător!"
  },
  {
   "key": "1966091432990638080",
   "en": "Get out of here.",
   "ro": "Ieși de aici."
  },
  {
   "key": "1966091433007415300",
   "en": "Leave me alone.",
   "ro": "Lasă-mă în pace."
  },
  {
   "key": "1966091433175187460",
   "en": "Hands off me!",
   "ro": "Dă-ți mâinile de pe mine!"
  },
  {
   "key": "1966091433191964676",
   "en": "Stop!",
   "ro": "Stai!"
  },
  {
   "key": "2008213591900585992",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "2008213591934140424",
   "en": "What's that?",
   "ro": "Ce-i aia?"
  },
  {
   "key": "2008213592152244232",
   "en": "You're no different from them.",
   "ro": "Nu ești diferită de ei.",
   "ro_m": "Nu ești diferit de ei."
  },
  {
   "key": "2008213592185798664",
   "en": "Come the fuck out!",
   "ro": "Ieși dracu' afară!"
  },
  {
   "key": "2008213593393758216",
   "en": "Hm, don't like that.",
   "ro": "Hm, nu-mi place asta."
  }
 ]
}
