{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_f_20_enus_20.json",
 "entries": [
  {
   "key": "1954477994549485572",
   "en": "Something happen…?",
   "ro": "S-a întâmplat ceva…?"
  },
  {
   "key": "1954477994566262788",
   "en": "Should I say hello…?",
   "ro": "Ar trebui să zic salut…?"
  },
  {
   "key": "1954477994616594436",
   "en": "What the…?",
   "ro": "Ce naiba…?"
  },
  {
   "key": "1954477994633371652",
   "en": "Hey!",
   "ro": "Hei!"
  },
  {
   "key": "1954477994650148868",
   "en": "Me again.",
   "ro": "Iar eu."
  },
  {
   "key": "1954477994700480516",
   "en": "What if they don't hire me…? But what will I do…? What…? When…?",
   "ro": "Dacă nu mă angajează…? Dar ce-o să fac…? Ce…? Când…?"
  },
  {
   "key": "1954477994717257732",
   "en": "If only… If not, then… Ugh, I don't know anymore… Used to be easier.",
   "ro": "Dacă ar fi… Dacă nu, atunci… Ugh, nu mai știu… Înainte era mai ușor."
  },
  {
   "key": "1954477994817921028",
   "en": "Thanks. I'll try.",
   "ro": "Mulțumesc. O să încerc."
  },
  {
   "key": "1954477995052802052",
   "en": "Psychopath!",
   "ro": "Psihopat!"
  },
  {
   "key": "1954477995086356480",
   "en": "Somebody stop her!",
   "en_m": "Somebody stop him!",
   "ro": "Oprește-o cineva!",
   "ro_m": "Oprește-l cineva!"
  },
  {
   "key": "1954477995153465348",
   "en": "Not me!",
   "ro": "Nu eu!"
  },
  {
   "key": "1954477995170242564",
   "en": "No, no, no…!",
   "ro": "Nu, nu, nu…!"
  },
  {
   "key": "1954477995254128644",
   "en": "Is she following me, or is it my imagination…?",
   "en_m": "Is he following me, or is it my imagination…?",
   "ro": "Mă urmărește ea, sau mi se pare mie…?",
   "ro_m": "Mă urmărește el, sau mi se pare mie…?"
  },
  {
   "key": "1954477995270905860",
   "en": "Huh? What's going on?",
   "ro": "Huh? Ce se întâmplă?"
  }
 ]
}
