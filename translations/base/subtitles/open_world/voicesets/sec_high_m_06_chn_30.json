{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_high_m_06_chn_30.json",
 "entries": [
  {
   "key": "1897919892982079492",
   "en": "Conform and adapt.",
   "ro": "Conformează-te și adaptează-te."
  },
  {
   "key": "1897919893015633924",
   "en": "I represent the corporation.",
   "ro": "Reprezint corporația."
  },
  {
   "key": "1897919893065965572",
   "en": "Exit the area immediately!",
   "ro": "Părăsiți zona imediat!"
  },
  {
   "key": "1897919893116297220",
   "en": "Keep your distance. Turn back, now!",
   "ro": "Nu vă apropiați. Întoarceți-vă, acum!"
  },
  {
   "key": "1897919893183406084",
   "en": "Drop your weapon!",
   "ro": "Aruncă arma!"
  },
  {
   "key": "1897919893200183300",
   "en": "Calm down!",
   "ro": "Calmați-vă!"
  },
  {
   "key": "1897919893267292160",
   "en": "Last warning.",
   "ro": "Ultimul avertisment."
  },
  {
   "key": "1897919893284069380",
   "en": "I won't say it again.",
   "ro": "Nu o să mai spun o dată."
  },
  {
   "key": "1897919893334401028",
   "en": "Excellent choice.",
   "ro": "Alegere excelentă."
  },
  {
   "key": "1897919893367955460",
   "en": "Bravo.",
   "ro": "Bravo."
  },
  {
   "key": "1897919893418287108",
   "en": "Someone here? Show your face!",
   "ro": "E cineva aici? Arată-ți fața!"
  },
  {
   "key": "1897919893451841540",
   "en": "Gonna check it out.",
   "ro": "Mă duc să verific."
  },
  {
   "key": "1897919893518950400",
   "en": "Must have been hearing things.",
   "ro": "Probabil mi s-a părut."
  },
  {
   "key": "1897919893535727620",
   "en": "No threat detected.",
   "ro": "Nicio amenințare detectată."
  },
  {
   "key": "1897919893586059268",
   "en": "Target nearby!",
   "ro": "Țintă în apropiere!"
  },
  {
   "key": "1897919893602836484",
   "en": "Careful! She's in here somewhere.",
   "en_m": "Careful! He's in here somewhere.",
   "ro": "Atenție! E pe aici undeva."
  },
  {
   "key": "1897919893653168132",
   "en": "Dead!",
   "ro": "Mort!"
  },
  {
   "key": "1897919893703499780",
   "en": "Yes sir!",
   "ro": "Da, domnule!"
  },
  {
   "key": "1897919893753831428",
   "en": "Attack!",
   "ro": "Atacă!"
  },
  {
   "key": "1897919893787385860",
   "en": "Fire!",
   "ro": "Foc!"
  },
  {
   "key": "1897919893837717508",
   "en": "Die!",
   "ro": "Mori!"
  },
  {
   "key": "1897919893921603588",
   "en": "Nail her!",
   "en_m": "Nail him!",
   "ro": "Prindeți-o!",
   "ro_m": "Prindeți-l!"
  },
  {
   "key": "1897919893955158020",
   "en": "Keep the pace!",
   "ro": "Țineți ritmul!"
  },
  {
   "key": "1897919894039044096",
   "en": "It cannot be!",
   "ro": "Nu se poate!"
  },
  {
   "key": "1897919894055821316",
   "en": "Watch it!",
   "ro": "Ai grijă!"
  },
  {
   "key": "1897919894139707396",
   "en": "Watch out.",
   "ro": "Atenție."
  },
  {
   "key": "1897919894173261828",
   "en": "You want problems?",
   "ro": "Vrei probleme?"
  },
  {
   "key": "1897919894223593476",
   "en": "Hi.",
   "ro": "Salut."
  },
  {
   "key": "1897919894290702336",
   "en": "Yeah, we found him... Yeah by his teeth… Mm… Joytoys were bitten badly...",
   "ro": "Da, l-am găsit... Da, după dinți… Mm… Joytoy-urile au fost mușcate rău..."
  },
  {
   "key": "1897919894307479556",
   "en": "Yeah…? How's the new hand…? Fuckin' nice!",
   "ro": "Da…? Cum merge mâna nouă…? Al dracului de mișto!"
  },
  {
   "key": "1897919894374588420",
   "en": "Flanking formation!",
   "ro": "Pe flancuri!"
  },
  {
   "key": "1897919894408142852",
   "en": "Taking the right!",
   "ro": "Eu iau dreapta!"
  },
  {
   "key": "1897919894475251716",
   "en": "Fall back!",
   "ro": "Retrageți-vă!"
  },
  {
   "key": "1897919894508806148",
   "en": "Good bye.",
   "ro": "La revedere."
  },
  {
   "key": "1897919894525583364",
   "en": "Gonna investigate.",
   "ro": "Mă duc să verific."
  },
  {
   "key": "1897919894592692228",
   "en": "Hear that? Let's go.",
   "ro": "Ai auzit? Hai."
  },
  {
   "key": "1897919894643023876",
   "en": "Safeties off!",
   "ro": "Scoateți siguranța!"
  },
  {
   "key": "1897919894693355524",
   "en": "Go do recon!",
   "ro": "Du-te în recunoaștere!"
  },
  {
   "key": "1897919894726909956",
   "en": "Speed! Go go go!",
   "ro": "Repede! Hai, hai, hai!"
  },
  {
   "key": "1897919894810796036",
   "en": "Khh… khhh… ghhh… die.",
   "ro": "Khh… khhh… ghhh… mori."
  },
  {
   "key": "1897927163791286272",
   "en": "Nah, they won't hurt him. He's in one of our cells… I know. He's a specialist.",
   "ro": "Nu, n-au să-i facă nimic. E într-una din celulele noastre… Știu. E specialist."
  },
  {
   "key": "1897927666554118144",
   "en": "Something's wrong with the signal delay. Gotta invest I guess… Great! Thanks.",
   "ro": "E ceva în neregulă cu întârzierea semnalului. Trebuie să investesc, cred… Super! Mersi."
  }
 ]
