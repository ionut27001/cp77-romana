{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_m_02_enus_20_rep.json",
 "entries": [
  {
   "key": "1896565264055017476",
   "en": "What? You uh... lost your way?",
   "ro": "Ce? Te-ai… rătăcit?"
  },
  {
   "key": "1896565264071794692",
   "en": "Ahh... Life's good, eh?",
   "ro": "Ahh... Viața e bună, nu?"
  },
  {
   "key": "1896565264122126340",
   "en": "Where're you goin'?",
   "ro": "Unde te duci?"
  },
  {
   "key": "1896565264155680772",
   "en": "Hey, you wanna turn around there?",
   "ro": "Hei, vrei să te întorci acolo?"
  },
  {
   "key": "1896565264206012420",
   "en": "Hey… put that away.",
   "ro": "Hei… pune-o la loc."
  },
  {
   "key": "1896565264239566852",
   "en": "Don't do that!",
   "ro": "Nu face asta!"
  },
  {
   "key": "1896565264289898500",
   "en": "This won't be good for you!",
   "ro": "N-o să-ți fie bine!"
  },
  {
   "key": "1896565264306675716",
   "en": "Listen to me! Seriously.",
   "ro": "Ascultă-mă! Serios."
  },
  {
   "key": "1896565264373784580",
   "en": "Yeah. Well done!",
   "ro": "Da. Bravo!"
  },
  {
   "key": "1896565264390561796",
   "en": "Good choice, choom.",
   "ro": "Alegere bună, choom."
  },
  {
   "key": "1896565264474447876",
   "en": "What's that?",
   "ro": "Ce-i aia?"
  },
  {
   "key": "1896565264491225092",
   "en": "Am I goin' mad?",
   "ro": "O iau razna?"
  },
  {
   "key": "1896565264541556740",
   "en": "Uhh, just imagining things.",
   "ro": "Uhh, doar îmi imaginez lucruri."
  },
  {
   "key": "1896565264558333956",
   "en": "All good. All good.",
   "ro": "Totul bine. Totul bine."
  },
  {
   "key": "1896565264608665604",
   "en": "Aw come on, someone there?",
   "ro": "Hai, mă, e cineva acolo?"
  },
  {
   "key": "1896565264642220036",
   "en": "Ugh, where the fuck... ?",
   "ro": "Ugh, unde dracu'... ?"
  },
  {
   "key": "1896565264709328900",
   "en": "Hey!!",
   "ro": "Hei!!"
  },
  {
   "key": "1896565264742883328",
   "en": "Slow down!",
   "ro": "Mai încet!"
  },
  {
   "key": "1896565264793214980",
   "en": "Wassup wassup.",
   "ro": "Ce faci, ce faci."
  },
  {
   "key": "1896565264877101060",
   "en": "Augh, listen man, we… we had no choice… No… No, I don't remember anything… Nuh-uh… Ah, fuck off!",
   "ro": "Augh, ascultă, frate, noi… noi n-am avut de ales… Nu… Nu, nu-mi amintesc nimic… Nici vorbă… Ah, du-te dracu'!"
  },
  {
   "key": "1896565264893878276",
   "en": "Well, what can we do…? We had a good night… Yeah… Totally… Nah, barely, man, barely.",
   "ro": "Păi, ce să facem…? Am avut o noapte bună… Da… Total… Nah, abia, frate, abia."
  },
  {
   "key": "1896565264927432708",
   "en": "Peace.",
   "ro": "Pace."
  },
  {
   "key": "1896565264960987140",
   "en": "What's going on here?",
   "ro": "Ce se întâmplă aici?"
  },
  {
   "key": "1896565265346863108",
   "en": "Security!",
   "ro": "Pază!"
  },
  {
   "key": "1896565265380417540",
   "en": "Do something about this one!",
   "en_m": "Do something about him!",
   "ro": "Fă ceva cu ea!",
   "ro_m": "Fă ceva cu el!"
  },
  {
   "key": "1896565265497858052",
   "en": "Oh my God!",
   "ro": "Doamne!"
  },
  {
   "key": "1896565265514635268",
   "en": "She's a psycho!",
   "en_m": "He's a psycho!",
   "ro": "E nebună!",
   "ro_m": "E nebun!"
  },
  {
   "key": "1896565265615298564",
   "en": "Please, you've got it wrong!",
   "ro": "Te rog, nu e ce crezi!"
  },
  {
   "key": "1896565265632075780",
   "en": "You don't have to kill me!",
   "ro": "Nu trebuie să mă omori!"
  },
  {
   "key": "1896565265749516292",
   "en": "Piss off, honey.",
   "en_m": "Piss off, buddy.",
   "ro": "Cară-te, scumpo.",
   "ro_m": "Cară-te, amice."
  },
  {
   "key": "1896565265783070724",
   "en": "Look, I know you're into me, but I don't need company.",
   "ro": "Uite, știu că ți-e cu ochii pe mine, dar nu-mi trebuie companie."
  }
 ]
}
