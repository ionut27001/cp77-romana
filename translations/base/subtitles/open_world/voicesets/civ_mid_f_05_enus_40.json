{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_f_05_enus_40.json",
 "entries": [
  {
   "key": "1922786362475945988",
   "en": "Heh, what do you want?!",
   "ro": "Heh, ce vrei?!"
  },
  {
   "key": "1922786362509500420",
   "en": "I don't know you.",
   "ro": "Nu te cunosc."
  },
  {
   "key": "1922786362576609284",
   "en": "Who let you in here! Get out!",
   "ro": "Cine te-a lăsat să intri?! Ieși afară!"
  },
  {
   "key": "1922786362610163712",
   "en": "Get your butt out of here!",
   "ro": "Mișcă-te de aici!"
  },
  {
   "key": "1922786362660495364",
   "en": "Are you joking? Put that away!",
   "ro": "Glumești? Pune asta la loc!"
  },
  {
   "key": "1922786362677272580",
   "en": "You're asking for trouble. Big trouble.",
   "ro": "Ceri necazuri. Necazuri mari."
  },
  {
   "key": "1922786362744381440",
   "en": "This isn't a game. Get out!",
   "ro": "Nu e joc. Ieși afară!"
  },
  {
   "key": "1922786362761158660",
   "en": "Security won't be so nice. I'm warning you.",
   "ro": "Securitatea nu va fi la fel de drăguță. Te avertizez."
  },
  {
   "key": "1922786362811490308",
   "en": "This better be the last time.",
   "ro": "Să fie ultima dată."
  },
  {
   "key": "1922786362845044740",
   "en": "Good. Things were getting unpleasant.",
   "ro": "Bine. Lucrurile deveneau neplăcute."
  },
  {
   "key": "1922786362895376388",
   "en": "This a joke, or what…",
   "ro": "E o glumă, sau ce…"
  },
  {
   "key": "1922786362928930820",
   "en": "Hm… Interesting.",
   "ro": "Hm… Interesant."
  },
  {
   "key": "1922786362996039684",
   "en": "Looks like I scared her.",
   "en_m": "Looks like I scared him.",
   "ro": "Se pare că am speriat-o.",
   "ro_m": "Se pare că l-am speriat."
  },
  {
   "key": "1922786363029594116",
   "en": "Peace and quiet, heh. How I like it.",
   "ro": "Pace și liniște, heh. Așa îmi place."
  },
  {
   "key": "1922786363096702980",
   "en": "Heard a creak…",
   "ro": "Am auzit un scârțâit…"
  },
  {
   "key": "1922786363130257412",
   "en": "Come out! Before I lose my patience!",
   "ro": "Ieși la iveală! Înainte să-mi pierd răbdarea!"
  },
  {
   "key": "1922786363214143488",
   "en": "Another junkie!",
   "ro": "Alt drogat!"
  },
  {
   "key": "1922786363398692868",
   "en": "No manners!",
   "ro": "Fără maniere!"
  },
  {
   "key": "1922786363449024516",
   "en": "Speaking. Who is this?",
   "ro": "La telefon. Cine e?"
  },
  {
   "key": "1922786363516133380",
   "en": "No way in hell. I don't agree.",
   "ro": "Nici gând. Nu sunt de acord."
  },
  {
   "key": "1922786363549687808",
   "en": "I want to speak to your manager!",
   "ro": "Vreau să vorbesc cu managerul tău!"
  },
  {
   "key": "1922786363583242244",
   "en": "I'll file a complaint! You'll see!",
   "ro": "O să depun o plângere! O să vezi!"
  },
  {
   "key": "1922786363616796676",
   "en": "That can't be a coincidence.",
   "ro": "Nu poate fi o coincidență."
  },
  {
   "key": "1922786364036227076",
   "en": "Intruder! Over here!",
   "ro": "Intrus! Aici!"
  },
  {
   "key": "1922786364053004292",
   "en": "Do something! Help!",
   "ro": "Fă ceva! Ajutor!"
  },
  {
   "key": "1922786364170444804",
   "en": "Killers! Killers!",
   "ro": "Ucigași! Ucigași!"
  },
  {
   "key": "1922786364187222020",
   "en": "Aaah!!!",
   "ro": "Aaah!!!"
  },
  {
   "key": "1922786364321439744",
   "en": "No, no… Please… Please!!",
   "ro": "Nu, nu… Te rog… Te rog!!"
  },
  {
   "key": "1922786364338216964",
   "en": "I-I don't deserve this!",
   "ro": "N-nu merit asta!"
  },
  {
   "key": "1922786364422103044",
   "en": "Leave me alone! Goddamn perverts.",
   "ro": "Lasă-mă în pace! Perverșii ăștia al naibii."
  },
  {
   "key": "1922786364472434692",
   "en": "I don't want company.",
   "ro": "Nu vreau companie."
  }
 ]
