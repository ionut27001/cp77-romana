{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_low_m_05_nat_30.json",
 "entries": [
  {
   "key": "1905540748231057408",
   "en": "Not here to chat.",
   "ro": "Nu-s aici să stau la povești."
  },
  {
   "key": "1905540748247834628",
   "en": "Every man for himself.",
   "ro": "Fiecare pentru el."
  },
  {
   "key": "1905540748314943488",
   "en": "You must not be here!",
   "ro": "Nu ai voie aici!"
  },
  {
   "key": "1905540748331720708",
   "en": "No, no. You must leave.",
   "ro": "Nu, nu. Trebuie să pleci."
  },
  {
   "key": "1905540748398829572",
   "en": "This person is a threat!",
   "ro": "Persoana asta e o amenințare!"
  },
  {
   "key": "1905540748432384004",
   "en": "She's armed!",
   "en_m": "He's armed!",
   "ro": "E înarmată!",
   "ro_m": "E înarmat!"
  },
  {
   "key": "1905540748499492868",
   "en": "Listen, this is just my job. So please calm down.",
   "ro": "Ascultă, doar fac și eu treaba mea. Hai, calmează-te, te rog."
  },
  {
   "key": "1905540748533047300",
   "en": "Stop it!",
   "ro": "Încetează!"
  },
  {
   "key": "1905540748583378948",
   "en": "Please. Go away.",
   "ro": "Te rog. Pleacă."
  },
  {
   "key": "1905540748600156164",
   "en": "Go quietly.",
   "ro": "Pleacă liniștit."
  },
  {
   "key": "1905540748667265028",
   "en": "Hello? Someone there?",
   "ro": "Alo? E cineva acolo?"
  },
  {
   "key": "1905540748684042244",
   "en": "What was that?",
   "ro": "Ce-a fost asta?"
  },
  {
   "key": "1905540748751151104",
   "en": "Oof… that went ok.",
   "ro": "Uf… a mers bine."
  },
  {
   "key": "1905540748767928324",
   "en": "Ok,all clear.",
   "ro": "Ok, totul e curat."
  },
  {
   "key": "1905540748835037188",
   "en": "Hey now! Resistance is futile!",
   "ro": "Hei, hei! Rezistența e inutilă!"
  },
  {
   "key": "1905540748851814404",
   "en": "Must be here somewhere!",
   "ro": "Trebuie să fie pe-aici pe undeva!"
  },
  {
   "key": "1905540748902146052",
   "en": "Body!",
   "ro": "Un cadavru!"
  },
  {
   "key": "1905540748952477700",
   "en": "Sure!",
   "ro": "Sigur!"
  },
  {
   "key": "1905540749036363780",
   "en": "I have been attacked!",
   "ro": "Am fost atacat!"
  },
  {
   "key": "1905540749069918208",
   "en": "What the hell is your problem, woman?",
   "en_m": "What the hell is your problem, man?",
   "ro": "Ce naiba ai, femeie?",
   "ro_m": "Ce naiba ai, frate?"
  },
  {
   "key": "1905540749120249860",
   "en": "Grenade!",
   "ro": "Granată!"
  },
  {
   "key": "1905540749187358724",
   "en": "Some kind of freak!",
   "ro": "Un fel de ciudată!",
   "ro_m": "Un fel de ciudat!"
  },
  {
   "key": "1905540749220913156",
   "en": "Fuck this shit!",
   "ro": "M-am săturat de rahatul ăsta!"
  },
  {
   "key": "1905540749288022020",
   "en": "Not me! I deserve to live!",
   "ro": "Nu eu! Merit să trăiesc!"
  },
  {
   "key": "1905540749321576448",
   "en": "I'm too young to die!",
   "ro": "Sunt prea tânără să mor!"
  },
  {
   "key": "1905540749371908100",
   "en": "No, excuse me.",
   "ro": "Nu, scuzați-mă."
  },
  {
   "key": "1905540749405462532",
   "en": "Sorry.",
   "ro": "Scuze."
  },
  {
   "key": "1905540749455794180",
   "en": "Yes?",
   "ro": "Da?"
  },
  {
   "key": "1905540749522903044",
   "en": "Mother… There's no way… Listen, neither Kate nor I can--.",
   "ro": "Mamă… Nu se poate… Ascultă, nici Kate, nici eu nu putem--."
  },
  {
   "key": "1905540749539680260",
   "en": "Uh… Yeah… Wait… Why don't you shut up…! Yes, I'm fucking yelling!",
   "ro": "Ăă… Da… Stai… Taci din gură…! Da, țip, pula mea!"
  },
  {
   "key": "1905540749606789124",
   "en": "Try from the right!",
   "ro": "Încearcă din dreapta!"
  },
  {
   "key": "1905540749640343556",
   "en": "Go, go!",
   "ro": "Hai, hai!"
  },
  {
   "key": "1905540749707452420",
   "en": "Heads down!",
   "ro": "Capetele jos!"
  },
  {
   "key": "1905540749741006852",
   "en": "I must go. Love you.",
   "ro": "Trebuie să plec. Te iubesc."
  },
  {
   "key": "1905540749774561284",
   "en": "What was that.",
   "ro": "Ce-a fost asta."
  },
  {
   "key": "1905540749892001796",
   "en": "Stay close!",
   "ro": "Rămâi aproape!"
  },
  {
   "key": "1905540749925556228",
   "en": "We should go look…",
   "ro": "Ar trebui să mergem să vedem…"
  },
  {
   "key": "1905540749992665092",
   "en": "Your turn. Go on.",
   "ro": "E rândul tău. Hai."
  },
  {
   "key": "1905540750009442308",
   "en": "Just give up, damn you!",
   "ro": "Renunță odată, dracu' să te ia!"
  },
  {
   "key": "1905540750059773956",
   "en": "Aarghh… khhhh…please... I got…. kids… kkhh… khhh.",
   "ro": "Aarghh… khhhh… te rog... am... copii… kkhh… khhh."
  },
  {
   "key": "1905545904641286144",
   "en": "I understand, but you must understand us… It costs us so much already… Mm.",
   "ro": "Înțeleg, da' trebuie să ne înțelegi și tu… Deja ne costă o grămadă… Mm."
  },
  {
   "key": "1905546426261708800",
   "en": "Listen! I'll buy them today…. Mm… Exactly.",
   "ro": "Ascultă! Le cumpăr azi…. Mm… Exact."
  }
 ]
