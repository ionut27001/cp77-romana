{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_6th_m_02_nat_30.json",
 "entries": [
  {
   "key": "1789450788428681220",
   "en": "Can sure tell you never been in the army, kid.",
   "ro": "Se vede că n-ai fost niciodată în armată, puștiule."
  },
  {
   "key": "1789450788445458436",
   "en": "You're no patriot.",
   "ro": "Nu ești patriot."
  },
  {
   "key": "1789450788512567296",
   "en": "Time you turned back, scopsucker.",
   "ro": "E timpul să te întorci, jigodie."
  },
  {
   "key": "1789450788529344516",
   "en": "About face – turn!",
   "ro": "Întoarcere – întoarce-te!"
  },
  {
   "key": "1789450788596453380",
   "en": "'Bout to knock that poly one-shot outta your hands, choomba.",
   "ro": "O să-ți scot pistolul ăla de polimer din mână, choomba."
  },
  {
   "key": "1789450788630007812",
   "en": "Lower your weapon!",
   "ro": "Jos arma!"
  },
  {
   "key": "1789450788680339460",
   "en": "At ease, gonk.",
   "ro": "Odihnă, fraierule."
  },
  {
   "key": "1789450788697116676",
   "en": "Step aside!",
   "ro": "Dă-te la o parte!"
  },
  {
   "key": "1789450788764225540",
   "en": "Left face – turn!",
   "ro": "Stânga-mprejur – întoarce-te!"
  },
  {
   "key": "1789450788781002756",
   "en": "'Atta girl.",
   "en_m": "'Atta boy.",
   "ro": "Așa, fată.",
   "ro_m": "Așa, băiatule."
  },
  {
   "key": "1789450788831334404",
   "en": "Someone there?",
   "ro": "E cineva acolo?"
  },
  {
   "key": "1789450788931997700",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1789450788982329348",
   "en": "Area secured.",
   "ro": "Zonă securizată."
  },
  {
   "key": "1789450789015883780",
   "en": "All clear.",
   "ro": "Totul curat."
  },
  {
   "key": "1789450789082992644",
   "en": "Got someone on your tail, coward!",
   "ro": "Te urmărește cineva, lașule!"
  },
  {
   "key": "1789450789099769860",
   "en": "What? You too chicken?",
   "ro": "Ce? Și tu ești laș?"
  },
  {
   "key": "1789450789150101508",
   "en": "Killed in action!",
   "ro": "Ucis în luptă!"
  },
  {
   "key": "1789450789183655940",
   "en": "Understood.",
   "ro": "Înțeles."
  },
  {
   "key": "1789450789351428100",
   "en": "Follow me, soldiers!",
   "ro": "După mine, soldați!"
  },
  {
   "key": "1789450789368205316",
   "en": "To arms!",
   "ro": "La arme!"
  },
  {
   "key": "1789450789401759748",
   "en": "Get down!",
   "ro": "Jos!"
  },
  {
   "key": "1789450789452091396",
   "en": "God and Country!",
   "ro": "Dumnezeu și Patria!"
  },
  {
   "key": "1789450789468868612",
   "en": "U-S-A! U-S-A!",
   "ro": "U-S-A! U-S-A!"
  },
  {
   "key": "1789450789535977476",
   "en": "We got soldiers down!",
   "ro": "Avem soldați căzuți!"
  },
  {
   "key": "1789450789569531908",
   "en": "Retreat!",
   "ro": "Retragere!"
  },
  {
   "key": "1789450789619863556",
   "en": "Watch where you goin'!",
   "ro": "Ai grijă pe unde mergi!"
  },
  {
   "key": "1789450789636640772",
   "en": "Outta my way!",
   "ro": "Dă-te din drum!"
  },
  {
   "key": "1789450789686972420",
   "en": "Captain?",
   "ro": "Căpitane?"
  },
  {
   "key": "1789450789754081284",
   "en": "Of course... I'll check it out... Yessir, you have my word...",
   "ro": "Sigur... o să verific... Da, domnule, aveți cuvântul meu..."
  },
  {
   "key": "1789450789770858500",
   "en": "Had a little problem... no, no, took care of it... mhm...",
   "ro": "Am avut o mică problemă... nu, nu, am rezolvat-o... mhm..."
  },
  {
   "key": "1789450789821190148",
   "en": "Flank positions!",
   "ro": "Poziții de flanc!"
  },
  {
   "key": "1789450789871521796",
   "en": "Move back – turn!",
   "ro": "Înapoi – întoarce-te!"
  },
  {
   "key": "1789450789905076228",
   "en": "Retreat!",
   "ro": "Retragere!"
  },
  {
   "key": "1789450789921853444",
   "en": "Yes sir!",
   "ro": "Da, domnule!"
  },
  {
   "key": "1789450789955407876",
   "en": "What in the...",
   "ro": "Ce naiba..."
  },
  {
   "key": "1789450790005739524",
   "en": "Hey! Think someone's there.",
   "ro": "Hei! Cred că e cineva acolo."
  },
  {
   "key": "1789450790022516740",
   "en": "What the?! Let's go!",
   "ro": "Ce dracu'?! Hai!"
  },
  {
   "key": "1789450790089625600",
   "en": "Go patrol!",
   "ro": "La patrulare!"
  },
  {
   "key": "1789450790106402820",
   "en": "Pin her down!",
   "en_m": "Pin him down!",
   "ro": "Imobilizează-o!",
   "ro_m": "Imobilizează-l!"
  },
  {
   "key": "1789450790139957252",
   "en": "Echh... augh... you're... dead...",
   "ro": "Echh... augh... ești... mort..."
  }
 ]
}
