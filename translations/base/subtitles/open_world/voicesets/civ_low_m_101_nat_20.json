 "entries": [
  {
   "key": "1922931710360035332",
   "en": "Forward!",
   "ro": "Înainte!"
  },
  {
   "key": "1922931710376812548",
   "en": "Kinda boring, eh?",
   "ro": "Cam plictisitor, nu?"
  },
  {
   "key": "1922931710443921412",
   "en": "What's your problem?",
   "ro": "Ce problemă ai?"
  },
  {
   "key": "1922931710460698628",
   "en": "Oof!",
   "ro": "Uf!"
  },
  {
   "key": "1922931710511030276",
   "en": "Hey.",
   "ro": "Hei."
  },
  {
   "key": "1922931710578139140",
   "en": "What…? No…! Seriously thought… you're jokin', right…? No…?! Howah!",
   "ro": "Ce…? Nu…! Chiar credeai… glumești, nu…? Nu…?! Howah!"
  },
  {
   "key": "1922931710594916356",
   "en": "Respect, man… Yeaaa… First round's on me… Uh-huh…! Word.",
   "ro": "Respect, frate… Ieaaa… Prima rundă e pe mine… Uh-huh…! Pe bune."
  },
  {
   "key": "1922931710645248004",
   "en": "Bye then.",
   "ro": "Pa atunci."
  },
  {
   "key": "1922931710829797380",
   "en": "Run away!",
   "ro": "Fugi!"
  },
  {
   "key": "1922931710863351812",
   "en": "Hunta, hunta!",
   "ro": "Hunta, hunta!"
  },
  {
   "key": "1922931710980792324",
   "en": "What do you want?",
   "ro": "Ce vrei?"
  },
  {
   "key": "1922931710997569540",
   "en": "Leave it! I beg you!",
   "ro": "Lasă! Te rog!"
  },
  {
   "key": "1922931711115010052",
   "en": "You go your way, I'll go mine.",
   "ro": "Tu pe drumul tău, eu pe al meu."
  },
  {
   "key": "1922931711148564484",
   "en": "You know, this town has more than one sidewalk…",
   "ro": "Știi, orașul ăsta are și alte trotuare…"
  }
 ]
