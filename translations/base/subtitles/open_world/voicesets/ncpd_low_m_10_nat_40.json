   "ro": "Trebuie să fie pe aici pe undeva!"
  },
  {
   "key": "1863514814457438212",
   "en": "Got a problem.",
   "ro": "Am o problemă."
  },
  {
   "key": "1863514814490992644",
   "en": "Copy.",
   "ro": "Am înțeles."
  },
  {
   "key": "1863514814541324292",
   "en": "Officer under fire!",
   "ro": "Ofițer sub foc!"
  },
  {
   "key": "1863514814558101508",
   "en": "Got lead comin' at me!",
   "ro": "Vin gloanțe spre mine!"
  },
  {
   "key": "1863514814625210372",
   "en": "Throwing a 'nade!",
   "ro": "Arunc o grenadă!"
  },
  {
   "key": "1863514814658764804",
   "en": "Surrender.",
   "ro": "Predă-te."
  },
  {
   "key": "1863514814675542020",
   "en": "Find cover!",
   "ro": "Găsește adăpost!"
  },
  {
   "key": "1863514814725873668",
   "en": "Don't like this. Don't like this at all.",
   "ro": "Nu-mi place. Deloc."
  },
  {
   "key": "1863514814742650884",
   "en": "'Ey, 'ey, 'ey! Not good.",
   "ro": "Hei, hei, hei! Nasol."
  },
  {
   "key": "1863514814826536960",
   "en": "What, huh?",
   "ro": "Ce, ha?"
  },
  {
   "key": "1863514814843314180",
   "en": "You fuckin' gonked?",
   "ro": "Ești țicnit, pula mea?"
  },
  {
   "key": "1863514814876868612",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1863514814927200260",
   "en": "When...? Sorry, I can't... really... I'm sorry... mhm...",
   "ro": "Când...? Scuze, nu pot... chiar... îmi pare rău... mhm..."
  },
  {
   "key": "1863514814943977476",
   "en": "Uh-huh... Yeah, yeah, I remember that case... No, I wasn't on duty...",
   "ro": "Uh-huh... Da, da, mi-aduc aminte de cazul ăla... Nu eram de serviciu..."
  },
  {
   "key": "1863514814994309124",
   "en": "Get her! Move!",
   "en_m": "Get him! Move!",
   "ro": "Prindeți-o! Mișcați!",
   "ro_m": "Prindeți-l! Mișcați!"
  },
  {
   "key": "1863514815027863556",
   "en": "Goin' left flank!",
   "ro": "Merg pe flancul stâng!"
  },
  {
   "key": "1863514815078195204",
   "en": "Grenade! Grenade!",
   "ro": "Grenadă! Grenadă!"
  },
  {
   "key": "1863514815094972420",
   "en": "See ya.",
   "ro": "Ne vedem."
  },
  {
   "key": "1863514815128526852",
   "en": "I'm on it.",
   "ro": "Mă ocup."
  },
  {
   "key": "1863514815178858500",
   "en": "Intervention time.",
   "ro": "Timpul intervenției."
  },
  {
   "key": "1863514815195635716",
   "en": "Let's do this.",
   "ro": "Hai să facem asta."
  },
  {
   "key": "1863514815229190148",
   "en": "You.",
   "ro": "Tu."
  },
  {
   "key": "1863514815245967364",
   "en": "Remember your training!",
   "ro": "Amintește-ți antrenamentul!"
  },
  {
   "key": "1863514815279521796",
   "en": "Argh... ech... I can't... breathe...",
   "ro": "Argh... ech... Nu pot... să respir..."
  },
  {
   "key": "1867744188828344320",
   "en": "That was Mike's assignment there... Mhm...",
   "ro": "Asta era treaba lui Mike acolo... Mhm..."
  }
 ]
