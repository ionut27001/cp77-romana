   "en": "You're about to catch a bullet. I'm serious.",
   "ro": "Ești pe cale să iei un glonț. Serios."
  },
  {
   "key": "1863514814205779972",
   "en": "Good choice.",
   "ro": "Bună alegere."
  },
  {
   "key": "1863514814222557188",
   "en": "Sensible.",
   "ro": "Rațional."
  },
  {
   "key": "1863514814272888836",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1863514814289666052",
   "en": "What's that?",
   "ro": "Ce-i aia?"
  },
  {
   "key": "1863514814339997700",
   "en": "I'm done.",
   "ro": "Am terminat."
  },
  {
   "key": "1863514814356774916",
   "en": "Area secured.",
   "ro": "Zonă securizată."
  },
  {
   "key": "1863514814407106564",
   "en": "We will find you.",
   "ro": "Te vom găsi."
  },
  {
   "key": "1863514814423883780",
   "en": "She's gotta be around here somewhere!",
