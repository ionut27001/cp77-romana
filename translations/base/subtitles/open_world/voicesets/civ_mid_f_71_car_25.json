{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_f_71_car_25.json",
 "entries": [
  {
   "key": "1954568576198287364",
   "en": "Life is full of disappointment…",
   "ro": "Viața e plină de dezamăgiri…"
  },
  {
   "key": "1954568576215064580",
   "en": "I try and I try…",
   "ro": "Încerc și încerc…"
  },
  {
   "key": "1954568576265396228",
   "en": "Ugh…",
   "ro": "Ugh…"
  },
  {
   "key": "1954568576282173444",
   "en": "Uh, hello!",
   "ro": "Uh, salut!"
  },
  {
   "key": "1954568576315727876",
   "en": "No changes.",
   "ro": "Nicio schimbare."
  },
  {
   "key": "1954568576366059524",
   "en": "You know… I haven't played in so long, I just lost my enthusiasm… Sad, but oh well.",
   "ro": "Știi… n-am mai jucat de mult, mi-am pierdut entuziasmul… Trist, dar asta e."
  },
  {
   "key": "1954568576382836740",
   "en": "Of course I want to… But it's not up to me… She's got a regular crew… I-I'm just an extra.",
   "ro": "Sigur că vreau… Dar nu depinde de mine… Are deja echipa ei… Eu… eu sunt doar un figurant."
  },
  {
   "key": "1954568576416391172",
   "en": "I try. Seriously.",
   "ro": "Încerc. Serios."
  },
  {
   "key": "1954568576567386116",
   "en": "Oh my God... !",
   "ro": "Doamne... !"
  },
  {
   "key": "1954568576584163332",
   "en": "What did I ever do?!",
   "ro": "Ce-am făcut eu vreodată?!"
  },
  {
   "key": "1954568576668049412",
   "en": "Leave me the fuck alone!",
   "ro": "Lasă-mă dracu' în pace!"
  },
  {
   "key": "1954568576684826628",
   "en": "You have no right!",
   "ro": "N-ai niciun drept!"
  },
  {
   "key": "1954568576768712708",
   "en": "Get away from me.",
   "ro": "Pleacă de lângă mine."
  },
  {
   "key": "1954568576785489924",
   "en": "Let me worry in peace.",
   "ro": "Lasă-mă să-mi fac griji în pace."
  }
 ]
}
