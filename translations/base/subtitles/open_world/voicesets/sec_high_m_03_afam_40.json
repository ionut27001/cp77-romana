{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_high_m_03_afam_40.json",
 "entries": [
  {
   "key": "1896863460278935556",
   "en": "You ain't too likeable.",
   "ro": "Nu ești chiar simpatic."
  },
  {
   "key": "1896863460295712772",
   "en": "I'm all too familiar with your kind.",
   "ro": "Îți știu specia prea bine."
  },
  {
   "key": "1896863460362821636",
   "en": "Back it up now, let's go!",
   "ro": "Dă-te înapoi acum, hai!"
  },
  {
   "key": "1896863460396376068",
   "en": "Step back.",
   "ro": "Dă-te înapoi."
  },
  {
   "key": "1896863460463484932",
   "en": "Lower your weapon!",
   "ro": "Jos arma!"
  },
  {
   "key": "1896863460497039364",
   "en": "Armed agitator present!",
   "ro": "Avem o agitatoare înarmată!",
   "ro_m": "Avem un agitator înarmat!"
  },
  {
   "key": "1896863460564148228",
   "en": "I WILL open fire on you.",
   "ro": "O să deschid focul asupra ta."
  },
  {
   "key": "1896863460580925444",
   "en": "I'm talking to you.",
   "ro": "Cu tine vorbesc."
  },
  {
   "key": "1896863460648034308",
   "en": "Take a walk.",
   "ro": "Dă-te la plimbare."
  },
  {
   "key": "1896863460681588740",
   "en": "Get lost!",
   "ro": "Cară-te!"
  },
  {
   "key": "1896863460748697600",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1896863460765474820",
   "en": "I'm on it.",
   "ro": "Mă ocup."
  },
  {
   "key": "1896863460832583684",
   "en": "Intervention completed.",
   "ro": "Intervenție încheiată."
  },
  {
   "key": "1896863460866138116",
   "en": "No abnormalities detected.",
   "ro": "Nicio anomalie detectată."
  },
  {
   "key": "1896863460916469764",
   "en": "She's a terrorist! Stay vigilant!",
   "en_m": "He's a terrorist! Stay vigilant!",
   "ro": "E o teroristă! Fiți vigilenți!",
   "ro_m": "E un terorist! Fiți vigilenți!"
  },
  {
   "key": "1896863460933246980",
   "en": "Come out, hands where I can see 'em!",
   "ro": "Ieși, cu mâinile la vedere!"
  },
  {
   "key": "1896863460983578628",
   "en": "Soldier down!",
   "ro": "Soldat căzut!"
  },
  {
   "key": "1896863461033910272",
   "en": "Received.",
   "ro": "Recepționat."
  },
  {
   "key": "1896863461084241924",
   "en": "Hold your fire!",
   "ro": "Nu trageți!"
  },
  {
   "key": "1896863461101019140",
   "en": "Drop your weapon!",
   "ro": "Aruncă arma!"
  },
  {
   "key": "1896863461134573572",
   "en": "Frag out!",
   "ro": "Grenadă!"
  },
  {
   "key": "1896863461201682436",
   "en": "Lay it on her!",
   "en_m": "Lay it on him!",
   "ro": "Trageți în ea!",
   "ro_m": "Trageți în el!"
  },
  {
   "key": "1896863461235236868",
   "en": "Enemy contact!",
   "ro": "Contact inamic!"
  },
  {
   "key": "1896863461285568516",
   "en": "I'm hit! Medic!",
   "ro": "Sunt lovit! Medic!"
  },
  {
   "key": "1896863461302345732",
   "en": "Goddamn it!",
   "ro": "Fir-ar al dracului!"
  },
  {
   "key": "1896863461369454592",
   "en": "Watch yourself.",
   "ro": "Ai grijă la tine."
  },
  {
   "key": "1896863461386231812",
   "en": "Bah.",
   "ro": "Bah."
  },
  {
   "key": "1896863461436563460",
   "en": "What's happening?",
   "ro": "Ce se întâmplă?"
  },
  {
   "key": "1896863461486895108",
   "en": "We took care of it proper… Dumbass thought he'd get in with the Nomads.",
   "ro": "Ne-am făcut treaba cum trebuie… Idiotul credea că se bagă și el la nomazi."
  },
  {
   "key": "1896863461503672324",
   "en": "Nah, she won't be causing any more problems… She's rotting where the sun don't shine.",
   "ro": "Nu, n-o să mai facă probleme… Putrezește într-o groapă uitată de lume."
  },
  {
   "key": "1896863461587558404",
   "en": "Pin her down!",
   "en_m": "Pin him down!",
   "ro": "Imobilizează-o!",
   "ro_m": "Imobilizează-l!"
  },
  {
   "key": "1896863461621112836",
   "en": "On my way!",
   "ro": "Vin!"
  },
  {
   "key": "1896863461654667268",
   "en": "Get down!",
   "ro": "Jos!"
  },
  {
   "key": "1896863461671444484",
   "en": "Later man.",
   "ro": "Ne vedem, bă."
  },
  {
   "key": "1896863461704998916",
   "en": "I don't like this.",
   "ro": "Nu-mi place asta."
  },
  {
   "key": "1896863461772107780",
   "en": "Cover me.",
   "ro": "Acoperă-mă."
  },
  {
   "key": "1896863461788884996",
   "en": "C'mon.",
   "ro": "Hai."
  },
  {
   "key": "1896863461822439428",
   "en": "Right behind ya.",
   "ro": "Sunt chiar după tine."
  },
  {
   "key": "1896863461855993860",
   "en": "Shoot to kill!",
   "ro": "Trageți să omorâți!"
  },
  {
   "key": "1896863461889548292",
   "en": "Argh... Argh... Let me ...go…",
   "ro": "Argh... Argh... Lasă-mă... să plec…"
  },
  {
   "key": "1896879223865876480",
   "en": "So smart, yet so boneheaded… Yeah.",
   "ro": "Atât de deștept, dar atât de tâmpit… Da."
  },
  {
   "key": "1896879548370788352",
   "en": "Apparently she's in solitary… Mm-hmm… Fuck that, man.",
   "ro": "Se pare că e la izolare… Mm-hmm… Futu-i, bă."
  },
  {
   "key": "2236498258661875716",
   "en": "Damn it!",
   "ro": "La naiba!"
  },
  {
   "key": "2236498258913533956",
   "en": "Soldier down! Security alert!",
   "ro": "Soldat căzut! Alertă de securitate!"
  },
  {
   "key": "2236498259064528900",
   "en": "You gotta be kidding me...",
   "ro": "Faci mișto de mine..."
  },
  {
   "key": "2236498259181969412",
   "en": "Didn't put any call out. Must be a glitch.",
   "ro": "N-a dat niciun semnal. Trebuie să fie o eroare."
  },
  {
   "key": "2236498259232301060",
   "en": "We need to re-sync!",
   "ro": "Trebuie să ne resincronizăm!"
  },
  {
   "key": "2236498259366518788",
   "en": "Take that position! Close the flank!",
   "ro": "Ocupați poziția aceea! Închideți flancul!"
  },
  {
   "key": "2236498259416850436",
   "en": "Goddamn cyberpsycho!",
   "ro": "Fir-ar al dracului de cyberpsycho!"
  },
  {
   "key": "2236498259467182084",
   "en": "Time to end this!",
   "ro": "E timpul să terminăm cu asta!"
  },
  {
   "key": "2236498259534290948",
   "en": "Hold your positions and provide cover!",
   "ro": "Țineți-vă pozițiile și asigurați acoperire!"
  },
  {
   "key": "2236498259702063108",
   "en": "She's wounded!",
   "en_m": "He's wounded!",
   "ro": "E rănită!",
   "ro_m": "E rănit!"
  },
  {
   "key": "2236498259886612484",
   "en": "Target in critical condition! Move to eliminate!",
   "ro": "Ținta e în stare critică! Deplasați-vă s-o eliminați!"
  },
  {
   "key": "2236498259936944132",
   "en": "Copy that!",
   "ro": "Am înțeles!"
  },
  {
   "key": "2236498260004052992",
   "en": "She's taking cover!",
   "en_m": "He's taking cover!",
   "ro": "Se adăpostește!"
  },
  {
   "key": "2236498260104716292",
   "en": "Cover me! I'm reloading!",
   "ro": "Acoperă-mă! Reîncarc!"
  },
  {
   "key": "2236498260171825156",
   "en": "Eliminate the threat! Now, damn it!",
   "ro": "Eliminați amenințarea! Acum, la naiba!"
  },
  {
   "key": "2236498260289265668",
   "en": "Lost all visuals! Need assistance!",
   "ro": "Nu mai văd nimic! Am nevoie de ajutor!"
  },
  {
   "key": "2236498260373151748",
   "en": "We're getting hacked!",
   "ro": "Ne hackuiesc!"
  },
  {
   "key": "2236498260440260612",
   "en": "Back in action!",
   "ro": "Din nou în acțiune!"
  },
  {
   "key": "2236498260507369476",
   "en": "Where's our backup?!",
   "ro": "Unde sunt întăririle?!"
  },
  {
   "key": "2236498260557701124",
   "en": "Direct combat!",
   "ro": "Luptă directă!"
  },
  {
   "key": "2236498260608032772",
   "en": "Getting in range!",
   "ro": "Intru în raza de tragere!"
  },
  {
   "key": "2236498260691918848",
   "en": "I'll cover you!",
   "ro": "Te acopăr!"
  },
  {
   "key": "2236498260759027716",
   "en": "Taking heavy losses!",
   "ro": "Suferim pierderi grele!"
  },
  {
   "key": "2236498261010685952",
   "en": "Better check that out...",
   "ro": "Mai bine verific..."
  }
 ]
}
