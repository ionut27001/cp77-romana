{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_6th_f_03_enus_30.json",
 "entries": [
  {
   "key": "1789974754037698564",
   "en": "Who you fight for?",
   "ro": "Pentru cine lupți?"
  },
  {
   "key": "1789974754071252992",
   "en": "Who you run for?",
   "ro": "Pentru cine alergi?"
  },
  {
   "key": "1789974754121584644",
   "en": "You can't be here.",
   "ro": "Nu ai ce căuta aici."
  },
  {
   "key": "1789974754138361860",
   "en": "Move. Too close.",
   "ro": "Dă-te la o parte. Prea aproape."
  },
  {
   "key": "1789974754222247940",
   "en": "Just lookin' for trouble, ain't ya?",
   "ro": "Cauți doar necazuri, nu?"
  },
  {
   "key": "1789974754239025156",
   "en": "Ain't compensatin' for nothin' with that.",
   "ro": "Nu compensezi nimic cu asta."
  },
  {
   "key": "1789974754306134016",
   "en": "This don't end well for you.",
   "ro": "Nu se termină bine pentru tine."
  },
  {
   "key": "1789974754322911236",
   "en": "Calm down.",
   "ro": "Calmează-te."
  },
  {
   "key": "1789974754373242884",
   "en": "Good. That I like.",
   "ro": "Bine. Asta îmi place."
  },
  {
   "key": "1789974754390020100",
   "en": "Everyone's gotta know their place, right?",
   "ro": "Toată lumea trebuie să-și cunoască locul, nu?"
  },
  {
   "key": "1789974754440351748",
   "en": "Isn't this interesting...",
   "ro": "Interesant, nu-i așa..."
  },
  {
   "key": "1789974754473906180",
   "en": "Better not be any trouble.",
   "ro": "Mai bine să nu fie necazuri."
  },
  {
   "key": "1789974754524237824",
   "en": "Should be fine...",
   "ro": "Ar trebui să fie bine..."
  },
  {
   "key": "1789974754557792260",
   "en": "Nothing here.",
   "ro": "Nimic aici."
  },
  {
   "key": "1789974754608123908",
   "en": "Still gonna die! Let's get it over with.",
   "ro": "Tot o să mori! Hai să terminăm odată."
  },
  {
   "key": "1789974754624901124",
   "en": "I'll make it quick, I promise. Come on out.",
   "ro": "Repede fac, promit. Ieși afară."
  },
  {
   "key": "1789974754658455556",
   "en": "Oooh... Not a good sign.",
   "ro": "Oooh... Nu e semn bun."
  },
  {
   "key": "1789974754692009988",
   "en": "Of course. I understand.",
   "ro": "Desigur. Înțeleg."
  },
  {
   "key": "1789974754759118852",
   "en": "Fight!",
   "ro": "Luptă!"
  },
  {
   "key": "1789974754792673280",
   "en": "'Bout to get mad. Real mad.",
   "ro": "O să mă enervez. De-a binelea."
  },
  {
   "key": "1789974754843004928",
   "en": "Here's your ticket to hell!",
   "ro": "Iată biletul tău spre iad!"
  },
  {
   "key": "1789974754893336580",
   "en": "We don't play nice with traitor scum!",
   "ro": "Nu ne jucăm frumos cu jegurile de trădători!"
  },
  {
   "key": "1789974754926891012",
   "en": "Ahh, gotta love it!",
   "ro": "Ahh, trebuie să iubești asta!"
  },
  {
   "key": "1789974754993999876",
   "en": "C'mon, look alive!",
   "ro": "Hai, fii pe fază!"
  },
  {
   "key": "1789974755010777092",
   "en": "Seen worse.",
   "ro": "Am văzut și mai rău."
  },
  {
   "key": "1789974755077885956",
   "en": "What the?!",
   "ro": "Ce dracu'?!"
  },
  {
   "key": "1789974755094663172",
   "en": "Watch it, choom!",
   "ro": "Ai grijă, choom!"
  },
  {
   "key": "1789974755144994820",
   "en": "Yep. Talk to me.",
   "ro": "Da. Vorbește."
  },
  {
   "key": "1789974755195326468",
   "en": "What...? No, don't know 'er...",
   "ro": "Ce...? Nu, nu o cunosc..."
  },
  {
   "key": "1789974755228880896",
   "en": "OK... And what's she packin'...?",
   "ro": "OK... Și ce are la ea...?"
  },
  {
   "key": "1789974755279212548",
   "en": "On her ass! Go!",
   "en_m": "On his ass! Go!",
   "ro": "Pe urmele ei! Hai!",
   "ro_m": "Pe urmele lui! Hai!"
  },
  {
   "key": "1789974755329544196",
   "en": "Aaagh!",
   "ro": "Aaagh!"
  },
  {
   "key": "1789974755379875844",
   "en": "Holy shit!",
   "ro": "Ce căcat!"
  },
  {
   "key": "1789974755396653060",
   "en": "Be in touch.",
   "ro": "Ținem legătura."
  },
  {
   "key": "1789974755430207492",
   "en": "Yep. Definitely saw something.",
   "ro": "Da. Sigur am văzut ceva."
  },
  {
   "key": "1789974755497316356",
   "en": "Safety off, let's go. Don't ask, just do.",
   "ro": "Siguranța dezactivată, hai. Nu întreba, fă."
  },
  {
   "key": "1789974755514093572",
   "en": "Follow me.",
   "ro": "Urmează-mă."
  },
  {
   "key": "1789974755564425220",
   "en": "Check it out... But watch out, too.",
   "ro": "Verifică... Dar fii atent și tu."
  },
  {
   "key": "1789974755581202436",
   "en": "Let's go!",
   "ro": "Hai!"
  },
  {
   "key": "1789974755631534080",
   "en": "Aaagh... echh... ech... Gonna wish you... never...",
   "ro": "Aaagh... echh... ech... O să-ți pară rău... că nu..."
  },
  {
   "key": "1790051282939383808",
   "en": "Must be a plant, get rid of 'er...",
   "ro": "Trebuie să fie o infiltrată, scapă de ea..."
  },
  {
   "key": "1790051501965938688",
   "en": "On our streets...? You know what to do...",
   "ro": "Pe străzile noastre...? Știi ce ai de făcut..."
  },
  {
   "key": "3992931294621384704",
   "en": "This don't end well for you.",
   "ro": "Nu se termină bine pentru tine."
  },
  {
   "key": "3995612458742104064",
   "en": "Fight!",
   "ro": "Luptă!"
  },
  {
   "key": "3995613412090626048",
   "en": "What the?!",
   "ro": "Ce dracu'?!"
  },
  {
   "key": "3995614064388784128",
   "en": "Still gonna die!",
   "ro": "Tot o să mori!"
  }
 ]
}
