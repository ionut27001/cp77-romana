 "entries": [
  {
   "key": "1954470346773012484",
   "en": "Can it wait?",
   "ro": "Poate aștepta?"
  },
  {
   "key": "1954470346806566912",
   "en": "I'm a bit busy.",
   "ro": "Sunt puțin ocupată."
  },
  {
   "key": "1954470346840121348",
   "en": "Ugh…",
   "ro": "Ugh…"
  },
  {
   "key": "1954470346873675780",
   "en": "Get away!",
   "ro": "Dă-te la o parte!"
  },
  {
   "key": "1954470346907230212",
   "en": "Yes?",
   "ro": "Da?"
  },
  {
   "key": "1954470346940784644",
   "en": "Of course… I'll, uh, I'll take care of it… No, no, no problem… Mm-hmm… Uh-huh.",
   "ro": "Sigur… Mă ocup eu, uh… Nu, nu, nicio problemă… Mm-hmm… Uh-huh."
  },
  {
   "key": "1954470346974339076",
   "en": "Yes, the re-- the report too… I can do it… I-I remember… Yeah… Yes… As you wish.",
   "ro": "Da, și ra-- raportul… Pot să-l fac… M-am… mi-amintesc… Da… Da… Cum doriți."
  },
  {
   "key": "1954470347007893508",
   "en": "Goodbye.",
   "ro": "La revedere."
  },
  {
   "key": "1954470347142111236",
   "en": "It's a terrorist attack!",
   "ro": "E un atac terorist!"
  },
  {
   "key": "1954470347175665668",
   "en": "Somebody help me!",
   "ro": "Cineva să mă ajute!"
  },
  {
   "key": "1954470347242774532",
   "en": "Don't hurt me!",
   "ro": "Nu mă răni!"
  },
  {
   "key": "1954470347259551748",
   "en": "How could you?",
   "ro": "Cum ai putut?"
  },
  {
   "key": "1954470347343437828",
   "en": "I don't have time for games.",
   "ro": "N-am timp de jocuri."
  },
  {
   "key": "1954470347360215044",
   "en": "You seem to have a lot of free time.",
   "ro": "Se pare că ai mult timp liber."
  }
 ]
