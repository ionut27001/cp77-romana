  },
  {
   "key": "1949190341226258436",
   "en": "She already has one… She makes fun of me… I also want one…! Please, please!",
   "ro": "Ea are deja una… Râde de mine… Și eu vreau una…! Te rog, te rog!"
  },
  {
   "key": "1949190341243035652",
   "en": "But mom… How…? You bought one before…! For real! But…",
   "ro": "Dar mami… Cum adică…? Ai mai cumpărat una înainte…! Pe bune! Dar…"
  },
  {
   "key": "1949190341293367300",
   "en": "I hate you!",
   "ro": "Te urăsc!"
  },
  {
   "key": "1949190341494693892",
   "en": "Aaahhhh!",
   "ro": "Aaaah!"
  },
  {
   "key": "1949190341511471108",
   "en": "Mommyyyy!",
   "ro": "Mămiiii!"
  },
  {
   "key": "1949190341645688836",
   "en": "Mmm…. No!",
   "ro": "Mmm… Nu!"
  },
  {
   "key": "1949190341662466052",
   "en": "My daddy will save me!",
   "ro": "Tati mă va salva!"
  },
  {
   "key": "1949190341746352132",
   "en": "I think she's following me…",
   "en_m": "I think he's following me…",
   "ro": "Cred că ea mă urmărește…",
   "ro_m": "Cred că el mă urmărește…"
  },
  {
   "key": "1949190341763129348",
   "en": "Are you going where I'm going?",
   "ro": "Mergi unde merg și eu?"
  },
  {
   "key": "1958911151428378628",
   "en": "But... you didn't let me finish!",
   "ro": "Dar… nu m-ai lăsat să termin!"
  },
  {
   "key": "1958911151495487488",
   "en": "Promise to listen this time?",
   "ro": "Promiți că asculți de data asta?"
  },
  {
   "key": "1958911151512264708",
