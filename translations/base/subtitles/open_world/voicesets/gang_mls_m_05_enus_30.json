{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_mls_m_05_enus_30.json",
 "entries": [
  {
   "key": "1821221878201090052",
   "en": "All that meat's just slowin' you down.",
   "ro": "Toată carnea asta doar te încetinește."
  },
  {
   "key": "1821221878217867268",
   "en": "Take a good look, 'cause this is the fuckin' future.",
   "ro": "Uită-te bine, că asta e viitorul dracului."
  },
  {
   "key": "1821221878284976132",
   "en": "I don't know you, so back off.",
   "ro": "Nu te cunosc, așa că dă-te înapoi."
  },
  {
   "key": "1821221878318530560",
   "en": "Keep back and watch your distance.",
   "ro": "Stai în spate și păstrează distanța."
  },
  {
   "key": "1821221878368862212",
   "en": "Don't even start with me.",
   "ro": "Nici nu începe cu mine."
  },
  {
   "key": "1821221878402416644",
   "en": "I'll nail you to the wall with that shit.",
   "ro": "Te țintuiesc de perete cu porcăria asta."
  },
  {
   "key": "1821221878469525508",
   "en": "Make up your mind. There's no goin' back.",
   "ro": "Hotărăște-te. Nu mai e cale de întoarcere."
  },
  {
   "key": "1821221878486302724",
   "en": "That's enough of that.",
   "ro": "Gata cu asta."
  },
  {
   "key": "1821221878553411588",
   "en": "Fuck off, meatsack.",
   "ro": "Du-te-n pula mea, sac de carne."
  },
  {
   "key": "1821221878570188804",
   "en": "Get out of here.",
   "ro": "Ieși de aici."
  },
  {
   "key": "1821221878637297668",
   "en": "Whoa. Hear that?",
   "ro": "Uau. Auzi?"
  },
  {
   "key": "1821221878654074884",
   "en": "What the fuck…?",
   "ro": "Ce pula mea…?"
  },
  {
   "key": "1821221878704406532",
   "en": "Shit. Need some shut-eye.",
   "ro": "Rahat. Trebuie să trag un pui de somn."
  },
  {
   "key": "1821221878737960964",
   "en": "False alarm.",
   "ro": "Alarmă falsă."
  },
  {
   "key": "1821221878805069828",
   "en": "You're here, I know you are.",
   "ro": "Ești aici, știu că ești."
  },
  {
   "key": "1821221878855401472",
   "en": "Can't hide forever.",
   "ro": "Nu te poți ascunde la nesfârșit."
  },
  {
   "key": "1821221878905733124",
   "en": "One of ours!",
   "ro": "Unul de-al nostru!"
  },
  {
   "key": "1821221878956064772",
   "en": "All right, then.",
   "ro": "Bine, atunci."
  },
  {
   "key": "1821221879006396420",
   "en": "She's here. C'mon!",
   "ro": "E aici. Hai!"
  },
  {
   "key": "1821221879023173636",
   "en": "Fuck 'er up and give 'er to me!",
   "ro": "Fă-o praf și dă-mi-o!"
  },
  {
   "key": "1821221879073505284",
   "en": "Here, hold this!",
   "ro": "Ține asta!"
  },
  {
   "key": "1821221879123836932",
   "en": "Move, move!",
   "ro": "Mișcă, mișcă!"
  },
  {
   "key": "1821221879140614148",
   "en": "Flush the bitch out!",
   "ro": "Scoate-o afară pe cățea!"
  },
  {
   "key": "1821221879224500228",
   "en": "Goddamn it!",
   "ro": "Fir-ar al dracului!"
  },
  {
   "key": "1821221879308386308",
   "en": "You wanna die today?",
   "ro": "Vrei să mori azi?"
  },
  {
   "key": "1821221879341940740",
   "en": "Who the fuck?",
   "ro": "Cine pula mea?"
  },
  {
   "key": "1821221879375495172",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1821221879476158468",
   "en": "Yep... I'll do just like you're tellin' it...",
   "ro": "Da... o să fac exact cum spui..."
  },
  {
   "key": "1821221879509712900",
   "en": "Hmm... no, I can't make it... 'cause I can't... gotta take care of somethin'...",
   "ro": "Hmm... nu, nu ajung... n-am cum... am de rezolvat ceva..."
  },
  {
   "key": "1821221879576821764",
   "en": "Smoke her out!",
   "ro": "Scoate-o cu fum!"
  },
  {
   "key": "1821221879627153412",
   "en": "OK, you distract her!",
   "ro": "OK, tu o distragi!"
  },
  {
   "key": "1821221879711039488",
   "en": "Lettin' it fly!",
   "ro": "O las să zboare!"
  },
  {
   "key": "1821221879727816708",
   "en": "Later.",
   "ro": "Pe mai târziu."
  },
  {
   "key": "1821221879744593924",
   "en": "Shit. The fuck was that?!",
   "ro": "Rahat. Ce pula mea a fost aia?!"
  },
  {
   "key": "1821221879811702788",
   "en": "See what that was.",
   "ro": "Vezi ce a fost."
  },
  {
   "key": "1821221879845257220",
   "en": "Search and destroy.",
   "ro": "Caută și distruge."
  },
  {
   "key": "1821221879912366084",
   "en": "I'll back you up.",
   "ro": "Te acopăr."
  },
  {
   "key": "1821221879945920516",
   "en": "I'm gonna end her!",
   "ro": "O termin!"
  },
  {
   "key": "1821221879979474948",
   "en": "Khe... stop... you hear...? enough...",
   "ro": "Khe... stop... auzi...? destul..."
  },
  {
   "key": "1821402364756131840",
   "en": "Well, yeah...? Then where? I know where it is...",
   "ro": "Păi, da...? Atunci unde? Știu unde e..."
  },
  {
   "key": "1821402920820178944",
   "en": "Get 'er the fuck off me!",
   "en_m": "Get 'im the fuck off me!",
   "ro": "Scoate-o dracului de pe mine!",
   "ro_m": "Scoate-l dracului de pe mine!"
  }
 ]
}
