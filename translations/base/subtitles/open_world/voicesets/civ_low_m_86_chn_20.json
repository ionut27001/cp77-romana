{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_m_86_chn_20.json",
 "entries": [
  {
   "key": "1922913471143878660",
   "en": "Welcome, welcome.",
   "ro": "Bun venit, bun venit."
  },
  {
   "key": "1922913471177433092",
   "en": "Where you off to?",
   "ro": "Unde te duci?"
  },
  {
   "key": "1922913471244541956",
   "en": "What the…?",
   "ro": "Ce naiba…?"
  },
  {
   "key": "1922913471261319172",
   "en": "Why though? Why?",
   "ro": "De ce totuși? De ce?"
  },
  {
   "key": "1922913471294873604",
   "en": "What now?",
   "ro": "Ce acum?"
  },
  {
   "key": "1922913471361982468",
   "en": "I'll be back soon… No… I'm sober… Well, maybe one… Abydos, like always.",
   "ro": "Mă întorc curând… Nu… Sunt treaz… Păi, poate unul… Abydos, ca de obicei."
  },
  {
   "key": "1922913471395536900",
   "en": "Yes… I promise… Just today… Finally have a day off!",
   "ro": "Da… Promit… Doar azi… În sfârșit am și eu o zi liberă!"
  },
  {
   "key": "1922913471429091332",
   "en": "Be there soon. Bye.",
   "ro": "Ajung curând. Pa."
  },
  {
   "key": "1922913471630417924",
   "en": "Why today…?",
   "ro": "De ce azi…?"
  },
  {
   "key": "1922913471647195140",
   "en": "Somebody stop her!",
   "en_m": "Somebody stop him!",
   "ro": "Oprește-o cineva!",
   "ro_m": "Oprește-l cineva!"
  },
  {
   "key": "1922913471747858436",
   "en": "My wife… she's waiting for me!",
   "ro": "Soția mea… mă așteaptă!"
  },
  {
   "key": "1922913471781412868",
   "en": "I don't deserve this!",
   "ro": "Nu merit asta!"
  },
  {
   "key": "1922913471898853380",
   "en": "What's with the sneaking around?",
   "ro": "Ce-i cu furișatul ăsta?"
  },
  {
   "key": "1922913471949185024",
   "en": "You think I don't see you?",
   "ro": "Crezi că nu te văd?"
  }
 ]
}
