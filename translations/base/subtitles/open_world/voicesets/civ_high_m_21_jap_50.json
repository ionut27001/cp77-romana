 "entries": [
  {
   "key": "1878088761390669828",
   "en": "Is something the matter?",
   "ro": "E ceva în neregulă?"
  },
  {
   "key": "1878088761407447044",
   "en": "Did we have an appointment?",
   "ro": "Aveam o întâlnire?"
  },
  {
   "key": "1878088761474555908",
   "en": "Someone has issues!",
   "ro": "Cineva are probleme!"
  },
  {
   "key": "1878088761491333124",
   "en": "Oh! Someone is in a hurry!",
   "ro": "Oh! Cineva se grăbește!"
  },
  {
   "key": "1878088761541664772",
   "en": "Hello...? Yes, speaking...",
   "ro": "Alo...? Da, vorbesc..."
  },
  {
   "key": "1878088761591996420",
   "en": "Ahhh... We closed the deal with another party... No, my mind is made up…",
   "ro": "Ahhh... Ne-am înțeles cu altcineva... Nu, m-am decis deja…"
  },
  {
   "key": "1878088761625550852",
   "en": "Was that a threat...? Mh-hm... Good luck - with our security? You will need it.",
   "ro": "A fost o amenințare...? Mh-hm... Noroc cu securitatea noastră? O să-ți trebuiască."
  },
  {
   "key": "1878088761659105284",
   "en": "Give it a rest.",
   "ro": "Las-o baltă."
  },
  {
   "key": "1878088761843654660",
   "en": "Ugh... this is too much...!",
   "ro": "Ugh... e prea mult...!"
  },
  {
   "key": "1878088761860431876",
   "en": "Agh! She's going to kill us!",
   "ro": "Agh! Ne va omorî!"
  },
  {
   "key": "1878088761961095172",
   "en": "Do not do this...",
   "ro": "Nu face asta..."
  },
  {
   "key": "1878088762145644544",
   "en": "Why...? Why me?",
   "ro": "De ce...? De ce eu?"
  },
  {
   "key": "1878088762229530628",
   "en": "Spare me your games. I can see you.",
   "ro": "Scutește-mă de jocurile tale. Te văd."
  },
  {
   "key": "1878088762263085060",
   "en": "Just tell me what it is you want.",
   "ro": "Spune-mi doar ce vrei."
  },
  {
   "key": "1878090029144219648",
   "en": "That will not work on me. Don't waste your effort.",
   "ro": "Asta nu merge cu mine. Nu-ți pierde vremea."
  },
  {
   "key": "1958931269592064004",
   "en": "Ah, you are busy. I will wait...",
   "ro": "Ah, ești ocupată. Aștept...",
   "ro_m": "Ah, ești ocupat. Aștept..."
  },
  {
   "key": "1958931269642395652",
   "en": "Ah, where was I?",
   "ro": "Ah, unde rămăsesem?"
  },
  {
   "key": "1958931269659172868",
   "en": "I am waiting.",
   "ro": "Aștept."
  }
 ]
