   "ro": "Hei! Ai grijă!"
  },
  {
   "key": "1896782534723248132",
   "en": "<kiroshi l=\"arb\" o=\"Ahlan mama!\" t=\"Hi, mama!\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"arb\" o=\"Ahlan mama!\" t=\"Salut, mama!\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1896782534773579780",
   "en": "Great… Yeah, her too… Eeeh, we get along… Yes… Night City is Night City!",
   "ro": "Super… Da, și ea… Eeeh, ne înțelegem… Da… Night City e Night City!"
  },
  {
   "key": "1896782534807134212",
   "en": "Vegetarian only… We believe--… Mhm… Yeah I'll pass it on… Always!",
   "ro": "Doar vegetarian… Credem--… Mhm… Da, transmit… Mereu!"
  },
  {
   "key": "1896782534840688644",
   "en": "Miss you. Bye.",
   "ro": "Mi-e dor de tine. Pa."
  },
  {
   "key": "1896782534874243076",
   "en": "I... I don't get it…",
   "ro": "Eu... nu înțeleg…"
  },
  {
   "key": "1896782535260119040",
   "en": "Someone's here!",
   "ro": "E cineva aici!"
  },
  {
   "key": "1896782535276896260",
   "en": "Security!",
   "ro": "Pază!"
  },
  {
   "key": "1896782535377559556",
   "en": "<kiroshi l=\"arb\" o=\"Ya Elahy!\" t=\"Oh God!\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"arb\" o=\"Ya Elahy!\" t=\"O, Doamne!\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1896782535411113988",
   "en": "She's crazy!",
   "en_m": "He's crazy!",
   "ro": "E nebună!",
   "ro_m": "E nebun!"
  },
  {
   "key": "1896782535511777284",
   "en": "Don't shoot!",
   "ro": "Nu trage!"
  },
  {
   "key": "1896782535545331716",
   "en": "Who will take care of my mama…?",
   "ro": "Cine o să aibă grijă de mama mea…?"
  },
  {
   "key": "1896782535645995012",
   "en": "Got a problem with me?",
   "ro": "Ai o problemă cu mine?"
  },
  {
   "key": "1896782535713103876",
   "en": "You go your way, I go mine. Yes?",
   "ro": "Tu mergi pe drumul tău, eu pe al meu. Da?"
  },
  {
   "key": "1958905569044635652",
   "en": "Heh... Well, that's a first...",
   "ro": "Heh... Ei bine, asta e o premieră..."
  },
  {
   "key": "1958905569111744516",
   "en": "Great. So as I was saying...",
   "ro": "Super. Deci, cum ziceam..."
  },
  {
   "key": "1958905569128521732",
   "en": "Let's make this quick.",
   "ro": "Hai să terminăm repede."
