  },
  {
   "key": "1896782534454812676",
   "en": "Must be tripping.",
   "ro": "Sigur tripezi."
  },
  {
   "key": "1896782534505144324",
   "en": "Huh, just a false alarm.",
   "ro": "Huh, doar o alarmă falsă."
  },
  {
   "key": "1896782534538698756",
   "en": "Can't hear anything now.",
   "ro": "Nu mai aud nimic acum."
  },
  {
   "key": "1896782534589030404",
   "en": "You are here! I heard you!",
   "ro": "Ești aici! Te-am auzit!"
  },
  {
   "key": "1896782534622584836",
   "en": "Can't have imagined it…!",
   "ro": "Nu se poate să-mi fi imaginat…!"
