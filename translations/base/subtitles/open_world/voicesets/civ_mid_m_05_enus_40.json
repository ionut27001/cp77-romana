{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_m_05_enus_40.json",
 "entries": [
  {
   "key": "1906979841615863812",
   "en": "Do I know you? Well?",
   "ro": "Te cunosc? Ei?"
  },
  {
   "key": "1906979841649418244",
   "en": "Uh... all good?",
   "ro": "Uh... totul bine?"
  },
  {
   "key": "1906979841733304320",
   "en": "Hey, you! What're you doing here?!",
   "ro": "Hei, tu! Ce cauți aici?!"
  },
  {
   "key": "1906979841766858752",
   "en": "Take a hike! Unless you want trouble!",
   "ro": "Cară-te! Dacă nu vrei necazuri!"
  },
  {
   "key": "1906979841833967616",
   "en": "Ey now, guns away!",
   "ro": "Hei, acum, armele jos!"
  },
  {
   "key": "1906979841850744836",
   "en": "Holster your weapon, dammit!",
   "ro": "Pune arma în toc, la naiba!"
  },
  {
   "key": "1906979841917853700",
   "en": "This will end badly for you! I'm serious!",
   "ro": "O să se termine prost pentru tine! Sunt serios!"
  },
  {
   "key": "1906979841934630916",
   "en": "Do as I say or I'll call for help. You'll see!",
   "ro": "Fă cum zic, că altfel chem ajutor. O să vezi tu!"
  },
  {
   "key": "1906979842001739780",
   "en": "Well. Looks like you came to your senses.",
   "ro": "Ei. Se pare că ți-ai revenit."
  },
  {
   "key": "1906979842035294212",
   "en": "You learn fast.",
   "ro": "Înveți repede."
  },
  {
   "key": "1906979842119180292",
   "en": "Was that… Hm.",
   "ro": "A fost...? Hm."
  },
  {
   "key": "1906979842152734724",
   "en": "Whoa. Was that... ?",
   "ro": "Uau. A fost... ?"
  },
  {
   "key": "1906979842236620804",
   "en": "Hm. Seems OK.",
   "ro": "Hm. Pare OK."
  },
  {
   "key": "1906979842270175236",
   "en": "Guess it's fine.",
   "ro": "Presupun că e în regulă."
  },
  {
   "key": "1906979842354061312",
   "en": "Listen, punk! I'll tell you what I think about all this...",
   "ro": "Ascultă, golane! Îți spun eu ce cred despre toată treaba asta..."
  },
  {
   "key": "1906979842370838532",
   "en": "Do you think this is a game?",
   "ro": "Crezi că e joc?"
  },
  {
   "key": "1906979842471501824",
   "en": "What the fuck was that?!",
   "ro": "Ce pula mea a fost asta?!"
  },
  {
   "key": "1906979842505056256",
   "en": "You high or what?!",
   "ro": "Ești drogat sau ce?!"
  },
  {
   "key": "1906979842538610692",
   "en": "Yeah, what's up?",
   "ro": "Da, ce faci?"
  },
  {
   "key": "1906979842622496772",
   "en": "You're cuttin' out. Come again?",
   "ro": "Se întrerupe. Repetă?"
  },
  {
   "key": "1906979842639273988",
   "en": "Wait, you're kidding me. How big?",
   "ro": "Stai, faci mișto de mine. Cât de mare?"
  },
  {
   "key": "1906979842689605636",
   "en": "Uh-huh. Uh-huh. Bye now.",
   "ro": "Uh-huh. Uh-huh. Pa acum."
  },
  {
   "key": "1906979842723160068",
   "en": "What the fresh hell?!",
   "ro": "Ce dracu'?! "
  },
  {
   "key": "1906979843176144900",
   "en": "Intruder!",
   "ro": "Intrus!"
  },
  {
   "key": "1906979843209699332",
   "en": "Enough of this. Security!",
   "ro": "Destul. Securitatea!"
  },
  {
   "key": "1906979843310362628",
   "en": "Fuck's sake!",
   "ro": "Pula mea, pe bune!"
  },
  {
   "key": "1906979843343917060",
   "en": "Aughh!",
   "ro": "Aughh!"
  },
  {
   "key": "1906979843444580356",
   "en": "Let me… It's not worth it!",
   "ro": "Lasă-mă… Nu merită!"
  },
  {
   "key": "1906979843478134788",
   "en": "Got no money!",
   "ro": "N-am bani!"
  },
  {
   "key": "1906979843578798084",
   "en": "Why are you following me? Fuck off!",
   "ro": "De ce mă urmărești? Du-te-n pula mea!"
  },
  {
   "key": "1906979843612352516",
   "en": "You ain't getting shit outta me, so take a hike!",
   "ro": "Nu scoți niciun căcat din mine, așa că șterge-o!"
  }
 ]
}
