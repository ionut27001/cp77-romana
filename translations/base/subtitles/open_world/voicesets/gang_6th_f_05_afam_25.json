{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_6th_f_05_afam_25.json",
 "entries": [
  {
   "key": "1789979031388917764",
   "en": "Worst streetscum come out at night.",
   "ro": "Cel mai rău gunoi de stradă iese noaptea."
  },
  {
   "key": "1789979031405694980",
   "en": "Gotta fight for somethin', but what the hell would you know.",
   "ro": "Trebuie să lupți pentru ceva, da' ce naiba ai ști tu."
  },
  {
   "key": "1789979031489581060",
   "en": "Wanna see what I'll do? Huh, gonk? Get back!",
   "ro": "Vrei să vezi ce-o să fac? Ha, fraiere? Înapoi!"
  },
  {
   "key": "1789979031523135492",
   "en": "You think I'm just some dumb cunt? Get back!",
   "ro": "Tu crezi că-s doar o pizdă tâmpită? Înapoi!"
  },
  {
   "key": "1789979031573467140",
   "en": "Drop it, or you get a bullet 'tween those pretty eyes of yours.",
   "ro": "Aruncă-l, sau iei un glonț între ochii ăia frumoși ai tăi."
  },
  {
   "key": "1789979031607021572",
   "en": "Stash it, or I give you a third eye!",
   "ro": "Ascunde-l, sau îți dau un al treilea ochi!"
  },
  {
   "key": "1789979031657353216",
   "en": "You fucking scum! Do as I say!",
   "ro": "Tu, gunoi nenorocit! Fă ce-ți spun!"
  },
  {
   "key": "1789979031674130436",
   "en": "Shut up and fuck off!",
   "ro": "Taci și cară-te!"
  },
  {
   "key": "1789979031724462080",
   "en": "Bend that knee or die. See you chose wisely.",
   "ro": "Îngenunchează sau mori. Se vede că ai ales cu cap."
  },
  {
   "key": "1789979031741239300",
   "en": "You really are a bunch of spineless cowards, aren't you?",
   "ro": "Chiar sunteți niște lași fără coloană, nu?"
  },
  {
   "key": "1789979031808348164",
   "en": "Not the fuckin' earware... Again?",
   "ro": "Nu iarăși nenorocita de earware... Din nou?"
  },
  {
   "key": "1789979031841902592",
   "en": "Ripper musta fucked up the calibration...",
   "ro": "Ripperul a dat peste cap calibrarea..."
  },
  {
   "key": "1789979031909011460",
   "en": "All right, I'm done. That's enough.",
   "ro": "Bine, am terminat. Ajunge."
  },
  {
   "key": "1789979031925788676",
   "en": "Nothin' outta the ordinary.",
   "ro": "Nimic în afara obișnuitului."
  },
  {
   "key": "1789979031992897540",
   "en": "How 'bout you come on out and let's talk?",
   "ro": "Ce zici să ieși și să vorbim?"
  },
  {
   "key": "1789979032026451972",
   "en": "Look, no hard feelings. Come on out.",
   "ro": "Uite, fără supărare. Ieși afară."
  },
  {
   "key": "1789979032060006404",
   "en": "Fuck. Another patriot down!",
   "ro": "Futu-i. Încă un patriot jos!"
  },
  {
   "key": "1789979032110338052",
   "en": "Fiiiine, I'll do it. Jesus.",
   "ro": "Biiine, o să fac. Doamne."
  },
  {
   "key": "1789979032160669700",
   "en": "Day's nothin' but shit!",
   "ro": "Ziua e doar rahat!"
  },
  {
   "key": "1789979032194224132",
   "en": "No justice, no mercy!",
   "ro": "Fără dreptate, fără milă!"
  },
  {
   "key": "1789979032227778564",
   "en": "Bird's flying!",
   "ro": "Pasărea zboară!"
  },
  {
   "key": "1789979032278110212",
   "en": "Hit the scum where it counts!",
   "ro": "Lovește gunoiul unde doare!"
  },
  {
   "key": "1789979032294887428",
   "en": "I'ma kill the fucker myself!",
   "ro": "O să-l omor eu pe nenorocitul ăla!"
  },
  {
   "key": "1789979032345219076",
   "en": "Noooo!!!",
   "ro": "Nuuu!!!"
  },
  {
   "key": "1789979032378773508",
   "en": "Regroup!",
   "ro": "Regrupați-vă!"
  },
  {
   "key": "1789979032429105156",
   "en": "Get lost.",
   "ro": "Cară-te."
  },
  {
   "key": "1789979032445882372",
   "en": "What the...",
   "ro": "Ce naiba..."
  },
  {
   "key": "1789979032496214020",
   "en": "Talk to me.",
   "ro": "Vorbește cu mine."
  },
  {
   "key": "1789979032546545668",
   "en": "Uhhuh... Yep... Yep... I know, I heard... No, no, no way, man…",
   "ro": "Mhm... Da... Da... Știu, am auzit... Nu, nu, nici vorbă, frate…"
  },
  {
   "key": "1789979032563322884",
   "en": "Yeah...? OK... all right, then...",
   "ro": "Da...? OK... bine, atunci..."
  },
  {
   "key": "1789979032613654532",
   "en": "Take her from behind!",
   "en_m": "Take him from behind!",
   "ro": "Prinde-o din spate!",
   "ro_m": "Prinde-l din spate!"
  },
  {
   "key": "1789979032663986180",
   "en": "Try to get 'round her!",
   "en_m": "Try to get 'round him!",
   "ro": "Încearcă să o ocolești!",
   "ro_m": "Încearcă să-l ocolești!"
  },
  {
   "key": "1789979032714317828",
   "en": "Aaaagh!",
   "ro": "Aaaagh!"
  },
  {
   "key": "1789979032747872260",
   "en": "Peace.",
   "ro": "Pace."
  },
  {
   "key": "1789979032781426688",
   "en": "Uggghhh... Not again.",
   "ro": "Uggghhh... Nu iar."
  },
  {
   "key": "1789979032831758340",
   "en": "Gotta be something big. C'mon.",
   "ro": "Trebuie să fie ceva mare. Hai."
  },
  {
   "key": "1789979032848535556",
   "en": "Got a bad feelin' bout this. Better check it out.",
   "ro": "Mi se pare aiurea treaba asta. Mai bine verific."
  },
  {
   "key": "1789979032898867200",
   "en": "Go deal with it. I'm done for today.",
   "ro": "Du-te și rezolvă. Am terminat pentru azi."
  },
  {
   "key": "1789979032915644420",
   "en": "For principle! For glory!",
   "ro": "Pentru principiu! Pentru glorie!"
  },
  {
   "key": "1789979032949198852",
   "en": "Aaagh... not... so... hard...",
   "ro": "Aaagh... nu... așa... tare..."
  },
  {
   "key": "1790070412941824000",
   "en": "Nope, can't agree to that... Sorry...",
   "ro": "Nu, nu pot fi de acord cu asta... Scuze..."
  },
  {
   "key": "2230239450671226884",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "2230239450788667396",
   "en": "Fuck!",
   "ro": "Futu-i!"
  },
  {
   "key": "2230239450838999044",
   "en": "Keep pushing!",
   "ro": "Continuă să împingi!"
  },
  {
   "key": "2230239450906107908",
   "en": "Sixer down! Stay frosty!",
   "ro": "Un Sixer jos! Rămâneți vigilenți!"
  },
  {
   "key": "2230239450956439556",
   "en": "Shit! Can't see nothin'!",
   "ro": "Rahat! Nu văd nimic!"
  },
  {
   "key": "2230239451090657284",
   "en": "Didn't call nobody! Spread out! Now!",
   "ro": "N-am chemat pe nimeni! Răspândiți-vă! Acum!"
  },
  {
   "key": "2230239451174543364",
   "en": "Don't fucking stop! Keep firing!",
   "ro": "Nu te opri, pula mea! Continuă să tragi!"
  },
  {
   "key": "2230239451375869956",
   "en": "Now you're gonna get it!",
   "ro": "Acum o să iei!"
  },
  {
   "key": "2230239451442978820",
   "en": "Eat shit!",
   "ro": "Sugi pula!"
  },
  {
   "key": "2230239451677859844",
   "en": "Nailed 'er!",
   "en_m": "Nailed 'im!",
   "ro": "Am nimerit-o!",
   "ro_m": "Am nimerit-l!"
  },
  {
   "key": "2230239451862409220",
   "en": "Move up! She's almost down!",
   "en_m": "Move up! He's almost down!",
   "ro": "Înaintați! E aproape jos!"
  },
  {
   "key": "2230239451912740868",
   "en": "Roger that!",
   "ro": "Am înțeles!"
  },
  {
   "key": "2230239451963072516",
   "en": "Bitch, show yourself!",
   "ro": "Curvo, arată-te!"
  },
  {
   "key": "2230239452030181380",
   "en": "Fuck, tha'ass my people!",
   "ro": "Futu-i, ăia-s oamenii mei!"
  },
  {
   "key": "2230239452097290244",
   "en": "Reloading! Cover me!",
   "ro": "Reîncarc! Acoperiți-mă!"
  },
  {
   "key": "2230239452181176320",
   "en": "Look out! Friendly turned!",
   "ro": "Atenție! Un aliat a trecut de partea lor!"
  },
  {
   "key": "2230239452298616836",
   "en": "Fuck! My eyes!",
   "ro": "Futu-i! Ochii mei!"
  },
  {
   "key": "2230239452365725700",
   "en": "Netrunner!",
   "ro": "Netrunner!"
  },
  {
   "key": "2230239452432834564",
   "en": "Ooohhh! Some good shit right there!",
   "ro": "Ooohhh! Marfă rău acolo!"
  },
  {
   "key": "2230239452483166212",
   "en": "Callin' reinforcements!",
   "ro": "Chem întăriri!"
  },
  {
   "key": "2230239452550275076",
   "en": "I'ma fuck you up!",
   "ro": "O să te fac praf!"
  },
  {
   "key": "2230239452600606724",
   "en": "I'll get 'er up close!",
   "en_m": "I'll get 'im up close!",
   "ro": "O aduc aproape!",
   "ro_m": "Îl aduc aproape!"
  },
  {
   "key": "2230239452650938372",
   "en": "Providing heavy fire!",
   "ro": "Asigur foc greu!"
  }
 ]
