{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_mid_f_02_mex_25.json",
 "entries": [
  {
   "key": "1856186479631933444",
   "en": "What?",
   "ro": "Ce?"
  },
  {
   "key": "1856186479665487876",
   "en": "Why you hangin' around if you ain't got nothin' to tell me?",
   "ro": "De ce mai stai pe aici dacă n-ai nimic să-mi spui?"
  },
  {
   "key": "1856186479715819524",
   "en": "Turn around and keep walking.",
   "ro": "Întoarce-te și continuă să mergi."
  },
  {
   "key": "1856186479732596740",
   "en": "Wanna see you movin' back, on the double.",
   "ro": "Vreau să te văd înapoi, imediat."
  },
  {
   "key": "1856186479782928388",
   "en": "Listen, better stash that iron.",
   "ro": "Ascultă, mai bine ascunde arma aia."
  },
  {
   "key": "1856186479799705604",
   "en": "Better drop your weapon or else.",
   "ro": "Mai bine lasă arma jos, altfel..."
  },
  {
   "key": "1856186479850037252",
   "en": "Final warning.",
   "ro": "Ultimul avertisment."
  },
  {
   "key": "1856186479883591684",
   "en": "Not gonna say it again.",
   "ro": "Nu o să repet."
  },
  {
   "key": "1856186479950700544",
   "en": "Now scram.",
   "ro": "Acum cară-te."
  },
  {
   "key": "1856186479967477764",
   "en": "Get outta here.",
   "ro": "Dispari."
  },
  {
   "key": "1856186480017809412",
   "en": "Who we got lurkin' here?",
   "ro": "Cine se ascunde pe aici?"
  },
  {
   "key": "1856186480034586628",
   "en": "Police! What's going on here?",
   "ro": "Poliția! Ce se întâmplă aici?"
  },
  {
   "key": "1856186480101695492",
   "en": "Ugh, so bored.",
   "ro": "Ugh, mă plictisesc."
  },
  {
   "key": "1856186480118472708",
   "en": "That's all she wrote.",
   "ro": "Asta e tot."
  },
  {
   "key": "1856186480185581572",
   "en": "We gon' find you. Don't drag it out.",
   "ro": "Te vom găsi. Nu o lungi."
  },
  {
   "key": "1856186480202358788",
   "en": "Shoulda used your damn head instead of hiding!",
   "ro": "Ar fi trebuit să-ți folosești capul dracului în loc să te ascunzi!"
  },
  {
   "key": "1856186480235913220",
   "en": "We got a badge killer!",
   "ro": "Avem un ucigaș de polițiști!"
  },
  {
   "key": "1856186480269467652",
   "en": "Roger. On it.",
   "ro": "Înțeles. Mă ocup."
  },
  {
   "key": "1856186480336576516",
   "en": "A little help here!",
   "ro": "Puțin ajutor aici!"
  },
  {
   "key": "1856186480353353732",
   "en": "I'm under fire!",
   "ro": "Trag în mine!"
  },
  {
   "key": "1856186480386908164",
   "en": "Hot one, in the air!",
   "ro": "Unul fierbinte, în aer!"
  },
  {
   "key": "1856186480437239812",
   "en": "Fuck, I love this job!",
   "ro": "Futu-i, iubesc treaba asta!"
  },
  {
   "key": "1856186480454017028",
   "en": "I'm reloading!",
   "ro": "Reîncarc!"
  },
  {
   "key": "1856186480504348676",
   "en": "Fucking fuck!",
   "ro": "Futu-i!"
  },
  {
   "key": "1856186480537903108",
   "en": "Help! Goddamnit!",
   "ro": "Ajutor! Mama dracului!"
  },
  {
   "key": "1856186480621789188",
   "en": "Watch where you're goin'!",
   "ro": "Uită-te unde mergi!"
  },
  {
   "key": "1856186480655343616",
   "en": "Where you walkin'?",
   "ro": "Unde mergi?"
  },
  {
   "key": "1856186480705675268",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1856186480756006916",
   "en": "Course... mhm... I'll swing by, take care of it...",
   "ro": "Sigur... mhm... trec pe acolo, mă ocup..."
  },
  {
   "key": "1856186480772784132",
   "en": "Glad you called... yeah... yeah, go take care of it, I can't today...",
   "ro": "Bine că ai sunat... da... da, du-te și rezolvă, eu azi nu pot..."
  },
  {
   "key": "1856186480823115780",
   "en": "From behind! Go around!",
   "ro": "Din spate! Ocolește!"
  },
  {
   "key": "1856186480856670212",
   "en": "I'll take the side!",
   "ro": "Mă ocup de flanc!"
  },
  {
   "key": "1856186480890224644",
   "en": "Heads down! 'Bout to blow!",
   "ro": "Capetele jos! E gata să explodeze!"
  },
  {
   "key": "1856186480923779076",
   "en": "Bye.",
   "ro": "Pa."
  },
  {
   "key": "1856186480940556292",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1856186480990887940",
   "en": "Better go check it out.",
   "ro": "Mai bine mă duc să verific."
  },
  {
   "key": "1856186481007665156",
   "en": "Let's get to work.",
   "ro": "Hai la treabă."
  },
  {
   "key": "1856186481041219588",
   "en": "Get on it.",
   "ro": "Ocupă-te."
  },
  {
   "key": "1856186481057996804",
   "en": "Cover me!",
   "ro": "Acoperă-mă!"
  },
  {
   "key": "1856186481108328452",
   "en": "Ech... ech... no... please...",
   "ro": "Eh... eh... nu... te rog..."
  },
  {
   "key": "1867675994577969152",
   "en": "Don't worry... yeah, later today...",
   "ro": "Nu-ți face griji... da, mai târziu azi..."
  },
  {
   "key": "1867676502441074688",
   "en": "Mhm, mhm... love you, too...",
   "ro": "Mhm, mhm... te iubesc și eu..."
  }
 ]
}
