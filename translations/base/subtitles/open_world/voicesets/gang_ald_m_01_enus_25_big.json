{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_ald_m_01_enus_25_big.json",
 "entries": [
  {
   "key": "1944322658312167428",
   "en": "Welcome to reality.",
   "ro": "Bun venit în realitate."
  },
  {
   "key": "1944322658328944644",
   "en": "Either you live the life, or the life lives you.",
   "ro": "Ori trăiești viața, ori viața te trăiește."
  },
  {
   "key": "1944322658446385156",
   "en": "Hello! Stop waving that around!",
   "ro": "Salut! Nu mai flutura aia!"
  },
  {
   "key": "1944322658463162372",
   "en": "Put that away!",
   "ro": "Pune asta la loc!"
  },
  {
   "key": "1944322658899369988",
   "en": "It has begun!",
   "ro": "A început!"
  },
  {
   "key": "1944322658932924416",
   "en": "Take your positions!",
   "ro": "Luați pozițiile!"
  },
  {
   "key": "1944322659000033284",
   "en": "Give them hell!",
   "ro": "Fă-i praf!"
  },
  {
   "key": "1944322659033587712",
   "en": "I will take care of them!",
   "ro": "Mă ocup eu de ei!"
  },
  {
   "key": "1944322659067142148",
   "en": "What in hell?!",
   "ro": "Ce naiba?!"
  },
  {
   "key": "1944322659100696576",
   "en": "Motherfucker!",
   "ro": "Futu-i mama mă-sii!"
  },
  {
   "key": "1944322659151028228",
   "en": "Watch out!",
   "ro": "Atenție!"
  },
  {
   "key": "1944322659167805444",
   "en": "What the hell?!",
   "ro": "Ce dracu'?!"
  },
  {
   "key": "1944322659201359876",
   "en": "Greetings.",
   "ro": "Salutări."
  },
  {
   "key": "1944322659251691524",
   "en": "Of course I do, tell me… Where did it happen…?",
   "ro": "Sigur că da, spune-mi… Unde s-a întâmplat…?"
  },
  {
   "key": "1944322659268468740",
   "en": "But how did you lose it…? Ahh, man… What can I tell you…?",
   "ro": "Dar cum ai pierdut-o…? Ahh, frate… Ce să-ți zic…?"
  },
  {
   "key": "1944322659385909252",
   "en": "Attention, grenade!",
   "ro": "Atenție, granată!"
  },
  {
   "key": "1944322659402686468",
   "en": "Take care!",
   "ro": "Ai grijă!"
  },
  {
   "key": "1944322659553681412",
   "en": "Move your asses! Move goddammit it!",
   "ro": "Mișcați-vă! Mișcați-vă, mama dracului!"
  },
  {
   "key": "1944358681444392960",
   "en": "All right… Give me a moment to think… All right, I believe I know how to trace it… Mhm… Yes, yes.",
   "ro": "Bine… Dă-mi un moment să mă gândesc… Bine, cred că știu cum s-o urmăresc… Mhm… Da, da."
  },
  {
   "key": "1944359271482302464",
   "en": "No wait! Wait, I know how to trace them… Mm-hmm… Do not concern yourself.",
   "ro": "Nu, așteaptă! Așteaptă, știu cum să-i urmăresc… Mm-hmm… Nu-ți face griji."
  },
  {
   "key": "1958981519400804356",
   "en": "Ugh, city folk...",
   "ro": "Ugh, orășeni..."
  },
  {
   "key": "1958981519451136004",
   "en": "Now where were we? Right...",
   "ro": "Deci unde rămăsesem? Aha..."
  },
  {
   "key": "1958981519484690436",
   "en": "What'll it be?",
   "ro": "Ce vrei?"
  }
 ]
}
