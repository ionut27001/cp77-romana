{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_33_ind_30.json",
 "entries": [
  {
   "key": "1948863777079336964",
   "en": "Oh my goodness... Hey, sexy.",
   "ro": "Doamne... Hei, sexy."
  },
  {
   "key": "1948863777112891392",
   "en": "You're not sad, all alone?",
   "ro": "Nu ești tristă, singură?",
   "ro_m": "Nu ești trist, singur?"
  },
  {
   "key": "1948863777163223040",
   "en": "I must ask you to leave.",
   "ro": "Trebuie să te rog să pleci."
  },
  {
   "key": "1948863777180000260",
   "en": "Just go. Seriously.",
   "ro": "Pleacă. Serios."
  },
  {
   "key": "1948863777213554692",
   "en": "Fuck, not this!",
   "ro": "Futu-i, nu asta!"
  },
  {
   "key": "1948863777247109124",
   "en": "Put the gun down before you start a bloodbath!",
   "ro": "Pune arma jos, înainte să se facă baie de sânge!"
  },
  {
   "key": "1948863777280663556",
   "en": "If they find you here… You're dead.",
   "ro": "Dacă te găsesc aici… Ești moartă.",
   "ro_m": "Dacă te găsesc aici… Ești mort."
  },
  {
   "key": "1948863777314217988",
   "en": "This isn't a joke! They'll fuck you up!",
   "ro": "Nu e glumă! Te fac praf!"
  },
  {
   "key": "1948863777364549632",
   "en": "Great. Thanks.",
   "ro": "Minunat. Mulțumesc."
  },
  {
   "key": "1948863777381326852",
   "en": "I almost had a bloody heart attack, you know?",
   "ro": "Aproape să fac infarct, știi?"
  },
  {
   "key": "1948863777431658500",
   "en": "Is that someone?",
   "ro": "E cineva acolo?"
  },
  {
   "key": "1948863777448435716",
   "en": "This is too much…",
   "ro": "E prea mult…"
  },
  {
   "key": "1948863777498767364",
   "en": "There is nobody here. Nobody.",
   "ro": "Nu e nimeni aici. Nimeni."
  },
  {
   "key": "1948863777515544580",
   "en": "Yeah… Just seeing things.",
   "ro": "Da… Văd lucruri."
  },
  {
   "key": "1948863777616207872",
   "en": "Some--… somebody here?",
   "ro": "Cine--… cineva aici?"
  },
  {
   "key": "1948863777649762308",
   "en": "Come out! I know you're in here!",
   "ro": "Ieși! Știu că ești aici!"
  },
  {
   "key": "1948863777767202820",
   "en": "Hey!",
   "ro": "Hei!"
  },
  {
   "key": "1948863777817534468",
   "en": "Outta my way!",
   "ro": "Dă-te din drum!"
  },
  {
   "key": "1948863777867866116",
   "en": "Miss me?",
   "ro": "Ți-a fost dor de mine?"
  },
  {
   "key": "1948863777951752196",
   "en": "You wanna…? Sure…! No, I can buy it… Chateau Piquette ok?",
   "ro": "Vrei…? Sigur…! Nu, plătesc eu… Chateau Piquette, bine?"
  },
  {
   "key": "1948863777985306628",
   "en": "Wonderful… We have a date… Sure… sure… Pizza for dessert.",
   "ro": "Super… Avem un date… Sigur… sigur… Pizza la desert."
  },
  {
   "key": "1948863778035638276",
   "en": "Miss you already !",
   "ro": "Mi-e dor de tine deja!"
  },
  {
   "key": "1948863778052415492",
   "en": "What was that?",
   "ro": "Ce-a fost asta?"
  },
  {
   "key": "1948863778505400324",
   "en": "Security! Security!",
   "ro": "Securitate! Securitate!"
  },
  {
   "key": "1948863778522177540",
   "en": "She's dangerous!",
   "en_m": "He's dangerous!",
   "ro": "Ea e periculoasă!",
   "ro_m": "El e periculos!"
  },
  {
   "key": "1948863778656395268",
   "en": "Another crazy!",
   "ro": "Încă o nebună!",
   "ro_m": "Încă un nebun!"
  },
  {
   "key": "1948863778706726916",
   "en": "She'll blow us up!",
   "en_m": "He'll blow us up!",
   "ro": "Ea ne aruncă în aer!",
   "ro_m": "El ne aruncă în aer!"
  },
  {
   "key": "1948863778908053508",
   "en": "I'm too young!",
   "ro": "Sunt prea tânăr!"
  },
  {
   "key": "1948863778941607940",
   "en": "No… Don't do this! No!",
   "ro": "Nu… Nu face asta! Nu!"
  },
  {
   "key": "1948863779109380096",
   "en": "You know… This is getting scary, I mean, I'm really scared.",
   "ro": "Știi… Începe să mă sperie, adică chiar mi-e frică."
  },
  {
   "key": "1948863779126157316",
   "en": "Why don't you go your own way?",
   "ro": "De ce nu-ți vezi de drum?"
  }
 ]
