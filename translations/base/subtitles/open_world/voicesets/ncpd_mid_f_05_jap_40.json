{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_mid_f_05_jap_40.json",
 "entries": [
  {
   "key": "1856229626202300416",
   "en": "Lookin' like shit warmed over, punk.",
   "ro": "Arăți ca naiba, golanule."
  },
  {
   "key": "1856229626219077636",
   "en": "What's in your pocket, huh?",
   "ro": "Ce ai în buzunar, ha?"
  },
  {
   "key": "1856229626269409284",
   "en": "All you gonna find here is trouble.",
   "ro": "Aici găsești doar necazuri."
  },
  {
   "key": "1856229626286186500",
   "en": "Now one step back.",
   "ro": "Acum un pas înapoi."
  },
  {
   "key": "1856229626336518148",
   "en": "'Bout to take that shit away from you.",
   "ro": "O să-ți iau rahatul ăsta."
  },
  {
   "key": "1856229626370072580",
   "en": "Yeah, yeah, very nice. Now holster it.",
   "ro": "Da, da, foarte frumos. Acum pune-o în toc."
  },
  {
   "key": "1856229626437181440",
   "en": "About to show you what the NCPD can do.",
   "ro": "O să-ți arăt ce poate face NCPD-ul."
  },
  {
   "key": "1856229626453958660",
   "en": "Simmer down. Seriously.",
   "ro": "Calmează-te. Serios."
  },
  {
   "key": "1856229626504290308",
   "en": "Fuck off – but no fast moves.",
   "ro": "Du-te dracu'! – dar fără mișcări bruște."
  },
  {
   "key": "1856229626537844740",
   "en": "Get lost, before I run outta patience.",
   "ro": "Dispari, până nu-mi pierd răbdarea."
  },
  {
   "key": "1856229626588176388",
   "en": "The fuck! What is it now?",
   "ro": "Ce căcat! Ce e acum?"
  },
  {
   "key": "1856229626604953604",
   "en": "Heh?",
   "ro": "Heh?"
  },
  {
   "key": "1856229626655285252",
   "en": "Investigation complete.",
   "ro": "Investigația s-a încheiat."
  },
  {
   "key": "1856229626688839684",
   "en": "Welp, \"at ease.\"",
   "ro": "Ei, „odihnă”."
  },
  {
   "key": "1856229626755948548",
   "en": "Come on out. Won't shoot you right away.",
   "ro": "Ieși afară. Nu te împușc imediat."
  },
  {
   "key": "1856229626772725764",
   "en": "You done lost your fuckin' rights. Come out!",
   "ro": "Ți-ai pierdut dracului drepturile. Ieși afară!"
  },
  {
   "key": "1856229626823057412",
   "en": "Goddamnit!",
   "ro": "Mama dracului!"
  },
  {
   "key": "1856229626873389060",
   "en": "No problem.",
   "ro": "Nicio problemă."
  },
  {
   "key": "1856229626940497924",
   "en": "I'm under attack!",
   "ro": "Sunt atacată!"
  },
  {
   "key": "1856229626974052352",
   "en": "Another motherfucker!",
   "ro": "Încă un nenorocit!"
  },
  {
   "key": "1856229627024384004",
   "en": "Here's your sentence!",
   "ro": "Iată sentința!"
  },
  {
   "key": "1856229627091492868",
   "en": "No arrests! Stand your ground!",
   "ro": "Fără arestări! Țineți poziția!"
  },
  {
   "key": "1856229627108270084",
   "en": "You're fucked now!",
   "ro": "Ești moartă acum!",
   "ro_m": "Ești mort acum!"
  },
  {
   "key": "1856229627158601732",
   "en": "Think I'm hit!",
   "ro": "Cred că m-au lovit!"
  },
  {
   "key": "1856229627192156164",
   "en": "Can't get a fuckin' break!",
   "ro": "Nu pot avea o pauză, pula mea!"
  },
  {
   "key": "1856229627242487812",
   "en": "'Ey!",
   "ro": "Hei!"
  },
  {
   "key": "1856229627259265028",
   "en": "You little bitch.",
   "ro": "Pizdă mică."
  },
  {
   "key": "1856229627309596676",
   "en": "'Sup?",
   "ro": "Ce faci?"
  },
  {
   "key": "1856229627359928324",
   "en": "Uh-huh... No... No, no way... It's just...",
   "ro": "Mhm... Nu... Nu, nici vorbă... E doar..."
  },
  {
   "key": "1856229627393482756",
   "en": "Mhm...mhm... Yeah... I dunno... I really, really can't... I'm sorry...",
   "ro": "Mhm...mhm... Da... Nu știu... Chiar, chiar nu pot... Îmi pare rău..."
  },
  {
   "key": "1856229627460591620",
   "en": "Both sides! Now!",
   "ro": "Ambele părți! Acum!"
  },
  {
   "key": "1856229627510923268",
   "en": "Goin' in from the side!",
   "ro": "Intru din lateral!"
  },
  {
   "key": "1856229627544477700",
   "en": "Run! Get out!",
   "ro": "Fugiți! Ieșiți afară!"
  },
  {
   "key": "1856229627561254916",
   "en": "Bye bye.",
   "ro": "Pa, pa."
  },
  {
   "key": "1856229627594809348",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1856229627645140996",
   "en": "You see anything, shoot first.",
   "ro": "Dacă vezi ceva, împușcă primul."
  },
  {
   "key": "1856229627678695424",
   "en": "Shoot first, questions later.",
   "ro": "Împușcă întâi, întreabă după."
  },
  {
   "key": "1856229627712249860",
   "en": "I got your back.",
   "ro": "Te acopăr."
  },
  {
   "key": "1856229627729027076",
   "en": "Shoot! Shoot her down!",
   "en_m": "Shoot! Shoot him down!",
   "ro": "Împușcă! Împușcă-o!",
   "ro_m": "Împușcă! Împușcă-l!"
  },
  {
   "key": "1856229627762581508",
   "en": "Argh... fuckin'... ech... ech...",
   "ro": "Argh... pula mea... ech... ech..."
  },
  {
   "key": "1867693178222026752",
   "en": "I don't wanna, all right...? Yeah, love you too.",
   "ro": "Nu vreau, bine...? Da, și eu te iubesc."
  }
 ]
}
