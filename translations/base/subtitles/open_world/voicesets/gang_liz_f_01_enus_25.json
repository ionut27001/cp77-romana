 "entries": [
  {
   "key": "1822649938973679620",
   "en": "I'm off the clock, hon.",
   "ro": "Am terminat tura, dragă."
  },
  {
   "key": "1822649939007234048",
   "en": "Eye of the tiger, babe...",
