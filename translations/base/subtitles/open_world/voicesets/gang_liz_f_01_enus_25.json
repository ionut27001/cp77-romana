   "en": "You're makin' a mistake.",
   "ro": "Facă o greșeală."
  },
  {
   "key": "1822649939158228996",
   "en": "Final warning.",
   "ro": "Ultimul avertisment."
  },
  {
   "key": "1822649939175006212",
   "en": "'Ey! You don't wanna see us mad.",
   "ro": "Hei! Nu vrei să ne vezi nervoși."
  },
  {
   "key": "1822649939208560644",
   "en": "Good choice.",
   "ro": "Bună alegere."
  },
  {
   "key": "1822649939225337868",
   "en": "Get outta my sight.",
   "ro": "Dispari din fața mea!"
  },
  {
   "key": "1822649939275669508",
   "en": "What now?",
   "ro": "Ce acum?"
  },
  {
   "key": "1822649939292446724",
   "en": "Something's not right...",
   "ro": "Ceva nu e în regulă..."
  },
  {
   "key": "1822649939342778372",
   "en": "Nothin' to worry about.",
   "ro": "N-ai de ce să-ți faci griji."
  },
  {
   "key": "1822649939359555588",
   "en": "Everything's fine.",
   "ro": "Totul e bine."
  },
  {
   "key": "1822649939393110020",
   "en": "Come on out, sweetheart.",
   "ro": "Hai, ieși afară, dragă."
  },
  {
   "key": "1822649939409887236",
   "en": "Come the fuck out!",
   "ro": "Ieși dracu' afară!"
  },
  {
   "key": "1822649939443441668",
   "en": "One down!",
   "ro": "Unul jos!"
  },
  {
   "key": "1822649939476996100",
   "en": "Yep. You got it.",
   "ro": "Da. Ai înțeles."
  },
  {
   "key": "1822649939527327748",
   "en": "Let's dance!",
   "ro": "Hai la dans!"
  },
  {
   "key": "1822649939560882180",
   "en": "Kill 'er!",
