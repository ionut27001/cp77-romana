   "ro": "Omoară-o!",
   "ro_m": "Omoară-l!"
  },
  {
   "key": "1822649939594436612",
   "en": "Grenade!",
   "ro": "Granată!"
  },
  {
   "key": "1822649939644768260",
   "en": "Die, bitch!",
   "ro": "Moră, curvo!"
  },
  {
   "key": "1822649939661545476",
   "en": "Let's go!",
   "ro": "Hai!"
  },
  {
   "key": "1822649939695099908",
   "en": "Fuck!",
   "ro": "Futu-i!"
  },
  {
   "key": "1822649939711877124",
   "en": "Little help here!",
   "ro": "Un pic de ajutor aici!"
  },
  {
   "key": "1822649939762208772",
   "en": "'Ey!",
   "ro": "Hei!"
  },
  {
   "key": "1822649939778985988",
   "en": "Fuck off!",
   "ro": "Du-te dracu'!"
  },
  {
   "key": "1822649939812540420",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1822649939846094852",
   "en": "Mhm... yeah, I'll see... mhm, I dunno... mhm... All right, mom...",
   "ro": "Mhm... da, o să văd... mhm, nu știu... mhm... Bine, mamă..."
  },
  {
   "key": "1822649939862872068",
   "en": "What...? Hard to say... this week for sure…",
   "ro": "Ce...? Greu de spus... săptămâna asta sigur…"
  },
  {
   "key": "1822649939913203716",
   "en": "From the right!",
   "ro": "Din dreapta!"
  },
  {
   "key": "1822649939929980932",
   "en": "On my way!",
   "ro": "Vin!"
  },
  {
   "key": "1822649939963535364",
   "en": "Grenade!",
   "ro": "Granată!"
  },
  {
   "key": "1822649939980312580",
   "en": "See ya.",
   "ro": "Ne vedem."
  },
  {
   "key": "1822649939997089796",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1822649940047421444",
   "en": "You. Go on.",
   "ro": "Tu. Du-te."
  },
  {
   "key": "1822649940064198660",
   "en": "Let's check it out.",
   "ro": "Hai să verificăm."
  },
  {
   "key": "1822649940097753092",
   "en": "Go.",
   "ro": "Du-te."
  },
  {
   "key": "1822649940114530308",
   "en": "Give 'em hell!",
   "ro": "Fă-i praf!"
  },
  {
   "key": "1822649940148084740",
   "en": "Argh... lemme... go... echh... ech",
   "ro": "Argh... lasă-mă... să plec... echh... ech"
  },
  {
   "key": "1867654646108643328",
   "en": "Mhm... mhm... all right...",
   "ro": "Mhm... mhm... bine..."
  },
  {
   "key": "1959025482786709508",
   "en": "Hellooo? I'm talking to you!",
   "ro": "Alooo? Îți vorbesc!"
  },
  {
   "key": "1959025482837041156",
   "en": "This is your last chance, OK?",
   "ro": "Asta e ultima ta șansă, OK?"
  },
  {
   "key": "1959025482870595584",
   "en": "Come on, time's up.",
   "ro": "Hai, timpul a expirat."
  }
 ]
