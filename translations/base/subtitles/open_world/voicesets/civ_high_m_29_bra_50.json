{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_29_bra_50.json",
 "entries": [
  {
   "key": "1948848702717206532",
   "en": "Ugh, kids these days.",
   "ro": "Uf, tineretul din ziua de azi."
  },
  {
   "key": "1948848702733983748",
   "en": "How am I? Couldn't be better.",
   "ro": "Cum sunt? Nu se poate mai bine."
  },
  {
   "key": "1948848702784315396",
   "en": "I recommend you leave.",
   "ro": "Îți recomand să pleci."
  },
  {
   "key": "1948848702801092612",
   "en": "Listen to me, you gotta scram.",
   "ro": "Ascultă-mă, cară-te!"
  },
  {
   "key": "1948848702851424260",
   "en": "You're in trouble!",
   "ro": "Ești în pericol!"
  },
  {
   "key": "1948848702884978692",
   "en": "Put that away. Warning you.",
   "ro": "Pune aia la loc. Te avertizez."
  },
  {
   "key": "1948848702935310340",
   "en": "They will kill you. Not kidding.",
   "ro": "Te vor omorî. Nu glumesc."
  },
  {
   "key": "1948848702952087556",
   "en": "You don’t know what you're getting into!",
   "ro": "Nu știi în ce te bagi!"
  },
  {
   "key": "1948848703002419204",
   "en": "Thank God.",
   "ro": "Mulțumesc lui Dumnezeu."
  },
  {
   "key": "1948848703019196420",
   "en": "Oof! Heh, you scared me!",
   "ro": "Of! Hei, m-ai speriat!"
  },
  {
   "key": "1948848703069528068",
   "en": "Well, well!",
   "ro": "Ei, ei!"
  },
  {
   "key": "1948848703086305284",
   "en": "What could that be…",
   "ro": "Ce-o fi aia…"
  },
  {
   "key": "1948848703136636932",
   "en": "Must be nothing.",
   "ro": "Probabil nimic."
  },
  {
   "key": "1948848703153414148",
   "en": "All good.",
   "ro": "Totul bine."
  },
  {
   "key": "1948848703203745796",
   "en": "Don't hide!",
   "ro": "Nu te ascunde!"
  },
  {
   "key": "1948848703220523012",
   "en": "You'll be found!",
   "ro": "Te vor găsi!"
  },
  {
   "key": "1948848703270854660",
   "en": "Hey now! Careful!",
   "ro": "Hei, hei! Ai grijă!"
  },
  {
   "key": "1948848703287631876",
   "en": "Have some respect for your elders!",
   "ro": "Arată respect față de bătrâni!"
  },
  {
   "key": "1948848703321186308",
   "en": "Hey man! Long time!",
   "ro": "Hei, omule! De mult nu te-am mai văzut!"
  },
  {
   "key": "1948848703371517956",
   "en": "Ah, they finally got ya, huh…? Hehehe…! What to do, huh? Got what ya deserved!",
   "ro": "Ah, te-au prins până la urmă, nu? Hehehe…! Ce să-i faci? Ai primit ce meritai!"
  },
  {
   "key": "1948848703388295172",
   "en": "Uh, you I could help… If you didn't fuck me over that one time.. So you see… Not my problem!",
   "ro": "Ăă, pe tine te-aș fi putut ajuta… Dacă nu m-ai fi futut atunci… Așa că, vezi tu… Nu-i problema mea!"
  },
  {
   "key": "1948848703421849604",
   "en": "Karma.",
   "ro": "Karma."
  },
  {
   "key": "1948848703438626820",
   "en": "What was that?",
   "ro": "Ce-a fost asta?"
  },
  {
   "key": "1948848703891611652",
   "en": "Over here! Over here!",
   "ro": "Aici! Aici!"
  },
  {
   "key": "1948848703908388868",
   "en": "Security! Help!",
   "ro": "Securitate! Ajutor!"
  },
  {
   "key": "1948848704009052164",
   "en": "Jesus Christ!",
   "ro": "Doamne, Dumnezeule!"
  },
  {
   "key": "1948848704025829380",
   "en": "Terrorist!",
   "ro": "Terorist!"
  },
  {
   "key": "1948848704109715460",
   "en": "Please! I have kids!",
   "ro": "Te rog! Am copii!"
  },
  {
   "key": "1948848704126492676",
   "en": "How can you do this?!",
   "ro": "Cum poți să faci asta?!"
  },
  {
   "key": "1948848704227155968",
   "en": "You won't get anything out of me.",
   "ro": "Nu scoți nimic de la mine."
  },
  {
   "key": "1948848704260710404",
   "en": "Run away, snot-nosed little brat.",
   "ro": "Dispari, puștoaico năsoasă!",
   "ro_m": "Dispari, puștiule năsos!"
  }
 ]
}
