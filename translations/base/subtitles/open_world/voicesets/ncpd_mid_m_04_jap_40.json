{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_mid_m_04_jap_40.json",
 "entries": [
  {
   "key": "1856159278865850368",
   "en": "You look like the type to talk. C'mon. We'll make it worth your while.",
   "ro": "Arăți ca tipa care vorbește. Hai, că o să-ți fie și profitabil.",
   "ro_m": "Arăți ca tipul care vorbește. Hai, că o să-ți fie și profitabil."
  },
  {
   "key": "1856159278882627588",
   "en": "You're fuckin' scum.",
   "ro": "Ești o scursură nenorocită."
  },
  {
   "key": "1856159278932959236",
   "en": "Wrong way. Better turn around.",
   "ro": "Drum greșit. Mai bine întoarce-te."
  },
  {
   "key": "1856159278949736452",
   "en": "Move back, move along.",
   "ro": "Înapoi, mișcă-te."
  },
  {
   "key": "1856159279016845312",
   "en": "Tsk, tsk, tsk. You sure that's what you want?",
   "ro": "Tsk, tsk, tsk. Sigur asta vrei?"
  },
  {
   "key": "1856159279033622532",
   "en": "You know I'm a fuckin' badge, right?",
   "ro": "Știi că sunt un nenorocit de polițist, nu?"
  },
  {
   "key": "1856159279083954180",
   "en": "Watch it, gonk. No appeal if you're dead.",
   "ro": "Atenție, fraierule. Dacă mori, nu mai ai apel."
  },
  {
   "key": "1856159279117508612",
   "en": "Really wouldn't do that.",
   "ro": "Chiar nu aș face asta."
  },
  {
   "key": "1856159279167840260",
   "en": "Beat it.",
   "ro": "Cară-te!"
  },
  {
   "key": "1856159279184617476",
   "en": "See you.",
   "ro": "Ne vedem."
  },
  {
   "key": "1856159279234949124",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1856159279251726340",
   "en": "I'll take care of it.",
   "ro": "Mă ocup eu."
  },
  {
   "key": "1856159279302057988",
   "en": "False alarm.",
   "ro": "Alarmă falsă."
  },
  {
   "key": "1856159279335612420",
   "en": "No idea what it was.",
   "ro": "N-am idee ce era."
  },
  {
   "key": "1856159279385944068",
   "en": "Come out, come out wherever you are!",
   "ro": "Ieși, ieși, oriunde te-ai ascunde!"
  },
  {
   "key": "1856159279402721284",
   "en": "Listen, just give us a couple names and it won't be so bad.",
   "ro": "Ascultă, dă-ne și tu câteva nume și n-o să fie așa de rău."
  },
  {
   "key": "1856159279453052932",
   "en": "Got a stiff.",
   "ro": "Avem un cadavru."
  },
  {
   "key": "1856159279486607364",
   "en": "No problem. I'm on it.",
   "ro": "Nicio problemă. Mă ocup."
  },
  {
   "key": "1856159279553716228",
   "en": "You gotta problem now!",
   "ro": "Acum ai o problemă!"
  },
  {
   "key": "1856159279604047876",
   "en": "You comin' at a badge? A fuckin' badge?!",
   "ro": "Te pui cu un polițist? Cu un nenorocit de polițist?!"
  },
  {
   "key": "1856159279687933956",
   "en": "Grenade flying!",
   "ro": "Granată în aer!"
  },
  {
   "key": "1856159279771820036",
   "en": "Find cover!",
   "ro": "Găsește adăpost!"
  },
  {
   "key": "1856159279805374468",
   "en": "Don't lose your damn heads! Focus!",
   "ro": "Nu vă pierdeți capetele, fir-ar! Concentrare!"
  },
  {
   "key": "1856159279872483332",
   "en": "This fucking job.",
   "ro": "Treaba asta nenorocită."
  },
  {
   "key": "1856159279906037764",
   "en": "Yep, we're fucked.",
   "ro": "Da, ne-am futut."
  },
  {
   "key": "1856159279956369412",
   "en": "Fuck off.",
   "ro": "Du-te dracu'!"
  },
  {
   "key": "1856159279973146628",
   "en": "You wanna go downtown?",
   "ro": "Vrei să mergi în Downtown?"
  },
  {
   "key": "1856159280023478276",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1856159280073809924",
   "en": "Yeah...? Easy, easy... mhm... yeah…",
   "ro": "Da...? Ușor, ușor... mhm... da…"
  },
  {
   "key": "1856159280090587140",
   "en": "But how...? No, no way... fuck...",
   "ro": "Dar cum...? Nu, nicio șansă... futu-i..."
  },
  {
   "key": "1856159280140918788",
   "en": "Use your gonk brains!",
   "ro": "Folosiți-vă mintea de fraieri!"
  },
  {
   "key": "1856159280174473220",
   "en": "I'm on it!",
   "ro": "Mă ocup!"
  },
  {
   "key": "1856159280208027652",
   "en": "Get down!",
   "ro": "Jos!"
  },
  {
   "key": "1856159280241582084",
   "en": "Love you.",
   "ro": "Te iubesc."
  },
  {
   "key": "1856159280258359300",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1856159280308690948",
   "en": "Let's go.",
   "ro": "Hai să mergem."
  },
  {
   "key": "1856159280342245376",
   "en": "We better take care of it.",
   "ro": "Mai bine ne ocupăm de asta."
  },
  {
   "key": "1856159280375799812",
   "en": "You. Lead the way.",
   "ro": "Tu. Condu."
  },
  {
   "key": "1856159280392577028",
   "en": "Be cool, you shitheads!",
   "ro": "Stați calmi, căcaților!"
  },
  {
   "key": "1856159280426131460",
   "en": "Echhh... ech... argh...",
   "ro": "Echhh... ech... argh..."
  },
  {
   "key": "1867703230089666560",
   "en": "I'll be there... I'm tellin' you... don't worry...",
   "ro": "O să fiu acolo... îți spun... nu-ți face griji..."
  },
  {
   "key": "1867703674333569024",
   "en": "Listen, don't worry, I'll see you later...",
   "ro": "Ascultă, nu-ți face griji, ne vedem mai târziu..."
  }
 ]
