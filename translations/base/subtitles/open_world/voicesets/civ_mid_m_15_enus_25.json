{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_m_15_enus_25.json",
 "entries": [
  {
   "key": "1907009951450537988",
   "en": "Uh, hi?",
   "ro": "Uh, salut?"
  },
  {
   "key": "1907009951484092420",
   "en": "Yeah? There something you want?",
   "ro": "Da? Vrei ceva?"
  },
  {
   "key": "1907009951534424068",
   "en": "You're not welcome here. Goodbye.",
   "ro": "Nu ești binevenit aici. La revedere."
  },
  {
   "key": "1907009951567978500",
   "en": "Hey, you! Get out of here.",
   "ro": "Hei, tu! Ieși de aici."
  },
  {
   "key": "1907009951618310148",
   "en": "OK… Put that away, yeah?",
   "ro": "OK… Pune-o la loc, da?"
  },
  {
   "key": "1907009951651864580",
   "en": "That's not funny. Put it away!",
   "ro": "Nu e amuzant. Pune-o la loc!"
  },
  {
   "key": "1907009951718973444",
   "en": "Off you go before we have a problem.",
   "ro": "Hai, pleacă, înainte să avem probleme."
  },
  {
   "key": "1907009951752527876",
   "en": "Go, or you'll regret it!",
   "ro": "Pleacă, sau o să regreți!"
  },
  {
   "key": "1907009951802859524",
   "en": "Couldn'ta just left when I told you to?",
   "ro": "Nu puteai să pleci când ți-am zis?"
  },
  {
   "key": "1907009951836413956",
   "en": "This better be the last time!",
   "ro": "Mai bine să fie ultima dată!"
  },
  {
   "key": "1907009951903522820",
   "en": "Yeah. That's strange…",
   "ro": "Da. E ciudat…"
  },
  {
   "key": "1907009951937077252",
   "en": "Pff. Weird.",
   "ro": "Pff. Ciudat."
  },
  {
   "key": "1907009952004186116",
   "en": "She's gone.",
   "en_m": "He's gone.",
   "ro": "A plecat."
  },
  {
   "key": "1907009952037740544",
   "en": "Guess eveything's fine…",
   "ro": "Cred că totul e bine…"
  },
  {
   "key": "1907009952088072196",
   "en": "Hello? Someone here? 'S not funny!",
   "ro": "Alo? E cineva aici? Nu e amuzant!"
  },
  {
   "key": "1907009952104849412",
   "en": "Come out! I can hear you!",
   "ro": "Ieși afară! Te aud!"
  },
  {
   "key": "1907009952171958276",
   "en": "What're you doing?!",
   "ro": "Ce faci?!"
  },
  {
   "key": "1907009952188735492",
   "en": "Hey! Hey!!",
   "ro": "Hei! Hei!!"
  },
  {
   "key": "1907009952239067140",
   "en": "Hello? Yeah, I got a minute.",
   "ro": "Alo? Da, am un minut."
  },
  {
   "key": "1907009952306176004",
   "en": "She did what? Seriously?",
   "ro": "Ea a făcut ce? Serios?"
  },
  {
   "key": "1907009952339730436",
   "en": "Uh-huh. Yeah, I mean, sure.",
   "ro": "Uh-huh. Da, adică, sigur."
  },
  {
   "key": "1907009952390062084",
   "en": "OK, gotta go. Bye.",
   "ro": "OK, trebuie să plec. Pa."
  },
  {
   "key": "1907009952406839300",
   "en": "What the hell?",
   "ro": "Ce naiba?"
  },
  {
   "key": "1907009952826269700",
   "en": "Over here! Shoot this creep!",
   "ro": "Aici! Împușcă nenorocitul ăsta!"
  },
  {
   "key": "1907009953010819076",
   "en": "Do something, for fuck's sake!",
   "ro": "Fă ceva, pula mea!"
  },
  {
   "key": "1907009953195368452",
   "en": "Psycho! She's a psycho!",
   "en_m": "Psycho! He's a psycho!",
   "ro": "Nebună! E nebună!",
   "ro_m": "Nebun! E nebun!"
  },
  {
   "key": "1907009953228922884",
   "en": "She'll kill us all!",
   "en_m": "He'll kill us all!",
   "ro": "Ea o să ne omoare pe toți!",
   "ro_m": "El o să ne omoare pe toți!"
  },
  {
   "key": "1907009953379917828",
   "en": "No, no… Please, no!",
   "ro": "Nu, nu… Te rog, nu!"
  },
  {
   "key": "1907009953447026692",
   "en": "Fuck, not me, please!",
   "ro": "Futu-i, nu eu, te rog!"
  },
  {
   "key": "1907009953614798852",
   "en": "Do I look like a fuckin' tour guide?",
   "ro": "Arăt ca un nenorocit de ghid turistic?"
  },
  {
   "key": "1907009953648353284",
   "en": "Stop fucking following me!",
   "ro": "Nu mă mai urmări, pula mea!"
  }
 ]
}
