 "entries": [
  {
   "key": "1955987297580130308",
   "en": "Don't talk to me!",
   "ro": "Nu-mi vorbi!"
  },
  {
   "key": "1955987297596907524",
   "en": "Just one of those days…!",
   "ro": "Una din zilele alea…!"
  },
  {
   "key": "1955987297647239172",
   "en": "You blind or what?!",
   "ro": "Ești oarbă sau ce?!",
   "ro_m": "Ești orb sau ce?!"
  },
  {
   "key": "1955987297664016388",
   "en": "Stay out of the way!",
   "ro": "Dă-te la o parte!"
  },
  {
   "key": "1955987297697570820",
   "en": "But why…?",
   "ro": "Dar de ce…?"
  },
  {
   "key": "1955987297747902468",
   "en": "You can't…! You promised…! Without you… Are you joking…? But… But you… We…",
   "ro": "Nu poți…! Ai promis…! Fără tine… Glumești…? Dar… Dar tu… Noi…"
  },
  {
   "key": "1955987297764679684",
   "en": "I fucking love you, that's why…! Is it that hard to understand…? Wait what…? You're lying!",
   "ro": "Te iubesc în pula mea, de-aia…! E așa greu de înțeles…? Ce…? Minți!"
  },
  {
   "key": "1955987297798234116",
   "en": "You fucker…!",
   "ro": "Nenorocitule…!"
  },
  {
   "key": "1955987297949229060",
   "en": "Help me!",
   "ro": "Ajută-mă!"
  },
  {
   "key": "1955987297982783488",
   "en": "Why…?",
   "ro": "De ce…?"
  },
  {
   "key": "1955987298100224004",
   "en": "Faster!",
   "ro": "Mai repede!"
  },
  {
   "key": "1955987298117001220",
   "en": "Just don't make it hurt!",
   "ro": "Nu mă face să sufăr!"
  },
  {
   "key": "1955987298200887300",
   "en": "Don't annoy me!",
   "ro": "Nu mă enerva!"
  },
  {
   "key": "1955987298217664516",
   "en": "Don't come any closer!",
   "ro": "Nu te apropia!"
  }
 ]
