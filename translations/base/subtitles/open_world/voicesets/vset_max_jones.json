{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\vset_max_jones.json",
 "entries": [
  {
   "key": "1965060343395229700",
   "en": "What a shitshow!",
   "ro": "Ce dezastru!"
  },
  {
   "key": "1965060343630110724",
   "en": "Looks like it's on.",
   "ro": "Se pare că a început."
  },
  {
   "key": "1965060343713996804",
   "en": "It's a grenade!",
   "ro": "E o granată!"
  },
  {
   "key": "1965060343814660100",
   "en": "Blow me, assholes!",
   "ro": "Sugeți-o, nesimțiților!"
  },
  {
   "key": "1965060343864991744",
   "en": "Cocksuckers!",
   "ro": "Sugători de pule!"
  },
  {
   "key": "1965060343982432260",
   "en": "Least I'll go down fighting.",
   "ro": "Măcar mor luptând."
  },
  {
   "key": "1965060344049541124",
   "en": "Screw all of this!",
   "ro": "La naiba cu tot!"
  },
  {
   "key": "1965060344133427204",
   "en": "Eat shit!",
   "ro": "Sugi pula!"
  },
  {
   "key": "1965060344200536068",
   "en": "I... I don't feel – I'm not afraid!",
   "ro": "Eu... nu simt – nu mi-e frică!"
  },
  {
   "key": "1965060344284422144",
   "en": "Arghh...khe... stop... fuck...",
   "ro": "Arghh... khe... stop... futu-i..."
  },
  {
   "key": "1965060344905179140",
   "en": "I'm talking to you.",
   "ro": "Cu tine vorbesc."
  },
  {
   "key": "1965060344989065216",
   "en": "What now?",
   "ro": "Ce acum?"
  },
  {
   "key": "1965060345173614592",
   "en": "Everything all right?",
   "ro": "E totul bine?"
  },
  {
   "key": "1965060345240723460",
   "en": "OK, let's finish this up.",
   "ro": "OK, hai să terminăm."
  },
  {
   "key": "1965060345307832324",
   "en": "Come on, don't have all day.",
   "ro": "Hai, nu am toată ziua."
  },
  {
   "key": "1965060345358163972",
   "en": "You always take this long to make up your mind?",
   "ro": "Mereu îți ia atât de mult să te hotărăști?"
  },
  {
   "key": "1965060345928589312",
   "en": "Well, we've said all we needed to say.",
   "ro": "Ei bine, am spus tot ce trebuia."
  },
  {
   "key": "1965060345978920964",
   "en": "You go handle your stuff, OK?",
   "ro": "Du-te și rezolvă-ți treburile, OK?"
  },
  {
   "key": "1965060346448683012",
   "en": "Hey!",
   "ro": "Hei!"
  },
  {
   "key": "1965060346566123520",
   "en": "Watch where you're goin'.",
   "ro": "Uită-te pe unde mergi."
  }
 ]
