{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_m_97_chn_30.json",
 "entries": [
  {
   "key": "1922689537169432576",
   "en": "Hasn't rained in a while.",
   "ro": "N-a mai plouat de mult."
  },
  {
   "key": "1922689537186209796",
   "en": "This is pointless.",
   "ro": "E inutil."
  },
  {
   "key": "1922689537236541444",
   "en": "Spare me.",
   "ro": "Scutește-mă."
  },
  {
   "key": "1922689537270095876",
   "en": "And now this…!",
   "ro": "Și acum asta…!"
  },
  {
   "key": "1922689537303650308",
   "en": "Did you hear?",
   "ro": "Ai auzit?"
  },
  {
   "key": "1922689537353981956",
   "en": "Yes… I just can't breathe… It's coming… I'm telling you, this is the end… Yeah…",
   "ro": "Da… Nu mai pot respira… Vine… Îți spun, s-a sfârșit… Da…"
  },
  {
   "key": "1922689537370759172",
   "en": "We're ruined… Acid rain...? More like an A-bomb...",
   "ro": "Suntem ruinați… Ploaie acidă...? Mai degrabă o bombă atomică..."
  },
  {
   "key": "1922689537404313604",
   "en": "Later.",
   "ro": "Pe mai târziu."
  },
  {
   "key": "1922689537572085764",
   "en": "It's starting again!",
   "ro": "O ia de la capăt!"
  },
  {
   "key": "1922689537588862980",
   "en": "This is the end! The end!",
   "ro": "E sfârșitul! Sfârșitul!"
  },
  {
   "key": "1922689537672749060",
   "en": "I didn't get to say goodbye…!",
   "ro": "N-am apucat să-mi iau rămas bun…!"
  },
  {
   "key": "1922689537706303492",
   "en": "Let me live!",
   "ro": "Lasă-mă să trăiesc!"
  },
  {
   "key": "1922689537790189572",
   "en": "You're wasting time.",
   "ro": "Pierzi vremea."
  },
  {
   "key": "1922689537823744004",
   "en": "Got no money or nothing.",
   "ro": "N-am bani, nimic."
  }
 ]
}
