{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_f_15_chn_30.json",
 "entries": [
  {
   "key": "1953219305930792964",
   "en": "Another face in the crowd.",
   "ro": "Încă o față în mulțime."
  },
  {
   "key": "1953219305947570180",
   "en": "Where is this all going?",
   "ro": "Încotro se îndreaptă toate astea?"
  },
  {
   "key": "1953219305997901828",
   "en": "This is no place for you.",
   "ro": "Aici nu e locul tău."
  },
  {
   "key": "1953219306014679044",
   "en": "You must leave.",
   "ro": "Trebuie să pleci."
  },
  {
   "key": "1953219306065010692",
   "en": "You cannot!",
   "ro": "Nu poți!"
  },
  {
   "key": "1953219306081787908",
   "en": "Someone will get hurt!",
   "ro": "O să se rănească cineva!"
  },
  {
   "key": "1953219306132119556",
   "en": "This may end badly!",
   "ro": "S-ar putea să se termine prost!"
  },
  {
   "key": "1953219306148896772",
   "en": "You will die here!",
   "ro": "O să mori aici!"
  },
  {
   "key": "1953219306199228420",
   "en": "Very good. That's right.",
   "ro": "Foarte bine. Așa e."
  },
  {
   "key": "1953219306216005636",
   "en": "Force never solves anything.",
   "ro": "Forța nu rezolvă niciodată nimic."
  },
  {
   "key": "1953219306266337284",
   "en": "Oh my goodness…!",
   "ro": "Vai de mine…!"
  },
  {
   "key": "1953219306283114500",
   "en": "There are more things in heaven and Earth…",
   "ro": "Sunt mai multe lucruri în cer și pe pământ…"
  },
  {
   "key": "1953219306333446148",
   "en": "She ran away. Or maybe she was never here…?",
   "en_m": "He ran away. Or maybe he was never here…?",
   "ro": "Ea a fugit. Sau poate n-a fost niciodată aici…?",
   "ro_m": "El a fugit. Sau poate n-a fost niciodată aici…?"
  },
  {
   "key": "1953219306350223364",
   "en": "Must be my imagination.",
   "ro": "Trebuie să fie imaginația mea."
  },
  {
   "key": "1953219306400555012",
   "en": "You are here. I can feel you.",
   "ro": "Ești aici. Te simt."
  },
  {
   "key": "1953219306417332228",
   "en": "I will find you.",
   "ro": "O să te găsesc."
  },
  {
   "key": "1953219306467663876",
   "en": "What's your hurry?",
   "ro": "Ce te grăbești?"
  },
  {
   "key": "1953219306484441092",
   "en": "Slow down please!",
   "ro": "Încetinește, te rog!"
  },
  {
   "key": "1953219306517995524",
   "en": "I told you, I will make it.",
   "ro": "Ți-am spus, o să reușesc."
  },
  {
   "key": "1953219306568327172",
   "en": "That is what I mean… Inspiration comes and goes… Mhm… Exactly… Oh, certainly.",
   "ro": "Asta vreau să spun… Inspirația vine și pleacă… Mhm… Exact… Oh, sigur."
  },
  {
   "key": "1953219306585104388",
   "en": "Relax, I will write it… Yes… It is always this way, and I always manage… I promise.",
   "ro": "Relaxează-te, o să scriu… Da… Așa e mereu, și mereu mă descurc… Promit."
  },
  {
   "key": "1953219306618658820",
   "en": "I will be in touch.",
   "ro": "O să țin legătura."
  },
  {
   "key": "1953219306652213248",
   "en": "Inconceivable.",
   "ro": "De neconceput."
  },
  {
   "key": "1953219307004534788",
   "en": "Help! Over here!",
   "ro": "Ajutor! Aici!"
  },
  {
   "key": "1953219307021312004",
   "en": "Save me!",
   "ro": "Salvează-mă!"
  },
  {
   "key": "1953219307121975300",
   "en": "This is the end!",
   "ro": "Asta e sfârșitul!"
  },
  {
   "key": "1953219307138752516",
   "en": "We will all perish!",
   "ro": "O să pierim cu toții!"
  },
  {
   "key": "1953219307222638596",
   "en": "Have mercy on me!",
   "ro": "Ai milă de mine!"
  },
  {
   "key": "1953219307239415812",
   "en": "Why? What for?",
   "ro": "De ce? Pentru ce?"
  },
  {
   "key": "1953219307323301892",
   "en": "I don't need a shadow, thank you.",
   "ro": "Nu am nevoie de o umbră, mulțumesc."
  },
  {
   "key": "1953219307340079108",
   "en": "Get away from me. Please.",
   "ro": "Pleacă de lângă mine. Te rog."
  },
  {
   "key": "1958936728411611140",
   "en": "Why are you leaving?",
   "ro": "De ce pleci?"
  },
  {
   "key": "1958936728461942788",
   "en": "OK… back to business.",
   "ro": "OK… înapoi la treabă."
  },
  {
   "key": "1958936728495497220",
   "en": "Make your choice.",
   "ro": "Fă-ți alegerea."
  }
 ]
}
