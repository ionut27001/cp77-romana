{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_m_23_enus_40.json",
 "entries": [
  {
   "key": "1922847217330692100",
   "en": "What's the point?",
   "ro": "Care-i rostul?"
  },
  {
   "key": "1922847217364246532",
   "en": "There's a war coming. I know it.",
   "ro": "Vine un război. Știu."
  },
  {
   "key": "1922847217431355396",
   "en": "Hey!",
   "ro": "Hei!"
  },
  {
   "key": "1922847217448132612",
   "en": "You in a hurry?",
   "ro": "Te grăbești?"
  },
  {
   "key": "1922847217498464260",
   "en": "It's me. Got a minute?",
   "ro": "Sunt eu. Ai un minut?"
  },
  {
   "key": "1922847217582350340",
   "en": "I think so… Should we get outta here…? Dunno… Europe?",
   "ro": "Cred că da… Ar trebui să plecăm de aici…? Nu știu… Europa?"
  },
  {
   "key": "1922847217615904772",
   "en": "Anywhere but here… We're gonna die here… No.. I'm not exaggerating… Please.",
   "ro": "Oriunde, numai nu aici… O să murim aici… Nu… nu exagerez… Te rog."
  },
  {
   "key": "1922847217666236416",
   "en": "Just think about it, OK? Bye.",
   "ro": "Gândește-te la asta, OK? Pa."
  },
  {
   "key": "1922847217834008580",
   "en": "I knew it… Knew it!",
   "ro": "Știam… Știam!"
  },
  {
   "key": "1922847217850785796",
   "en": "We're all gonna die!",
   "ro": "O să murim cu toții!"
  },
  {
   "key": "1922847217968226308",
   "en": "Th-think a little!",
   "ro": "G-gândește-te puțin!"
  },
  {
   "key": "1922847218001780740",
   "en": "This what they want?!",
   "ro": "Asta vor?!"
  },
  {
   "key": "1922847218169552896",
   "en": "Look, I got nothing with you. So just go away.",
   "ro": "Uite, n-am nimic cu tine. Deci cară-te."
  },
  {
   "key": "1922847218203107328",
   "en": "Jeez, leave me alone. Jackass.",
   "ro": "Doamne… lasă-mă în pace. Boule."
  }
 ]
}
