{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_m_64_jap_30.json",
 "entries": [
  {
   "key": "1907029693838139396",
   "en": "What's your problem?",
   "ro": "Ce problemă ai?"
  },
  {
   "key": "1907029693854916612",
   "en": "Pleasure is mine.",
   "ro": "Plăcerea e de partea mea."
  },
  {
   "key": "1907029693922025476",
   "en": "Leave this place. Now!",
   "ro": "Pleacă de aici. Acum!"
  },
  {
   "key": "1907029693955579908",
   "en": "Do you have an entrance pass? No? Then goodbye.",
   "ro": "Ai bilet de intrare? Nu? Atunci, la revedere."
  },
  {
   "key": "1907029694022688772",
   "en": "Holster your weapon before you make a mistake.",
   "ro": "Pune-ți arma în toc înainte să faci o greșeală."
  },
  {
   "key": "1907029694039465988",
   "en": "Let's not escalate. Lower your weapon.",
   "ro": "Hai să nu escaladăm. Pune arma jos."
  },
  {
   "key": "1907029694089797636",
   "en": "Go, or they will kill you.",
   "ro": "Pleacă, sau te vor omorî."
  },
  {
   "key": "1907029694123352068",
   "en": "Say goodbye.",
   "ro": "Spune la revedere."
  },
  {
   "key": "1907029694173683716",
   "en": "I am glad we solved this without unpleasantries.",
   "ro": "Mă bucur că am rezolvat fără neplăceri."
  },
  {
   "key": "1907029694207238148",
   "en": "You are reasonable.",
   "ro": "Ești rezonabilă.",
   "ro_m": "Ești rezonabil."
  },
  {
   "key": "1907029694257569796",
   "en": "Hm? What's this?",
   "ro": "Hm? Ce-i asta?"
  },
  {
   "key": "1907029694291124228",
   "en": "That's strange…",
   "ro": "Ciudat…"
  },
  {
   "key": "1907029694358233092",
   "en": "Ugh… not worth it.",
   "ro": "Ugh… nu merită."
  },
  {
   "key": "1907029694391787524",
   "en": "That’s about it.",
   "ro": "Cam asta e."
  },
  {
   "key": "1907029694475673604",
   "en": "Hello... ? Hello!",
   "ro": "Alo... ? Alo!"
  },
  {
   "key": "1907029694509228036",
   "en": "Will you come out? Or do I call security to dig you out?",
   "ro": "Ieși sau chem securitatea să te scoată de-acolo?"
  },
  {
   "key": "1907029694576336900",
   "en": "This is a travesty!",
   "ro": "E o batjocură!"
  },
  {
   "key": "1907029694609891332",
   "en": "This is too much!",
   "ro": "E prea mult!"
  },
  {
   "key": "1907029694660222980",
   "en": "I can talk.",
   "ro": "Pot să vorbesc."
  },
  {
   "key": "1907029694744109060",
   "en": "Yes, was to be expected.",
   "ro": "Da, era de așteptat."
  },
  {
   "key": "1907029694777663492",
   "en": "I will send you the file when I get home.",
   "ro": "Îți trimit fișierul când ajung acasă."
  },
  {
   "key": "1907029694827995140",
   "en": "<kiroshi l=\"jpn\" o=\"さよなら\" t=\"Goodbye.\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"jpn\" o=\"さよなら\" t=\"La revedere.\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1907029694844772356",
   "en": "Hm? But… Who?",
   "ro": "Hm? Dar… Cine?"
  },
  {
   "key": "1907029695280979972",
   "en": "Security! Security to me!",
   "ro": "Securitate! Securitate la mine!"
  },
  {
   "key": "1907029695314534404",
   "en": "Code red! Code red!",
   "ro": "Cod roșu! Cod roșu!"
  },
  {
   "key": "1907029695431974916",
   "en": "This is the end!",
   "ro": "Asta e sfârșitul!"
  },
  {
   "key": "1907029695465529348",
   "en": "Noooo! Oh gods!",
   "ro": "Nuuu! O, zeilor!"
  },
  {
   "key": "1907029695599747076",
   "en": "Don't hurt me!",
   "ro": "Nu mă răni!"
  },
  {
   "key": "1907029695633301504",
   "en": "Kill the others and spare me!",
   "ro": "Omoară-i pe ceilalți și cruță-mă!"
  },
  {
   "key": "1907029695750742020",
   "en": "You're invading my personal space.",
   "ro": "Îmi invadezi spațiul personal."
  },
  {
   "key": "1907029695784296448",
   "en": "Please leave me in peace.",
   "ro": "Lasă-mă în pace, te rog."
  }
 ]
}
