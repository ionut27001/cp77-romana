   "en": "Out of my sight.",
   "ro": "Dispari din fața mea."
  },
  {
   "key": "1912499198878031876",
   "en": "Halt! Who's there!",
   "ro": "Stai! Cine e acolo!"
  },
  {
   "key": "1912499198894809092",
   "en": "I've got this.",
   "ro": "Mă ocup eu."
  },
  {
   "key": "1912499198978695168",
   "en": "I got nothing.",
   "ro": "N-am nimic."
  },
  {
   "key": "1912499199012249604",
   "en": "No threat detected.",
   "ro": "Nicio amenințare detectată."
  },
  {
   "key": "1912499199096135684",
   "en": "I'll piss on your grave when this is over!",
   "ro": "O să-ți pisez pe mormânt când se termină!"
  },
  {
   "key": "1912499199112912900",
   "en": "Hellooooo? Where are youuuu?",
   "ro": "Halloooo? Unde eștiuuu?"
  },
  {
   "key": "1912499199163244548",
   "en": "I think it's one of ours!",
   "ro": "Cred că e unul de-al nostru!"
  },
  {
   "key": "1912499199196798980",
   "en": "Understood.",
   "ro": "Înțeles."
  },
  {
   "key": "1912499199263907844",
   "en": "Shoot!",
   "ro": "Trage!"
  },
  {
   "key": "1912499199280685060",
   "en": "Enemy contact! I'm engaging!",
   "ro": "Contact inamic! Mă angajez!"
  },
  {
   "key": "1912499199331016708",
   "en": "Frag out!",
   "ro": "Grenadă!"
  },
  {
   "key": "1912499199398125572",
   "en": "Neutralize the target!",
   "ro": "Neutralizați ținta!"
  },
  {
   "key": "1912499199431680004",
   "en": "Open fire!",
   "ro": "Deschideți focul!"
  },
  {
   "key": "1912499199498788868",
   "en": "She's chipped!",
