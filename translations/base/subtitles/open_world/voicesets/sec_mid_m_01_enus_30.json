   "ro": "E cipată!",
   "ro_m": "E cipat!"
  },
  {
   "key": "1912499199515566084",
   "en": "I need backup!",
   "ro": "Am nevoie de întăriri!"
  },
  {
   "key": "1912499199582674948",
   "en": "Back up, lady.",
   "en_m": "Back it up, man.",
   "ro": "Dă-te înapoi, doamnă.",
   "ro_m": "Dă-te înapoi, băiete."
  },
  {
   "key": "1912499199616229376",
   "en": "Watch it.",
   "ro": "Atenție."
  },
  {
   "key": "1912499199649783812",
   "en": "Yes?",
   "ro": "Da?"
  },
  {
   "key": "1912499199750447108",
   "en": "Uh-huh… Please explain exactly why… Why the badges will be guarding the perimeter?",
   "ro": "Explică exact de ce… De ce o să păzească polițaii perimetrul?"
  },
  {
   "key": "1912499199784001540",
   "en": "OK, but I want to lead the mission myself.",
   "ro": "OK, dar vreau eu să conduc misiunea."
  },
  {
   "key": "1912499199851110404",
   "en": "Together!",
   "ro": "Împreună!"
  },
  {
