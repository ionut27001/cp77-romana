   "ro": "Arma jos, sau trag!"
  },
  {
   "key": "1912499198626373636",
   "en": "You're asking for trouble.",
   "ro": "Cauți necazuri."
  },
  {
   "key": "1912499198693482500",
   "en": "This will end badly for you.",
   "ro": "Se va termina prost pentru tine."
  },
  {
   "key": "1912499198727036932",
   "en": "Very unwise.",
   "ro": "Foarte neînțelept."
  },
  {
   "key": "1912499198794145796",
   "en": "Get moving.",
   "ro": "Mișcă-te."
  },
  {
