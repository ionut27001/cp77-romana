  },
  {
   "key": "2233834383378391040",
   "en": "It wasn't me. At ease and spread out.",
   "ro": "Nu eu am fost. La odihnă și răspândiți-vă."
  },
  {
   "key": "2233834383512608772",
   "en": "Damn it, we're exposed!",
   "ro": "La naiba, suntem expuși!"
