  {
   "key": "1912499199951773700",
   "en": "Get down!",
   "ro": "Jos!"
  },
  {
   "key": "1912499199985328128",
   "en": "Yes, I will.",
   "ro": "Da, o să."
  },
  {
   "key": "1912499200018882564",
   "en": "Commencing patrol.",
   "ro": "Încep patrularea."
  },
  {
   "key": "1912499200102768644",
   "en": "Psst. Safety off.",
   "ro": "Psst. Siguranța scoasă."
  },
  {
   "key": "1912499200136323076",
   "en": "Shh… Shoot at will.",
   "ro": "Șșș… Trageți la discreție."
  },
  {
   "key": "1912499200186654724",
   "en": "Go there.",
   "ro": "Du-te acolo."
  },
  {
   "key": "1912499200220209156",
   "en": "Go! Go! Go!",
   "ro": "Hai! Hai! Hai!"
  },
  {
   "key": "1912499200270540804",
   "en": "Ekhh… ghh… I'm corporation… idiot….",
   "ro": "Ekhh… ghh… Sunt corporatist… idiot…."
  },
  {
   "key": "1912514399924920320",
   "en": "I'd rather use my own guys… OK, I see.",
   "ro": "Aș prefera să-mi folosesc oamenii… OK, am înțeles."
  },
  {
   "key": "1912514691328385024",
   "en": "It'll be better that way, trust me… Of course it'll be on the down-low… Mm.",
   "ro": "Așa o să fie mai bine, ai încredere… Sigur că o să fie pe ascuns… Mm."
  },
  {
   "key": "1958947896232550404",
   "en": "Hey, I wasn't finished...",
   "ro": "Hei, nu terminasem…"
  },
  {
   "key": "1958947896299659268",
   "en": "You ready to hear me out now?",
   "ro": "Ești gata să mă asculți acum?"
  },
  {
   "key": "1958947896316436484",
   "en": "Ahe-he-he-hem!",
   "ro": "Ahe-he-he-hem!"
  },
  {
   "key": "2233834383059623940",
   "en": "Unit down!",
   "ro": "Unitate doborâtă!"
  },
  {
