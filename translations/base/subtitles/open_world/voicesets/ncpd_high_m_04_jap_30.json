{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_high_m_04_jap_30.json",
 "entries": [
  {
   "key": "1856002170943037444",
   "en": "I got the authority here, choom.",
   "ro": "Am autoritatea aici, choom."
  },
  {
   "key": "1856002170959814660",
   "en": "Beat it.",
   "ro": "Cară-te!"
  },
  {
   "key": "1856002171010146308",
   "en": "Back it up.",
   "ro": "Dă-te înapoi."
  },
  {
   "key": "1856002171026923524",
   "en": "You made a mistake.",
   "ro": "Ai făcut o greșeală."
  },
  {
   "key": "1856002171060477956",
   "en": "Got her weapon drawn.",
   "en_m": "Got his weapon drawn.",
   "ro": "Are arma scoasă."
  },
  {
   "key": "1856002171077255172",
   "en": "All that showing off won't end well.",
   "ro": "Cu fițele astea o să sfârșești prost."
  },
  {
   "key": "1856002171127586820",
   "en": "I'm not gonna repeat myself.",
   "ro": "Nu mai zic o dată."
  },
  {
   "key": "1856002171144364036",
   "en": "You're gonna regret it.",
   "ro": "O să regreți."
  },
  {
   "key": "1856002171194695684",
   "en": "Fun's over.",
   "ro": "Gata cu distracția."
  },
  {
   "key": "1856002171211472900",
   "en": "Yeah, see ya.",
   "ro": "Da, ne vedem."
  },
  {
   "key": "1856002171245027332",
   "en": "Initiating police action.",
   "ro": "Inițiez acțiune polițienească."
  },
  {
   "key": "1856002171261804548",
   "en": "Hello? Anyone there?",
   "ro": "Alo? E cineva acolo?"
  },
  {
   "key": "1856002171312136196",
   "en": "Nothing suspicious.",
   "ro": "Nimic suspect."
  },
  {
   "key": "1856002171328913412",
   "en": "All checked out.",
   "ro": "Totul e în regulă."
  },
  {
   "key": "1856002171379245060",
   "en": "Come out with your hands up!",
   "ro": "Ieși cu mâinile sus!"
  },
  {
   "key": "1856002171379245076",
   "en": "Toss your weapon and come out!",
   "ro": "Aruncă arma și ieși!"
  },
  {
   "key": "1856002171412799492",
   "en": "We got a problem!",
   "ro": "Avem o problemă!"
  },
  {
   "key": "1856002171446353920",
   "en": "Understood.",
   "ro": "Înțeles."
  },
  {
   "key": "1856002171479908356",
   "en": "ID-ed the suspect!",
   "ro": "Am identificat suspecta!",
   "ro_m": "Am identificat suspectul!"
  },
  {
   "key": "1856002171513462788",
   "en": "Neutralizing the threat!",
   "ro": "Neutralizez amenințarea!"
  },
  {
   "key": "1856002171530240004",
   "en": "Here she goes!",
   "ro": "Iată-o!"
  },
  {
   "key": "1856002171580571652",
   "en": "Heads down!",
   "ro": "Capetele jos!"
  },
  {
   "key": "1856002171597348868",
   "en": "There will be no negotiation.",
   "ro": "Nu va exista nicio negociere."
  },
  {
   "key": "1856002171647680516",
   "en": "I'm hit!",
   "ro": "Sunt lovită!",
   "ro_m": "Sunt lovit!"
  },
  {
   "key": "1856002171664457732",
   "en": "Fucking hell!",
   "ro": "Pula mea!"
  },
  {
   "key": "1856002171714789380",
   "en": "Better not do that again.",
   "ro": "Mai bine nu mai faci asta."
  },
  {
   "key": "1856002171731566596",
   "en": "You're playing with fire.",
   "ro": "Te joci cu focul."
  },
  {
   "key": "1856002171765121028",
   "en": "Copy.",
   "ro": "Am înțeles."
  },
  {
   "key": "1856002171798675460",
   "en": "No... I'm serious, I can't... Kowalski's closer anyway...",
   "ro": "Nu... pe bune, nu pot... Kowalski e mai aproape oricum..."
  },
  {
   "key": "1856002171832229892",
   "en": "Had to go in there swingin'... All in the system…",
   "ro": "Trebuia să intrăm acolo cu pumnii la bătaie... Totul e trecut în sistem…"
  },
  {
   "key": "1856002171882561540",
   "en": "Both sides! Go! Now!",
   "ro": "Ambele părți! Mergeți! Acum!"
  },
  {
   "key": "1856002171916115972",
   "en": "I'm going flank!",
   "ro": "Mă duc pe flanc!"
  },
  {
   "key": "1856002171932893188",
   "en": "Watch out!",
   "ro": "Atenție!"
  },
  {
   "key": "1856002171966447616",
   "en": "10-4.",
   "ro": "10-4."
  },
  {
   "key": "1856002171983224836",
   "en": "Initiating intervention.",
   "ro": "Inițiez intervenția."
  },
  {
   "key": "1856002172016779268",
   "en": "Go, go, move it!",
   "ro": "Hai, hai, mișcați-vă!"
  },
  {
   "key": "1856002172033556484",
   "en": "Gotta check it out.",
   "ro": "Trebuie să verific."
  },
  {
   "key": "1856002172067110916",
   "en": "Right behind you.",
   "ro": "Sunt chiar în spatele tău."
  },
  {
   "key": "1856002172083888132",
   "en": "Cover fire!",
   "ro": "Foc de acoperire!"
  },
  {
   "key": "1856002172117442564",
   "en": "Argh... let go... ech... ech... lemme...",
   "ro": "Argh... dă drumul... ech... ech... lasă-mă..."
  },
  {
   "key": "1867748455995793408",
   "en": "Nah, did it so we didn't need to file any report...",
   "ro": "Nah, am făcut-o ca să nu mai scriem niciun raport..."
  }
 ]
}
