{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_f_21_enus_25.json",
 "entries": [
  {
   "key": "1922797621346836484",
   "en": "OK... what do you want?",
   "ro": "OK... ce vrei?"
  },
  {
   "key": "1922797621380390916",
   "en": "Look, uh, I-I'm waiting for a friend.",
   "ro": "Uite, uh, a-aștept un prieten."
  },
  {
   "key": "1922797621464276996",
   "en": "Quit sniffing around. Scram!",
   "ro": "Nu mai băga nasul. Cară-te!"
  },
  {
   "key": "1922797621497831424",
   "en": "This is private property. Get out!",
   "ro": "Asta e proprietate privată. Ieși afară!"
  },
  {
   "key": "1922797621581717508",
   "en": "You think this is funny? Put that away!",
   "ro": "Ți se pare amuzant? Pune-o la loc!"
  },
  {
   "key": "1922797621615271936",
   "en": "Don't threaten me. Understand?",
   "ro": "Nu mă amenința. Ai înțeles?"
  },
  {
   "key": "1922797621665603588",
   "en": "Should I call security?",
   "ro": "Să chem securitatea?"
  },
  {
   "key": "1922797621699158020",
   "en": "I'll scream. I'm serious.",
   "ro": "O să țip. Sunt serioasă."
  },
  {
   "key": "1922797621766266884",
   "en": "Well. Looks like you got wise.",
   "ro": "Ei bine. Se pare că te-ai prins."
  },
  {
   "key": "1922797621783044100",
   "en": "Yeah, nice. You're making steps.",
   "ro": "Da, frumos. Faci progrese."
  },
  {
   "key": "1922797621850152960",
   "en": "Huh… That's weird…",
   "ro": "Huh… Ciudat…"
  },
  {
   "key": "1922797621883707396",
   "en": "Funny…",
   "ro": "Amuzant…"
  },
  {
   "key": "1922797621934039044",
   "en": "Ehh... back to normal...",
   "ro": "Ehh... înapoi la normal..."
  },
  {
   "key": "1922797621967593476",
   "en": "Awww, fuck it.",
   "ro": "Awww, dă-o dracu'."
  },
  {
   "key": "1922797622034702340",
   "en": "Hello? Hello!",
   "ro": "Alo? Alo!"
  },
  {
   "key": "1922797622068256772",
   "en": "I'll call security! Come out!",
   "ro": "Chem securitatea! Ieși afară!"
  },
  {
   "key": "1922797622118588420",
   "en": "What's your problem?!",
   "ro": "Ce problemă ai?!"
  },
  {
   "key": "1922797622152142852",
   "en": "Not funny!",
   "ro": "Nu-i amuzant!"
  },
  {
   "key": "1922797622202474500",
   "en": "Ohh… Long time no speak!",
   "ro": "Ohh… De mult nu am mai vorbit!"
  },
  {
   "key": "1922797622269583364",
   "en": "We have to meet up. Uh, definitely!",
   "ro": "Trebuie să ne întâlnim. Uh, sigur!"
  },
  {
   "key": "1922797622286360580",
   "en": "Thursday, Friday, whatever works for you.",
   "ro": "Joi, vineri, ce ți se potrivește."
  },
  {
   "key": "1922797622353469440",
   "en": "See you soon! Bye!",
   "ro": "Ne vedem curând! Pa!"
  },
  {
   "key": "1922797622370246660",
   "en": "Oh boy…",
   "ro": "Oh, băiete…"
  },
  {
   "key": "1922797622789677060",
   "en": "Help! Over here!",
   "ro": "Ajutor! Aici!"
  },
  {
   "key": "1922797622823231492",
   "en": "Emergency! Here!",
   "ro": "Urgență! Aici!"
  },
  {
   "key": "1922797622940672004",
   "en": "Oh Jesus! Oh Jesus Christ!",
   "ro": "Doamne! Doamne, Dumnezeule!"
  },
  {
   "key": "1922797622974226436",
   "en": "Nooooo!!",
   "ro": "Nuuuu!!"
  },
  {
   "key": "1922797623091666948",
   "en": "No… Not me… Not meeee…",
   "ro": "Nu… Nu eu… Nu euuu…"
  },
  {
   "key": "1922797623125221380",
   "en": "Go away! Leave me alone!!!",
   "ro": "Pleacă! Lasă-mă în pace!!!"
  },
  {
   "key": "1922797623225884676",
   "en": "Not interested!",
   "ro": "Nu mă interesează!"
  },
  {
   "key": "1922797623259439108",
   "en": "Not a step closer!",
   "ro": "Niciun pas mai aproape!"
  }
 ]
}
