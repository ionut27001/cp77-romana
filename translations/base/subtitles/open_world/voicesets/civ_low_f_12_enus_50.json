 "entries": [
  {
   "key": "1949175410862972932",
   "en": "It's hot today.",
   "ro": "E cald azi."
  },
  {
   "key": "1949175410879750148",
   "en": "What's your rush?",
   "ro": "Ce te grăbești?"
  },
  {
   "key": "1949175410930081796",
   "en": "Oh hell no!",
   "ro": "Oh, nici gând!"
  },
  {
   "key": "1949175410946859012",
   "en": "Watch yourself!",
   "ro": "Fii atent!"
  },
  {
   "key": "1949175410997190656",
   "en": "Hi, sweetie.",
   "ro": "Salut, dragă."
  },
  {
   "key": "1949175411047522308",
   "en": "Still in town… Uh-huh… S-sure…! Why not… Invite him.",
   "ro": "Tot în oraș… Aha… S-sigur…! De ce nu… Invită-l."
  },
  {
   "key": "1949175411064299524",
   "en": "He hasn't been in a while… Heard he's a hacker now…? Yeah, yeah, doesn't sound like him.",
   "ro": "N-a mai fost de mult… Am auzit că acum e hacker…? Da, da, nu-i el genul."
  },
  {
   "key": "1949175411114631172",
   "en": "We'll see!",
   "ro": "Vom vedea!"
  },
  {
   "key": "1949175411248848900",
   "en": "Help! Police!",
   "ro": "Ajutor! Poliția!"
  },
  {
   "key": "1949175411282403332",
   "en": "What should I do…?!",
   "ro": "Ce să fac…?!"
  },
  {
   "key": "1949175411366289412",
   "en": "Why…? Please…!",
   "ro": "De ce…? Te rog…!"
  },
  {
   "key": "1949175411383066628",
   "en": "I wanna go home!",
   "ro": "Vreau acasă!"
  },
  {
   "key": "1949175411466952708",
   "en": "Two steps back, all righty?",
   "ro": "Doi pași înapoi, bine?"
  },
  {
   "key": "1949175411483729924",
   "en": "Look, I don't want company.",
   "ro": "Uite, nu vreau companie."
  }
 ]
