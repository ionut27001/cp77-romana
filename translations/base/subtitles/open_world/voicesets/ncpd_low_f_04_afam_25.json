{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_low_f_04_afam_25.json",
 "entries": [
  {
   "key": "1863556358333915140",
   "en": "Don't distract me!",
   "ro": "Nu mă distrage!"
  },
  {
   "key": "1863556358350692356",
   "en": "Could arrest you at any moment!",
   "ro": "Te pot aresta oricând!"
  },
  {
   "key": "1863556358384246788",
   "en": "Where you goin'?! Huh, punk?",
   "ro": "Unde te duci?! Hei, golanule?"
  },
  {
   "key": "1863556358417801220",
   "en": "'Ey, 'ey, 'ey! The hell you doin'?",
   "ro": "Hei, hei, hei! Ce dracu' faci?"
  },
  {
   "key": "1863556358451355652",
   "en": "Gun on the ground! Now!",
   "ro": "Arma jos! Acum!"
  },
  {
   "key": "1863556358468132868",
   "en": "You wanna lose an arm?!",
   "ro": "Vrei să-ți pierzi un braț?!"
  },
  {
   "key": "1863556358518464516",
   "en": "This is your warning. Don't make me play bad cop.",
   "ro": "Ăsta e avertismentul. Nu mă obliga să joc polițistul rău."
  },
  {
   "key": "1863556358535241732",
   "en": "Nah, go 'head, provoke me...",
   "ro": "Nu, hai, provoacă-mă..."
  },
  {
   "key": "1863556358585573380",
   "en": "Lookin' for trouble, huh?",
   "ro": "Cauți necazuri, ha?"
  },
  {
   "key": "1863556358602350596",
   "en": "That's right, get gone.",
   "ro": "Așa e, cară-te."
  },
  {
   "key": "1863556358652682244",
   "en": "Now that ain't right...",
   "ro": "Asta nu-i în regulă..."
  },
  {
   "key": "1863556358669459460",
   "en": "Something's wrong here.",
   "ro": "Ceva nu-i în regulă aici."
  },
  {
   "key": "1863556358703013892",
   "en": "All right! All done.",
   "ro": "Bine! Gata!"
  },
  {
   "key": "1863556358719791108",
   "en": "That's that!",
   "ro": "Asta e tot!"
  },
  {
   "key": "1863556358770122756",
   "en": "Come on out! Out you come!",
   "ro": "Ieși afară! Ieși, hai!"
  },
  {
   "key": "1863556358786899972",
   "en": "Aaaugh! Where's the bitch at?!",
   "ro": "Aaaugh! Unde e cățea aia?!"
  },
  {
   "key": "1863556358820454404",
   "en": "Body! Got a body!",
   "ro": "Cadavru! Avem un cadavru!"
  },
  {
   "key": "1863556358854008836",
   "en": "Got it!",
   "ro": "Am înțeles!"
  },
  {
   "key": "1863556358887563268",
   "en": "Fuck! Bitch is on my ass!",
   "en_m": "Motherfucker's on my ass!",
   "ro": "Futu-i! Cățea aia e pe urmele mele!",
   "ro_m": "Futu-i! Nenorocitul ăla e pe urmele mele!"
  },
  {
   "key": "1863556358904340484",
   "en": "I'ma fuckin' wipe you!",
   "ro": "Te omor, pula mea!"
  },
  {
   "key": "1863556358937894916",
   "en": "Oooph!",
   "ro": "Oooph!"
  },
  {
   "key": "1863556358988226564",
   "en": "Not good! Not good!",
   "ro": "Nu-i bine! Nu-i bine!"
  },
  {
   "key": "1863556359005003780",
   "en": "Fucking firefights!",
   "ro": "Schimburi de focuri, pula mea!"
  },
  {
   "key": "1863556359038558212",
   "en": "Fuck! This shit ain't worth the pay!",
   "ro": "Futu-i! Porcăria asta nu merită banii!"
  },
  {
   "key": "1863556359055335428",
   "en": "Fucking fuck! I'm done!",
   "ro": "Futu-i, pula mea! Gata, m-am săturat!"
  },
  {
   "key": "1863556359105667076",
   "en": "'Ey!",
   "ro": "Hei!"
  },
  {
   "key": "1863556359122444292",
   "en": "What? Huh?!",
   "ro": "Ce? Ha?!"
  },
  {
   "key": "1863556359155998724",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1863556359206330372",
   "en": "I'm a finish up here, go back to base and deal with those reports...",
   "ro": "Termin aici, mă întorc la bază și mă ocup de rapoartele alea..."
  },
  {
   "key": "1863556359223107588",
   "en": "I know... Yeah, I saw... Can't do a damn thing...",
   "ro": "Știu... Da, am văzut... Nu pot face nimic, fir-ar..."
  },
  {
   "key": "1863556359256662020",
   "en": "Go right, go right!",
   "ro": "La dreapta, la dreapta!"
  },
  {
   "key": "1863556359306993668",
   "en": "All right!",
   "ro": "Bine!"
  },
  {
   "key": "1863556359340548100",
   "en": "Aaaaugh!",
   "ro": "Aaaaugh!"
  },
  {
   "key": "1863556359357325316",
   "en": "Bye.",
   "ro": "Pa."
  },
  {
   "key": "1863556359390879748",
   "en": "Don't like that one bit.",
   "ro": "Nu-mi place deloc."
  },
  {
   "key": "1863556359441211396",
   "en": "To work! Go, go, go!",
   "ro": "La treabă! Hai, hai, hai!"
  },
  {
   "key": "1863556359457988612",
   "en": "Get your shit together, let's go!",
   "ro": "Adună-te! Hai, mergem!"
  },
  {
   "key": "1863556359508320260",
   "en": "Search the area!",
   "ro": "Percheziționați zona!"
  },
  {
   "key": "1863556359525097476",
   "en": "Heads down!",
   "ro": "Capetele jos!"
  },
  {
   "key": "1863556359558651908",
   "en": "Argh... ech... ech... lemme... go...",
   "ro": "Argh... ech... ech... lasă-mă... să plec..."
  },
  {
   "key": "1867697874384052224",
   "en": "What're you gonna do... Mhm... Yeah, cause she's young... I know, I know...",
   "ro": "Ce-o să faci... Mhm... Da, pentru că e tânără... Știu, știu..."
  },
  {
   "key": "1867698198469533696",
   "en": "Ain't changin' anytime soon... I'm tellin ya...",
   "ro": "Nu se schimbă prea curând... Îți spun eu..."
  },
  {
   "key": "2235060783993200644",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "2235060784261636096",
   "en": "Fire!",
   "ro": "Foc!"
  },
  {
   "key": "2235060784395853824",
   "en": "We got a problem!",
   "ro": "Avem o problemă!"
  },
  {
   "key": "2235060784429408260",
   "en": "I'm blind!",
   "ro": "Sunt oarbă!"
  },
  {
   "key": "2235060784899170304",
   "en": "What? Bored already? Go on, beat's callin'!",
   "ro": "Ce? Te-ai plictisit deja? Hai, patrula te cheamă!"
  },
  {
   "key": "2235060785066942468",
   "en": "Fuck this job!",
   "ro": "Bag pula-n treaba asta!"
  },
  {
   "key": "2235060785150828548",
   "en": "Officers being downed! Jesus!",
   "ro": "Ofițeri doborâți! Doamne!"
  },
  {
   "key": "2235060785587036164",
   "en": "What yo murderin' bitch-ass waitin' for, huh?!",
   "ro": "Ce așteaptă cățea asta ucigașă, ha?!",
   "ro_m": "Ce așteaptă pizda asta ucigașă, ha?!"
  },
  {
   "key": "2235060785855471620",
   "en": "Suspect hit!",
   "ro": "Suspect lovit!"
  },
  {
   "key": "2235060785939357700",
   "en": "Got her! Knocked her flat!",
   "en_m": "Got him! Knocked him flat!",
   "ro": "Am prins-o! Am doborât-o!",
   "ro_m": "L-am prins! L-am doborât!"
  },
  {
   "key": "2235060786023243780",
   "en": "Surround the suspect!",
   "ro": "Înconjurați suspecta!",
   "ro_m": "Înconjurați suspectul!"
  },
  {
   "key": "2235060786241347588",
   "en": "She's barely standing! Keep the pressure up!",
   "en_m": "He's barely standing! Keep the pressure up!",
   "ro": "Abia mai stă în picioare! Țineți presiunea!"
  },
  {
   "key": "2235060786425896964",
   "en": "That's a copy!",
   "ro": "Primit!"
  },
  {
   "key": "2235060786543337476",
   "en": "It's too late! You're goin' down!",
   "ro": "E prea târziu! Cazi!"
  },
  {
   "key": "2235060786644000772",
   "en": "Gotta reload!",
   "ro": "Trebuie să reîncarc!"
  },
  {
   "key": "2235060786794995712",
   "en": "Fuck's wrong with you?!",
   "ro": "Ce dracu' ai, pula mea?!"
  },
  {
   "key": "2235060787063431172",
   "en": "Can't see nothin'!",
   "ro": "Nu văd nimic!"
  },
  {
   "key": "2235060787164094468",
   "en": "Look out! Suspect be hackin'!",
   "ro": "Atenție! Suspecta hackuiește!",
   "ro_m": "Atenție! Suspectul hackuiește!"
  },
  {
   "key": "2235060787281534980",
   "en": "Ugh! That's it?!",
   "ro": "Ugh! Asta e tot?!"
  },
  {
   "key": "2235060787382198276",
   "en": "Need that backup ASAP!",
   "ro": "Am nevoie de întăriri, urgent!"
  },
  {
   "key": "2235060787482861572",
   "en": "Moving to subdue!",
   "ro": "Mă apropii să o imobilizez!",
   "ro_m": "Mă apropii să îl imobilizez!"
  },
  {
   "key": "2235060787583524868",
   "en": "Got a shotgun!",
   "ro": "Am un shotgun!"
  },
  {
   "key": "2235060787684188164",
   "en": "Covering fire!",
   "ro": "Foc de acoperire!"
  },
  {
   "key": "2235060787784851460",
   "en": "Officer down! I repeat, officer down!",
   "ro": "Ofițer doborât! Repet, ofițer doborât!"
  }
 ]
}
