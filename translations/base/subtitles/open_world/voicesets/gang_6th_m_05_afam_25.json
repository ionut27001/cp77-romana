  },
  {
   "key": "1789912110295519236",
   "en": "Can't stand little scopshitters like you.",
   "ro": "Nu suport jeguri ca tine."
  },
  {
   "key": "1789912110345850884",
   "en": "What's this, huh?!",
   "ro": "Ce-i asta, ha?!"
  },
  {
   "key": "1789912110362628100",
