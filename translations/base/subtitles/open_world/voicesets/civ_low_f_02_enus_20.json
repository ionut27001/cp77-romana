{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_f_02_enus_20.json",
 "entries": [
  {
   "key": "1908037628542328832",
   "en": "Um, hi?",
   "ro": "Um, salut?"
  },
  {
   "key": "1908037628559106052",
   "en": "What're you staring at?",
   "ro": "La ce te uiți?"
  },
  {
   "key": "1908037628642992132",
   "en": "Hey, you! Get the fuck outta here!",
   "ro": "Hei, tu! Cară-te dracu' de-aici!"
  },
  {
   "key": "1908037628676546564",
   "en": "You lost or somethin'? Beat it!",
   "ro": "Te-ai rătăcit sau ceva? Valea!"
  },
  {
   "key": "1908037628726878212",
   "en": "Hey, hey, relax! Let's just put that away now...!",
   "ro": "Hei, hei, calmează-te! Lasă aia jos acum...!"
  },
  {
   "key": "1908037628760432644",
   "en": "What's the big deal? There's no need for that.",
   "ro": "Care-i faza? Nu e nevoie de asta."
  },
  {
   "key": "1908037628827541508",
   "en": "Get gone, or blood's gonna spill.",
   "ro": "Dispari, sau curge sânge."
  },
  {
   "key": "1908037628861095940",
   "en": "Run along, 'fore you catch lead. For real.",
   "ro": "Ia-o din loc, înainte să iei plumb. Pe bune."
  },
  {
   "key": "1908037628928204804",
   "en": "Ugh, just when I thought things'd get messy.",
   "ro": "Ugh, tocmai când credeam că se încinge."
  },
  {
   "key": "1908037628961759236",
   "en": "That's right, and don't come back!",
   "ro": "Așa e, și nu te mai întoarce!"
  },
  {
   "key": "1908037629045645312",
   "en": "Oh, shit...",
   "ro": "Oh, căcat..."
  },
  {
   "key": "1908037629079199748",
   "en": "The fuck's goin' on here?",
   "ro": "Ce căcat se întâmplă aici?"
  },
  {
   "key": "1908037629163085824",
   "en": "Eh, to hell with this.",
   "ro": "Eh, dracu' s-o ia."
  },
  {
   "key": "1908037629179863044",
   "en": "Waste o' my precious time.",
   "ro": "Pierdere de timp prețios."
  },
  {
   "key": "1908037629263749120",
   "en": "I must be imagining things...",
   "ro": "Trebuie că-mi imaginez lucruri..."
  },
  {
   "key": "1908037629297303552",
   "en": "How 'bout over here...",
   "ro": "Ce zici de aici..."
  },
  {
   "key": "1908037629381189636",
   "en": "What's your fuckin' problem?",
   "ro": "Care-i problema ta, dracu'?"
  },
  {
   "key": "1908037629414744068",
   "en": "Chill the fuck out!",
   "ro": "Calmează-te dracu'!"
  },
  {
   "key": "1908037629481852932",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1908037629532184580",
   "en": "I told you there'd be trouble, didn't I?",
   "ro": "Ți-am spus că va fi belea, nu?"
  },
  {
   "key": "1908037629565739012",
   "en": "'Cause you're fucking crazy, that's why!",
   "ro": "Pentru că ești nebun de-a binelea, de-aia!"
  },
  {
   "key": "1908037629632847876",
   "en": "Fine, later.",
   "ro": "Bine, mai târziu."
  },
  {
   "key": "1908037629649625092",
   "en": "What in the name of...?",
   "ro": "Ce naiba...?"
  },
  {
   "key": "1908037630085832708",
   "en": "Hey! Over here!",
   "ro": "Hei! Aici!"
  },
  {
   "key": "1908037630119387140",
   "en": "Do something!",
   "ro": "Fă ceva!"
  },
  {
   "key": "1908037630270382084",
   "en": "Fuck! Run!",
   "ro": "Futu-i! Fugi!"
  },
  {
   "key": "1908037630303936516",
   "en": "Shit! Make a run for it!",
   "ro": "Căcat! Fugi!"
  },
  {
   "key": "1908037630387822596",
   "en": "Please! I've got kids...!",
   "ro": "Te rog! Am copii...!"
  },
  {
   "key": "1908037630421377028",
   "en": "No, no, no! Please!",
   "ro": "Nu, nu, nu! Te rog!"
  },
  {
   "key": "1908037630505263108",
   "en": "Can you, like, fuck off?",
   "ro": "Poți să te cari, gen?"
  },
  {
   "key": "1908037630538817540",
   "en": "Stay back, OK?",
   "ro": "Stai în spate, OK?"
  },
  {
   "key": "1958907708508774404",
   "en": "There was something else...",
   "ro": "Mai era ceva..."
  },
  {
   "key": "1958907708559106052",
   "en": "OK, I really need to say this.",
   "ro": "OK, chiar trebuie să spun asta."
  },
  {
   "key": "1958907708575883268",
   "en": "No time to waste.",
   "ro": "N-avem timp de pierdut."
  }
 ]
}
