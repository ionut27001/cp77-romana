{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_scv_m_15_rus_25.json",
 "entries": [
  {
   "key": "1898244257637588996",
   "en": "I got no beef with you.",
   "ro": "Nu am nimic cu tine."
  },
  {
   "key": "1898244257654366212",
   "en": "What do YOU want?!",
   "ro": "Ce vrei tu?!"
  },
  {
   "key": "1898244257687920644",
   "en": "Leave us alone. Go away!",
   "ro": "Lăsați-ne în pace. Dispari!"
  },
  {
   "key": "1898244257721475076",
   "en": "Don't fuck around, man!",
   "ro": "Fără prostii, mă!"
  },
  {
   "key": "1898244257771806724",
   "en": "Put that away!",
   "ro": "Pune asta la loc!"
  },
  {
   "key": "1898244257805361156",
   "en": "You can't do that!",
   "ro": "Nu poți să faci asta!"
  },
  {
   "key": "1898244257855692804",
   "en": "What?",
   "ro": "Ce?"
  },
  {
   "key": "1898244257872470020",
   "en": "I'm talking to you!",
   "ro": "Cu tine vorbesc!"
  },
  {
   "key": "1898244257922801668",
   "en": "Just go away!",
   "ro": "Pleacă dracu'!"
  },
  {
   "key": "1898244257939578884",
   "en": "Leave me alone!",
   "ro": "Lasă-mă în pace!"
  },
  {
   "key": "1898244257973133316",
   "en": "Hello-oo! Who's there? Speak up!",
   "ro": "Alooo! Cine-i acolo? Vorbește!"
  },
  {
   "key": "1898244257989910532",
   "en": "What the fuck's going on?",
   "ro": "Ce pula mea se întâmplă?"
  },
  {
   "key": "1898244258040242180",
   "en": "I still got a bad feeling.",
   "ro": "Încă am un sentiment rău."
  },
  {
   "key": "1898244258057019396",
   "en": "Ugh, I dunno… I think it's all clear.",
   "ro": "Ugh, nu știu… Cred că e totul curat."
  },
  {
   "key": "1898244258107351044",
   "en": "Just come out, please.",
   "ro": "Ieși, te rog."
  },
  {
   "key": "1898244258124128260",
   "en": "You can't hide like that!",
   "ro": "Nu poți să te ascunzi așa!"
  },
  {
   "key": "1898244258157682692",
   "en": "Body! There's a body here!",
   "ro": "Cadavru! E un cadavru aici!"
  },
  {
   "key": "1898244258191237120",
   "en": "Yes! Of course. Sure!",
   "ro": "Da! Desigur. Sigur!"
  },
  {
   "key": "1898244258241568772",
   "en": "You shit the bed this time!",
   "ro": "De data asta ai dat-o în bară!"
  },
  {
   "key": "1898244258258345988",
   "en": "I-- I'll kill you!",
   "ro": "T--te omor!"
  },
  {
   "key": "1898244258291900420",
   "en": "Throwing!",
   "ro": "Arunc!"
  },
  {
   "key": "1898244258325454852",
   "en": "Ha, ha, ha!",
   "ro": "Ha, ha, ha!"
  },
  {
   "key": "1898244258342232072",
   "en": "Yes! Yes! Yes!",
   "ro": "Da! Da! Da!"
  },
  {
   "key": "1898244258392563716",
   "en": "It hurts. Owwww, it hurts.",
   "ro": "Mă doare. Oooo, mă doare."
  },
  {
   "key": "1898244258409340932",
   "en": "I don't wannaaaa.",
   "ro": "Nu vreauuuu."
  },
  {
   "key": "1898244258459672580",
   "en": "Oof!",
   "ro": "Uf!"
  },
  {
   "key": "1898244258476449796",
   "en": "Hey, watch it!",
   "ro": "Hei, ai grijă!"
  },
  {
   "key": "1898244258510004228",
   "en": "…Yes?",
   "ro": "…Da?"
  },
  {
   "key": "1898244258560335876",
   "en": "I'll do it… Uh, dunno… But I'll find out!",
   "ro": "O să fac… Ăă, nu știu… Dar o să aflu!"
  },
  {
   "key": "1898244258577113092",
   "en": "I know who I'm talking to… Of course.",
   "ro": "Știu cu cine vorbesc… Desigur."
  },
  {
   "key": "1898244258627444740",
   "en": "We gotta surround her!",
   "en_m": "We gotta suround him!",
   "ro": "Trebuie s-o înconjurăm!",
   "ro_m": "Trebuie să-l înconjurăm!"
  },
  {
   "key": "1898244258677776384",
   "en": "On it! Coming!",
   "ro": "Pe loc! Vin!"
  },
  {
   "key": "1898244258711330820",
   "en": "Watch out!",
   "ro": "Atenție!"
  },
  {
   "key": "1898244258728108036",
   "en": "Goodbye.",
   "ro": "La revedere."
  },
  {
   "key": "1898244258828771332",
   "en": "Ehh…",
   "ro": "Ehh…"
  },
  {
   "key": "1898244258879102980",
   "en": "Can you come with me?",
   "ro": "Poți veni cu mine?"
  },
  {
   "key": "1898244258895880196",
   "en": "W--we gotta check it out.",
   "ro": "T--trebuie să verificăm."
  },
  {
   "key": "1898244258929434628",
   "en": "Y--you go first.",
   "ro": "T--tu mergi prima.",
   "ro_m": "T--tu mergi primul."
  },
  {
   "key": "1898244258946211844",
   "en": "There she is!",
   "en_m": "There he is!",
   "ro": "Iată-o!",
   "ro_m": "Iată-l!"
  },
  {
   "key": "1898244258979766276",
   "en": "Ekhh… please… arghhh… no.",
   "ro": "Ekhh… te rog… arghhh… nu."
  },
  {
   "key": "1898265609295749120",
   "en": "What…? Yeah… But they could kill me… Okay.",
   "ro": "Ce…? Da… Dar m-ar putea omorî… Bine."
  },
  {
   "key": "1898265876389027840",
   "en": "Of course, no problem… Thank you!",
   "ro": "Desigur, nicio problemă… Mulțumesc!"
  }
 ]
}
