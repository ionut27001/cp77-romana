{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_f_60_jap_25.json",
 "entries": [
  {
   "key": "1922589792090464260",
   "en": "<kiroshi l=\"jpn\" o=\"こんにちは\" t=\"Hello.\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"jpn\" o=\"こんにちは\" t=\"Salut.\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1922589792124018692",
   "en": "Do I know you?",
   "ro": "Te cunosc?"
  },
  {
   "key": "1922589792174350340",
   "en": "Get out of here.",
   "ro": "Ieși de aici."
  },
  {
   "key": "1922589792207904772",
   "en": "What is your business here?",
   "ro": "Ce treabă ai aici?"
  },
  {
   "key": "1922589792258236420",
   "en": "Who are you trying to scare?",
   "ro": "Pe cine încerci să sperii?"
  },
  {
   "key": "1922589792275013636",
   "en": "You're not planning to use that?",
   "ro": "Nu plănuiești să folosești asta?"
  },
  {
   "key": "1922589792342122500",
   "en": "You'll pay for this!",
   "ro": "O să plătești pentru asta!"
  },
  {
   "key": "1922589792358899716",
   "en": "Don't you know what they'll do to you?",
   "ro": "Nu știi ce-o să-ți facă?"
  },
  {
   "key": "1922589792409231364",
   "en": "That's right.",
   "ro": "Așa e."
  },
  {
   "key": "1922589792442785796",
   "en": "Excellent.",
   "ro": "Excelent."
  },
  {
   "key": "1922589792509894660",
   "en": "What in the… ?",
   "ro": "Ce naiba…?"
  },
  {
   "key": "1922589792543449092",
   "en": "Coincidence? I don't think so.",
   "ro": "Coincidență? Nu cred."
  },
  {
   "key": "1922589792610557956",
   "en": "No one.",
   "ro": "Nimeni."
  },
  {
   "key": "1922589792627335172",
   "en": "All normal.",
   "ro": "Totul normal."
  },
  {
   "key": "1922589792711221252",
   "en": "Just wait till I find you…",
   "ro": "Așteaptă să te găsesc…"
  },
  {
   "key": "1922589792744775684",
   "en": "You can't hide.",
   "ro": "Nu te poți ascunde."
  },
  {
   "key": "1922589792795107332",
   "en": "<kiroshi l=\"jpn\" o=\"バカ野郎！\" t=\"Idiot!\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"jpn\" o=\"バカ野郎！\" t=\"Idiot!\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1922589792845438976",
   "en": "What is this?",
   "ro": "Ce e asta?"
  },
  {
   "key": "1922589792895770628",
   "en": "You again?",
   "ro": "Tu din nou?"
  },
  {
   "key": "1922589792979656704",
   "en": "What don't you understand…? Because I don't want to… It is how it is… Mm-hmm.",
   "ro": "Ce nu pricepi…? Pur și simplu nu vreau… Așa e."
  },
  {
   "key": "1922589792996433924",
   "en": "Not my fault... I've evolved… Yes. With people like me, I… That's it.",
   "ro": "Nu-i vina mea... Am evoluat… Da. Cu oameni ca mine, eu… Asta e."
  },
  {
   "key": "1922589793046765572",
   "en": "Don't call me again.",
   "ro": "Nu mă mai suna."
  },
  {
   "key": "1922589793080320004",
   "en": "Huh…",
   "ro": "Hm…"
  },
  {
   "key": "1922589793566859268",
   "en": "Security!",
   "ro": "Pază!"
  },
  {
   "key": "1922589793600413696",
   "en": "Someone here!",
   "ro": "Cineva aici!"
  },
  {
   "key": "1922589793717854212",
   "en": "Not again!",
   "ro": "Nu din nou!"
  },
  {
   "key": "1922589793751408644",
   "en": "Help!",
   "ro": "Ajutor!"
  },
  {
   "key": "1922589793885626368",
   "en": "I… I know people!",
   "ro": "Eu… știu oameni!"
  },
  {
   "key": "1922589793902403588",
   "en": "I'm warning you! Don't do this!",
   "ro": "Te avertizez! Nu face asta!"
  },
  {
   "key": "1922589794019844100",
   "en": "Gimme a break.",
   "ro": "Lasă-mă, mă!"
  },
  {
   "key": "1922589794053398532",
   "en": "I'm busy.",
   "ro": "Sunt ocupată."
  }
 ]
}
