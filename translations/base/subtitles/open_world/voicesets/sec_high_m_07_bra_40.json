   "ro": "La revedere."
  },
  {
   "key": "1897929337262841860",
   "en": "Moving to investigate.",
   "ro": "Mă deplasez să verific."
  },
  {
   "key": "1897929337329950724",
   "en": "Shoot first. Question later.",
   "ro": "Împușcă primul. Întreabă după."
  },
  {
   "key": "1897929337346727940",
   "en": "Safety off.",
   "ro": "Siguranța scoasă."
  },
  {
   "key": "1897929337397059588",
   "en": "Patrol the area!",
   "ro": "Patrulați zona!"
  },
  {
   "key": "1897929337413836804",
   "en": "Keep up the pressure!",
   "ro": "Țineți presiunea!"
  },
  {
   "key": "1897929337480945664",
   "en": "Argh… khh… khhh… you… fucked.",
   "ro": "Argh… khh… khhh… ai… futut-o."
  },
  {
   "key": "1897948491558690816",
   "en": "Wait… She did mention it one time… Don't quote me on that though… I understand.",
   "ro": "Stai... A pomenit-o o dată... Dar să nu zici că ai aflat de la mine... Am înțeles."
  },
  {
   "key": "1897948992727687168",
   "en": "No! I never told anyone anything. Wouldn't dream of it… Those must be rumors… Mm.",
   "ro": "Nu! N-am spus nimic nimănui. Nici prin cap nu mi-ar trece... Sigur-s doar zvonuri... Mm."
