  },
  {
   "key": "1922840462806753284",
   "en": "I'm frigging begging you! Please!",
   "ro": "Te rog din suflet! Te rog!"
  },
  {
   "key": "1922840462840307716",
   "en": "I've got a life to live!",
   "ro": "Am și eu o viață de trăit!"
  },
  {
   "key": "1922840462924193796",
   "en": "What are you getting at?",
