{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_hmls_m_04_nat_30.json",
 "entries": [
  {
   "key": "1953265932078981124",
   "en": "Hi.",
   "ro": "Salut."
  },
  {
   "key": "1953265932112535556",
   "en": "Where ya been?",
   "ro": "Unde-ai fost?"
  },
  {
   "key": "1953265932162867204",
   "en": "Careful.",
   "ro": "Atenție."
  },
  {
   "key": "1953265932179644420",
   "en": "Slow down there.",
   "ro": "Mai încet."
  },
  {
   "key": "1953265932213198852",
   "en": "Bad news.",
   "ro": "Veste proastă."
  },
  {
   "key": "1953265932280307712",
   "en": "Gotta move out… Again, yep… Less opportunities… Yeah, unfortunately.",
   "ro": "Trebuie să ne mutăm… Iar, da… Mai puține șanse… Da, din păcate."
  },
  {
   "key": "1953265932297084932",
   "en": "Tell 'em… We gotta find somethin'… Yeah… As usual.",
   "ro": "Spune-le… Trebuie să găsim ceva… Da… Ca de obicei."
  },
  {
   "key": "1953265932330639364",
   "en": "It'll work out somehow.",
   "ro": "Se va rezolva cumva."
  },
  {
   "key": "1953265932481634308",
   "en": "Run away!",
   "ro": "Fugi!"
  },
  {
   "key": "1953265932498411524",
   "en": "She's gonna kill!",
   "en_m": "He's gonna kill!",
   "ro": "O să omoare!"
  },
  {
   "key": "1953265932582297604",
   "en": "You don't have to do this.",
   "ro": "Nu trebuie să faci asta."
  },
  {
   "key": "1953265932599074820",
   "en": "Ki-kickin' the man who's down?",
   "ro": "Lo-lovești omul căzut?"
  },
  {
   "key": "1953265932682960900",
   "en": "Why don't you just go on your own way?",
   "ro": "De ce nu-ți vezi de drum?"
  },
  {
   "key": "1953265932716515328",
   "en": "I got nothin' to say to ya.",
   "ro": "N-am nimic să-ți spun."
  }
 ]
