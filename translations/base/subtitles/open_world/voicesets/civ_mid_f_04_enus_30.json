{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_f_04_enus_30.json",
 "entries": [
  {
   "key": "1922740278651265028",
   "en": "Uh, hello? Mm-hmm?",
   "ro": "Uh, salut? Mm-hmm?"
  },
  {
   "key": "1922740278668042244",
   "en": "Hi! You, uh, looking for someone?",
   "ro": "Salut! Tu, uh, cauți pe cineva?"
  },
  {
   "key": "1922740278718373892",
   "en": "Hey! Please leave this area.",
   "ro": "Hei! Te rog, părăsește zona asta."
  },
  {
   "key": "1922740278751928324",
   "en": "Get back. I'm counting to three!",
   "ro": "Dă-te înapoi. Număr până la trei!"
  },
  {
   "key": "1922740278819037184",
   "en": "Hey! Put that away!",
   "ro": "Hei! Pune aia la loc!"
  },
  {
   "key": "1922740278835814404",
   "en": "Stop playing around! Lower your weapon!",
   "ro": "Nu te mai juca! Coboară arma!"
  },
  {
   "key": "1922740278902923264",
   "en": "I'm asking you one last time!",
   "ro": "Te întreb ultima dată!"
  },
  {
   "key": "1922740278919700484",
   "en": "Hello, I'm talking to you!",
   "ro": "Salut, îți vorbesc!"
  },
  {
   "key": "1922740278986809344",
   "en": "Oh, bravo! Wise choice!",
   "ro": "Oh, bravo! Alegere înțeleaptă!"
  },
  {
   "key": "1922740279003586564",
   "en": "Oooh! Very wise!",
   "ro": "Oooh! Foarte înțelept!"
  },
  {
   "key": "1922740279053918212",
   "en": "What's going on?",
   "ro": "Ce se întâmplă?"
  },
  {
   "key": "1922740279154581508",
   "en": "Ugh, great.",
   "ro": "Ugh, grozav."
  },
  {
   "key": "1922740279288799232",
   "en": "Well, nothing.",
   "ro": "Păi, nimic."
  },
  {
   "key": "1922740279322353668",
   "en": "Hm, seems fine.",
   "ro": "Hm, pare în regulă."
  },
  {
   "key": "1922740279406239748",
   "en": "You're here somewhere…",
   "ro": "Ești pe-aici pe undeva…"
  },
  {
   "key": "1922740279423016964",
   "en": "Come out! Now!",
   "ro": "Ieși! Acum!"
  },
  {
   "key": "1922740279506903044",
   "en": "Ugh! What is with you?!",
   "ro": "Ugh! Ce-i cu tine?!"
  },
  {
   "key": "1922740279523680260",
   "en": "How rude!",
   "ro": "Ce nesimțire!"
  },
  {
   "key": "1922740279574011908",
   "en": "Yep? Hello?",
   "ro": "Da? Salut?"
  },
  {
   "key": "1922740279657897984",
   "en": "Yeah, yeah, of course. Of course. Uh-huh. How? No no no… I-I don't believe it.",
   "ro": "Da, da, sigur. Sigur. Uh-huh. Cum? Nu, nu, nu… N-nu cred."
  },
  {
   "key": "1922740279691452420",
   "en": "Ehh, but maybe it's the right choice? I don't know… Mm-hmm… Mm-hmm… Uh-huh, yeah…",
   "ro": "Ehh, dar poate e alegerea corectă? Nu știu… Mm-hmm… Mm-hmm… Uh-huh, da…"
  },
  {
   "key": "1922740279741784068",
   "en": "Ok. Bye now.",
   "ro": "Ok. Pa acum."
  },
  {
   "key": "1922740279775338500",
   "en": "It was supposed to be a quiet day.",
   "ro": "Ar fi trebuit să fie o zi liniștită."
  },
  {
   "key": "1922740280177991684",
   "en": "Help! Quickly! To me!",
   "ro": "Ajutor! Repede! La mine!"
  },
  {
   "key": "1922740280194768900",
   "en": "Help! Emergency!",
   "ro": "Ajutor! Urgență!"
  },
  {
   "key": "1922740280312209412",
   "en": "Augh, save yourselves! She's psychotic!",
   "en_m": "Augh, save yourselves! He's psychotic!",
   "ro": "Augh, fugiți! E nebună de legat!",
   "ro_m": "Augh, fugiți! E nebun de legat!"
  },
  {
   "key": "1922740280345763844",
   "en": "Heh, no!",
   "ro": "Heh, nu!"
  },
  {
   "key": "1922740280446427140",
   "en": "No… no… why?!",
   "ro": "Nu… nu… de ce?!"
  },
  {
   "key": "1922740280463204356",
   "en": "I don't want to die…",
   "ro": "Nu vreau să mor…"
  },
  {
   "key": "1922740280563867652",
   "en": "Hey! I'm talking to you! Leave me alone!",
   "ro": "Hei! Îți vorbesc! Lasă-mă în pace!"
  },
  {
   "key": "1922740280597422084",
   "en": "I know what you're thinking. How dare you!?",
   "ro": "Știu la ce te gândești. Cum îndrăznești?!"
  }
 ]
}
