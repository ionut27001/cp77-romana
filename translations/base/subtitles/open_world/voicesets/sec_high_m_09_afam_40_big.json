{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_high_m_09_afam_40_big.json",
 "entries": [
  {
   "key": "1897985373717929988",
   "en": "Don't come near me.",
   "ro": "Nu te apropia de mine."
  },
  {
   "key": "1897985373734707204",
   "en": "Don't forget who's the boss around here.",
   "ro": "Nu uita cine e șeful aici."
  },
  {
   "key": "1897985373801816068",
   "en": "Corporation territory.",
   "ro": "Teritoriu al corporației."
  },
  {
   "key": "1897985373835370496",
   "en": "Move back.",
   "ro": "Dă-te înapoi."
  },
  {
   "key": "1897985373902479364",
   "en": "Safety better be on.",
   "ro": "Mai bine să fie siguranța activată."
  },
  {
   "key": "1897985373936033796",
   "en": "Don't make me disarm you myself.",
   "ro": "Nu mă face să te dezarmez eu."
  },
  {
   "key": "1897985374019919876",
   "en": "I will open fire.",
   "ro": "Deschid focul."
  },
  {
   "key": "1897985374053474304",
   "en": "You got a deathwish?",
   "ro": "Ai chef de moarte?"
  },
  {
   "key": "1897985374120583168",
   "en": "No sudden moves.",
   "ro": "Fără mișcări bruște."
  },
  {
   "key": "1897985374137360388",
   "en": "That's good, now keep goin'…",
   "ro": "Bine, acum continuă…"
  },
  {
   "key": "1897985374204469252",
   "en": "Huh? Commencing investigation.",
   "ro": "Hm? Încep investigația."
  },
  {
   "key": "1897985374321909764",
   "en": "Securing area.",
   "ro": "Securizez zona."
  },
  {
   "key": "1897985374389018628",
   "en": "Area secure.",
   "ro": "Zonă securizată."
  },
  {
   "key": "1897985374422573060",
   "en": "Clean.",
   "ro": "Curat."
  },
  {
   "key": "1897985374472904708",
   "en": "Come out alone and you won't get hurt!",
   "ro": "Ieși singură și nu te rănești!",
   "ro_m": "Ieși singur și nu te rănești!"
  },
  {
   "key": "1897985374506459140",
   "en": "Show yourself, terrorist!",
   "ro": "Arată-te, teroristule!"
  },
  {
   "key": "1897985374540013572",
   "en": "Someone's been killed!",
   "ro": "Cineva a fost ucis!"
  },
  {
   "key": "1897985374573568004",
   "en": "Understood.",
   "ro": "Înțeles."
  },
  {
   "key": "1897985374640676868",
   "en": "She's attacking me!",
   "en_m": "He's attacking me!",
   "ro": "Ea mă atacă!",
   "ro_m": "El mă atacă!"
  },
  {
   "key": "1897985374674231300",
   "en": "Terrorist attack!",
   "ro": "Atac terorist!"
  },
  {
   "key": "1897985374724562948",
   "en": "Grenade out – stay clear!",
   "ro": "Granată afară – la adăpost!"
  },
  {
   "key": "1897985374758117380",
   "en": "Forward!",
   "ro": "Înainte!"
  },
  {
   "key": "1897985374791671812",
   "en": "Cancel her!",
   "en_m": "Cancel him!",
   "ro": "Elimin-o!",
   "ro_m": "Elimină-l!"
  },
  {
   "key": "1897985374842003460",
   "en": "Regroup!",
   "ro": "Regrupați-vă!"
  },
  {
   "key": "1897985374875557888",
   "en": "Retreating!",
   "ro": "Mă retrag!"
  },
  {
   "key": "1897985374925889540",
   "en": "What the--?",
   "ro": "Ce naiba--?"
  },
  {
   "key": "1897985374942666756",
   "en": "Watch where you're going.",
   "ro": "Uită-te pe unde mergi."
  },
  {
   "key": "1897985374976221188",
   "en": "H'lo?",
   "ro": "Alo?"
  },
  {
   "key": "1897985375026552836",
   "en": "Mhm… Yeah it's healed real well… Full replacement…",
   "ro": "Mhm… Da, s-a vindecat foarte bine… Înlocuire completă…"
  },
  {
   "key": "1897985375060107264",
   "en": "Went fine… Mm… We just replaced our informers and--.",
   "ro": "A mers bine… Mm… Tocmai ce ne-am schimbat informatorii și--."
  },
  {
   "key": "1897985375127216132",
   "en": "Attrition!",
   "ro": "Uzură!"
  },
  {
   "key": "1897985375177547780",
   "en": "On it!",
   "ro": "Mă ocup!"
  },
  {
   "key": "1897985375211102212",
   "en": "Heads down!",
   "ro": "Capetele jos!"
  },
  {
   "key": "1897985375244656644",
   "en": "Yeah, you too!",
   "ro": "Da, și tu!"
  },
  {
   "key": "1897985375278211072",
   "en": "I'll check it out.",
   "ro": "Mă duc să verific."
  },
  {
   "key": "1897985375345319940",
   "en": "Let's get this over with.",
   "ro": "Hai să terminăm odată."
  },
  {
   "key": "1897985375362097156",
   "en": "C'mon.",
   "ro": "Hai."
  },
  {
   "key": "1897985375412428804",
   "en": "Go see what's goin' on.",
   "ro": "Du-te să vezi ce se întâmplă."
  },
  {
   "key": "1897985375429206020",
   "en": "You're dead!",
   "ro": "Ești moartă!",
   "ro_m": "Ești mort!"
  },
  {
   "key": "1897985375479537668",
   "en": "Ekhh… khh… let… go.",
   "ro": "Ekhh… khh… lasă…-mă…"
  },
  {
   "key": "1898000307168223232",
   "en": "No point tryin' to save it after he nearly cut it clean off… What a job…",
   "ro": "N-are rost să-l mai salvezi, după ce aproape l-a tăiat de tot... Ce treabă..."
  },
  {
   "key": "1898000825785524224",
   "en": "Nah, wasn't a gunfight. Maybe next time.",
   "ro": "Nah, n-a fost schimb de focuri. Poate data viitoare."
  },
  {
   "key": "1959048887539900416",
   "en": "Was it something I said...?",
   "ro": "A fost ceva ce-am zis...?"
  },
  {
   "key": "1959048887590232068",
   "en": "Now, as I was saying...",
   "ro": "Acum, cum ziceam..."
  },
  {
   "key": "1959048887607009284",
   "en": "Yo... you with me?",
   "ro": "Yo... ești cu mine?"
  }
 ]
