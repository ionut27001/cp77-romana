 "entries": [
  {
   "key": "1906970041523904512",
   "en": "Yes?",
   "ro": "Da?"
  },
  {
   "key": "1906970041540681732",
   "en": "Mm-hmm?",
   "ro": "Mm-hmm?"
  },
  {
   "key": "1906970041624567812",
   "en": "Huh? You can't be here!",
   "ro": "Huh? Nu ai voie aici!"
  },
  {
   "key": "1906970041658122240",
   "en": "Hey! Can't be here…",
   "ro": "Hei! Nu ai voie aici…"
  },
  {
   "key": "1906970041725231108",
   "en": "Stay calm! Please, put it down!",
   "ro": "Stai calm! Te rog, pune-o jos!"
  },
  {
   "key": "1906970041742008324",
   "en": "Please! Put it away!",
   "ro": "Te rog! Pune-o la loc!"
  },
  {
   "key": "1906970041809117188",
   "en": "I-- I'm gonna call security!",
   "ro": "O-- O să chem securitatea!"
  },
  {
   "key": "1906970041825894404",
   "en": "You hear me?!",
   "ro": "Mă auzi?!"
  },
  {
   "key": "1906970041893003268",
   "en": "Well, that's better…",
   "ro": "Ei, asta e mai bine…"
  },
  {
   "key": "1906970041909780484",
   "en": "Now, can't we all just get along? Heh...",
   "ro": "Acum, nu putem să ne înțelegem cu toții? Heh..."
  },
  {
   "key": "1906970041993666564",
   "en": "What's goin' on?",
   "ro": "Ce se întâmplă?"
  },
  {
   "key": "1906970042043998208",
   "en": "Wha--? What the?",
   "ro": "Ce--? Ce-i asta?"
  },
  {
   "key": "1906970042094329860",
   "en": "Aww, whatever…",
   "ro": "A, oricum…"
  },
  {
   "key": "1906970042127884292",
   "en": "Well, shit… Better get back to work...",
   "ro": "Ei, căcat… Mai bine mă întorc la muncă..."
  },
  {
   "key": "1906970042211770368",
   "en": "Somewhere in here…",
   "ro": "Undeva pe-aici…"
  },
  {
   "key": "1906970042228547588",
   "en": "Where… are you?",
   "ro": "Unde… ești?"
  },
  {
   "key": "1906970042278879236",
   "en": "Hey! Watch it!",
   "ro": "Hei! Ai grijă!"
  },
  {
   "key": "1906970042312433668",
   "en": "Wh-what the!?",
   "ro": "Ce-- ce-i asta!?"
  },
  {
   "key": "1906970042362765316",
   "en": "Yes? Hello?",
   "ro": "Da? Alo?"
  },
  {
   "key": "1906970042413096964",
   "en": "You know, the, uh… Yeah… Uh, unless…",
   "ro": "Știi, chestia aia, uh… Da… Uh, dacă nu…"
  },
  {
   "key": "1906970042446651396",
   "en": "Uh, dunno, dunno… I think, uh… Yeah… Yeah, that too...",
   "ro": "Ăă, nu știu, nu știu… Cred că, ăă… Da… Da, și asta..."
  },
  {
   "key": "1906970042496983044",
   "en": "Uh, fine, fine. Bye!",
   "ro": "Uh, bine, bine. Pa!"
  },
  {
   "key": "1906970042530537476",
   "en": "Was that... ?",
   "ro": "A fost... ?"
  },
  {
   "key": "1906970043050631172",
   "en": "Help! To me!",
   "ro": "Ajutor! La mine!"
  },
  {
   "key": "1906970043100962820",
   "en": "Security! Here! Over here!",
   "ro": "Securitate! Aici! Pe-aici!"
  },
  {
   "key": "1906970043268734980",
   "en": "Help! Oh God!",
   "ro": "Ajutor! Doamne!"
  },
  {
   "key": "1906970043302289412",
   "en": "No! Aaah!",
   "ro": "Nu! Aaah!"
  },
  {
   "key": "1906970043503616004",
   "en": "Please! My kids...",
   "ro": "Te rog! Copiii mei..."
  },
  {
   "key": "1906970043520393220",
   "en": "No, please, no…",
   "ro": "Nu, te rog, nu…"
  },
  {
   "key": "1906970043654610948",
   "en": "Hey! What do you want!?",
   "ro": "Hei! Ce vrei!?"
  },
  {
   "key": "1906970043688165380",
   "en": "For Christ's sake, leave me be!",
   "ro": "Doamne, lasă-mă în pace!"
  }
 ]
