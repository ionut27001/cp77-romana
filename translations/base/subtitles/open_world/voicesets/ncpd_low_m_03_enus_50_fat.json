  {
   "key": "1863380515074727940",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1863380515208945668",
   "en": "I know, honey... What should you do? Nothing...",
   "ro": "Știu, dragă... Ce ar trebui să faci? Nimic..."
