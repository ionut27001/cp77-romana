  {
   "key": "1863380516047806468",
   "en": "You fucking freak!",
   "ro": "Ești un freak nenorocit!"
  },
  {
   "key": "1863380516114915332",
   "en": "Argh... Ech... no... no...",
   "ro": "Argh... Ech... nu... nu..."
  },
  {
   "key": "1867728399572262912",
   "en": "Look, you wanted to do it yourself, now you gotta... Just wait it out... I'm tellin' you...",
   "ro": "Uite, ai vrut să te descurci singură, acum n-ai încotro... Stai și așteaptă... Îți zic eu...",
   "ro_m": "Uite, ai vrut să te descurci singur, acum n-ai încotro... Stai și așteaptă... Îți zic eu..."
  },
  {
   "key": "1867728693341315072",
   "en": "Oh-ho-ho, I can't wait... And carrots...? Hell yeah!",
