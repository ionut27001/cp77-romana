   "ro": "Și eu te iubesc."
  },
  {
   "key": "1863380515645153284",
   "en": "Uhh?",
   "ro": "Uhh?"
  },
  {
   "key": "1863380515812925444",
   "en": "Goddamnit! Somethin' ain't right!",
   "ro": "Mama dracului! Ceva nu-i în regulă!"
  },
  {
