   "ro": "Coboară arma!"
  },
  {
   "key": "1863380514823069700",
   "en": "Help! I'm shot! Don't let me die!",
   "ro": "Ajutor! Sunt împușcat! Nu mă lăsa să mor!"
  },
  {
