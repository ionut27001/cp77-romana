{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_f_09_enus_25.json",
 "entries": [
  {
   "key": "1949038421689884676",
   "en": "What's up.",
   "ro": "Ce faci."
  },
  {
   "key": "1949038421723439108",
   "en": "New around here?",
   "ro": "Ești nouă pe-aici?",
   "ro_m": "Ești nou pe-aici?"
  },
  {
   "key": "1949038421773770756",
   "en": "Where you walking?!",
   "ro": "Vezi pe unde mergi!"
  },
  {
   "key": "1949038421807325188",
   "en": "What's your problem?!",
   "ro": "Ce problemă ai?!"
  },
  {
   "key": "1949038421840879620",
   "en": "Hiya.",
   "ro": "Salut."
  },
  {
   "key": "1949038421891211268",
   "en": "Oh, nothin'… I'll stop by the Mox… A beer or two, that business… Yeah… Yeah.",
   "ro": "A, nimic… Mă opresc pe la Mox… O bere sau două, chestia aia… Da… Da."
  },
  {
   "key": "1949038421907988484",
   "en": "If you want to, cool… No… You think I have what? Heh, yeah… Live a little, am I right?",
   "ro": "Dacă vrei, cool… Nu… Crezi că am ce? Heh, da… Mai trăiește și tu puțin, nu?"
  },
  {
   "key": "1949038421958320132",
   "en": "See ya.",
   "ro": "Ne vedem."
  },
  {
   "key": "1949038422092537860",
   "en": "Oh my god! Psycho!",
   "ro": "Doamne! Nebun!"
  },
  {
   "key": "1949038422126092292",
   "en": "She's armed! Hear me?!",
   "en_m": "He's armed! Hear me?!",
   "ro": "E înarmată! Mă auzi?!",
   "ro_m": "E înarmat! Mă auzi?!"
  },
  {
   "key": "1949038422193201156",
   "en": "Let me go!",
   "ro": "Dă-mi drumul!"
  },
  {
   "key": "1949038422226755588",
   "en": "I don't even know you!",
   "ro": "Nici măcar nu te cunosc!"
  },
  {
   "key": "1949038422310641664",
   "en": "What you following me for?",
   "ro": "De ce mă urmărești?"
  },
  {
   "key": "1949038422327418884",
   "en": "You wanna go?!",
   "ro": "Vrei să te bați?!"
  }
 ]
}
