{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_mid_f_03_afam_25.json",
 "entries": [
  {
   "key": "1856199096870117380",
   "en": "Yeah? Something happen?",
   "ro": "Da? S-a întâmplat ceva?"
  },
  {
   "key": "1856199096886894596",
   "en": "Look, I'm workin' here.",
   "ro": "Uite, lucrez aici."
  },
  {
   "key": "1856199096937226244",
   "en": "Please step back!",
   "ro": "Dă-te înapoi, te rog!"
  },
  {
   "key": "1856199096954003460",
   "en": "You can't be here!",
   "ro": "Nu poți fi aici!"
  },
  {
   "key": "1856199097004335108",
   "en": "Please, drop your weapon!",
   "ro": "Te rog, aruncă arma!"
  },
  {
   "key": "1856199097021112324",
   "en": "Drop your weapon immediately!",
   "ro": "Aruncă arma imediat!"
  },
  {
   "key": "1856199097071443972",
   "en": "I will shoot!",
   "ro": "O să trag!"
  },
  {
   "key": "1856199097104998404",
   "en": "This is your final warning!",
   "ro": "Aceasta e ultimul tău avertisment!"
  },
  {
   "key": "1856199097155330052",
   "en": "Please, back off.",
   "ro": "Te rog, dă-te înapoi."
  },
  {
   "key": "1856199097172107268",
   "en": "That's right. Nice 'n' easy.",
   "ro": "Așa e. Ușor, ușor."
  },
  {
   "key": "1856199097222438916",
   "en": "Hello? Someone there?",
   "ro": "Alo? E cineva acolo?"
  },
  {
   "key": "1856199097239216132",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1856199097289547780",
   "en": "Think that's enough for one day.",
   "ro": "Cred că ajunge pentru azi."
  },
  {
   "key": "1856199097306324996",
   "en": "That's all, folks.",
   "ro": "Asta-i tot, oameni buni."
  },
  {
   "key": "1856199097356656644",
   "en": "Please drop your weapon, come out slowly.",
   "ro": "Te rog, aruncă arma și ieși încet."
  },
  {
   "key": "1856199097373433860",
   "en": "Don't make it worse for yourself. Come on out.",
   "ro": "Nu te complica. Ieși afară."
  },
  {
   "key": "1856199097406988292",
   "en": "Jesus! He's not breathing!",
   "ro": "Doamne! Nu respiră!"
  },
  {
   "key": "1856199097457319940",
   "en": "Of course!",
   "ro": "Bineînțeles!"
  },
  {
   "key": "1856199097507651588",
   "en": "Attack on an officer!",
   "ro": "Atac asupra unui ofițer!"
  },
  {
   "key": "1856199097524428804",
   "en": "Officer under fire!",
   "ro": "Ofițer sub foc!"
  },
  {
   "key": "1856199097557983236",
   "en": "Watch out!",
   "ro": "Atenție!"
  },
  {
   "key": "1856199097608314884",
   "en": "Cover fire! Hit 'em!",
   "ro": "Foc de acoperire! Trageți în ei!"
  },
  {
   "key": "1856199097625092100",
   "en": "Attack! Let's go!",
   "ro": "Atac! Hai!"
  },
  {
   "key": "1856199097658646532",
   "en": "Holy shit!",
   "ro": "Ce căcat!"
  },
  {
   "key": "1856199097692200964",
   "en": "She's got it in for me!",
   "en_m": "He's got it in for me!",
   "ro": "Are ceva cu mine!"
  },
  {
   "key": "1856199097742532612",
   "en": "Yo! I'm walkin' here!",
   "ro": "Hei! Merg pe aici!"
  },
  {
   "key": "1856199097759309828",
   "en": "Don't like you either!",
   "ro": "Nici pe tine nu te plac!"
  },
  {
   "key": "1856199097792864260",
   "en": "Hey.",
   "ro": "Hei."
  },
  {
   "key": "1856199097843195908",
   "en": "Mhm... I know... yeah, 'course...",
   "ro": "Mhm... știu... da, sigur..."
  },
  {
   "key": "1856199097859973124",
   "en": "Got it... If someone's gotta do it, OK...",
   "ro": "Am înțeles... Dacă trebuie să facă cineva, bine..."
  },
  {
   "key": "1856199097927081988",
   "en": "Surround the target!",
   "ro": "Încercuiți ținta!"
  },
  {
   "key": "1856199097994190848",
   "en": "Attack!",
   "ro": "Atacă!"
  },
  {
   "key": "1856199098078076932",
   "en": "Gonna blow!",
   "ro": "O să explodeze!"
  },
  {
   "key": "1856199098128408580",
   "en": "All right, bye.",
   "ro": "Bine, pa."
  },
  {
   "key": "1856199098161963012",
   "en": "What's going on?",
   "ro": "Ce se întâmplă?"
  },
  {
   "key": "1856199098262626308",
   "en": "Psst... C'mere. Quick.",
   "ro": "Psst... Vino aici. Repede."
  },
  {
   "key": "1856199098296180740",
   "en": "Shhh... Stay alert.",
   "ro": "Șșș... Fii pe fază."
  },
  {
   "key": "1856199098346512388",
   "en": "Go check it out. Please.",
   "ro": "Du-te să verifici. Te rog."
  },
  {
   "key": "1856199098380066820",
   "en": "Don't give up now!",
   "ro": "Nu renunța acum!"
  },
  {
   "key": "1856199098413621252",
   "en": "Argh... no... no... please...",
   "ro": "Argh... nu... nu... te rog..."
  },
  {
   "key": "1867678963994206208",
   "en": "Listen, it's no problem, really... OK... OK... all right...",
   "ro": "Ascultă, nu-i nicio problemă, chiar... Bine... bine... în regulă..."
  },
  {
   "key": "1867679846358327296",
   "en": "Is that an order?... Mhm, understood... all right...",
   "ro": "E ordin?... Mhm, înțeles... bine..."
  }
 ]
}
