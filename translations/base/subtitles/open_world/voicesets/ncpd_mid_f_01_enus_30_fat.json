{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_mid_f_01_enus_30_fat.json",
 "entries": [
  {
   "key": "1856177393527955460",
   "en": "What?!",
   "ro": "Ce?!"
  },
  {
   "key": "1856177393561509892",
   "en": "What? You get mugged or somethin'? Shit happens.",
   "ro": "Ce? Ai fost jefuit sau ceva? Se mai întâmplă."
  },
  {
   "key": "1856177393611841540",
   "en": "Yo, shit-for-brains! Back it up!",
   "ro": "Hei, descreieratule! Dă înapoi!"
  },
  {
   "key": "1856177393645395968",
   "en": "Get back, or you an' me're gonna have a problem.",
   "ro": "Dă-te înapoi, că avem o problemă, tu și cu mine."
  },
  {
   "key": "1856177393695727620",
   "en": "Whatcha doin' that for?!",
   "ro": "De ce faci asta?!"
  },
  {
   "key": "1856177393712504836",
   "en": "Stash your weapon! Now!",
   "ro": "Pune arma în depozit! Acum!"
  },
  {
   "key": "1856177393762836484",
   "en": "'Bout to cuff you, you fuckin' punk!",
   "ro": "O să te încătușez, golan nenorocit!"
  },
  {
   "key": "1856177393796390916",
   "en": "What, bitch, I gotta teach you a lesson?",
   "ro": "Ce, curvo, trebuie să te învăț minte?"
  },
  {
   "key": "1856177393846722564",
   "en": "And leave me the hell alone.",
   "ro": "Și lasă-mă naibii în pace."
  },
  {
   "key": "1856177393880276996",
   "en": "Yeah. Beat it.",
   "ro": "Da. Cară-te."
  },
  {
   "key": "1856177393930608644",
   "en": "Eeh?",
   "ro": "Eeh?"
  },
  {
   "key": "1856177393947385860",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1856177393997717508",
   "en": "All right, enough.",
   "ro": "Bine, destul."
  },
  {
   "key": "1856177394014494724",
   "en": "Sick of this.",
   "ro": "M-am săturat."
  },
  {
   "key": "1856177394064826372",
   "en": "Crawl on out, worm!",
   "ro": "Târăște-te afară, vierme!"
  },
  {
   "key": "1856177394081603588",
   "en": "Better come out, give yourself up!",
   "ro": "Mai bine ieși, predă-te!"
  },
  {
   "key": "1856177394131935236",
   "en": "Officer down!",
   "ro": "Ofițer doborât!"
  },
  {
   "key": "1856177394165489668",
   "en": "You got it!",
   "ro": "Ai înțeles!"
  },
  {
   "key": "1856177394215821316",
   "en": "I'ma fuckin' kill you!",
   "ro": "Te omor, pula mea!"
  },
  {
   "key": "1856177394232598532",
   "en": "You're going down!",
   "ro": "S-a zis cu tine!"
  },
  {
   "key": "1856177394266152964",
   "en": "Watch out! Here goes nothin'!",
   "ro": "Atenție! Hai să vedem!"
  },
  {
   "key": "1856177394333261824",
   "en": "Hang in there!",
   "ro": "Ține-te bine!"
  },
  {
   "key": "1856177394350039044",
   "en": "Have some self-respect!",
   "ro": "Ai puțin respect de sine!"
  },
  {
   "key": "1856177394400370692",
   "en": "This is not good!",
   "ro": "Nu e bine!"
  },
  {
   "key": "1856177394417147908",
   "en": "Let's go, you CHOOH-heads!",
   "ro": "Hai, voi, CHOOH-heads!"
  },
  {
   "key": "1856177394467479556",
   "en": "Fuckin' punk.",
   "ro": "Golan nenorocit."
  },
  {
   "key": "1856177394484256772",
   "en": "I gotta slam you?!",
   "ro": "Trebuie să te trântesc?!"
  },
  {
   "key": "1856177394517811204",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1856177394584920068",
   "en": "Nope... Not doin' it... What...? How much...?",
   "ro": "Nu... Nu fac... Ce...? Cât...?"
  },
  {
   "key": "1856177394618474500",
   "en": "Uh-huh... How many of 'em...? All right... I'll round some up... mhm…",
   "ro": "Aha... Câți dintre ei...? Bine... O să strâng câțiva... mhm…"
  },
  {
   "key": "1856177394668806148",
   "en": "Attack! Attack from all sides!",
   "ro": "Atac! Atac din toate părțile!"
  },
  {
   "key": "1856177394702360580",
   "en": "C'mon, move!",
   "ro": "Hai, mișcați!"
  },
  {
   "key": "1856177394735915012",
   "en": "Down! Get down!",
   "ro": "Jos! La pământ!"
  },
  {
   "key": "1856177394752692228",
   "en": "I'ma just finish up here. I'll call you.",
   "ro": "Termin aici. Te sun."
  },
  {
   "key": "1856177394786246656",
   "en": "What was that?",
   "ro": "Ce-a fost asta?"
  },
  {
   "key": "1856177394836578308",
   "en": "'Ey! C'mere!",
   "ro": "Hei! Vino aici!"
  },
  {
   "key": "1856177394853355524",
   "en": "Follow me!",
   "ro": "Urmează-mă!"
  },
  {
   "key": "1856177394920464388",
   "en": "Go take care of it.",
   "ro": "Du-te și rezolvă."
  },
  {
   "key": "1856177394937241604",
   "en": "Eliminate the fuckin' target!",
   "ro": "Elimină ținta dracului!"
  },
  {
   "key": "1856177394987573248",
   "en": "Argh... ech... ech... mercy...",
   "ro": "Argh... ech... ech... îndurare..."
  },
  {
   "key": "1867673730861768704",
   "en": "Hm, all right... I'll think of somethin'...",
   "ro": "Hm, bine... Mă gândesc la ceva..."
  },
  {
   "key": "1867674165425217536",
   "en": "Six of us'll be enough... Yeah, yeah...",
   "ro": "Șase dintre noi sunt de ajuns... Da, da..."
  },
  {
   "key": "2235088979799187460",
   "en": "Done with this shit!",
   "ro": "Gata cu rahatul ăsta!"
  },
  {
   "key": "2235088979849519108",
   "en": "Attaaack!",
   "ro": "Ataaaac!"
  },
  {
   "key": "2235088979966959616",
   "en": "This don't look good! Watch your six!",
   "ro": "Asta nu arată bine! Păzește-ți spatele!"
  },
  {
   "key": "2235088980000514052",
   "en": "No, no, no... c'mon!",
   "ro": "Nu, nu, nu... hai!"
  },
  {
   "key": "2235088980117954560",
   "en": "What? I swear I didn't call no one.",
   "ro": "Ce? Jur că n-am sunat pe nimeni."
  },
  {
   "key": "2235088980386390020",
   "en": "Toss the damn weapon!",
   "ro": "Aruncă arma dracului!"
  },
  {
   "key": "2235088980470276100",
   "en": "You're breaking the law!",
   "ro": "Încalci legea!"
  },
  {
   "key": "2235088980621271044",
   "en": "She's hit! I got her!",
   "en_m": "He's hit! I got him!",
   "ro": "E lovită! Am prins-o!",
   "ro_m": "E lovit! L-am prins!"
  },
  {
   "key": "2235088980688379908",
   "en": "She's wounded!",
   "en_m": "He's wounded!",
   "ro": "E rănită!",
   "ro_m": "E rănit!"
  },
  {
   "key": "2235088980973592580",
   "en": "Keep the pressure up! She won't last long!",
   "en_m": "Keep the pressure up! He won't last long!",
   "ro": "Menține presiunea! Nu o să mai țină mult!"
  },
  {
   "key": "2235088981040701440",
   "en": "Copy that!",
   "ro": "Am înțeles!"
  },
  {
   "key": "2235088981091033092",
   "en": "Come on out! I'll make it quick for ya!",
   "ro": "Ieși, hai! Termin repede cu tine!"
  },
  {
   "key": "2235088981141364740",
   "en": "Hold on! I'm reloading!",
   "ro": "Stai! Reîncarc!"
  },
  {
   "key": "2235088981191696388",
   "en": "Fuck, losin' control of our people here!",
   "ro": "Futu-i, pierdem controlul oamenilor noștri aici!"
  },
  {
   "key": "2235088981309136900",
   "en": "Fuck! Can't see nothin'!",
   "ro": "Futu-i! Nu văd nimic!"
  },
  {
   "key": "2235088981376245764",
   "en": "Shit! I didn't sign up to fuck with NetWatch!",
   "ro": "Rahat! N-am semnat să mă pun cu NetWatch!"
  },
  {
   "key": "2235088981443354624",
   "en": "Wooh! I'm back!",
   "ro": "Uuuh! M-am întors!"
  },
  {
   "key": "2235088981493686276",
   "en": "Requesting backup!",
   "ro": "Cer întăriri!"
  },
  {
   "key": "2235088981527240708",
   "en": "You're gonna feel the force o' the law!",
   "ro": "O să simți forța legii!"
  },
  {
   "key": "2235088981594349572",
   "en": "Moving in!",
   "ro": "Intrăm!"
  },
  {
   "key": "2235088981661458436",
   "en": "Heads low! I'm coverin' you!",
   "ro": "Capetele jos! Te acopăr!"
  },
  {
   "key": "2235088981728567300",
   "en": "Takin' heavy losses!",
   "ro": "Suferim pierderi grele!"
  },
  {
   "key": "2235088981997002756",
   "en": "Huh?",
   "ro": "Hm?"
  }
 ]
}
