{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_m_21_enus_25.json",
 "entries": [
  {
   "key": "1922631935047770116",
   "en": "You in a rush to get somewhere?",
   "ro": "Te grăbești undeva?"
  },
  {
   "key": "1922631935081324548",
   "en": "Eh, same old same old.",
   "ro": "Eh, tot aia."
  },
  {
   "key": "1922631935131656196",
   "en": "Watch it!",
   "ro": "Ai grijă!"
  },
  {
   "key": "1922631935165210628",
   "en": "What are you, blind?",
   "ro": "Ce, ești orb?"
  },
  {
   "key": "1922631935198765060",
   "en": "Hey, you called?",
   "ro": "Hei, ai sunat?"
  },
  {
   "key": "1922631935265873924",
   "en": "What the hell…? Didn't work, yeah? Ugh, again?! Not qualified...",
   "ro": "Ce naiba…? N-a mers, da? Ugh, iar?! Nu-s bun de nimic..."
  },
  {
   "key": "1922631935282651140",
   "en": "I'm not coming out of here… Yeah… Guess I got to… Maybe on the corner?",
   "ro": "Nu ies de aici… Da… Cred că trebuie… Poate la colț?"
  },
  {
   "key": "1922631935332982788",
   "en": "Thanks. Bye.",
   "ro": "Mersi. Pa."
  },
  {
   "key": "1922631935517532164",
   "en": "Just what I needed!",
   "ro": "Exact ce-mi trebuia!"
  },
  {
   "key": "1922631935551086596",
   "en": "Oh Jesus, Mary and Joseph…!",
   "ro": "Oh, Doamne, Dumnezeule…!"
  },
  {
   "key": "1922631935651749892",
   "en": "Why me?",
   "ro": "De ce eu?"
  },
  {
   "key": "1922631935685304324",
   "en": "Not like this!",
   "ro": "Nu așa!"
  },
  {
   "key": "1922631935819522048",
   "en": "I'd like to be alone.",
   "ro": "Aș vrea să fiu singur."
  },
  {
   "key": "1922631935836299268",
   "en": "Would ya stop following me?",
   "ro": "Ai putea să nu mă mai urmărești?"
  }
 ]
}
