{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_10_afam_40_big.json",
 "entries": [
  {
   "key": "1949151209410568196",
   "en": "Oh look! Another fan, is that it?",
   "ro": "Oh, uite! Încă un fan, nu?"
  },
  {
   "key": "1949151209427345412",
   "en": "How can I help you?",
   "ro": "Cu ce te pot ajuta?"
  },
  {
   "key": "1949151209477677060",
   "en": "Hey! You can't do that here!",
   "ro": "Hei! Nu poți face asta aici!"
  },
  {
   "key": "1949151209494454276",
   "en": "Get out before you get in trouble.",
   "ro": "Ieși înainte să ai probleme."
  },
  {
   "key": "1949151209561563136",
   "en": "Oh, no, no, no, no, no! Take that away!",
   "ro": "Nu, nu, nu, nu, nu! Ia-o de-aici!"
  },
  {
   "key": "1949151209578340356",
   "en": "Put away your weapon.",
   "ro": "Pune-ți arma la loc."
  },
  {
   "key": "1949151209628672004",
   "en": "No jokes. Or they'll drop you.",
   "ro": "Fără glume. Altfel te împușcă."
  },
  {
   "key": "1949151209645449220",
   "en": "This will end in a bloodbath.",
   "ro": "Asta se va termina într-un masacru."
  },
  {
   "key": "1949151209695780868",
   "en": "Good… good.",
   "ro": "Bine… bine."
  },
  {
   "key": "1949151209712558084",
   "en": "That's better.",
   "ro": "Așa e mai bine."
  },
  {
   "key": "1949151209762889732",
   "en": "Hm… Something's wrong here.",
   "ro": "Hm… Ceva nu e în regulă aici."
  },
  {
   "key": "1949151209779666948",
   "en": "I don't understand.",
   "ro": "Nu înțeleg."
  },
  {
   "key": "1949151209829998596",
   "en": "Nothing. Must be gettin' old.",
   "ro": "Nimic. Trebuie că mă îmbătrânesc."
  },
  {
   "key": "1949151209863553028",
   "en": "I'm getting jumpy…",
   "ro": "Mă agit…"
  },
  {
   "key": "1949151209913884676",
   "en": "We playin' hide and seek?",
   "ro": "Jucăm de-a v-ați ascunselea?"
  },
  {
   "key": "1949151209930661892",
   "en": "I'll find you anyway.",
   "ro": "Te găsesc oricum."
  },
  {
   "key": "1949151209980993540",
   "en": "Don't push me!",
   "ro": "Nu mă împinge!"
  },
  {
   "key": "1949151209997770756",
   "en": "Hey! You!",
   "ro": "Hei! Tu!"
  },
  {
   "key": "1949151210031325188",
   "en": "It's me. We need to postpone the interview.",
   "ro": "Sunt eu. Trebuie să amânăm interviul."
  },
  {
   "key": "1949151210081656836",
   "en": "I have a session… Yeah, they wanted it before the battle… You know, presentation… Coupla pics at the gym.",
   "ro": "Am o sesiune… Da, o voiau înainte de bătălie… Știi tu, prezentare… Câteva poze la sală."
  },
  {
   "key": "1949151210098434052",
   "en": "Whadaya mean, where…? On the cover…! Pff, I wouldn't waste my time… You know me.",
   "ro": "Cum adică, unde…? Pe copertă…! Pff, nu mi-aș pierde timpul… Mă cunoști."
  },
  {
   "key": "1949151210131988484",
   "en": "We'll make it, don't worry.",
   "ro": "O să reușim, nu-ți face griji."
  },
  {
   "key": "1949151210165542916",
   "en": "Oh, great.",
   "ro": "Oh, minunat."
  },
  {
   "key": "1949151210517864452",
   "en": "Hey! Deal with her!",
   "en_m": "Hey! Deal with him!",
   "ro": "Hei! Ocupă-te de ea!",
   "ro_m": "Hei! Ocupă-te de el!"
  },
  {
   "key": "1949151210534641668",
   "en": "She's armed! Hurry!",
   "en_m": "He's armed! Hurry!",
   "ro": "E înarmată! Grăbește-te!",
   "ro_m": "E înarmat! Grăbește-te!"
  },
  {
   "key": "1949151210635304964",
   "en": "She's armed! Run!",
   "en_m": "He's armed! Run!",
   "ro": "E înarmată! Fugi!",
   "ro_m": "E înarmat! Fugi!"
  },
  {
   "key": "1949151210652082180",
   "en": "Don't provoke her!",
   "en_m": "Don't provoke him!",
   "ro": "Nu o provoca!",
   "ro_m": "Nu-l provoca!"
  },
  {
   "key": "1949151210735968260",
   "en": "What good'll this do you?",
   "ro": "La ce-ți folosește asta?"
  },
  {
   "key": "1949151210752745476",
   "en": "Let me be. Please.",
   "ro": "Lasă-mă în pace. Te rog."
  },
  {
   "key": "1949151210836631556",
   "en": "I wouldn't try anything if I were you.",
   "ro": "Nu aș încerca nimic dacă aș fi în locul tău."
  },
  {
   "key": "1949151210853408772",
   "en": "No pictures, understand? I'm warning you.",
   "ro": "Fără poze, înțeles? Te avertizez."
  }
 ]
}
