{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_6th_f_01_enus_40.json",
 "entries": [
  {
   "key": "1789967661301862404",
   "en": "Ever fight for anything in your life?",
   "ro": "Ai luptat vreodată pentru ceva în viața ta?"
  },
  {
   "key": "1789967661335416832",
   "en": "What? Call yourself a city girl?",
   "en_m": "What? Call yourself a city boy?",
   "ro": "Ce? Tu te crezi fată de oraș?",
   "ro_m": "Ce? Tu te crezi băiat de oraș?"
  },
  {
   "key": "1789967661385748480",
   "en": "The hell you think you're goin', punk?",
   "ro": "Ce dracu' crezi că faci, golanule?"
  },
  {
   "key": "1789967661402525700",
   "en": "This is our turf. Get out.",
   "ro": "Aici e teritoriul nostru. Valea!"
  },
  {
   "key": "1789967661469634564",
   "en": "Drop your weapon. Now.",
   "ro": "Aruncă arma. Acum."
  },
  {
   "key": "1789967661486411780",
   "en": "'Ey! Quit wavin' that around, gonk.",
   "ro": "Hei! Nu mai flutura aia, fraierule!"
  },
  {
   "key": "1789967661553520644",
   "en": "Keep your ass where it belongs, kid.",
   "ro": "Stai unde-ți e locul, puștiule."
  },
  {
   "key": "1789967661570297860",
   "en": "'Bout to cross the line, punk.",
   "ro": "Ești pe punctul să treci linia, golanule."
  },
  {
   "key": "1789967661654183940",
   "en": "Keep followin' orders, you might just live, sunshine.",
   "ro": "Continuă să urmezi ordinele și poate scapi cu viață, soare."
  },
  {
   "key": "1789967661670961156",
   "en": "Good, good... Now fuck off.",
   "ro": "Bine, bine... Acum cară-te!"
  },
  {
   "key": "1789967661721292804",
   "en": "Got some suspicious activity here.",
   "ro": "Avem activitate suspectă aici."
  },
  {
   "key": "1789967661754847236",
   "en": "Suspicious indeed...",
   "ro": "Suspect, într-adevăr..."
  },
  {
   "key": "1789967661805178884",
   "en": "Area secured.",
   "ro": "Zonă securizată."
  },
  {
   "key": "1789967661821956100",
   "en": "All right. 'Nough goin' round in circles.",
   "ro": "Bine. Destul cu învârtitul în cerc."
  },
  {
   "key": "1789967661872287748",
   "en": "Now – if I was a little punk bitch, where'd I hide...",
   "ro": "Acum – dacă aș fi o javră de golan, unde m-aș ascunde..."
  },
  {
   "key": "1789967661905842176",
   "en": "Helloooo? Where you at?",
   "ro": "Halloooo? Unde ești?"
  },
  {
   "key": "1789967661939396612",
   "en": "Fuck. We gotta problem...",
   "ro": "Futu-i. Avem o problemă..."
  },
  {
   "key": "1789967661972951044",
   "en": "Rog that.",
   "ro": "Am înțeles."
  },
  {
   "key": "1789967662023282692",
   "en": "Contact! We got enemy contact!",
   "ro": "Contact! Avem contact inamic!"
  },
  {
   "key": "1789967662056837124",
   "en": "Shut the fuck up and get 'em!",
   "ro": "Taci dracu' din gură și ia-i!"
  },
  {
   "key": "1789967662090391556",
   "en": "Got somethin' for ya here!",
   "ro": "Am ceva pentru tine aici!"
  },
  {
   "key": "1789967662140723204",
   "en": "Together! Stay strong!",
   "ro": "Împreună! Țineți-vă tari!"
  },
  {
   "key": "1789967662174277636",
   "en": "Put some heart into it! Kill! KILL!",
   "ro": "Puneți suflet! Ucideți! UCIDEȚI!"
  },
  {
   "key": "1789967662241386500",
   "en": "No! No! No! Not how we fuckin' play!",
   "ro": "Nu! Nu! Nu! Așa nu jucăm noi, pula mea!"
  },
  {
   "key": "1789967662274940932",
   "en": "Get your shit together, soldiers!",
   "ro": "Adunați-vă, soldați!"
  },
  {
   "key": "1789967662342049792",
   "en": "Fuck you!",
   "ro": "Futu-te!"
  },
  {
   "key": "1789967662358827012",
   "en": "Hands to yourself!",
   "ro": "Ține-ți mâinile la tine!"
  },
  {
   "key": "1789967662392381444",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1789967662442713092",
   "en": "Glad you called... Yeah... Yeah, 'course I...",
   "ro": "Mă bucur că ai sunat... Da... Da, sigur că..."
  },
  {
   "key": "1789967662459490308",
   "en": "Uh-huh... Mmhm... But they're all still OK?",
   "ro": "Uh-huh... Mmhm... Dar toți sunt bine?"
  },
  {
   "key": "1789967662526599168",
   "en": "Get behind her!",
   "en_m": "Get behind him!",
   "ro": "Pune-te în spatele ei!",
   "ro_m": "Pune-te în spatele lui!"
  },
  {
   "key": "1789967662560153604",
   "en": "Roger that!",
   "ro": "Am înțeles!"
  },
  {
   "key": "1789967662593708036",
   "en": "Get out! Hut two!",
   "ro": "Valea! Hut two!"
  },
  {
   "key": "1789967662627262468",
   "en": "Love you too.",
   "ro": "Și eu te iubesc."
  },
  {
   "key": "1789967662660816896",
   "en": "What was that?!",
   "ro": "Ce-a fost asta?!"
  },
  {
   "key": "1789967662694371332",
   "en": "Psst! ...psst! C'mon, let's check it out.",
   "ro": "Pssst! ...pssst! Hai, să vedem."
  },
  {
   "key": "1789967662711148548",
   "en": "Hey, kid. Follow me.",
   "ro": "Hei, puștiule. Vino după mine."
  },
  {
   "key": "1789967662761480196",
   "en": "Go check it! Now!",
   "ro": "Du-te să verifici! Acum!"
  },
  {
   "key": "1789967662778257412",
   "en": "Remember what you're fighting for!",
   "ro": "Amintiți-vă pentru ce luptați!"
  },
  {
   "key": "1789967662811811844",
   "en": "Aughh... Let me... ecchh... echh...",
   "ro": "Aughh... Lasă-mă... ecchh... echh..."
  },
  {
   "key": "1790026090624159744",
   "en": "Really, hon, it's not a problem...",
   "ro": "Chiar, dragă, nu e nicio problemă..."
  },
  {
   "key": "1790026395852050432",
   "en": "Good, good... Sure, I understand.",
   "ro": "Bine, bine... Sigur, am înțeles."
  },
  {
   "key": "1958879526074228740",
   "en": "S'OK, we don't have to do this now.",
   "ro": "E în regulă, nu trebuie să facem asta acum."
  },
  {
   "key": "1958879526124560388",
   "en": "Where did we leave off?",
   "ro": "De unde am rămas?"
  },
  {
   "key": "1958879526141337604",
   "en": "Make up your mind already.",
   "ro": "Hotărăște-te odată."
  }
 ]
}
