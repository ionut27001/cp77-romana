 "entries": [
  {
   "key": "1856131275093041156",
   "en": "Mhm.",
   "ro": "Mhm."
  },
  {
   "key": "1856131275109818372",
   "en": "Leave me alone.",
   "ro": "Lasă-mă în pace."
  },
  {
   "key": "1856131275160150020",
   "en": "Don't even try. Back it up.",
   "ro": "Nu încerca. Dă-te înapoi."
  },
  {
   "key": "1856131275176927236",
   "en": "Move back. Now!",
   "ro": "Dă-te înapoi. Acum!"
  },
  {
   "key": "1856131275227258884",
   "en": "Quit waving that around!",
   "ro": "Nu mai flutura aia!"
  },
  {
   "key": "1856131275244036100",
   "en": "Stash it! Right now!",
   "ro": "Pune-o la loc! Acum!"
  },
  {
   "key": "1856131275294367748",
   "en": "Go ahead, try me.",
   "ro": "Hai, încearcă-mă."
  },
  {
   "key": "1856131275311144964",
   "en": "Another sec and you're gone. Try us.",
   "ro": "Încă o secundă și dispari. Încearcă-ne."
  },
  {
   "key": "1856131275344699396",
   "en": "Wise move.",
   "ro": "Bine ai făcut."
  },
  {
   "key": "1856131275378253828",
   "en": "That's better. Do what you're told.",
   "ro": "Așa e mai bine. Fă ce ți se spune."
  },
  {
   "key": "1856131275428585472",
   "en": "Hmm?",
   "ro": "Hmm?"
  },
  {
   "key": "1856131275445362688",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1856131275478917124",
   "en": "Secured the area.",
   "ro": "Am securizat zona."
  },
  {
   "key": "1856131275512471552",
   "en": "Code 4, under control.",
   "ro": "Cod 4, sub control."
  },
  {
   "key": "1856131275562803204",
   "en": "We will find you!",
   "ro": "Te vom găsi!"
  },
  {
   "key": "1856131275579580420",
   "en": "You won't squirm out of this one!",
   "ro": "Nu scapi din asta!"
  },
  {
   "key": "1856131275613134852",
   "en": "Fuck. Another one.",
   "ro": "Futu-i. Încă unul."
  },
  {
   "key": "1856131275646689284",
   "en": "Roger that!",
   "ro": "Am înțeles!"
  },
  {
   "key": "1856131275697020932",
   "en": "Eliminate her!",
   "en_m": "Eliminate him!",
   "ro": "Eliminați-o!",
   "ro_m": "Eliminați-l!"
  },
  {
   "key": "1856131275713798148",
   "en": "Destroy her!",
   "en_m": "Destroy him!",
   "ro": "Distrugeți-o!",
   "ro_m": "Distrugeți-l!"
  },
  {
   "key": "1856131275747352580",
   "en": "One in the air!",
   "ro": "Unul în aer!"
  },
  {
   "key": "1856131275797684228",
   "en": "She's mine!",
   "en_m": "He's mine!",
   "ro": "E a mea!",
   "ro_m": "E al meu!"
  },
  {
   "key": "1856131275814461444",
   "en": "Attack!",
   "ro": "Atacă!"
  },
  {
   "key": "1856131275864793092",
   "en": "Medic! Need a medic!",
   "ro": "Medic! Am nevoie de un medic!"
  },
  {
   "key": "1856131275881570308",
   "en": "Where's the fuckin' medic!",
   "ro": "Unde-i medicul dracului!"
  },
  {
   "key": "1856131275915124740",
   "en": "I'll remember you.",
   "ro": "O să te țin minte."
  },
  {
   "key": "1856131275948679172",
   "en": "You're askin' for trouble.",
   "ro": "Ceri necazuri."
  },
  {
   "key": "1856131275965456388",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1856131276015788036",
   "en": "Mhm... didn't go too great... yeah... at least three officers…",
   "ro": "Mhm... n-a mers prea bine... da... cel puțin trei ofițeri…"
  },
  {
   "key": "1856131276032565252",
   "en": "Yeah... yeah, it was my op... mhm…",
   "ro": "Da... da, a fost operațiunea mea... mhm…"
  },
  {
   "key": "1856131276082896900",
   "en": "Draw her out!",
   "en_m": "Draw him out!",
   "ro": "Scoateți-o!",
   "ro_m": "Scoateți-l!"
  },
  {
   "key": "1856131276116451332",
   "en": "Pin her down!",
   "en_m": "Pin him down!",
   "ro": "Imobilizează-o!",
   "ro_m": "Imobilizează-l!"
  },
  {
   "key": "1856131276150005764",
   "en": "Fucking hell!",
   "ro": "Pula mea!"
  },
  {
   "key": "1856131276166782980",
   "en": "Yep, all set up. Later.",
   "ro": "Da, totul e aranjat. Pe mai târziu."
  },
  {
   "key": "1856131276183560196",
   "en": "Full alert.",
   "ro": "Alertă maximă."
  },
  {
   "key": "1856131276217114628",
   "en": "Better get ready.",
   "ro": "Pregătiți-vă."
  },
  {
   "key": "1856131276233891844",
   "en": "Alert and ready, OK?",
   "ro": "Alertă și pregătiți, OK?"
  },
  {
   "key": "1856131276267446276",
   "en": "Move. Go ahead.",
   "ro": "Mișcă. Înainte."
  },
  {
   "key": "1856131276301000708",
   "en": "Forward! Go!",
   "ro": "Înainte! Haide!"
  },
  {
   "key": "1856131276317777924",
   "en": "Arghh... let go...",
   "ro": "Arghh... dă drumul..."
  },
  {
   "key": "1867757533610500096",
   "en": "Mhm... too bad... Where? OK...",
   "ro": "Mhm... păcat... Unde? OK..."
  },
  {
   "key": "1867757849357705216",
   "en": "'Course I take full responsibility... mhm...",
   "ro": "Sigur că îmi asum toată responsabilitatea... mhm..."
  }
 ]
