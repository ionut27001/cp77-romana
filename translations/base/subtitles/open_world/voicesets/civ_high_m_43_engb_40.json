{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_43_engb_40.json",
 "entries": [
  {
   "key": "1948872763224662016",
   "en": "Go back to your sewer.",
   "ro": "Înapoi în canalul tău."
  },
  {
   "key": "1948872763241439236",
   "en": "Out my sight. You disgust me.",
   "ro": "Dispari din fața mea. Mă dezgusti."
  },
  {
   "key": "1948872763291770884",
   "en": "You there! Scram.",
   "ro": "Tu, de acolo! Cară-te!"
  },
  {
   "key": "1948872763308548100",
   "en": "Fuck off. You hear?",
   "ro": "Du-te dracu'. Ai auzit?"
  },
  {
   "key": "1948872763358879748",
   "en": "Oh no…. Put that away!",
   "ro": "Oh, nu…. Pune-o la loc!"
  },
  {
   "key": "1948872763375656964",
   "en": "Put it away, I tell you! Now!",
   "ro": "Pune-o la loc, îți spun! Acum!"
  },
  {
   "key": "1948872763425988612",
   "en": "You're in for it!",
   "ro": "O să pățești!"
  },
  {
   "key": "1948872763442765828",
   "en": "They're coming for you!",
   "ro": "Vin după tine!"
  },
  {
   "key": "1948872763509874692",
   "en": "Smart… very smart.",
   "ro": "Deștept… foarte deștept."
  },
  {
   "key": "1948872763543429124",
   "en": "Wise choice.",
   "ro": "Alegere înțeleaptă."
  },
  {
   "key": "1948872763593760772",
   "en": "What was that?",
   "ro": "Ce-a fost asta?"
  },
  {
   "key": "1948872763627315204",
   "en": "Fuck, there's somebody there!",
   "ro": "Futu-i, e cineva acolo!"
  },
  {
   "key": "1948872763694424068",
   "en": "Not a soul.",
   "ro": "Niciun suflet."
  },
  {
   "key": "1948872763711201284",
   "en": "Maybe there was nobody…?",
   "ro": "Poate nu era nimeni…?"
  },
  {
   "key": "1948872763778310148",
   "en": "I'm not stupid! Show yourself!",
   "ro": "Nu-s prost! Arată-te!"
  },
  {
   "key": "1948872763811864580",
   "en": "I will find you!",
   "ro": "Te găsesc eu!"
  },
  {
   "key": "1948872763862196228",
   "en": "I don't believe it!",
   "ro": "Nu-mi vine să cred!"
  },
  {
   "key": "1948872763878973444",
   "en": "Sorry!",
   "ro": "Scuze!"
  },
  {
   "key": "1948872763912527876",
   "en": "What's new?",
   "ro": "Ce mai e nou?"
  },
  {
   "key": "1948872763979636740",
   "en": "Horrible… I've never been so… humiliated. What did we do last time?",
   "ro": "Groaznic… N-am mai fost niciodată atât de… umilit. Ce-am făcut ultima dată?"
  },
  {
   "key": "1948872763996413956",
   "en": "We can do it again… Old methods are best… Just take him somewhere… With your free hand.",
   "ro": "Putem s-o facem iar… Metodele vechi sunt cele mai bune… Doar du-l undeva… Cu mâna liberă."
  },
  {
   "key": "1948872764046745600",
   "en": "Tell me.",
   "ro": "Spune-mi."
  },
  {
   "key": "1948872764063522820",
   "en": "What was that?",
   "ro": "Ce-a fost asta?"
  },
  {
   "key": "1948872764415844356",
   "en": "Guards! Here!",
   "ro": "Gărzi! Aici!"
  },
  {
   "key": "1948872764432621572",
   "en": "Emergency! Over here!",
   "ro": "Urgență! Aici!"
  },
  {
   "key": "1948872764533284868",
   "en": "Police!",
   "ro": "Poliția!"
  },
  {
   "key": "1948872764550062084",
   "en": "Help me, for fuck's sake!",
   "ro": "Ajută-mă, pula mea!"
  },
  {
   "key": "1948872764633948164",
   "en": "I'll pay! Just don't do this! No!",
   "ro": "Plătesc! Nu face asta! Nu!"
  },
  {
   "key": "1948872764667502596",
   "en": "Take someone else! Not me!",
   "ro": "Ia pe altcineva! Nu pe mine!"
  },
  {
   "key": "1948872764751388676",
   "en": "Get away from me. Right now.",
   "ro": "Cară-te de lângă mine. Acum."
  },
  {
   "key": "1948872764768165892",
   "en": "Do not touch me. Understand?",
   "ro": "Nu mă atinge. Ai înțeles?"
  }
 ]
}
