{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_17_chn_50.json",
 "entries": [
  {
   "key": "1948824747117682692",
   "en": "What?",
   "ro": "Ce?"
  },
  {
   "key": "1948824747134459908",
   "en": "I'm a little out of your league, don't you think?",
   "ro": "Sunt cam peste nivelul tău, nu?"
  },
  {
   "key": "1948824747235123200",
   "en": "This is no place for scum.",
   "ro": "Aici nu e loc pentru jeguri."
  },
  {
   "key": "1948824747268677636",
   "en": "Scram!",
   "ro": "Cară-te!"
  },
  {
   "key": "1948824747352563716",
   "en": "What the… Get that out of here!",
   "ro": "Ce pula mea… Scoate asta de aici!"
  },
  {
   "key": "1948824747386118148",
   "en": "You wouldn't dare!",
   "ro": "N-ai îndrăzni!"
  },
  {
   "key": "1948824747470004228",
   "en": "They will take you down!",
   "ro": "Te vor doborî!"
  },
  {
   "key": "1948824747503558660",
   "en": "I'll count to three… One… Two…",
   "ro": "Număr până la trei… Unu… Doi…"
  },
  {
   "key": "1948824747553890308",
   "en": "That's right! Know your place!",
   "ro": "Așa e! Cunoaște-ți locul!"
  },
  {
   "key": "1948824747587444740",
   "en": "So? Was that so hard?",
   "ro": "Și? A fost așa de greu?"
  },
  {
   "key": "1948824747654553600",
   "en": "What’s this?",
   "ro": "Ce e asta?"
  },
  {
   "key": "1948824747671330820",
   "en": "Why is this happening?",
   "ro": "De ce se întâmplă asta?"
  },
  {
   "key": "1948824747704885252",
   "en": "Ha. Nobody here?",
   "ro": "Ha. Nimeni aici?"
  },
  {
   "key": "1948824747738439684",
   "en": "Was that a hallucination?",
   "ro": "A fost o halucinație?"
  },
  {
   "key": "1948824747771994116",
   "en": "Show yourself!",
   "ro": "Arată-te!"
  },
  {
   "key": "1948824747805548548",
   "en": "I'll find you one way or another!",
   "ro": "Te găsesc într-un fel sau altul!"
  },
  {
   "key": "1948824747839102980",
   "en": "What the?!",
   "ro": "Ce dracu'?!"
  },
  {
   "key": "1948824747855880196",
   "en": "Out of my way!",
   "ro": "Dă-te din calea mea!"
  },
  {
   "key": "1948824747906211844",
   "en": "You dare to call me?",
   "ro": "Îndrăznești să mă chemi?"
  },
  {
   "key": "1948824747956543488",
   "en": "No…! I already told you… You had your chance. You know it… I... I don't give a shit.",
   "ro": "Nu…! Ți-am spus deja… Ai avut șansa ta. Știi asta… Eu... Mă doare-n cur."
  },
  {
   "key": "1948824747973320708",
   "en": "Don't count on mother… I talked to a lawyer… You have a week… No! Not a word!",
   "ro": "Nu te baza pe mama… Am vorbit cu un avocat… Ai o săptămână… Nu! Niciun cuvânt!"
  },
  {
   "key": "1948824748023652356",
   "en": "Don't fuck this up.",
   "ro": "N-o fute!"
  },
  {
   "key": "1948824748057206788",
   "en": "What the fuck is going on here!?",
   "ro": "Ce pula mea se întâmplă aici!?"
  },
  {
   "key": "1948824748510191620",
   "en": "Intruder! Do you hear?!",
   "ro": "Intrus! Auzi?!"
  },
  {
   "key": "1948824748526968836",
   "en": "Kill her! Now!",
   "en_m": "Kill him! Now!",
   "ro": "Omoar-o! Acum!",
   "ro_m": "Omoară-l! Acum!"
  },
  {
   "key": "1948824748627632128",
   "en": "Protect me!",
   "ro": "Protejează-mă!"
  },
  {
   "key": "1948824748644409348",
   "en": "Fuck this psycho up!",
   "ro": "Bate-o pe psycho asta!",
   "ro_m": "Bate-l pe psycho asta!"
  },
  {
   "key": "1948824748728295428",
   "en": "How… how dare you?!",
   "ro": "Cum… cum îndrăznești?!"
  },
  {
   "key": "1948824748745072644",
   "en": "You'll regret this!",
   "ro": "O să regreți!"
  },
  {
   "key": "1948824748845735940",
   "en": "Go back to your hidey-hole.",
   "ro": "Întoarce-te în gaura ta."
  },
  {
   "key": "1948824748896067584",
   "en": "I don't associate with sewer rats.",
   "ro": "Nu mă asociez cu șobolanii de canal."
  }
 ]
}
