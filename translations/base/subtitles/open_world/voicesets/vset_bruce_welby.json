 "entries": [
  {
   "key": "1895210266365554692",
   "en": "Hey.",
   "ro": "Hei."
  },
  {
   "key": "1895210266382331908",
   "en": "How's it goin'?",
   "ro": "Cum merge?"
  },
  {
   "key": "1895210266449440772",
   "en": "Hey, don't leave me here!",
   "ro": "Hei, nu mă lăsa aici!"
  },
  {
   "key": "1895210266466217988",
   "en": "W-wait, where are you going?",
   "ro": "A-așteaptă, unde te duci?"
  },
  {
   "key": "1895210266516549632",
