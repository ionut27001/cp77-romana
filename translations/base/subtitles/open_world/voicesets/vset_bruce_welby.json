   "ro": "M-ai făcut să mă îngrijorez!"
  },
  {
   "key": "1895210266533326852",
   "en": "I could've been shot!",
   "ro": "Puteam să fiu împușcat!"
  },
  {
   "key": "1895210266550104068",
   "en": "They'll get us 'cause of you!",
   "ro": "Ne prind din cauza ta!"
  },
  {
   "key": "1895210266566881284",
   "en": "If you're here to get me out, do it already!",
   "ro": "Dacă ai venit să mă scoți, fă-o odată!"
  },
  {
   "key": "1895210266784985092",
   "en": "Hey!",
   "ro": "Hei!"
  },
  {
   "key": "1895210266801762308",
