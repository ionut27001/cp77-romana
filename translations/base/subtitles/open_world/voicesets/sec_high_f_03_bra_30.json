{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_high_f_03_bra_30.json",
 "entries": [
  {
   "key": "1898045725491077124",
   "en": "I want you out of my sight.",
   "ro": "Vreau să nu te mai văd."
  },
  {
   "key": "1898045725507854340",
   "en": "Obey, and I won't hurt you.",
   "ro": "Ascultă, și n-o să te rănesc."
  },
  {
   "key": "1898045725558185988",
   "en": "You need to step back.",
   "ro": "Trebuie să te dai înapoi."
  },
  {
   "key": "1898045725591740420",
   "en": "Stand back. Now.",
   "ro": "Dă-te înapoi. Acum."
  },
  {
   "key": "1898045725642072068",
   "en": "Potential imminent terrorist attack.",
   "ro": "Posibil atentat terorist iminent."
  },
  {
   "key": "1898045725658849284",
   "en": "The individual may pose a threat.",
   "ro": "Individul poate fi o amenințare."
  },
  {
   "key": "1898045725709180932",
   "en": "Surrender.",
   "ro": "Predă-te."
  },
  {
   "key": "1898045725725958148",
   "en": "Don't try anything.",
   "ro": "Nu încerca nimic."
  },
  {
   "key": "1898045725793067012",
   "en": "Keep moving back.",
   "ro": "Mai dă-te înapoi."
  },
  {
   "key": "1898045725826621444",
   "en": "Get far from here.",
   "ro": "Pleacă cât mai departe de aici."
  },
  {
   "key": "1898045725893730308",
   "en": "Enemy contact possible.",
   "ro": "Posibil contact cu inamicul."
  },
  {
   "key": "1898045725910507524",
   "en": "Something's up.",
   "ro": "Se întâmplă ceva."
  },
  {
   "key": "1898045725977616384",
   "en": "False alarm.",
   "ro": "Alarmă falsă."
  },
  {
   "key": "1898045726011170816",
   "en": "No threat detected.",
   "ro": "Nicio amenințare detectată."
  },
  {
   "key": "1898045726078279684",
   "en": "She's close! I can feel it.",
   "en_m": "He's close! I can feel it.",
   "ro": "E aproape! O simt.",
   "ro_m": "E aproape! Îl simt."
  },
  {
   "key": "1898045726095056900",
   "en": "Surrender or die.",
   "ro": "Predă-te sau mori."
  },
  {
   "key": "1898045726128611332",
   "en": "No vital signs!",
   "ro": "Fără semne vitale!"
  },
  {
   "key": "1898045726178942980",
   "en": "Understood!",
   "ro": "Înțeles!"
  },
  {
   "key": "1898045726229274628",
   "en": "You're mine.",
   "ro": "Te-am prins!"
  },
  {
   "key": "1898045726246051844",
   "en": "Big mistake.",
   "ro": "Mare greșeală."
  },
  {
   "key": "1898045726279606276",
   "en": "Up and away!",
   "ro": "Sus și la drum!"
  },
  {
   "key": "1898045726346715140",
   "en": "Handle her!",
   "en_m": "Handle him!",
   "ro": "Ocupă-te de ea!",
   "ro_m": "Ocupă-te de el!"
  },
  {
   "key": "1898045726363492356",
   "en": "I want her dead!",
   "en_m": "I want him dead!",
   "ro": "Vreau să o omor!",
   "ro_m": "Vreau să-l omor!"
  },
  {
   "key": "1898045726430601220",
   "en": "I'm hit! Cover me!",
   "ro": "M-au lovit! Acoperă-mă!"
  },
  {
   "key": "1898045726447378436",
   "en": "Need backup!",
   "ro": "Am nevoie de întăriri!"
  },
  {
   "key": "1898045726497710084",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1898045726531264516",
   "en": "You're asking for it.",
   "ro": "O cauți cu lumânarea."
  },
  {
   "key": "1898045726564818948",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1898045726615150596",
   "en": "Directions…? Who else knows about this…? Can I kill him…? Uh-huh… Ok… fine, I'll take care of it.",
   "ro": "Indicații...? Cine mai știe de chestia asta...? Pot să-l omor...? Mda... Bine, ok, mă ocup."
  },
  {
   "key": "1898045726631927812",
   "en": "Ok… Where'd'you lose the car?",
   "ro": "Ok... Unde ai pierdut mașina?"
  },
  {
   "key": "1898045726699036676",
   "en": "Take the high ground!",
   "ro": "Ocupați poziția înaltă!"
  },
  {
   "key": "1898045726749368324",
   "en": "On my way!",
   "ro": "Vin!"
  },
  {
   "key": "1898045726782922756",
   "en": "On the ground!",
   "ro": "La pământ!"
  },
  {
   "key": "1898045726799699972",
   "en": "Take care.",
   "ro": "Ai grijă de tine."
  },
  {
   "key": "1898045726850031616",
   "en": "I'm on it.",
   "ro": "Mă ocup."
  },
  {
   "key": "1898045726917140484",
   "en": "Be on high alert!",
   "ro": "Fiți în alertă maximă!"
  },
  {
   "key": "1898045726950694916",
   "en": "Prepare for enemy contact.",
   "ro": "Pregătiți-vă de contact cu inamicul."
  },
  {
   "key": "1898045727001026564",
   "en": "Covering you.",
   "ro": "Te acopăr."
  },
  {
   "key": "1898045727034580996",
   "en": "Come on!",
   "ro": "Hai!"
  },
  {
   "key": "1898045727101689860",
   "en": "Argh… no… no… khe... khe...",
   "ro": "Argh... nu... nu... khe... khe..."
  },
  {
   "key": "1898160504515862528",
   "en": "So my priority is the BD, not the car…? Yeah, I'll talk to him, but I can't promise anything.",
   "ro": "Deci BD-ul e prioritatea, nu mașina...? Da, o să vorbesc cu el, da' nu pot promite nimic."
  }
 ]
