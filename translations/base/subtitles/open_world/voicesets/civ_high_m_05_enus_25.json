{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_05_enus_25.json",
 "entries": [
  {
   "key": "1878024878382653444",
   "en": "Umm... Hi...",
   "ro": "Umm... Salut..."
  },
  {
   "key": "1878024878399430660",
   "en": "Oh. Hey.",
   "ro": "Oh. Salut."
  },
  {
   "key": "1878024878449762308",
   "en": "What the hell?",
   "ro": "Ce naiba?"
  },
  {
   "key": "1878024878483316740",
   "en": "Watch where you're going!",
   "ro": "Uită-te pe unde mergi!"
  },
  {
   "key": "1878024878533648388",
   "en": "Yes? And who is this?",
   "ro": "Da? Și cine ești?"
  },
  {
   "key": "1878024878600757252",
   "en": "Yes, it's me... N-no, I didn't quite catch that... Do you know who you're talking to?",
   "ro": "Da, eu sunt... N-nu am prea înțeles... Știi cu cine vorbești?"
  },
  {
   "key": "1878024878634311684",
   "en": "A death threat? To me? Absolutely...! I'll make sure Father hears of this!",
   "ro": "O amenințare cu moartea? La mine? Absolut...! O să mă asigur că Tatăl află de asta!"
  },
  {
   "key": "1878024878667866116",
   "en": "Yes. Goodbye.",
   "ro": "Da. La revedere."
  },
  {
   "key": "1878024878835638276",
   "en": "Over here! Security!",
   "ro": "Aici! Securitate!"
  },
  {
   "key": "1878024878852415492",
   "en": "I-I haven't done anything!",
   "ro": "N-n-am făcut nimic!"
  },
  {
   "key": "1878024878953078788",
   "en": "I-I'm warning you...! I-I have connections...!",
   "ro": "Te-te avertizez...! Am conexiuni...!"
  },
  {
   "key": "1878024878969856004",
   "en": "Do you have any idea who I am?",
   "ro": "Ai habar cine sunt?"
  },
  {
   "key": "1878024879104073732",
   "en": "What do you want?",
   "ro": "Ce vrei?"
  },
  {
   "key": "1878024879187959812",
   "en": "Following me is a baaaaad idea.",
   "ro": "Să mă urmărești e o idee foarte proastă."
  },
  {
   "key": "3994150171527266304",
   "en": "What... what's going on?",
   "ro": "Ce... ce se întâmplă?"
  },
  {
   "key": "3994152555334778880",
   "en": "Oh God... Oh dear God!",
   "ro": "Oh, Doamne... Oh, Doamne!"
  }
 ]
}
