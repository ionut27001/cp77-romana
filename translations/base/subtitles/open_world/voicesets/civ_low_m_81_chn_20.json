{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_m_81_chn_20.json",
 "entries": [
  {
   "key": "1922666878935244804",
   "en": "Hmmm…? You're just passing through?",
   "ro": "Hmmm…? Doar treci pe aici?"
  },
  {
   "key": "1922666878952022020",
   "en": "Everything OK?",
   "ro": "Totul e în regulă?"
  },
  {
   "key": "1922666879035908096",
   "en": "Oh come on!",
   "ro": "Hai, mă!"
  },
  {
   "key": "1922666879052685316",
   "en": "What do you want?",
   "ro": "Ce vrei?"
  },
  {
   "key": "1922666879103016964",
   "en": "Hey…",
   "ro": "Hei…"
  },
  {
   "key": "1922666879170125828",
   "en": "Uh, I mean… Wanna… Go somewhere…? No, just us two.",
   "ro": "Ăă, adică… Vrei… Să mergem undeva…? Nu, doar noi doi."
  },
  {
   "key": "1922666879186903044",
   "en": "I know… I thought that… No….! I didn't mean…! Uh, like… I wanted more often.",
   "ro": "Știu… Mă gândeam că… Nu….! N-am vrut să…! Ăă, adică… Voiam să fie mai des."
  },
  {
   "key": "1922666879237234692",
   "en": "Of course. I get it.",
   "ro": "Desigur. Înțeleg."
  },
  {
   "key": "1922666879438561284",
   "en": "We're gonna die!",
   "ro": "O să murim!"
  },
  {
   "key": "1922666879472115716",
   "en": "Do something about her!",
   "en_m": "Do something about him !",
   "ro": "Fă ceva cu ea!",
   "ro_m": "Fă ceva cu el!"
  },
  {
   "key": "1922666879589556228",
   "en": "I don't…. I don't… No!",
   "ro": "Nu… Nu… Nu!"
  },
  {
   "key": "1922666879606333444",
   "en": "What's that for? Hey!",
   "ro": "La ce e asta? Hei!"
  },
  {
   "key": "1922666879723773956",
   "en": "What are you playing at?",
   "ro": "Ce jocuri faci?"
  },
  {
   "key": "1922666879740551172",
   "en": "I don't like this sneaking around.",
   "ro": "Nu-mi place să ne furișăm."
  }
 ]
