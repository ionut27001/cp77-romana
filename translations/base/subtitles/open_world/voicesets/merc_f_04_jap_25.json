{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\merc_f_04_jap_25.json",
 "entries": [
  {
   "key": "1958796344083652612",
   "en": "You look like shit, bad night?",
   "ro": "Arăți ca naiba, noapte grea?"
  },
  {
   "key": "1958796344100429828",
   "en": "There's work, but not for you.",
   "ro": "E de lucru, dar nu pentru tine."
  },
  {
   "key": "1958796344150761476",
   "en": "Step back.",
   "ro": "Dă-te înapoi."
  },
  {
   "key": "1958796344167538692",
   "en": "You're kidding me. Buzz off.",
   "ro": "Faci mișto de mine? Valea!"
  },
  {
   "key": "1958796344217870340",
   "en": "I will disarm you myself.",
   "ro": "Te dezarmez eu."
  },
  {
   "key": "1958796344234647556",
   "en": "Stop waving that thing.",
   "ro": "Nu mai flutura chestia aia."
  },
  {
   "key": "1958796344284979204",
   "en": "Ughh... Idiot.",
   "ro": "Ughh... Idiot."
  },
  {
   "key": "1958796344301756420",
   "en": "I'm talking to you.",
   "ro": "Cu tine vorbesc."
  },
  {
   "key": "1958796344352088068",
   "en": "<kiroshi l=\"jpn\" o=\"失せろ\" t=\"Get lost.\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"jpn\" o=\"失せろ\" t=\"Valea!\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1958796344368865284",
   "en": "Get out!",
   "ro": "Ieși afară!"
  },
  {
   "key": "1958796344419196932",
   "en": "Hmmm…",
   "ro": "Hmmm…"
  },
  {
   "key": "1958796344435974148",
   "en": "Hello? Hello? Who's there?",
   "ro": "Alo? Alo? Cine-i acolo?"
  },
  {
   "key": "1958796344486305796",
   "en": "No point wasting time.",
   "ro": "N-are rost să pierdem timpul."
  },
  {
   "key": "1958796344503083012",
   "en": "All clear.",
   "ro": "Totul curat."
  },
  {
   "key": "1958796344553414660",
   "en": "Come on out. Playtime's over.",
   "ro": "Ieși afară. S-a terminat joaca."
  },
  {
   "key": "1958796344570191876",
   "en": "You scared? You should be.",
   "ro": "Ți-e frică? Și bine faci."
  },
  {
   "key": "1958796344603746308",
   "en": "Well we got a problem.",
   "ro": "Ei bine, avem o problemă."
  },
  {
   "key": "1958796344637300740",
   "en": "<kiroshi l=\"jpn\" o=\"了解\" t=\"Copy that.\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"jpn\" o=\"了解\" t=\"Primit.\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1958796344687632388",
   "en": "Engaging fire!",
   "ro": "Deschid focul!"
  },
  {
   "key": "1958796344704409604",
   "en": "I got action!",
   "ro": "Am acțiune!"
  },
  {
   "key": "1958796344737964036",
   "en": "She'll blow!",
   "ro": "O să explodeze!"
  },
  {
   "key": "1958796344788295684",
   "en": "I know what Imma buy with your bounty!",
   "ro": "Știu ce-o să cumpăr cu recompensa ta!"
  },
  {
   "key": "1958796344805072900",
   "en": "Client wants her dead!",
   "en_m": "Client wants him dead!",
   "ro": "Clientul o vrea moartă!",
   "ro_m": "Clientul îl vrea mort!"
  },
  {
   "key": "1958796344855404548",
   "en": "Medic! Where's the medic!",
   "ro": "Medic! Unde-i medicul!"
  },
  {
   "key": "1958796344872181764",
   "en": "I don't want to die! Fuck!",
   "ro": "Nu vreau să mor! Futu-i!"
  },
  {
   "key": "1958796344922513412",
   "en": "Fuck you, scum!",
   "ro": "Du-te-n pula mea, jegosule!"
  },
  {
   "key": "1958796344939290628",
   "en": "Fuck off.",
   "ro": "Du-te dracu'!"
  },
  {
   "key": "1958796344989622276",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1958796345056731140",
   "en": "I can't… Dad, I'm on a job… Got it… Got that too.",
   "ro": "Nu pot… Tati, sunt în treabă… Am înțeles… Și pe aia o am."
  },
  {
   "key": "1958796345090285572",
   "en": "Can't today… That's right… Oh I don't know, but not anytime soon… Yeah, yeah… I ate it, thanks.",
   "ro": "Nu azi… Da, exact… Nu știu, dar nu prea curând… Da, da… Am mâncat, mersi."
  },
  {
   "key": "1958796345157394436",
   "en": "Fucking flank maneuvre!",
   "ro": "Manevră de flanc nenorocită!"
  },
  {
   "key": "1958796345190948868",
   "en": "Understood!",
   "ro": "Înțeles!"
  },
  {
   "key": "1958796345224503300",
   "en": "Heads down!",
   "ro": "Capetele jos!"
  },
  {
   "key": "1958796345241280516",
   "en": "Love you too, bye.",
   "ro": "Și eu te iubesc, pa."
  },
  {
   "key": "1958796345258057732",
   "en": "What the…",
   "ro": "Ce naiba…"
  },
  {
   "key": "1958796345308389380",
   "en": "Cover me, we gotta go check.",
   "ro": "Acoperă-mă, trebuie să verificăm."
  },
  {
   "key": "1958796345325166596",
   "en": "Come on. Time to work.",
   "ro": "Hai. Timpul de lucru."
  },
  {
   "key": "1958796345358721028",
   "en": "I'm covering you. Go.",
   "ro": "Te acopăr. Du-te."
  },
  {
   "key": "1958796345375498244",
   "en": "Kill her!",
   "en_m": "Kill him!",
   "ro": "Omoară-o!",
   "ro_m": "Omoară-l!"
  },
  {
   "key": "1958796345409052676",
   "en": "Ackkk… eckkh… let go… ekhhh.",
   "ro": "Ackkk… eckkh… dă drumul… ekhhh."
  },
  {
   "key": "1958803222524108800",
   "en": "Uh… Don't check on me, I know what I'm doing… Yeah.",
   "ro": "Ăă… Nu mă mai verifica, știu ce fac… Da."
  },
  {
   "key": "1958943183361581060",
   "en": "Very professional...",
   "ro": "Foarte profesionist..."
  },
  {
   "key": "1958943183411912708",
   "en": "Ready when you are.",
   "ro": "Sunt gata când ești și tu."
  },
  {
   "key": "1958943183428689924",
   "en": "Time's money!",
   "ro": "Timpul înseamnă bani!"
  }
 ]
