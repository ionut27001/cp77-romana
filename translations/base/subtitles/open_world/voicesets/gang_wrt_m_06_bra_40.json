{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_wrt_m_06_bra_40.json",
 "entries": [
  {
   "key": "1825885119197077508",
   "en": "You got a problem?",
   "ro": "Ai o problemă?"
  },
  {
   "key": "1825885119213854724",
   "en": "What're you starin' at?",
   "ro": "La ce te uiți?"
  },
  {
   "key": "1825885119247409156",
   "en": "Posers fuck off.",
   "ro": "Pozorii, du-te dracu'!"
  },
  {
   "key": "1825885119280963584",
   "en": "You got the wrong address.",
   "ro": "Ai greșit adresa."
  },
  {
   "key": "1825885119314518020",
   "en": "Hope you know how to use that, for your sake.",
   "ro": "Sper că știi să folosești chestia aia, pentru binele tău."
  },
  {
   "key": "1825885119331295236",
   "en": "Ooohh, I'm so scared!",
   "ro": "Ooohh, ce frică mi-e!"
  },
  {
   "key": "1825885119381626884",
   "en": "You're askin' for it!",
   "ro": "Ți-o cauți cu lumânarea!"
  },
  {
   "key": "1825885119398404100",
   "en": "You're gonna get on your knees and beg!",
   "ro": "O să te pui în genunchi și o să cerșești!"
  },
  {
   "key": "1825885119431958532",
   "en": "Bitch.",
   "ro": "Curvă."
  },
  {
   "key": "1825885119448735748",
   "en": "That's right - do what you're told.",
   "ro": "Așa da - fă ce ți se spune."
  },
  {
   "key": "1825885119499067396",
   "en": "Argh! What in the name of...?",
   "ro": "Argh! Ce naiba...?"
  },
  {
   "key": "1825885119515844612",
   "en": "Hell was that?",
   "ro": "Ce dracu' a fost asta?"
  },
  {
   "key": "1825885119549399044",
   "en": "Can't be too careful...",
   "ro": "Nu strică să fii precaut..."
  },
  {
   "key": "1825885119566176260",
   "en": "Done with this shit.",
   "ro": "M-am săturat de rahatul ăsta."
  },
  {
   "key": "1825885119599730692",
   "en": "I WILL find you, and when I do... hohoho...",
   "ro": "TE GĂSESC, și când o fac... hohoho..."
  },
  {
   "key": "1825885119616507912",
   "en": "I'll go easy on you, I promise!",
   "ro": "Am să fiu blând cu tine, promit!"
  },
  {
   "key": "1825885119650062340",
   "en": "Not moving!",
   "ro": "Nu mă mișc!"
  },
  {
   "key": "1825885119683616772",
   "en": "Just say the word.",
   "ro": "Spune doar cuvântul."
  },
  {
   "key": "1825885119733948420",
   "en": "I'm gonna bleed you dry!",
   "ro": "O să te storc de sânge!"
  },
  {
   "key": "1825885119750725632",
   "en": "Get ready to die!",
   "ro": "Pregătește-te să mori!"
  },
  {
   "key": "1825885119767502852",
   "en": "See if you can handle this!",
   "ro": "Vezi dacă faci față la asta!"
  },
  {
   "key": "1825885119817834500",
   "en": "I was born for this shit!",
   "ro": "M-am născut pentru rahatul ăsta!"
  },
  {
   "key": "1825885119834611716",
   "en": "I'll lay out flat!",
   "ro": "Mă întind la pământ!"
  },
  {
   "key": "1825885119884943364",
   "en": "No, no, no, no...!",
   "ro": "Nu, nu, nu, nu...!"
  },
  {
   "key": "1825885119901720580",
   "en": "Gotta reload!",
   "ro": "Trebuie să reîncarc!"
  },
  {
   "key": "1825885119935275012",
   "en": "Fuck!",
   "ro": "Futu-i!"
  },
  {
   "key": "1825885119968829444",
   "en": "Seriously?",
   "ro": "Serios?"
  },
  {
   "key": "1825885119985606660",
   "en": "'Lo?",
   "ro": "Alo?"
  },
  {
   "key": "1825885120035938308",
   "en": "What...? I told you not to call me…",
   "ro": "Ce...? Ți-am zis să nu mă suni…"
  },
  {
   "key": "1825885120052715524",
   "en": "Mh-hm, actually we don't have anything to talk about…",
   "ro": "Mh-hm, de fapt n-avem despre ce vorbi…"
  },
  {
   "key": "1825885120103047172",
   "en": "Get on her rims!",
   "ro": "Dă-i la jante!"
  },
  {
   "key": "1825885120119824388",
   "en": "I'm goin' in!",
   "ro": "Intru!"
  },
  {
   "key": "1825885120153378820",
   "en": "Get outta the way!",
   "ro": "Dă-te din drum!"
  },
  {
   "key": "1825885120170156036",
   "en": "Yeah, fuck you too!",
   "ro": "Da, du-te-n pula mea și tu!"
  },
  {
   "key": "1825885120186933252",
   "en": "Oooof course...",
   "ro": "Oooof, desigur..."
  },
  {
   "key": "1825885120220487684",
   "en": "Better than standing around...",
   "ro": "Mai bine decât să stai degeaba..."
  },
  {
   "key": "1825885120237264900",
   "en": "Do a sweep for fuck's sake!",
   "ro": "Fă o razie, pula mea!"
  },
  {
   "key": "1825885120270819332",
   "en": "Quit fuckin' around and move it!",
   "ro": "Lasă prostiile și mișcă-te!"
  },
  {
   "key": "1825885120287596548",
   "en": "This is what I live for!",
   "ro": "Pentru asta trăiesc!"
  },
  {
   "key": "1825885120321150980",
   "en": "Khaa... fuck... you... in... the... ass... khe...",
   "ro": "Khaa... futu-i... în... cur... khe..."
  },
  {
   "key": "1867610281024692224",
   "en": "I don't give a shit... No...! I said no! Fuck...",
   "ro": "Mă doare-n cur... Nu...! Am zis nu! Pula mea..."
  },
  {
   "key": "1867610836702863360",
   "en": "I couldn't care less... just try it, asshole...",
   "ro": "Nu-mi pasă deloc... încearcă, boule..."
  }
 ]
}
