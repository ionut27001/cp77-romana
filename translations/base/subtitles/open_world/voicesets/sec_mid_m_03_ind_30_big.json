{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_mid_m_03_ind_30_big.json",
 "entries": [
  {
   "key": "1912534092920397828",
   "en": "This isn't the place for people like you.",
   "ro": "Aici nu e locul pentru oameni ca tine."
  },
  {
   "key": "1912534092970729472",
   "en": "Hands where I can see them.",
   "ro": "Mâinile unde le pot vedea."
  },
  {
   "key": "1912534093037838340",
   "en": "You. Back off.",
   "ro": "Tu. Dă-te înapoi."
  },
  {
   "key": "1912534093071392772",
   "en": "Leave, little one.",
   "ro": "Pleacă, micuțo.",
   "ro_m": "Pleacă, micuțule."
  },
  {
   "key": "1912534093121724420",
   "en": "Don't be stupid.",
   "ro": "Nu fi prost."
  },
  {
   "key": "1912534093155278848",
   "en": "You. Put it away.",
   "ro": "Tu. Pune-o la loc."
  },
  {
   "key": "1912534093222387712",
   "en": "I will beat you.",
   "ro": "O să te bat."
  },
  {
   "key": "1912534093255942144",
   "en": "Suspect refusing to cooperate. Awaiting orders.",
   "ro": "Suspectul refuză să coopereze. Aștept ordine."
  },
  {
   "key": "1912534093323051012",
   "en": "A future-oriented decision.",
   "ro": "O decizie orientată spre viitor."
  },
  {
   "key": "1912534093356605444",
   "en": "Go in peace.",
   "ro": "Mergi în pace."
  },
  {
   "key": "1912534093423714304",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1912534093440491524",
   "en": "I'm on it.",
   "ro": "Mă ocup."
  },
  {
   "key": "1912534093524377604",
   "en": "All clear.",
   "ro": "Totul curat."
  },
  {
   "key": "1912534093557932032",
   "en": "Area secure.",
   "ro": "Zonă securizată."
  },
  {
   "key": "1912534093625040900",
   "en": "Surrender!",
   "ro": "Predă-te!"
  },
  {
   "key": "1912534093658595332",
   "en": "Resistance is useless!",
   "ro": "Rezistența e inutilă!"
  },
  {
   "key": "1912534093725704196",
   "en": "Stay focused!",
   "ro": "Rămâi concentrat!"
  },
  {
   "key": "1912534093776035844",
   "en": "Understood!",
   "ro": "Înțeles!"
  },
  {
   "key": "1912534093843144708",
   "en": "Terrorist attack!",
   "ro": "Atac terorist!"
  },
  {
   "key": "1912534093859921924",
   "en": "Another extremist!",
   "ro": "Încă un extremist!"
  },
  {
   "key": "1912534093910253572",
   "en": "Lighting it up!",
   "ro": "Deschid focul!"
  },
  {
   "key": "1912534093977362436",
   "en": "Keep moving! Don't slow down!",
   "ro": "Continuă! Nu încetini!"
  },
  {
   "key": "1912534094010916868",
   "en": "I want her dead!",
   "en_m": "I want him dead!",
   "ro": "Vreau să o omor!",
   "ro_m": "Vreau să-l omor!"
  },
  {
   "key": "1912534094078025732",
   "en": "Regroup!",
   "ro": "Regrupați-vă!"
  },
  {
   "key": "1912534094111580164",
   "en": "Heads down!",
   "ro": "Capetele jos!"
  },
  {
   "key": "1912534094178689028",
   "en": "Behave yourself.",
   "ro": "Comportă-te."
  },
  {
   "key": "1912534094195466244",
   "en": "Cool it.",
   "ro": "Calmează-te."
  },
  {
   "key": "1912534094262575108",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1912534094346461184",
   "en": "Yes… I understand… Of course, I'll stay longer.",
   "ro": "Da… înțeleg… Desigur, o să mai rămân."
  },
  {
   "key": "1912534094363238404",
   "en": "Uh… No, I don't need new weaponry… I mean it.",
   "ro": "Ăă… Nu, nu-mi trebuie arme noi… Serios."
  },
  {
   "key": "1912534094447124484",
   "en": "Attack! From all sides!",
   "ro": "Atac! Din toate părțile!"
  },
  {
   "key": "1912534094497456132",
   "en": "Flanking!",
   "ro": "Flancare!"
  },
  {
   "key": "1912534094547787780",
   "en": "Get down!",
   "ro": "Jos!"
  },
  {
   "key": "1912534094581342212",
   "en": "Goodbye.",
   "ro": "La revedere."
  },
  {
   "key": "1912534094631673860",
   "en": "Commencing patrol.",
   "ro": "Încep patrularea."
  },
  {
   "key": "1912534094715559940",
   "en": "I'll lead. Cover me.",
   "ro": "Eu conduc. Acoperă-mă."
  },
  {
   "key": "1912534094765891584",
   "en": "Stay on my tail.",
   "ro": "Rămâi pe urmele mele."
  },
  {
   "key": "1912534094816223236",
   "en": "Go see what's going on.",
   "ro": "Du-te să vezi ce se întâmplă."
  },
  {
   "key": "1912534094866554884",
   "en": "Shoot, shoot!",
   "ro": "Împușcă, împușcă!"
  },
  {
   "key": "1912534094967218176",
   "en": "Khh… khh… you… whore…",
   "en_m": "Khhh… khhh… you… prick.",
   "ro": "Khh… khh… tu… curvă…",
   "ro_m": "Khhh… khhh… tu… boule…"
  },
  {
   "key": "1912539681696260096",
   "en": "I don't have that kind of information…! Yes, yes.",
   "ro": "N-am informații de-astea…! Da, da."
  },
  {
   "key": "1912541641040207872",
   "en": "Umm… You could say that… Sure…",
   "ro": "Umm… Ai putea spune asta… Sigur…"
  }
 ]
