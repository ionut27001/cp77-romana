  },
  {
   "key": "1876517392995590148",
   "en": "Calm down.",
   "ro": "Calmează-te."
  },
  {
   "key": "1876517393012367364",
   "en": "Control yourself, or we're fucked.",
   "ro": "Controlează-te, sau ne-am futut."
  },
  {
   "key": "1876517393079476228",
   "en": "No funny business this time.",
   "ro": "Fără prostii de data asta."
  },
  {
   "key": "1876517393113030660",
   "en": "Get lost.",
   "ro": "Cară-te."
  },
  {
   "key": "1876517393163362308",
   "en": "Hmm…",
   "ro": "Hmm…"
  },
  {
   "key": "1876517393196916740",
   "en": "Someone's here. I can feel it.",
   "ro": "E cineva aici. Simt."
  },
  {
   "key": "1876517393247248388",
   "en": "Nothing there. But stay vigilant.",
   "ro": "Nimic acolo. Dar rămâi vigilent."
  },
  {
   "key": "1876517393280802820",
   "en": "Area clear.",
   "ro": "Zonă liberă."
  },
  {
   "key": "1876517393331134468",
   "en": "Come out!",
   "ro": "Ieși afară!"
  },
  {
   "key": "1876517393364688900",
   "en": "Ugh, let's get this over with! Show yourself!",
   "ro": "Ugh, hai să terminăm odată! Arată-te!"
  },
  {
   "key": "1876517393398243332",
   "en": "Body found.",
   "ro": "Cadavru găsit."
  },
  {
   "key": "1876517393448574980",
   "en": "Affirmative.",
   "ro": "Afirmativ."
  },
  {
   "key": "1876517393498906628",
   "en": "You wanna play? Let's play!",
   "ro": "Vrei să te joci? Hai să ne jucăm!"
  },
  {
   "key": "1876517393515683844",
   "en": "Wanna see my claws?",
   "ro": "Vrei să vezi ghearele mele?"
  },
  {
   "key": "1876517393549238276",
   "en": "Ya lost something!",
   "ro": "Ai pierdut ceva!"
  },
  {
   "key": "1876517393616347140",
   "en": "My favorite color's blood-red!",
   "ro": "Culoarea mea preferată e roșu-sânge!"
  },
  {
   "key": "1876517393633124356",
   "en": "Tygers! Fight!",
   "ro": "Tygers! Luptă!"
  },
  {
   "key": "1876517393700233220",
   "en": "Am I… dying…?",
   "ro": "Mor…?"
  },
  {
   "key": "1876517393733787648",
   "en": "Let's finish this!",
   "ro": "Hai să terminăm odată!"
  },
  {
   "key": "1876517393784119300",
   "en": "Hey!!",
   "ro": "Hei!!"
  },
  {
   "key": "1876517393817673732",
   "en": "HellO-o! I'm walkin' here!",
   "ro": "HellO-o! Merg pe aici!"
  },
  {
   "key": "1876517393851228164",
   "en": "Yes?",
   "ro": "Da?"
  },
  {
   "key": "1876517393935114244",
   "en": "Why me…? Couldn't someone else…? I see… Yes, I'll make it work…",
   "ro": "De ce eu…? N-ar fi putut altcineva…? Înțeleg… Da, o să mă descurc…"
  },
  {
   "key": "1876517393968668676",
   "en": "Ahh… I wasn't alone…",
   "ro": "Ahh… Nu eram singură…"
  },
  {
   "key": "1876517394019000324",
   "en": "Fuck 'er up!",
   "en_m": "Fuck'im up !",
   "ro": "Fă-o praf!",
   "ro_m": "Fă-l praf!"
  },
  {
   "key": "1876517394086109188",
   "en": "Coming!",
   "ro": "Vin!"
  },
  {
   "key": "1876517394119663620",
   "en": "Get down!",
