{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_tcl_f_02_jap_25.json",
 "entries": [
  {
   "key": "1876517392760709124",
   "en": "It's rude to stare.",
   "ro": "E nepoliticos să privești fix."
  },
  {
   "key": "1876517392777486340",
   "en": "What do YOU want?",
   "ro": "Ce vrei TU?"
  },
  {
   "key": "1876517392844595204",
   "en": "Word of advice - step back.",
   "ro": "Un sfat - dă-te înapoi."
  },
  {
   "key": "1876517392861372420",
   "en": "Another few steps back. Unless you wanna dance…",
   "ro": "Încă câțiva pași înapoi. Dacă nu vrei să dansezi…"
  },
  {
   "key": "1876517392911704068",
   "en": "You're not scaring anyone with that toy.",
   "ro": "Nu sperii pe nimeni cu jucăria aia."
  },
  {
   "key": "1876517392945258500",
