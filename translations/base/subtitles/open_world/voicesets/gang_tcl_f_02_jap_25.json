   "ro": "N-are rost să așteptăm. Hai."
  },
  {
   "key": "1876517394287435780",
   "en": "Go, go.",
   "ro": "Hai, hai."
  },
  {
   "key": "1876517394337767428",
   "en": "Look into it.",
   "ro": "Verifică."
