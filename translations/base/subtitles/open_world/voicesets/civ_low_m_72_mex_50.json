 "entries": [
  {
   "key": "1922661415015424004",
   "en": "What's on your mind?",
   "ro": "Ce ai pe suflet?"
  },
  {
   "key": "1922661415032201220",
   "en": "How are you?",
   "ro": "Ce faci?"
  },
  {
   "key": "1922661415099310084",
   "en": "Uh, excuse you!",
   "ro": "Poftim?!"
  },
  {
   "key": "1922661415132864516",
   "en": "Nothing happened.",
   "ro": "Nu s-a întâmplat nimic."
  },
  {
   "key": "1922661415166418948",
   "en": "I'm here, I'm here.",
   "ro": "Sunt aici, sunt aici."
  },
  {
   "key": "1922661415233527812",
   "en": "What can I tell you… That's life… Uh-huh… Exactly.",
   "ro": "Ce să-ți spun… Așa e viața… Mhm… Exact."
  },
  {
   "key": "1922661415250305028",
   "en": "Chin up… That's right… It'll be all right… It can only get better… Just give it some time.",
   "ro": "Capul sus… Așa e… O să fie bine… Doar mai bine poate fi… Dă-i timp."
  },
  {
   "key": "1922661415300636676",
   "en": "No problem.",
   "ro": "Nicio problemă."
  },
  {
   "key": "1922661415535517700",
   "en": "Don't get in her way!",
   "en_m": "Don't get in his way!",
   "ro": "Nu-i sta în calea ei!",
   "ro_m": "Nu-i sta în calea lui!"
  },
  {
   "key": "1922661415569072128",
   "en": "Police!",
   "ro": "Poliția!"
  },
  {
   "key": "1922661415686512644",
   "en": "You won't do this!",
   "ro": "Nu o să faci asta!"
  },
  {
   "key": "1922661415720067076",
   "en": "Have mercy…!",
   "ro": "Ai milă…!"
  },
  {
   "key": "1922661415803953156",
   "en": "You must mistake me for someone else.",
   "ro": "Mă confunzi cu altcineva."
  },
  {
   "key": "1922661415837507588",
   "en": "You won't rob me, will you?",
   "ro": "Nu mă jefuiești, nu-i așa?"
  }
 ]
