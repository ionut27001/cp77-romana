 "entries": [
  {
   "key": "1922836447633088516",
   "en": "Hey there!",
   "ro": "Hei!"
  },
  {
   "key": "1922836447666642948",
   "en": "How's it goin?",
   "ro": "Ce mai faci?"
  },
  {
   "key": "1922836447716974596",
   "en": "Ey!",
   "ro": "Ey!"
  },
  {
   "key": "1922836447733751812",
   "en": "That on purpose?",
   "ro": "A fost intenționat?"
  },
  {
   "key": "1922836447784083460",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1922836447834415108",
   "en": "You shouldn't have called… I know… I know, you said it a million times… Yes, honestly.",
   "ro": "Nu trebuia să suni… Știu… Știu, ai spus-o de un milion de ori… Da, serios."
  },
  {
   "key": "1922836447851192324",
   "en": "No… Not even then.. Because I prefer him! Get-- what…? You deaf?",
   "ro": "Nu… Nici atunci.. Pentru că îl prefer pe el! Get-- ce…? Ești surd?"
  },
  {
   "key": "1922836447884746756",
   "en": "Don't call me again!",
   "ro": "Nu mă mai suna!"
  },
  {
   "key": "1922836448069296132",
   "en": "Oh my God!",
   "ro": "Doamne!"
  },
  {
   "key": "1922836448102850564",
   "en": "Take her gun away!",
   "en_m": "Take his gun away!",
   "ro": "Ia-i pistolul!"
  },
  {
   "key": "1922836448186736644",
   "en": "Leave me alone!",
   "ro": "Lasă-mă în pace!"
  },
  {
   "key": "1922836448304177156",
   "en": "Go away! Please!",
   "ro": "Pleacă! Te rog!"
  },
  {
   "key": "1922836448438394884",
   "en": "I don't want trouble.",
   "ro": "Nu vreau probleme."
  },
  {
   "key": "1922836448471949316",
   "en": "Just leave, OK?",
   "ro": "Pleacă, bine?"
  }
 ]
