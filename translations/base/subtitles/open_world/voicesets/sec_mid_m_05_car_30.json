   "en": "Put that away. Now.",
   "ro": "Pune-o la loc. Acum."
  },
  {
   "key": "1912563004828295168",
   "en": "Not the place for that.",
   "ro": "Nu e locul pentru asta."
  },
  {
   "key": "1912563004878626820",
   "en": "Playtime's over.",
   "ro": "S-a terminat joaca."
  },
  {
   "key": "1912563004912181252",
   "en": "Enough of this!",
   "ro": "Destul cu asta!"
  },
  {
   "key": "1912563004979290116",
   "en": "Didn't like you anyway.",
   "ro": "Oricum nu-mi plăceai."
  },
  {
   "key": "1912563005012844548",
   "en": "That's right.",
   "ro": "Așa e."
  },
  {
   "key": "1912563005079953412",
   "en": "Hmm…",
   "ro": "Hmm…"
  },
  {
   "key": "1912563005096730628",
   "en": "Shh…",
   "ro": "Șșș…"
  },
  {
   "key": "1912563005180616708",
   "en": "All clear.",
   "ro": "Totul curat."
  },
  {
   "key": "1912563005214171140",
   "en": "No sign of any threat.",
   "ro": "Niciun semn de amenințare."
  },
  {
   "key": "1912563005298057216",
   "en": "Surrender!",
   "ro": "Predă-te!"
  },
  {
   "key": "1912563005314834436",
   "en": "You think you stand a chance? Huh?",
   "ro": "Crezi că ai vreo șansă? Ha?"
  },
  {
   "key": "1912563005365166084",
   "en": "Great…",
   "ro": "Minunat…"
  },
  {
   "key": "1912563005415497732",
   "en": "Consider it done.",
   "ro": "Consideră că-i gata."
  },
  {
   "key": "1912563005465829380",
   "en": "Open fire!",
   "ro": "Deschideți focul!"
  },
  {
   "key": "1912563005499383812",
   "en": "Hostiles engaged! Opening fire!",
   "ro": "Inamici angajați! Deschid focul!"
  },
  {
   "key": "1912563005549715460",
   "en": "Pin's out!",
   "ro": "Am scos cuiul!"
  },
  {
   "key": "1912563005600047108",
   "en": "Eliminate the target!",
   "ro": "Eliminați ținta!"
  },
  {
   "key": "1912563005633601540",
   "en": "Fire!",
   "ro": "Foc!"
  },
  {
   "key": "1912563005700710404",
   "en": "She has combat implants!",
   "en_m": "He has combat implants!",
   "ro": "Are implanturi de luptă!"
  },
  {
   "key": "1912563005734264836",
   "en": "Need backup!",
   "ro": "Am nevoie de întăriri!"
  },
  {
   "key": "1912563005801373700",
   "en": "You must be out o' your mind.",
   "ro": "Trebuie să fii nebun la cap."
  },
  {
   "key": "1912563005834928132",
   "en": "The hell?!",
   "ro": "Ce dracu'?!"
  },
  {
   "key": "1912563005902036992",
   "en": "Hey.",
   "ro": "Hei."
  },
  {
   "key": "1912563005952368644",
   "en": "I can't… I can't right now… Uh huh…",
   "ro": "Nu pot… Nu pot acum… Uh huh…"
  },
  {
   "key": "1912563005985923076",
   "en": "What do you mean…? Of course we'll be there…",
   "ro": "Ce vrei să spui…? Sigur că o să fim acolo…"
  },
  {
   "key": "1912563006053031940",
   "en": "Let's move up!",
   "ro": "Hai să înaintăm!"
  },
  {
   "key": "1912563006120140804",
   "en": "You got it!",
   "ro": "Ai înțeles!"
  },
  {
   "key": "1912563006187249668",
   "en": "Incooooming!",
   "ro": "Vineee!"
  },
  {
   "key": "1912563006237581316",
   "en": "Yeah, I got it.",
   "ro": "Da, am înțeles."
  },
  {
   "key": "1912563006271135748",
   "en": "Quiet.",
   "ro": "Liniște."
  },
  {
   "key": "1912563006371799040",
   "en": "Let's check it out.",
   "ro": "Hai să verificăm."
  },
  {
   "key": "1912563006405353476",
   "en": "Need to sweep the area.",
   "ro": "Trebuie să mătur zona."
  },
  {
   "key": "1912563006472462340",
   "en": "I'm on your six. Go.",
   "ro": "Sunt în spatele tău. Du-te."
  },
  {
   "key": "1912563006506016772",
   "en": "Move! Move! Move!",
   "ro": "Mișcă! Mișcă! Mișcă!"
  },
  {
   "key": "1912563006589902848",
   "en": "Kghaa... khe... You'll pay for this...",
   "ro": "Kghaa... khe... O să plătești pentru asta..."
  },
  {
   "key": "1912567720350064640",
   "en": "No… End of discussion…",
   "ro": "Nu… Discuția s-a încheiat…"
  },
  {
   "key": "1912567955549855744",
   "en": "Yeah, I know them al… Uh-huh… Yeah…",
   "ro": "Da, îi știu pe toț… Uh-huh… Da…"
  },
  {
   "key": "1958951692664872964",
   "en": "Hey, we weren't finished.",
   "ro": "Hei, nu terminaserăm."
  },
  {
   "key": "1958951692731981828",
   "en": "Back to where we left off…",
   "ro": "Revenim de unde am rămas…"
  },
  {
   "key": "1958951692748759044",
   "en": "Make it quick.",
   "ro": "Fă repede."
  }
 ]
