{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_mid_f_02_enus_25.json",
 "entries": [
  {
   "key": "1912636007696048128",
   "en": "Don't start.",
   "ro": "Nu începe."
  },
  {
   "key": "1912636007712825348",
   "en": "You won't get a word outta me.",
   "ro": "Nu scoți niciun cuvânt din mine."
  },
  {
   "key": "1912636007763156996",
   "en": "You have no rights. Get out of here.",
   "ro": "N-ai niciun drept. Ieși de aici."
  },
  {
   "key": "1912636007796711428",
   "en": "Now! You're gone!",
   "ro": "Acum! Ai dispărut!"
  },
  {
   "key": "1912636007863820288",
   "en": "Get your firearm out of my face!",
   "ro": "Scoate-ți arma din fața mea!"
  },
  {
   "key": "1912636007880597508",
   "en": "Drop it. Now.",
   "ro": "Aruncă-o. Acum."
  },
  {
   "key": "1912636007930929156",
   "en": "Careful…",
   "ro": "Atenție…"
  },
  {
   "key": "1912636007964483588",
   "en": "I wouldn't advise it.",
   "ro": "Nu ți-aș recomanda."
  },
  {
   "key": "1912636008031592452",
   "en": "Mhm.",
   "ro": "Mhm."
  },
  {
   "key": "1912636008065146884",
   "en": "Just like that.",
   "ro": "Așa, pur și simplu."
  },
  {
   "key": "1912636008132255748",
   "en": "Hmm…",
   "ro": "Hmm…"
  },
  {
   "key": "1912636008165810180",
   "en": "Possible enemy activity.",
   "ro": "Posibilă activitate inamică."
  },
  {
   "key": "1912636008216141828",
   "en": "Area's clear.",
   "ro": "Zona e curată."
  },
  {
   "key": "1912636008249696260",
   "en": "Probably nothing.",
   "ro": "Probabil nimic."
  },
  {
   "key": "1912636008300027908",
   "en": "Enjoying your run-in with the corporation? Guess not, huh?",
   "ro": "Ți-a priit întâlnirea cu corporația? Ce, nu?"
  },
  {
   "key": "1912636008333582340",
   "en": "Come out!",
   "ro": "Ieși afară!"
  },
  {
   "key": "1912636008367136772",
   "en": "We have a problem! High alert!",
   "ro": "Avem o problemă! Alertă maximă!"
  },
  {
   "key": "1912636008417468420",
   "en": "I'm on it.",
   "ro": "Mă ocup."
  },
  {
   "key": "1912636008484577284",
   "en": "Terrorists!",
   "ro": "Teroriști!"
  },
  {
   "key": "1912636008518131716",
   "en": "They're attacking us!",
   "ro": "Ne atacă!"
  },
  {
   "key": "1912636008568463364",
   "en": "Oooff!",
   "ro": "Oooff!"
  },
  {
   "key": "1912636008635572228",
   "en": "I'm trying to get through!",
   "ro": "Încerc să trec!"
  },
  {
   "key": "1912636008669126660",
   "en": "Drive her back!",
   "en_m": "Drive him back!",
   "ro": "Împingeți-o înapoi!",
   "ro_m": "Împingeți-l înapoi!"
  },
  {
   "key": "1912636008736235520",
   "en": "Get your shit together!",
   "ro": "Adună-te!"
  },
  {
   "key": "1912636008753012740",
   "en": "Went clean through.",
   "ro": "A trecut curat."
  },
  {
   "key": "1912636008803344388",
   "en": "Uh.",
   "ro": "Uh."
  },
  {
   "key": "1912636008836898820",
   "en": "Watch it.",
   "ro": "Atenție."
  },
  {
   "key": "1912636008887230468",
   "en": "Bye.",
   "ro": "Pa."
  },
  {
   "key": "1912636008971116544",
   "en": "Oh come on, what can they--? What can they do, huh…? That's right.",
   "ro": "Hai, ce pot ei să--? Ce pot face, nu…? Așa e."
  },
  {
   "key": "1912636009021448196",
   "en": "That's a problem how…? Listen, we'll put on our company gear and go for a stroll, how's that?",
   "ro": "Cum adică, problemă…? Ascultă, ne punem pe echipamentul companiei și facem o plimbare, ce zici?"
  },
  {
   "key": "1912636009105334276",
   "en": "Get into position!",
   "ro": "Luați poziții!"
  },
  {
   "key": "1912636009189220356",
   "en": "I'm on it!",
   "ro": "Mă ocup!"
  },
  {
   "key": "1912636009273106436",
   "en": "Take cover!",
   "ro": "La adăpost!"
  },
  {
   "key": "1912636009306660868",
   "en": "You too.",
   "ro": "Și tu."
  },
  {
   "key": "1912636009390546948",
   "en": "Not again…",
   "ro": "Nu din nou…"
  },
  {
   "key": "1912636009474433028",
   "en": "All right. Get to work.",
   "ro": "Bine. La treabă."
  },
  {
   "key": "1912636009524764676",
   "en": "Hoh. Let's see what we got.",
   "ro": "Hoh. Să vedem ce avem."
  },
  {
   "key": "1912636009575096324",
   "en": "Get movin'.",
   "ro": "Mișcă-te."
  },
  {
   "key": "1912636009625427972",
   "en": "Cover me!",
   "ro": "Acoperă-mă!"
  },
  {
   "key": "1912636009692536836",
   "en": "Arghhh... Fuckkk... Fuck... You.",
   "ro": "Arghhh... Futu-i... Futu-i... pe tine."
  },
  {
   "key": "1912642268667846656",
   "en": "Oh relax… Mm… Yes.",
   "ro": "Oh, relaxează-te… Mm… Da."
  },
  {
   "key": "2233838124395569156",
   "en": "Regroup!",
   "ro": "Regrupați-vă!"
  },
  {
   "key": "2233838124513009664",
   "en": "Got a dead soldier! Search the area!",
   "ro": "Avem un soldat mort! Căutați zona!"
  },
  {
   "key": "2233838124613672964",
   "en": "Jesus Christ...",
   "ro": "Doamne, Dumnezeule..."
  },
  {
   "key": "2233838124798222340",
   "en": "Spread out! I didn't put any call out!",
   "ro": "Răspândiți-vă! N-am dat niciun apel!"
  },
  {
   "key": "2233838124999548932",
   "en": "Taking heavy losses!",
   "ro": "Suferim pierderi grele!"
  },
  {
   "key": "2233838125083435012",
   "en": "You killed them all!",
   "ro": "I-ai ucis pe toți!"
  },
  {
   "key": "2233838125133766660",
   "en": "Come at me!",
   "ro": "Vino la mine!"
  },
  {
   "key": "2233838125335093252",
   "en": "Target's wounded!",
   "ro": "Ținta e rănită!"
  },
  {
   "key": "2233838125402202116",
   "en": "Hit on target!",
   "ro": "Lovitură pe țintă!"
  },
  {
   "key": "2233838125586751492",
   "en": "Target has multiple wounds! Move to eliminate!",
   "ro": "Ținta are răni multiple! Mișcați-vă să o eliminați!"
  },
  {
   "key": "2233838125637083140",
   "en": "Copy that!",
   "ro": "Am înțeles!"
  },
  {
   "key": "2233838125704192004",
   "en": "We've got her pinned down!",
   "en_m": "We've got him pinned down!",
   "ro": "O avem imobilizată!",
   "ro_m": "Îl avem imobilizat!"
  },
  {
   "key": "2233838125771300868",
   "en": "Reloading!",
   "ro": "Reîncărcare!"
  },
  {
   "key": "2233838125821632516",
   "en": "Friendly hijacked!",
   "ro": "Prieten deturnat!"
  },
  {
   "key": "2233838125955850244",
   "en": "She jammed my optics! Cover me!",
   "en_m": "He jammed my optics! Cover me!",
   "ro": "Mi-a blocat optica! Acoperă-mă!"
  },
  {
   "key": "2233838126022959108",
   "en": "Watch your implants! Netrunner!",
   "ro": "Atenție la implanturi! Netrunner!"
  },
  {
   "key": "2233838126090067972",
   "en": "Wooh! I'm good!",
   "ro": "Wooh! Sunt bine!"
  },
  {
   "key": "2233838126157176836",
   "en": "Where's the damn backup?!",
   "ro": "Unde-i backup-ul dracului?!"
  },
  {
   "key": "2233838126257840132",
   "en": "Eliminating target!",
   "ro": "Elimin ținta!"
  },
  {
   "key": "2233838126308171780",
   "en": "Entering kill-zone!",
   "ro": "Intrăm în zona de ucidere!"
  },
  {
   "key": "2233838126375280644",
   "en": "Commencing heavy fire!",
   "ro": "Începem focul intens!"
  },
  {
   "key": "2233838126459166720",
   "en": "We're losing soldiers!",
   "ro": "Pierdem soldați!"
  },
  {
   "key": "2233838126777933828",
   "en": "Huh?",
   "ro": "Hm?"
  }
 ]
}
