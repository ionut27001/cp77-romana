   "en": "Don't provoke her!",
   "en_m": "Don't provoke him!",
   "ro": "Nu o provoca!",
   "ro_m": "Nu-l provoca!"
  },
  {
   "key": "1922654329292464132",
   "en": "You don't want to do this.",
   "ro": "Nu vrei să faci asta."
  },
  {
   "key": "1922654329326018564",
   "en": "What's that for?",
   "ro": "Pentru ce?"
  },
  {
   "key": "1922654329426681860",
   "en": "Can I… help you?",
   "ro": "Pot să… te ajut?"
