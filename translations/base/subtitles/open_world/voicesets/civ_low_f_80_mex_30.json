 "entries": [
  {
   "key": "1949096904615387140",
   "en": "Who are you?",
   "ro": "Cine ești?"
  },
  {
   "key": "1949096904632164356",
   "en": "Oh… I  thought you were someone else.",
   "ro": "Oh… Credeam că ești altcineva."
  },
  {
   "key": "1949096904682496004",
   "en": "Hey!",
   "ro": "Hei!"
  },
  {
   "key": "1949096904699273220",
   "en": "What the…?",
   "ro": "Ce naiba…?"
  },
  {
   "key": "1949096904732827652",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1949096904783159300",
   "en": "Hey…  Another break-in… Yes… It's her for sure… She's obsessed!",
   "ro": "Hei… Încă o spargere… Da… E ea, sigur… E obsedată!"
  },
  {
   "key": "1949096904816713728",
   "en": "Why…? They won't lift a finger without a bribe… But… I'm scared… Yes… Maybe.",
   "ro": "De ce…? Fără mită nu se bagă nimeni… Dar… Mi-e frică… Da… Poate."
  },
  {
   "key": "1949096904850268164",
   "en": "Call you later.",
   "ro": "Te sun mai târziu."
  },
  {
   "key": "1949096904984485892",
   "en": "She's got a gun! I saw!",
   "en_m": "He's got a gun! I saw!",
   "ro": "Ea are armă! Am văzut!",
   "ro_m": "El are armă! Am văzut!"
  },
  {
   "key": "1949096905018040324",
   "en": "Attack! Another attack!",
   "ro": "Atac! Încă un atac!"
  },
  {
   "key": "1949096905085149188",
   "en": "Let me be!",
   "ro": "Lasă-mă în pace!"
  },
  {
   "key": "1949096905101926404",
   "en": "Please! I'm nobody!",
   "ro": "Te rog! Nu sunt nimeni!"
  },
  {
   "key": "1949096905219366916",
   "en": "Did she send you? Go away!",
   "ro": "Ți-a trimis-o ea? Pleacă!"
  },
  {
   "key": "1949096905236144132",
   "en": "You're stalking me? Just like her?",
   "ro": "Mă urmărești? La fel ca ea?"
  }
 ]
