{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_mid_m_04_afam_25.json",
 "entries": [
  {
   "key": "1912542714010279936",
   "en": "Say it to my face.",
   "ro": "Spune-mi în față."
  },
  {
   "key": "1912542714027057156",
   "en": "Who you talkin' to, girl?",
   "en_m": "Who you talkin' to, boy?",
   "ro": "Cui îi vorbești, fată?",
   "ro_m": "Cui îi vorbești, băiete?"
  },
  {
   "key": "1912542714094166020",
   "en": "You'd best back up right now!",
   "ro": "Mai bine dă-te înapoi acum!"
  },
  {
   "key": "1912542714110943236",
   "en": "Don't be fuckin' dumb. Outta here.",
   "ro": "Nu fi proastă, dracu'. Cară-te de aici.",
   "ro_m": "Nu fi prost, dracu'. Cară-te de aici."
  },
  {
   "key": "1912542714194829316",
   "en": "Weapon down! I said, down!",
   "ro": "Arma jos! Am zis, jos!"
  },
  {
   "key": "1912542714228383748",
   "en": "Drop it! Now!",
   "ro": "Aruncă! Acum!"
  },
  {
   "key": "1912542714295492612",
   "en": "Get yourself together.",
   "ro": "Adună-te."
  },
  {
   "key": "1912542714312269828",
   "en": "You'd best listen now.",
   "ro": "Mai bine ascultă acum."
  },
  {
   "key": "1912542714379378688",
   "en": "No sudden movements, feel me?",
   "ro": "Fără mișcări bruște, m-ai înțeles?"
  },
  {
   "key": "1912542714396155908",
   "en": "Hop to it.",
   "ro": "Hai, mișcă-te."
  },
  {
   "key": "1912542714480041988",
   "en": "Identify the threat!",
   "ro": "Identifică amenințarea!"
  },
  {
   "key": "1912542714496819204",
   "en": "That's weird…",
   "ro": "Ciudat…"
  },
  {
   "key": "1912542714563928068",
   "en": "Area secure.",
   "ro": "Zonă securizată."
  },
  {
   "key": "1912542714597482500",
   "en": "No threat detected.",
   "ro": "Nicio amenințare detectată."
  },
  {
   "key": "1912542714681368580",
   "en": "Ain't nowhere to hide, so just come out!",
   "ro": "Nu ai unde să te ascunzi, așa că ieși!"
  },
  {
   "key": "1912542714714923008",
   "en": "Be on high alert! She's here somewhere!",
   "en_m": "Be on high alert! He's here somewhere!",
   "ro": "Fiți cu ochii în patru! E pe aici, pe undeva!",
   "ro_m": "Fiți în alertă! El e aici undeva!"
  },
  {
   "key": "1912542714765254660",
   "en": "Fuck!",
   "ro": "Futu-i!"
  },
  {
   "key": "1912542714815586308",
   "en": "Roger that.",
   "ro": "Înțeles."
  },
  {
   "key": "1912542714882695172",
   "en": "Neutralize her!",
   "en_m": "Neutralize him!",
   "ro": "Neutralizează-o!",
   "ro_m": "Neutralizează-l!"
  },
  {
   "key": "1912542714899472388",
   "en": "Contact! Contact!",
   "ro": "Contact! Contact!"
  },
  {
   "key": "1912542714949804036",
   "en": "Grenade out!",
   "ro": "Granată afară!"
  },
  {
   "key": "1912542715000135684",
   "en": "Goddamn terrorist!",
   "ro": "Teroristă al dracului!",
   "ro_m": "Terorist al dracului!"
  },
  {
   "key": "1912542715016912900",
   "en": "She's there!",
   "en_m": "He's there!",
   "ro": "Ea e acolo!",
   "ro_m": "El e acolo!"
  },
  {
   "key": "1912542715084021764",
   "en": "Brace yourselves!",
   "ro": "Pregătiți-vă!"
  },
  {
   "key": "1912542715100798980",
   "en": "I'm hit!",
   "ro": "Sunt lovită!",
   "ro_m": "Sunt lovit!"
  },
  {
   "key": "1912542715167907844",
   "en": "Shit son!",
   "ro": "La naiba, băiete!"
  },
  {
   "key": "1912542715184685060",
   "en": "Watch who you're stepping on.",
   "ro": "Vezi pe cine calci."
  },
  {
   "key": "1912542715235016708",
   "en": "Yes?",
   "ro": "Da?"
  },
  {
   "key": "1912542715302125572",
   "en": "Uh… I don't believe he deserves a raise… He ain't trustworthy.",
   "ro": "Ăă… Nu cred că merită o mărire… Nu-i de încredere."
  },
  {
   "key": "1912542715318902788",
   "en": "'Course… Fuck risk. If you're willing to do my back, I'm in.",
   "ro": "Sigur… Futu-i riscul. Dacă-mi acoperi spatele, intru."
  },
  {
   "key": "1912542715386011652",
   "en": "Right flank! Go!",
   "ro": "Flanc dreapta! Înainte!"
  },
  {
   "key": "1912542715436343300",
   "en": "Roger that!",
   "ro": "Am înțeles!"
  },
  {
   "key": "1912542715486674948",
   "en": "Heads down!",
   "ro": "Capetele jos!"
  },
  {
   "key": "1912542715503452164",
   "en": "No, thank you.",
   "ro": "Nu, mulțumesc."
  },
  {
   "key": "1912542715520229380",
   "en": "I don't like it.",
   "ro": "Nu-mi place."
  },
  {
   "key": "1912542715587338244",
   "en": "We need some intel.",
   "ro": "Avem nevoie de informații."
  },
  {
   "key": "1912542715637669892",
   "en": "Ready your weapon.",
   "ro": "Pregătește-ți arma."
  },
  {
   "key": "1912542715704778756",
   "en": "I'm covering you.",
   "ro": "Te acopăr."
  },
  {
   "key": "1912542715738333188",
   "en": "She doesn't escape! You hear me?",
   "en_m": "He doesn't escape! You hear me?",
   "ro": "Ea nu scapă! M-ai înțeles?",
   "ro_m": "El nu scapă! M-ai înțeles?"
  },
  {
   "key": "1912542715805442052",
   "en": "Argh… gghh… ekkk… duck… you…",
   "ro": "Argh… gghh… ekkk… futu-ți…"
  },
  {
   "key": "1912560323493634048",
   "en": "Did you hear who he fought for in the wars…? Exactly.",
   "ro": "Ai auzit pentru cine a luptat în războaie…? Exact."
  },
  {
   "key": "1912560934368845824",
   "en": "Mm… Exactly. In the name of science.",
   "ro": "Mm… Exact. În numele științei."
  },
  {
   "key": "2233826829621436420",
   "en": "Advance!",
   "ro": "Înainte!"
  },
  {
   "key": "2233826829722099716",
   "en": "Possible intruder!",
   "ro": "Posibil intrus!"
  },
  {
   "key": "2233826829789208580",
   "en": "What in the...",
   "ro": "Ce naiba..."
  },
  {
   "key": "2233826829940203524",
   "en": "Spread out.",
   "ro": "Răspândiți-vă!"
  },
  {
   "key": "2233826830057644036",
   "en": "Goddamn it! Regroup!",
   "ro": "Fir-ar! Reorganizați-vă!"
  },
  {
   "key": "2233826830175084548",
   "en": "Screw you!",
   "ro": "Du-te dracu'!"
  },
  {
   "key": "2233826830242193412",
   "en": "Control! It's just me!",
   "ro": "Control! Sunt doar eu!"
  },
  {
   "key": "2233826830342856708",
   "en": "Shoot to kill! Let's go!",
   "ro": "Împușcă să omori! Hai!"
  },
  {
   "key": "2233826830426742788",
   "en": "She's wounded!",
   "en_m": "He's wounded!",
   "ro": "E rănită!",
   "ro_m": "E rănit!"
  },
  {
   "key": "2233826830510628868",
   "en": "She's hit!",
   "en_m": "He's hit!",
   "ro": "A fost lovită!",
   "ro_m": "A fost lovit!"
  },
  {
   "key": "2233826830560960516",
   "en": "Take her flank!",
   "en_m": "Take his flank!",
   "ro": "Luați-i flancul!"
  },
  {
   "key": "2233826830678401028",
   "en": "Target's almost down! Don't hold back!",
   "ro": "Ținta e aproape jos! Nu te abține!"
  },
  {
   "key": "2233826830745509892",
   "en": "Understood!",
   "ro": "Înțeles!"
  },
  {
   "key": "2233826830829395968",
   "en": "She's using cover!",
   "en_m": "He's using cover!",
   "ro": "Ea folosește acoperirea!",
   "ro_m": "El folosește acoperirea!"
  },
  {
   "key": "2233826830879727620",
   "en": "Reloading weapon!",
   "ro": "Reîncarc arma!"
  },
  {
   "key": "2233826830946836484",
   "en": "Hold fire!",
   "ro": "Încetează focul!"
  },
  {
   "key": "2233826831081054212",
   "en": "Optics down!",
   "ro": "Optică jos!"
  },
  {
   "key": "2233826831131385860",
   "en": "Netrunner!",
   "ro": "Netrunner!"
  },
  {
   "key": "2233826831198494724",
   "en": "Ooof!",
   "ro": "Ooof!"
  },
  {
   "key": "2233826831248826372",
   "en": "We need backup!",
   "ro": "Avem nevoie de întăriri!"
  },
  {
   "key": "2233826831332712448",
   "en": "I'll take her out!",
   "en_m": "I'll take him out!",
   "ro": "O elimin!",
   "ro_m": "Îl elimin!"
  },
  {
   "key": "2233826831383044100",
   "en": "This oughta do the trick!",
   "ro": "Asta ar trebui să meargă!"
  },
  {
   "key": "2233826831450152964",
   "en": "Covering fire!",
   "ro": "Foc de acoperire!"
  },
  {
   "key": "2233826831500484612",
   "en": "We've got KIA!",
   "ro": "Avem morți!"
  },
  {
   "key": "2233826831852806144",
   "en": "Spotted something. Securing the area.",
   "ro": "Am văzut ceva. Securizez zona."
  },
  {
   "key": "2277915174932680708",
   "en": "Come on!",
   "ro": "Hai!"
  }
 ]
