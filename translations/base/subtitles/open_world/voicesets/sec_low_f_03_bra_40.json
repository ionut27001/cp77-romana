  },
  {
   "key": "1905562398892761092",
   "en": "Weapons are not permitted!",
   "ro": "Armele nu sunt permise!"
  },
  {
   "key": "1905562398926315524",
   "en": "What are you doing!?",
   "ro": "Ce faci!?"
  },
  {
   "key": "1905562398993424388",
   "en": "Take it easy, yeah? Just doin' my job.",
   "ro": "Stai calm, da? Doar îmi fac treaba."
  },
  {
   "key": "1905562399026978820",
   "en": "Calm yourself, lady.",
   "en_m": "Calm yourself, man.",
   "ro": "Calmează-te, doamnă.",
   "ro_m": "Calmează-te, domnule."
  },
  {
   "key": "1905562399094087684",
   "en": "Thank you.",
   "ro": "Mulțumesc."
  },
  {
   "key": "1905562399110864900",
   "en": "Thanks for your cooperation.",
   "ro": "Mulțumesc pentru cooperare."
  },
  {
   "key": "1905562399177973764",
   "en": "Oh-ho.",
   "ro": "Oh-ho."
  },
  {
   "key": "1905562399194750980",
   "en": "What now?",
   "ro": "Ce acum?"
  },
  {
   "key": "1905562399245082628",
   "en": "That's it.",
   "ro": "Asta e."
  },
  {
   "key": "1905562399295414272",
   "en": "I think there's nothing to worry about.",
   "ro": "Cred că nu e nimic de îngrijorat."
  },
  {
   "key": "1905562399379300356",
   "en": "I'm not playing hide-and-seek! Come out!",
   "ro": "Nu mă joc de-a v-ați ascunselea! Ieși la iveală!"
  },
  {
   "key": "1905562399396077572",
   "en": "Surrender, and no-one gets hurt!",
   "ro": "Predă-te și nu pățește nimeni nimic!"
  },
  {
   "key": "1905562399446409220",
   "en": "Body! Fucking corpse!",
   "ro": "Cadavru! Cadavru nenorocit!"
  },
  {
   "key": "1905562399513518084",
   "en": "Understood!",
   "ro": "Înțeles!"
  },
  {
   "key": "1905562399614181380",
   "en": "Piss off, crazy bitch!",
   "en_m": "Piss off, crazy fuck!",
   "ro": "Du-te dracu', cățea nebună!",
   "ro_m": "Du-te dracu', nenorocit nebun!"
  },
  {
   "key": "1905562399647735812",
   "en": "Get off me!",
   "ro": "Dă-te jos de pe mine!"
  },
  {
   "key": "1905562399731621892",
   "en": "Heads up!",
   "ro": "Atenție!"
  },
  {
   "key": "1905562399815507972",
   "en": "Why can't I fuckin' aim!",
   "ro": "De ce nu pot să țintesc, pula mea!"
  },
  {
   "key": "1905562399849062404",
   "en": "What does this fucker want?!",
   "ro": "Ce vrea nenorocitul ăsta?!"
  },
  {
   "key": "1905562399932948484",
   "en": "Get your shit together! I don't wanna die!",
   "ro": "Adună-te! Nu vreau să mor!"
  },
  {
   "key": "1905562399966502916",
   "en": "No! Please! Please don't kill me!",
   "ro": "Nu! Te rog! Te rog, nu mă omorî!"
  },
  {
   "key": "1905562400016834564",
   "en": "'Scuse me.",
   "ro": "Scuză-mă."
  },
  {
   "key": "1905562400050388996",
   "en": "Oof.",
   "ro": "Oof."
  },
  {
   "key": "1905562400083943428",
   "en": "Hello!",
   "ro": "Salut!"
  },
  {
   "key": "1905562400151052292",
   "en": "But you promised we'd meet today… I need it though… Mm.",
   "ro": "Dar ai promis că ne vedem azi… Chiar am nevoie… Mm."
  },
  {
   "key": "1905562400167829508",
   "en": "Mm-hmm… Yeah… But… N-no, you listen to me!",
   "ro": "Mm-hmm… Da… Dar… N-nu, tu mă asculți!"
  },
  {
   "key": "1905562400234938372",
   "en": "Need to surround her!",
   "en_m": "Need to surround him!",
   "ro": "Trebuie s-o înconjurăm!",
   "ro_m": "Trebuie să-l înconjurăm!"
  },
  {
   "key": "1905562400268492804",
   "en": "Stick together!",
   "ro": "Țineți-vă aproape!"
  },
  {
   "key": "1905562400318824452",
   "en": "Save yourselves!",
   "ro": "Salvați-vă!"
  },
  {
   "key": "1905562400335601668",
   "en": "Nice! Hang up, why don't you!",
   "ro": "Frumos! Închide, de ce nu!"
  },
  {
   "key": "1905562400369156100",
   "en": "It's always me.",
   "ro": "Mereu eu."
  },
  {
   "key": "1905562400436264964",
   "en": "We need to investigate.",
   "ro": "Trebuie să investigăm."
  },
  {
   "key": "1905562400469819392",
   "en": "Fine, just to be safe.",
   "ro": "Bine, ca să fim siguri."
  },
  {
   "key": "1905562400503373828",
   "en": "Go check it out.",
   "ro": "Du-te și verifică."
  },
  {
   "key": "1905562400536928256",
   "en": "Die, shithead!",
   "ro": "Mori, cap de rahat!"
  },
  {
   "key": "1905562400587259904",
   "en": "Khhh… argh… no… please.",
   "ro": "Khhh… argh… nu… te rog."
  },
  {
   "key": "1905568200403722240",
   "en": "Oh yeah, you have time for your friends, do you…? No… No, I can't!",
   "ro": "Ei, sigur, ai timp pentru prietenii tăi, nu?… Nu… Nu, nu pot!"
  },
  {
   "key": "1905568429194616832",
   "en": "We've been planning this for two weeks! How can you do this to me…?!",
   "ro": "De două săptămâni tot planificăm asta! Cum poți să-mi faci asta?!"
  }
 ]
