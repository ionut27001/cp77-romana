{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\vset_anna_hamill.json",
 "entries": [
  {
   "key": "1976538828580950020",
   "en": "Brought this on yourself!",
   "ro": "Ți-ai făcut-o cu mâna ta!"
  },
  {
   "key": "1976538828614504452",
   "en": "Goddamn it!",
   "ro": "Fir-ar al dracului!"
  },
  {
   "key": "1976538828648058884",
   "en": "Incoming!",
   "ro": "Vine!"
  },
  {
   "key": "1976538828715167748",
   "en": "Drop your weapon!",
   "ro": "Aruncă arma!"
  },
  {
   "key": "1976538828731944964",
   "en": "Big mistake!",
   "ro": "Greșeală mare!"
  },
  {
   "key": "1976538828815831044",
   "en": "Ah, come on!",
   "ro": "Ah, hai!"
  },
  {
   "key": "1976538828832608260",
   "en": "Shit, shit, not good.",
   "ro": "Căcat, căcat, nu e bine."
  },
  {
   "key": "1976538828882939908",
   "en": "Hyuhh!",
   "ro": "Hââ!"
  },
  {
   "key": "1976538828899717124",
   "en": "Don't make me do this!",
   "ro": "Nu mă face să fac asta!"
  },
  {
   "key": "1976538828950048772",
   "en": "Agh... akh... s-stop... agh...",
   "ro": "Agh... akh... o-oprește... agh..."
  },
  {
   "key": "1976538829134598148",
   "en": "Not gonna let me finish?",
   "ro": "Nu mă lași să termin?"
  },
  {
   "key": "1976538829168152580",
   "en": "What? Okay, later then.",
   "ro": "Ce? Bine, mai târziu atunci."
  },
  {
   "key": "1976538829235261444",
   "en": "Well? Can we get back on topic?",
   "ro": "Ei? Putem reveni la subiect?"
  },
  {
   "key": "1976538829268815876",
   "en": "There you are.",
   "ro": "Iată-te."
  },
  {
   "key": "1976538829285593092",
   "en": "Well?",
   "ro": "Ei?"
  },
  {
   "key": "1976538829319147524",
   "en": "Got me waiting here.",
   "ro": "Mă ții aici să aștept."
  },
  {
   "key": "1976538829537251332",
   "en": "Think we've said all we're going to say.",
   "ro": "Cred că am spus tot ce aveam de spus."
  },
  {
   "key": "1976538829570805764",
   "en": "We leave you to your business, you leave us to ours.",
   "ro": "Noi ne vedem de-ale noastre, voi de-ale voastre."
  },
  {
   "key": "1976538829721800704",
   "en": "Someone's standing here.",
   "ro": "Cineva stă aici."
  },
  {
   "key": "1976538829738577924",
   "en": "Careful, there.",
   "ro": "Atenție, acolo."
  }
 ]
}
