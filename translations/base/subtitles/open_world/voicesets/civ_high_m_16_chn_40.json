{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_16_chn_40.json",
 "entries": [
  {
   "key": "1878074096073842692",
   "en": "Are you looking at me...?",
   "ro": "Te uiți la mine...?"
  },
  {
   "key": "1878074096090619908",
   "en": "What happened?",
   "ro": "Ce s-a întâmplat?"
  },
  {
   "key": "1878074096157728772",
   "en": "Hey, get away from me!",
   "ro": "Hei, cară-te de lângă mine!"
  },
  {
   "key": "1878074096191283200",
   "en": "Realign your optics!",
   "ro": "Realiniază-ți optica!"
  },
  {
   "key": "1878074096224837636",
   "en": "It's me. Can you talk?",
   "ro": "Sunt eu. Poți vorbi?"
  },
  {
   "key": "1878074096275169284",
   "en": "Can you drop anything off with her...? If you can't then... Well, we're dead…",
   "ro": "Poți lăsa ceva la ea...? Dacă nu poți, atunci... Păi, suntem morți…"
  },
  {
   "key": "1878074096308723716",
   "en": "Yes... of course... I envy your confidence.",
   "ro": "Da... desigur... Îți invidiez încrederea."
  },
  {
   "key": "1878074096342278148",
   "en": "Good luck.",
   "ro": "Baftă."
  },
  {
   "key": "1878074096510050308",
   "en": "She's a cyberpsycho!",
   "en_m": "He's a cyberpsycho!",
   "ro": "Ea e un cyberpsycho!",
   "ro_m": "El e un cyberpsycho!"
  },
  {
   "key": "1878074096526827524",
   "en": "Here! Of all places!",
   "ro": "Aici! Din toate locurile!"
  },
  {
   "key": "1878074096610713604",
   "en": "I have not done anything! It was not me!",
   "ro": "N-am făcut nimic! Nu eu am fost!"
  },
  {
   "key": "1878074096644268036",
   "en": "Do not kill me! I-I am no one!",
   "ro": "Nu mă omorî! S-sunt nimeni!"
  },
  {
   "key": "1878074096728154116",
   "en": "I... I'm sorry. What is the meaning of this?",
   "ro": "Eu... Îmi pare rău. Ce e asta?"
  },
  {
   "key": "1878074096744931332",
   "en": "Am I correct in thinking you are following me?",
   "ro": "Să înțeleg că mă urmărești?"
  },
  {
   "key": "1878075048415731712",
   "en": "What? I'm being serious!",
   "ro": "Ce? Sunt serios!"
  }
 ]
}
