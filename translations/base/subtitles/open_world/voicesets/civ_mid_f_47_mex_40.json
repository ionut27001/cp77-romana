{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_f_47_mex_40.json",
 "entries": [
  {
   "key": "1922804337316732932",
   "en": "Well? What?",
   "ro": "Ei? Ce?"
  },
  {
   "key": "1922804337350287364",
   "en": "How are you?",
   "ro": "Ce faci?"
  },
  {
   "key": "1922804337400619012",
   "en": "You lost or what?",
   "ro": "Te-ai rătăcit sau ce?"
  },
  {
   "key": "1922804337417396228",
   "en": "You're not welcome.",
   "ro": "Nu ești binevenită.",
   "ro_m": "Nu ești binevenit."
  },
  {
   "key": "1922804337484505092",
   "en": "Hey now. None of that.",
   "ro": "Hei, hei. Fără d-astea."
  },
  {
   "key": "1922804337501282308",
   "en": "Put that away. Right now.",
   "ro": "Pune la loc. Acum."
  },
  {
   "key": "1922804337568391168",
   "en": "This is your last chance. Leave.",
   "ro": "Ultima șansă. Pleacă."
  },
  {
   "key": "1922804337585168388",
   "en": "You think I'm bluffing? Scram, or you'll regret it.",
   "ro": "Crezi că blufez? Șterge-o, că o să regreți."
  },
  {
   "key": "1922804337652277252",
   "en": "Smart choice.",
   "ro": "Alegere inteligentă."
  },
  {
   "key": "1922804337685831684",
   "en": "Ah, better already.",
   "ro": "Ah, deja mai bine."
  },
  {
   "key": "1922804337786494980",
   "en": "Stupid jokes.",
   "ro": "Glume proaste."
  },
  {
   "key": "1922804337820049412",
   "en": "Hm? What?",
   "ro": "Hm? Ce?"
  },
  {
   "key": "1922804337870381060",
   "en": "Phew. Peace at last.",
   "ro": "Uf. În sfârșit pace."
  },
  {
   "key": "1922804337903935492",
   "en": "No reason. No reason at all.",
   "ro": "Fără motiv. Deloc."
  },
  {
   "key": "1922804337971044356",
   "en": "You think I'll just let you go?!",
   "ro": "Crezi că te las să pleci așa?!"
  },
  {
   "key": "1922804337987821572",
   "en": "Just you wait.",
   "ro": "Mai așteaptă."
  },
  {
   "key": "1922804338071707648",
   "en": "Watch it!",
   "ro": "Ai grijă!"
  },
  {
   "key": "1922804338088484868",
   "en": "What the hell is this?!",
   "ro": "Ce dracu' e asta?!"
  },
  {
   "key": "1922804338155593732",
   "en": "Hey. Got what I asked for?",
   "ro": "Hei. Ai ce-am cerut?"
  },
  {
   "key": "1922804338239479812",
   "en": "Yes. Every eddy.",
   "ro": "Da. Fiecare eddy."
  },
  {
   "key": "1922804338273034244",
   "en": "Of course. Soon as I hang up.",
   "ro": "Sigur. Imediat ce închid."
  },
  {
   "key": "1922804338306588676",
   "en": "Mm-hmm. Bye now.",
   "ro": "Mm-hmm. Pa acum."
  },
  {
   "key": "1922804338340143108",
   "en": "Not good…",
   "ro": "Nu e bine…"
  },
  {
   "key": "1922804338742796292",
   "en": "Alarm! Over here!",
   "ro": "Alarmă! Aici!"
  },
  {
   "key": "1922804338759573508",
   "en": "Help! Intruder!",
   "ro": "Ajutor! Intrus!"
  },
  {
   "key": "1922804338877014020",
   "en": "Oh God!",
   "ro": "Doamne!"
  },
  {
   "key": "1922804338910568452",
   "en": "Save me! Save me!",
   "ro": "Salvează-mă! Salvează-mă!"
  },
  {
   "key": "1922804338994454532",
   "en": "J-J-Jesus Christ, have mercy…",
   "ro": "D-D-Dumnezeule, ai milă…"
  },
  {
   "key": "1922804339028008964",
   "en": "Hail Mary, full of grace.",
   "ro": "Bucură-te, Marie, plină de har."
  },
  {
   "key": "1922804339111895044",
   "en": "You bored? Piss off!",
   "ro": "Te plictisești? Cară-te!"
  },
  {
   "key": "1922804339145449476",
   "en": "Hey! Leave me in peace!",
   "ro": "Hei! Lasă-mă în pace!"
  }
 ]
}
