{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_m_41_enus_40.json",
 "entries": [
  {
   "key": "1922866321580105732",
   "en": "I don't believe… I've had the pleasure?",
   "ro": "Nu-mi vine să cred… Ne-am mai întâlnit?"
  },
  {
   "key": "1922866321596882948",
   "en": "You, uh, live around here?",
   "ro": "Tu, uh, locuiești pe-aici?"
  },
  {
   "key": "1922866321663991812",
   "en": "Wh-- whassat?!",
   "ro": "Ce-- ce-i aia?!"
  },
  {
   "key": "1922866321697546244",
   "en": "Oh my fu--…!",
   "ro": "Oh, futu-i…!"
  },
  {
   "key": "1922866321731100676",
   "en": "It's me.",
   "ro": "Sunt eu."
  },
  {
   "key": "1922866321798209540",
   "en": "No… no, not at all.. I… I pawned it… So…? I am sober…! I promise!",
   "ro": "Nu… nu, deloc… Am… am amanetat-o… Și…? Sunt treaz…! Promit!"
  },
  {
   "key": "1922866321814986756",
   "en": "Only… one… Anyways, she… she played me. That's how it was…! I… No, I'm telling you, man!",
   "ro": "Doar… una… Oricum, ea… m-a păcălit. Așa a fost…! Eu… Nu, îți zic, frate!"
  },
  {
   "key": "1922866321865318400",
   "en": "I'll call you back… sometime.",
   "ro": "Te sun înapoi… cândva."
  },
  {
   "key": "1922866322049867780",
   "en": "Killers!",
   "ro": "Ucigași!"
  },
  {
   "key": "1922866322083422212",
   "en": "Save yourselves, people!",
   "ro": "Salvați-vă, oameni buni!"
  },
  {
   "key": "1922866322184085508",
   "en": "Hey… l-let's talk!",
   "ro": "Hei… h-hai să vorbim!"
  },
  {
   "key": "1922866322217639940",
   "en": "Gonna let me go, right?",
   "ro": "Mă lași să plec, nu?"
  },
  {
   "key": "1922866322318303236",
   "en": "You trying to… trap me?",
   "ro": "Încerci să… mă prinzi în capcană?"
  },
  {
   "key": "1922866322335080452",
   "en": "You… you won't get me. Piss off!",
   "ro": "Tu… nu mă prinzi. Cară-te!"
  },
  {
   "key": "1958900068651147268",
   "en": "I'll just, uh, be right here...",
   "ro": "Eu, uh, rămân aici..."
  },
  {
   "key": "1958900068701478916",
   "en": "Let's get back to biz.",
   "ro": "Hai să revenim la afaceri."
  },
  {
   "key": "1958900068718256132",
   "en": "Kinda in a rush here...",
   "ro": "Sunt cam pe grabă aici..."
  }
 ]
}
