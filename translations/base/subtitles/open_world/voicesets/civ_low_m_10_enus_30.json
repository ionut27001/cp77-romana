{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_m_10_enus_30.json",
 "entries": [
  {
   "key": "1896586493826703364",
   "en": "Uh, hey. How's it going?",
   "ro": "Uh, salut. Ce mai faci?"
  },
  {
   "key": "1896586493843480580",
   "en": "Ey! Uhh... Do I know you?",
   "ro": "Ei! Uhh... Te cunosc?"
  },
  {
   "key": "1896586493893812228",
   "en": "Can you just leave?",
   "ro": "Poți să pleci?"
  },
  {
   "key": "1896586493927366660",
   "en": "I recommend fucking off.",
   "ro": "Îți recomand să te cari."
  },
  {
   "key": "1896586493994475524",
   "en": "What's that for?",
   "ro": "Pentru ce?"
  },
  {
   "key": "1896586494011252740",
   "en": "You're not planning to use that?",
   "ro": "Nu plănuiești să folosești asta?"
  },
  {
   "key": "1896586494061584388",
   "en": "They will shoot you!",
   "ro": "Te vor împușca!"
  },
  {
   "key": "1896586494095138820",
   "en": "They don’t like people like you!",
   "ro": "Nu le plac oamenii ca tine!"
  },
  {
   "key": "1896586494145470468",
   "en": "Yeah, that's right.",
   "ro": "Da, exact."
  },
  {
   "key": "1896586494162247684",
   "en": "Right, could've ended badly.",
   "ro": "Bine că n-a sfârșit rău."
  },
  {
   "key": "1896586494246133764",
   "en": "What the hell's going on?",
   "ro": "Ce naiba se întâmplă?"
  },
  {
   "key": "1896586494262910980",
   "en": "Weird...",
   "ro": "Ciudat..."
  },
  {
   "key": "1896586494330019840",
   "en": "Huh... nobody here.",
   "ro": "Huh... nimeni aici."
  },
  {
   "key": "1896586494346797060",
   "en": "All good.",
   "ro": "Totul bine."
  },
  {
   "key": "1896586494397128708",
   "en": "I know you're here!",
   "ro": "Știu că ești aici!"
  },
  {
   "key": "1896586494430683140",
   "en": "You better not jump at me!",
   "ro": "Mai bine nu te repezi la mine!"
  },
  {
   "key": "1896586494481014788",
   "en": "Hey, watch it!",
   "ro": "Hei, ai grijă!"
  },
  {
   "key": "1896586494497792004",
   "en": "You in a hurry or somethin'?",
   "ro": "Te grăbești sau ceva?"
  },
  {
   "key": "1896586494531346436",
   "en": "Hey. It's me.",
   "ro": "Hei. Sunt eu."
  },
  {
   "key": "1896586494598455300",
   "en": "Can I drop by…? I mean longer than that… Well… My mom kicked me out… What do you think?",
   "ro": "Pot să trec pe la tine…? Adică mai mult de-atât… Păi… Mama m-a dat afară… Ce zici?"
  },
  {
   "key": "1896586494615232516",
   "en": "Yeah… Uh-huh… The usual, only worse… You know her… Mm-hm… Thanks... You're the man.",
   "ro": "Da… Mhm… Ca de obicei, doar că mai rău… O cunoști… Mhm… Mersi... Ești tare."
  },
  {
   "key": "1896586494665564164",
   "en": "I'll be over in a bit.",
   "ro": "Vin într-o clipă."
  },
  {
   "key": "1896586494682341380",
   "en": "Egh... I don't get it…",
   "ro": "Egh... Nu înțeleg…"
  },
  {
   "key": "1896586495051440132",
   "en": "Over here! Help!",
   "ro": "Aici! Ajutor!"
  },
  {
   "key": "1896586495084994564",
   "en": "She's over here!",
   "en_m": "He's over here!",
   "ro": "Ea e aici!",
   "ro_m": "El e aici!"
  },
  {
   "key": "1896586495185657860",
   "en": "No! Not again!",
   "ro": "Nu! Nu din nou!"
  },
  {
   "key": "1896586495219212292",
   "en": "Fucking crazy!",
   "ro": "Nebun de-a binelea!"
  },
  {
   "key": "1896586495336652804",
   "en": "Please, no!",
   "ro": "Te rog, nu!"
  },
  {
   "key": "1896586495370207236",
   "en": "Why?",
   "ro": "De ce?"
  },
  {
   "key": "1896586495454093316",
   "en": "Hey, choom, go harrass someone else.",
   "ro": "Hei, choom, du-te să hărțuiești pe altcineva."
  },
  {
   "key": "1896586495470870532",
   "en": "Please, I need to be alone.",
   "ro": "Te rog, trebuie să fiu singur."
  }
 ]
}
