{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_mid_m_38_afam_30.json",
 "entries": [
  {
   "key": "1907014994530672644",
   "en": "What, huh?",
   "ro": "Ce, ha?"
  },
  {
   "key": "1907014994564227076",
   "en": "Hello.",
   "ro": "Salut."
  },
  {
   "key": "1907014994648113156",
   "en": "Hey, you. Go home.",
   "ro": "Hei, tu. Du-te acasă."
  },
  {
   "key": "1907014994664890372",
   "en": "You shouldn't be here.",
   "ro": "Nu ar trebui să fii aici."
  },
  {
   "key": "1907014994748776452",
   "en": "Drop it, you're askin' for a bloodbath.",
   "ro": "Lasă-o baltă, ceri un masacru."
  },
  {
   "key": "1907014994799108100",
   "en": "You wanna die? No? Then calm the fuck down.",
   "ro": "Vrei să mori? Nu? Atunci calmează-te dracu'!"
  },
  {
   "key": "1907014994882994180",
   "en": "Playin' with fire. You should get outta here.",
   "ro": "Te joci cu focul. Ar trebui să pleci de aici."
  },
  {
   "key": "1907014994933325824",
   "en": "Go. Go, before they shoot ya.",
   "ro": "Du-te. Du-te, înainte să te împuște."
  },
  {
   "key": "1907014994983657476",
   "en": "You don't got much of a survival instinct, do ya?",
   "ro": "Nu prea ai instinct de supraviețuire, nu?"
  },
  {
   "key": "1907014995017211908",
   "en": "Whew, that's better.",
   "ro": "Uf, așa e mai bine."
  },
  {
   "key": "1907014995084320772",
   "en": "Huh? Oh man…",
   "ro": "Ha? Oh, frate…"
  },
  {
   "key": "1907014995117875204",
   "en": "Hmm? What the…",
   "ro": "Hmm? Ce naiba…"
  },
  {
   "key": "1907014995184984068",
   "en": "Ugh. Pointless.",
   "ro": "Ugh. Inutil."
  },
  {
   "key": "1907014995218538500",
   "en": "Meh. Least I tried.",
   "ro": "Meh. Măcar am încercat."
  },
  {
   "key": "1907014995285647364",
   "en": "Playin' hide and seek?",
   "ro": "Te joci de-a v-ați ascunselea?"
  },
  {
   "key": "1907014995319201792",
   "en": "I heard you!",
   "ro": "Te-am auzit!"
  },
  {
   "key": "1907014995386310660",
   "en": "Ugh. You just crossed the line!",
   "ro": "Ugh. Ai trecut linia!"
  },
  {
   "key": "1907014995436642308",
   "en": "Why don't you control yourself!",
   "ro": "De ce nu te controlezi!"
  },
  {
   "key": "1907014995486973956",
   "en": "Hello? Yes, speaking.",
   "ro": "Alo? Da, eu sunt."
  },
  {
   "key": "1907014995554082820",
   "en": "No, I'm not interested.",
   "ro": "Nu, nu sunt interesat."
  },
  {
   "key": "1907014995604414464",
   "en": "I didn't order anything like that.",
   "ro": "N-am comandat așa ceva."
  },
  {
   "key": "1907014995637968900",
   "en": "Don't call this number again.",
   "ro": "Nu mai suna la numărul ăsta."
  },
  {
   "key": "1907014995671523332",
   "en": "Something's up…",
   "ro": "Se întâmplă ceva…"
  },
  {
   "key": "1907014996124508164",
   "en": "Security!",
   "ro": "Pază!"
  },
  {
   "key": "1907014996158062596",
   "en": "Hey! Clean up around here!",
   "ro": "Hei! Fă curat pe aici!"
  },
  {
   "key": "1907014996275503108",
   "en": "Run! Save yourselves!",
   "ro": "Fugiți! Salvați-vă!"
  },
  {
   "key": "1907014996309057540",
   "en": "Somebody call the cops!",
   "ro": "Cineva să cheme poliția!"
  },
  {
   "key": "1907014996409720836",
   "en": "Mercy…. I did nothin' to ya!",
   "ro": "Milă… N-am făcut nimic ție!"
  },
  {
   "key": "1907014996426498052",
   "en": "No – I don't wanna die!",
   "ro": "Nu – nu vreau să mor!"
  },
  {
   "key": "1907014996543938564",
   "en": "Leave me alone, yeah?",
   "ro": "Lasă-mă în pace, da?"
  },
  {
   "key": "1907014996594270212",
   "en": "Hey! Fuck off, OK!?",
   "ro": "Hei! Du-te dracu', OK?!"
  }
 ]
}
