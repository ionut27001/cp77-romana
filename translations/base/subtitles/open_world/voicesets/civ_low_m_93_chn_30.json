{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_m_93_chn_30.json",
 "entries": [
  {
   "key": "1922918890721517572",
   "en": "Take a hike.",
   "ro": "Cară-te!"
  },
  {
   "key": "1922918890738294788",
   "en": "I don't know you. Fuck off.",
   "ro": "Nu te cunosc. Du-te dracu'."
  },
  {
   "key": "1922918890805403652",
   "en": "Fuckin'…!",
   "ro": "Pula mea…!"
  },
  {
   "key": "1922918890822180868",
   "en": "What the fuck? Huh?!",
   "ro": "Ce pula mea?! Huh?!"
  },
  {
   "key": "1922918890872512516",
   "en": "Hi. It's me.",
   "ro": "Salut. Sunt eu."
  },
  {
   "key": "1922918890939621380",
   "en": "Who, huh…? Nothin… Nothin', I'm telling you…! Just fuckin' guess... He stood me up!",
   "ro": "Cine, hm…? Nimic… Nimic, îți zic…! Doar ghicește, pula mea…! M-a lăsat baltă!"
  },
  {
   "key": "1922918890973175812",
   "en": "I don't get it… He was sending signals… Mm-hmm... OK… I didn’t think of that.",
   "ro": "Nu pricep… Îmi trimitea semnale… Mm-hmm... Bine… Nu m-am gândit la asta."
  },
  {
   "key": "1922918891006730244",
   "en": "We'll talk later.",
   "ro": "Vorbim mai târziu."
  },
  {
   "key": "1922918891208056836",
   "en": "Call MaxTac!",
   "ro": "Cheamă MaxTac!"
  },
  {
   "key": "1922918891224834052",
   "en": "Where are the cops?!",
   "ro": "Unde-s polițiștii?!"
  },
  {
   "key": "1922918891325497348",
   "en": "C--… calm down! Be cool!",
   "ro": "L--… liniștește-te! Fii calm!"
  },
  {
   "key": "1922918891342274564",
   "en": "Please, no!",
   "ro": "Te rog, nu!"
  },
  {
   "key": "1922918891442937860",
   "en": "Fuck off. I'm not interested.",
   "ro": "Du-te dracu'. Nu mă interesează."
  },
  {
   "key": "1922918891476492292",
   "en": "Don't bother me, ok?",
   "ro": "Nu mă deranja, ok?"
  },
  {
   "key": "1958903196427526148",
   "en": "We put this on hold, OK?",
   "ro": "Amânăm asta, OK?"
  },
  {
   "key": "1958903196477857796",
   "en": "Ah, you're back. Good.",
   "ro": "Ah, te-ai întors. Bine."
  },
  {
   "key": "1958903196494635012",
   "en": "What do you think?",
   "ro": "Ce crezi?"
  }
 ]
}
