 "entries": [
  {
   "key": "1922625855605448708",
   "en": "Well hi there.",
   "ro": "Salutare."
  },
  {
   "key": "1922625855622225924",
   "en": "Life's a peach, am I right?",
   "ro": "Viața e frumoasă, nu-i așa?"
  },
  {
   "key": "1922625855672557572",
   "en": "What's the rush?",
   "ro": "Ce te grăbești?"
  },
  {
   "key": "1922625855689334788",
   "en": "Oh, come on!",
   "ro": "Hai, mă!"
  },
  {
   "key": "1922625855739666436",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1922625855789998084",
   "en": "Ugh, why…? I don't feel like it… Life's meant for living! Carpe diem!",
   "ro": "Ugh, de ce…? Nu am chef… Viața e făcută s-o trăiești! Carpe diem!"
  },
  {
   "key": "1922625855806775300",
   "en": "We all gonna die anyhow… Yeah..! Yeah…! Long as there's cash.",
   "ro": "O să murim toți oricum… Da..! Da…! Câtă vreme e cash."
  },
  {
   "key": "1922625855857106948",
   "en": "Hang in there.",
   "ro": "Ține-te bine."
  },
  {
   "key": "1922625856024879108",
   "en": "In the kisser! Again!",
   "ro": "În gură! Din nou!"
  },
  {
   "key": "1922625856058433540",
   "en": "She'll kill us!",
   "en_m": "He'll kill us!",
   "ro": "Ea ne va omorî!",
   "ro_m": "El ne va omorî!"
  },
  {
   "key": "1922625856142319620",
   "en": "Leave it, all right?",
   "ro": "Las-o, bine?"
  },
  {
   "key": "1922625856175874052",
   "en": "I was just passing through!",
   "ro": "Doar treceam pe-aici!"
  },
  {
   "key": "1922625856293314564",
   "en": "Aw, where are your friends, little girl?",
   "en_m": "Aw, where are your friends, little boy?",
   "ro": "Aww, unde sunt prietenii tăi, fetițo?",
   "ro_m": "Aww, unde sunt prietenii tăi, băiețel?"
  },
  {
   "key": "1922625856326868992",
   "en": "Off you go.",
   "ro": "Hai, du-te."
  }
 ]
