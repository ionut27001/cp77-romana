{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_32_car_50.json",
 "entries": [
  {
   "key": "1948855548341428228",
   "en": "Do you want me to ask \"How can I help you?\"",
   "ro": "Vrei să te întreb „Cu ce te pot ajuta?”"
  },
  {
   "key": "1948855548358205444",
   "en": "Leave me alone.",
   "ro": "Lasă-mă în pace."
  },
  {
   "key": "1948855548408537092",
   "en": "Go away.",
   "ro": "Pleacă."
  },
  {
   "key": "1948855548425314308",
   "en": "Just leave.",
   "ro": "Pleacă odată."
  },
  {
   "key": "1948855548475645956",
   "en": "Don't make this complicated!",
   "ro": "Nu complica lucrurile!"
  },
  {
   "key": "1948855548492423172",
   "en": "Put that away!",
   "ro": "Pune asta la loc!"
  },
  {
   "key": "1948855548542754820",
   "en": "They will treat you like a cyberpsycho.",
   "ro": "Te vor trata ca pe un cyberpsycho."
  },
  {
   "key": "1948855548559532036",
   "en": "I mean it. Get out of here!",
   "ro": "Serios. Ieși de aici!"
  },
  {
   "key": "1948855548609863684",
   "en": "Great. Thank you.",
   "ro": "Minunat. Mulțumesc."
  },
  {
   "key": "1948855548626640900",
   "en": "I was just thinking…",
   "ro": "Tocmai mă gândeam…"
  },
  {
   "key": "1948855548676972548",
   "en": "Just a moment of peace…",
   "ro": "Doar un moment de liniște…"
  },
  {
   "key": "1948855548693749764",
   "en": "I'm too old for this.",
   "ro": "Sunt prea bătrân pentru asta."
  },
  {
   "key": "1948855548744081412",
   "en": "And he's gone.",
   "ro": "Și a plecat."
  },
  {
   "key": "1948855548777635844",
   "en": "Outta sight, outta mind.",
   "ro": "Departe de ochi, departe de suflet."
  },
  {
   "key": "1948855548827967488",
   "en": "Ey must be here somewhere…",
   "ro": "Trebuie să fie pe-aici pe undeva…"
  },
  {
   "key": "1948855548844744708",
   "en": "You can't hide!",
   "ro": "Nu te poți ascunde!"
  },
  {
   "key": "1948855548895076352",
   "en": "Ugh…",
   "ro": "Ugh…"
  },
  {
   "key": "1948855548911853572",
   "en": "Don't push me!",
   "ro": "Nu mă împinge!"
  },
  {
   "key": "1948855548945408004",
   "en": "<kiroshi l=\"creo\" o=\"Bonjou, chè.\" t=\"Hello, dear.\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"creo\" o=\"Bonjou, chè.\" t=\"Salut, dragă.\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1948855548995739648",
   "en": "I know, sorry about it… I got a thing… Yeah, again… That's how it is.",
   "ro": "Știu, îmi pare rău… Am ceva de făcut… Da, iar… Așa-i."
  },
  {
   "key": "1948855549012516868",
   "en": "Go without me… Yes, I'll pay… Yes… You can tell me about it… Next time.",
   "ro": "Mergi fără mine… Da, plătesc eu… Da… Îmi poți povesti… Data viitoare."
  },
  {
   "key": "1948855549046071300",
   "en": "<kiroshi l=\"creo\" o=\"Babay.\" t=\"Bye bye.\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"creo\" o=\"Babay.\" t=\"Pa-pa.\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1948855549062848516",
   "en": "What now?",
   "ro": "Ce acum?"
  },
  {
   "key": "1948855549415170052",
   "en": "She's gonna attack!",
   "en_m": "He's gonna attack!",
   "ro": "Ea o să atace!",
   "ro_m": "El o să atace!"
  },
  {
   "key": "1948855549431947268",
   "en": "Do something!",
   "ro": "Fă ceva!"
  },
  {
   "key": "1948855549532610564",
   "en": "Aahhh!!",
   "ro": "Aahhh!!"
  },
  {
   "key": "1948855549549387780",
   "en": "Police!",
   "ro": "Poliția!"
  },
  {
   "key": "1948855549633273856",
   "en": "Have mercy. Please.",
   "ro": "Fii milos. Te rog."
  },
  {
   "key": "1948855549650051076",
   "en": "I… I can't… not yet!",
   "ro": "Eu… nu pot… nu încă!"
  },
  {
   "key": "1948855549717159940",
   "en": "What is up with you?",
   "ro": "Ce-ai?"
  },
  {
   "key": "1948855549750714372",
   "en": "Not right now, ok? Not now.",
   "ro": "Nu acum, bine? Nu acum."
  }
 ]
}
