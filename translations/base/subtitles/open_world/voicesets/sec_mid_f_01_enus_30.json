{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_mid_f_01_enus_30.json",
 "entries": [
  {
   "key": "1912622149245870080",
   "en": "Don't talk.",
   "ro": "Nu vorbi."
  },
  {
   "key": "1912622149262647300",
   "en": "Hello and good-fucking-bye!",
   "ro": "Salut și la revedere, pula mea!"
  },
  {
   "key": "1912622149329756164",
   "en": "Woah. Stay back.",
   "ro": "Uau. Stai pe loc."
  },
  {
   "key": "1912622149363310596",
   "en": "Made a wrong turn.",
   "ro": "Am făcut o greșeală de drum."
  },
  {
   "key": "1912622149463973888",
   "en": "That's not allowed!",
   "ro": "Nu e voie!"
  },
  {
   "key": "1912622149480751108",
   "en": "No open carry here, friend.",
   "ro": "Aici nu se poartă arme la vedere, prietene."
  },
  {
   "key": "1912622149547859972",
   "en": "Listen, I just don't like you.",
   "ro": "Ascultă, pur și simplu nu-mi placi."
  },
  {
   "key": "1912622149581414404",
   "en": "Playtime's over.",
   "ro": "S-a terminat joaca."
  },
  {
   "key": "1912622149631746052",
   "en": "See? Was it that hard?",
   "ro": "Vezi? A fost așa de greu?"
  },
  {
   "key": "1912622149665300484",
   "en": "That's right – keep going.",
   "ro": "Așa e – continuă."
  },
  {
   "key": "1912622149732409348",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1912622149765963780",
   "en": "Possibly hostile activity!",
   "ro": "Posibilă activitate ostilă!"
  },
  {
   "key": "1912622149833072644",
   "en": "No stone unturned.",
   "ro": "Nicio piatră neîntoarsă."
  },
  {
   "key": "1912622149866627072",
   "en": "Area secure.",
   "ro": "Zonă securizată."
  },
  {
   "key": "1912622149933735940",
   "en": "Game's up, terrorist! Just cut your losses already!",
   "ro": "Jocul s-a terminat, teroristule! Renunță deja!"
  },
  {
   "key": "1912622149967290372",
   "en": "These attacks won't accomplish anything!",
   "ro": "Atacurile astea nu vor duce la nimic!"
  },
  {
   "key": "1912622150034399236",
   "en": "Holy shit!",
   "ro": "Ce căcat!"
  },
  {
   "key": "1912622150084730884",
   "en": "Understood!",
   "ro": "Înțeles!"
  },
  {
   "key": "1912622150151839744",
   "en": "Liquidate her!",
   "en_m": "Liquidate him!",
   "ro": "Lichidați-o!",
   "ro_m": "Lichidați-l!"
  },
  {
   "key": "1912622150168616964",
   "en": "Intruder alert! Intruder!",
   "ro": "Alertă de intrus! Intrus!"
  },
  {
   "key": "1912622150202171396",
   "en": "Frag out!",
   "ro": "Grenadă!"
  },
  {
   "key": "1912622150286057476",
   "en": "Neutralize her!",
   "en_m": "Neutralize him!",
   "ro": "Neutralizează-o!",
   "ro_m": "Neutralizează-l!"
  },
  {
   "key": "1912622150319611908",
   "en": "That's what I'm talking about!",
   "ro": "Asta zic și eu!"
  },
  {
   "key": "1912622150386720772",
   "en": "This is very bad!",
   "ro": "E foarte grav!"
  },
  {
   "key": "1912622150420275204",
   "en": "Fuck, fuck, FUCK!",
   "ro": "Futu-i, futu-i, FUTU-I!"
  },
  {
   "key": "1912622150487384068",
   "en": "Lady!",
   "en_m": "Dude!",
   "ro": "Doamnă!",
   "ro_m": "Frate!"
  },
  {
   "key": "1912622150537715716",
   "en": "Don't make me mad!",
   "ro": "Nu mă enerva!"
  },
  {
   "key": "1912622150621601796",
   "en": "Talk to me.",
   "ro": "Vorbește cu mine."
  },
  {
   "key": "1912622150705487876",
   "en": "No… no… I don't want that shit, that's why… Jake bought one and cut himself in action...",
   "ro": "Nu… nu… nu vreau rahatul ăsta, de-aia… Jake și-a luat unul și s-a tăiat în acțiune..."
  },
  {
   "key": "1912622150789373956",
   "en": "Mucho moolah… Hmm, maybe I can pay another way. I know a guy… Mm.",
   "ro": "Mulți bani… Hmm, poate plătesc altfel. Cunosc eu un tip… Mm."
  },
  {
   "key": "1912622150873260036",
   "en": "Target exposed!",
   "ro": "Ținta expusă!"
  },
  {
   "key": "1912622150923591684",
   "en": "Covering!",
   "ro": "Acopăr!"
  },
  {
   "key": "1912622150990700548",
   "en": "Grenade! Take cover!",
   "ro": "Granată! La adăpost!"
  },
  {
   "key": "1912622151024254980",
   "en": "Waiting for you.",
   "ro": "Te aștept."
  },
  {
   "key": "1912622151057809412",
   "en": "Could be a trap! I'm checking it.",
   "ro": "Ar putea fi o capcană! Verific."
  },
  {
   "key": "1912622151158472708",
   "en": "Remember. We're clear to shoot on sight.",
   "ro": "Ține minte. Avem permisiune să tragem la vedere."
  },
  {
   "key": "1912622151208804356",
   "en": "Stick together.",
   "ro": "Rămâneți împreună."
  },
  {
   "key": "1912622151275913220",
   "en": "I'll cover you.",
   "ro": "Te acopăr."
  },
  {
   "key": "1912622151309467652",
   "en": "She's there! Keep shooting!",
   "en_m": "He's there! Keep shooting!",
   "ro": "Ea e acolo! Trageți în continuare!",
   "ro_m": "El e acolo! Trageți în continuare!"
  },
  {
   "key": "1912622151376576516",
   "en": "Khh… wha… khhh… let go.",
   "ro": "Khh… ce… khhh… dă drumul."
  },
  {
   "key": "1912630257624031232",
   "en": "I've got a month or… Mhm… I'll work something out..",
   "ro": "Mai am o lună sau… Mhm… mă descurc cumva.."
  },
  {
   "key": "1912630633785991168",
   "en": "Just ask, I'm sure I can find something… Yeah… Some fakes at the very least…",
   "ro": "Întreabă doar, sunt sigură că găsesc ceva… Da… Măcar niște falsuri…"
  },
  {
   "key": "2233840161904566276",
   "en": "No mercy!",
   "ro": "Fără milă!"
  },
  {
   "key": "2233840162022006788",
   "en": "Man down! Head on a swivel!",
   "ro": "Omul jos! Privire în toate părțile!"
  },
  {
   "key": "2233840162055561220",
   "en": "What the...",
   "ro": "Ce naiba..."
  },
  {
   "key": "2233840162173001728",
   "en": "False alarm. Spread out.",
   "ro": "Alarmă falsă. Răspândiți-vă!"
  },
  {
   "key": "2233840162290442244",
   "en": "Maintain formation!",
   "ro": "Mențineți formația!"
  },
  {
   "key": "2233840162357551104",
   "en": "Need a medic!",
   "ro": "Am nevoie de un medic!"
  },
  {
   "key": "2233840162407882756",
   "en": "Any last words?!",
   "ro": "Ultimele cuvinte?!"
  },
  {
   "key": "2233840162491768832",
   "en": "Aaargghh!",
   "ro": "Aaargghh!"
  },
  {
   "key": "2233840162743427076",
   "en": "Target's wounded!",
   "ro": "Ținta e rănită!"
  },
  {
   "key": "2233840162911199236",
   "en": "She's weak! Finish her off!",
   "en_m": "He's weak! Finish him off!",
   "ro": "E slăbită! Terminați-o!",
   "ro_m": "E slăbit! Terminați-l!"
  },
  {
   "key": "2233840162978308100",
   "en": "Roger!",
   "ro": "Roger!"
  },
  {
   "key": "2233840163045416964",
   "en": "She's hiding! Scared!",
   "en_m": "He's hiding! Scared!",
   "ro": "Se ascunde! E speriată!",
   "ro_m": "Se ascunde! E speriat!"
  },
  {
   "key": "2233840163095748612",
   "en": "Reloading!",
   "ro": "Reîncărcare!"
  },
  {
   "key": "2233840163146080260",
   "en": "Neutralize the threat!",
   "ro": "Neutralizează amenințarea!"
  },
  {
   "key": "2233840163263520772",
   "en": "Visuals down! I repeat, visuals down!",
   "ro": "Grafică căzută! Repet, grafică căzută!"
  },
  {
   "key": "2233840163313852420",
   "en": "She's a netrunner!",
   "en_m": "He's a netrunner!",
   "ro": "E netrunner!"
  },
  {
   "key": "2233840163380961284",
   "en": "Oof!",
   "ro": "Uf!"
  },
  {
   "key": "2233840163431292932",
   "en": "Need backup!",
   "ro": "Am nevoie de întăriri!"
  },
  {
   "key": "2233840163481624576",
   "en": "Entering close quarters!",
   "ro": "Intram în luptă la mică distanță!"
  },
  {
   "key": "2233840163531956228",
   "en": "Firing up close!",
   "ro": "Trag de aproape!"
  },
  {
   "key": "2233840163582287876",
   "en": "Covering fire!",
   "ro": "Foc de acoperire!"
  },
  {
   "key": "2233840163649396740",
   "en": "Heads down goddamnit!",
   "ro": "Capetele jos, mama dracului!"
  },
  {
   "key": "2233840163901054980",
   "en": "Saw something. Need to check it out.",
   "ro": "Am văzut ceva. Trebuie să verific."
  }
 ]
}
