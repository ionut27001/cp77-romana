  {
   "key": "1953249202392834052",
   "en": "Spare an eddy?",
   "ro": "Spari un eddy?"
  },
  {
   "key": "1953249202409611268",
   "en": "Whatchu lookin' at?",
   "ro": "La ce te uiți?"
  },
  {
   "key": "1953249202459942916",
   "en": "Fuck, man!",
   "ro": "Pula mea, frate!"
  },
  {
   "key": "1953249202459942928",
   "en": "I'm right here!",
   "ro": "Sunt chiar aici!"
  },
  {
   "key": "1953249202493497348",
   "en": "Where you gallivantin' today?",
   "ro": "Unde te plimbi azi?"
  },
  {
   "key": "1953249202543828996",
   "en": "Guess we missed each other… I don't feel like goin' there… Yeah… Ah, nice.",
   "ro": "Ne-am ratat, cred… Nu-mi arde de mers acolo… Da… Ah, fain."
  },
  {
   "key": "1953249202560606212",
   "en": "Got somethin'… Enough for some grub… Yeah… of course… Yeaaa.",
   "ro": "Am ceva… Cât să iau ceva de mâncat… Da… sigur… Yeaaa."
  },
  {
   "key": "1953249202594160644",
   "en": "Later.",
   "ro": "Pe mai târziu."
  },
  {
   "key": "1953249202745155588",
   "en": "Holy fuck!",
   "ro": "Băi, pula mea!"
  },
  {
   "key": "1953249202761932804",
   "en": "Oh shit!",
   "ro": "Ah, căcat!"
  },
  {
   "key": "1953249202845818884",
   "en": "Please! I'm beggin' you!",
   "ro": "Te rog! Mă rog de tine!"
  },
  {
   "key": "1953249202862596100",
   "en": "What you want from me?!",
   "ro": "Ce vrei de la mine?!"
  },
  {
   "key": "1953249202946482180",
   "en": "Fuck off, why don't ya.",
   "ro": "Du-te-n pula mea, nu?"
  },
  {
   "key": "1953249202963259396",
   "en": "The hell you stalkin' me for?",
   "ro": "Ce dracu' mă urmărești?"
  }
 ]
