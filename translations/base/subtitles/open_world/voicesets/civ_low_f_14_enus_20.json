{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_f_14_enus_20.json",
 "entries": [
  {
   "key": "1949041726231011332",
   "en": "But why? Just why?",
   "ro": "Dar de ce? Doar de ce?"
  },
  {
   "key": "1949041726264565764",
   "en": "We're all gonna die anyway.",
   "ro": "O să murim toți oricum."
  },
  {
   "key": "1949041726348451840",
   "en": "What's your hurry?",
   "ro": "Ce te grăbești?"
  },
  {
   "key": "1949041726382006276",
   "en": "Moron.",
   "ro": "Tâmpito!",
   "ro_m": "Tâmpitule!"
  },
  {
   "key": "1949041726398783492",
   "en": "Hey. It's me.",
   "ro": "Hei. Sunt eu."
  },
  {
   "key": "1949041726449115140",
   "en": "They found him… No, at the organ donor warehouse… Yeah… In pieces… Almost everything.",
   "ro": "L-au găsit… Nu, la depozitul de donatori de organe… Da… Bucăți… Mai tot, de fapt."
  },
  {
   "key": "1949041726482669572",
   "en": "Just a skull and spine left… Yeah… Really… Funeral's Friday... Thanks.",
   "ro": "A mai rămas doar un craniu și coloana… Da… Chiar… Înmormântarea e vineri... Mulțumesc."
  },
  {
   "key": "1949041726516224004",
   "en": "Catch you later.",
   "ro": "Ne vedem mai târziu."
  },
  {
   "key": "1949041726667218948",
   "en": "Oh god, no!",
   "ro": "Oh, Doamne, nu!"
  },
  {
   "key": "1949041726700773380",
   "en": "I knew it! I knew it!",
   "ro": "Știam! Știam!"
  },
  {
   "key": "1949041726784659456",
   "en": "I'm begging!",
   "ro": "Mă rog!"
  },
  {
   "key": "1949041726801436676",
   "en": "What's that for?",
   "ro": "Pentru ce?"
  },
  {
   "key": "1949041726902099972",
   "en": "I'm warning you, you won't make a killin' off me.",
   "ro": "Să știi, nu faci bani pe mine."
  },
  {
   "key": "1949041726918877188",
   "en": "Find yourself a better target.",
   "ro": "Găsește-ți o țintă mai bună."
  }
 ]
}
