{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\sec_low_m_03_afam_30.json",
 "entries": [
  {
   "key": "1905526811599052804",
   "en": "You got something to say?",
   "ro": "Ai ceva de spus?"
  },
  {
   "key": "1905526811632607236",
   "en": "Wanna go?",
   "ro": "Vrei să te iei la bătaie?"
  },
  {
   "key": "1905526811682938884",
   "en": "Hey you! Scram!",
   "ro": "Hei, tu! Valea!"
  },
  {
   "key": "1905526811699716100",
   "en": "Where ya think you goin?",
   "ro": "Unde crezi că te duci?"
  },
  {
   "key": "1905526811766824964",
   "en": "Fuckin' put that away!",
   "ro": "Pune dracu' chestia aia la loc!"
  },
  {
   "key": "1905526811783602180",
   "en": "Fuck outta my face!",
   "ro": "Dispari din fața mea!"
  },
  {
   "key": "1905526811850711044",
   "en": "I'm talkin' to you!",
   "ro": "Cu tine vorbesc!"
  },
  {
   "key": "1905526811867488260",
   "en": "Imma fuck you up!",
   "ro": "Te fac praf!"
  },
  {
   "key": "1905526811934597124",
   "en": "Who da man? Ha!",
   "ro": "Cine-i bărbatul? Ha!"
  },
  {
   "key": "1905526811951374340",
   "en": "I like being on top, he, he, he.",
   "ro": "Îmi place să fiu deasupra, he, he, he."
  },
  {
   "key": "1905526812018483204",
   "en": "Mm, mm, mm.",
   "ro": "Mm, mm, mm."
  },
  {
   "key": "1905526812035260420",
   "en": "What the…",
   "ro": "Ce naiba…"
  },
  {
   "key": "1905526812085592068",
   "en": "Guess it's all good.",
   "ro": "Se pare că e totul bine."
  },
  {
   "key": "1905526812119146500",
   "en": "Poof. Situation managed.",
   "ro": "Puf. Situație gestionată."
  },
  {
   "key": "1905526812169478148",
   "en": "Come out!",
   "ro": "Ieși afară!"
  },
  {
   "key": "1905526812186255364",
   "en": "Man, she's gotta be here somewhere!",
   "en_m": "Man, he's gotta be here somewhere!",
   "ro": "Frate, trebuie să fie pe-aici undeva!"
  },
  {
   "key": "1905526812253364228",
   "en": "Hey, a fuckin' body!",
   "ro": "Hei, un cadavru, pula mea!"
  },
  {
   "key": "1905526812286918660",
   "en": "Yeah, yeah.",
   "ro": "Da, da."
  },
  {
   "key": "1905526812354027524",
   "en": "She wants me dead!",
   "en_m": "He wants me dead!",
   "ro": "Vrea să mă omoare."
  },
  {
   "key": "1905526812387581956",
   "en": "Fuck! Help!",
   "ro": "Futu-i! Ajutor!"
  },
  {
   "key": "1905526812421136388",
   "en": "Choke on this!",
   "ro": "Sufocă-te cu asta!"
  },
  {
   "key": "1905526812488245252",
   "en": "Shoot!",
   "ro": "Trage!"
  },
  {
   "key": "1905526812505022468",
   "en": "Not here to cuddle!",
   "ro": "Nu sunt aici să mă îmbrățișez!"
  },
  {
   "key": "1905526812555354116",
   "en": "Fucking hell!",
   "ro": "Pula mea!"
  },
  {
   "key": "1905526812588908548",
   "en": "We're fucked!",
   "ro": "Ne-am futut."
  },
  {
   "key": "1905526812639240196",
   "en": "Ouch!",
   "ro": "Au!"
  },
  {
   "key": "1905526812672794628",
   "en": "Watch it, man!",
   "ro": "Ai grijă, frate!"
  },
  {
   "key": "1905526812723126276",
   "en": "What?",
   "ro": "Ce?"
  },
  {
   "key": "1905526812807012356",
   "en": "I don't get it… Why me…? Can't someone else--?",
   "ro": "Nu înțeleg… De ce eu…? Nu poate altcineva--?"
  },
  {
   "key": "1905526812840566788",
   "en": "Huh…? Where…? Do they still need me there…?",
   "ro": "Huh…? Unde…? Mă mai vor acolo…?"
  },
  {
   "key": "1905526812924452868",
   "en": "Take her up the ass!",
   "en_m": "Take him up the ass!",
   "ro": "Băgați-o în cur!",
   "ro_m": "Băgați-l în cur!"
  },
  {
   "key": "1905526812974784516",
   "en": "Comin'!",
   "ro": "Vin!"
  },
  {
   "key": "1905526813025116164",
   "en": "Fuckin' fuck!",
   "ro": "Futu-i, pula mea!"
  },
  {
   "key": "1905526813058670596",
   "en": "Bye then.",
   "ro": "Pa atunci."
  },
  {
   "key": "1905526813075447812",
   "en": "I don't like this.",
   "ro": "Nu-mi place asta."
  },
  {
   "key": "1905526813142556676",
   "en": "Eh you, reload and come with!",
   "ro": "Ei, tu, reîncarcă și vino cu noi!"
  },
  {
   "key": "1905526813176111108",
   "en": "Oh fuck! Be ready!",
   "ro": "Oh, futu-i! Fii gata!"
  },
  {
   "key": "1905526813209665540",
   "en": "Go check it.",
   "ro": "Du-te și verifică."
  },
  {
   "key": "1905526813226442756",
   "en": "Why don't you give up!",
   "ro": "De ce nu renunți!"
  },
  {
   "key": "1905526813276774404",
   "en": "Argh… khhh… khhh… whuh.",
   "ro": "Argh… khhh… khhh… whuh."
  },
  {
   "key": "1905532216681177088",
   "en": "Oh… Yeah I know… But I don't like him… Uhh… Ok.",
   "ro": "Ah… Da, știu… Dar nu-l suport… Ăă… Ok."
  },
  {
   "key": "1905532685000384512",
   "en": "Fine, fine… Yeah, I got it.",
   "ro": "Bine, bine… Da, am înțeles."
  },
  {
   "key": "2236547375622660100",
   "en": "Don't hold back!",
   "ro": "Nu te abține!"
  },
  {
   "key": "2236547375723323396",
   "en": "Shit! Keep your eyes open!",
   "ro": "La naiba! Ține ochii deschiși!"
  },
  {
   "key": "2236547375756877828",
   "en": "Fuck... Just updated my drivers...",
   "ro": "Pula mea... Tocmai mi-am actualizat driverele..."
  },
  {
   "key": "2236547375891095556",
   "en": "What? Come to chit-chat? Get back to work!",
   "ro": "Ce? Ai venit la povești? Înapoi la muncă!"
  },
  {
   "key": "2236547376193085444",
   "en": "What is it with you people?!",
   "ro": "Ce-i cu voi, mă?!"
  },
  {
   "key": "2236547376260194308",
   "en": "Fuck outta here!",
   "ro": "Cară-te dracu' de-aici!"
  },
  {
   "key": "2236547376427966468",
   "en": "Hold formation! Keep shooting!",
   "ro": "Mențineți formația! Continuați să trageți!"
  },
  {
   "key": "2236547376578961408",
   "en": "Got a hit!",
   "ro": "Am lovit!"
  },
  {
   "key": "2236547376797065220",
   "en": "She's on her knees! Finish the bitch!",
   "en_m": "He's on her knees! Finish the asshole!",
   "ro": "E în genunchi! Terminați-o, javra aia!",
   "ro_m": "E în genunchi! Terminați-l, boul ăla!"
  },
  {
   "key": "2236547376847396868",
   "en": "On it!",
   "ro": "Mă ocup!"
  },
  {
   "key": "2236547376897728516",
   "en": "C'mon, I'll make this quick for you!",
   "ro": "Hai, o să fie rapid pentru tine!"
  },
  {
   "key": "2236547376948060164",
   "en": "Shit! I'm out of ammo!",
   "ro": "La naiba! Am rămas fără muniție!"
  },
  {
   "key": "2236547376998391812",
   "en": "You lost your goddamn mind?!",
   "ro": "Ți-ai pierdut mințile, fir-ar?!"
  },
  {
   "key": "2236547377132609540",
   "en": "Can't see shit!",
   "ro": "Nu văd nimic, pula mea!"
  },
  {
   "key": "2236547377199718404",
   "en": "She's hacking our implants!",
   "en_m": "He's hacking our implants!",
   "ro": "Ne hackuiește implantele!"
  },
  {
   "key": "2236547377250050052",
   "en": "Ahhh! Much better!",
   "ro": "Ahhh! Mult mai bine!"
  },
  {
   "key": "2236547377300381700",
   "en": "Shit! I'm callin' reinforcements!",
   "ro": "La naiba! Chem întăriri!"
  },
  {
   "key": "2236547377367490564",
   "en": "I see 'er!",
   "en_m": "I see 'im!",
   "ro": "O văd!",
   "ro_m": "Îl văd!"
  },
  {
   "key": "2236547377417822212",
   "en": "Goin' in for the close kill!",
   "ro": "Mă duc să o termin de aproape!",
   "ro_m": "Mă duc să îl termin de aproape!"
  },
  {
   "key": "2236547377468153860",
   "en": "Gonna push her back!",
   "en_m": "Gonna push him back!",
   "ro": "O împing înapoi!",
   "ro_m": "Îl împing înapoi!"
  },
  {
   "key": "2236547377518485508",
   "en": "Fuck this! I don't wanna die!",
   "ro": "Bag pula-n asta! Nu vreau să mor!"
  },
  {
   "key": "2236547377703034880",
   "en": "Intruder!",
   "ro": "Intrus!"
  },
  {
   "key": "2236547377753366532",
   "en": "Don't like this one bit...",
   "ro": "Nu-mi place deloc..."
  }
 ]
}
