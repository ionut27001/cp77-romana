 "entries": [
  {
   "key": "1922697659841781764",
   "en": "Well, well. What a woman!",
   "en_m": "Well, well. What a man!",
   "ro": "Ei, ei. Ce femeie!",
   "ro_m": "Ei, ei. Ce bărbat!"
  },
  {
   "key": "1922697659858558980",
   "en": "This I can get behind!",
   "ro": "Asta pot să susțin!"
  },
  {
   "key": "1922697659925667844",
   "en": "Hey, watch it!",
   "ro": "Hei, ai grijă!"
  },
  {
   "key": "1922697659942445060",
   "en": "Shove off!",
   "ro": "Cară-te!"
  },
  {
   "key": "1922697659992776708",
   "en": "Hey, hey!",
   "ro": "Hei, hei!"
  },
  {
   "key": "1922697660059885572",
   "en": "Come over… You can admire my new 'do… Not just that… Braindance too. I kept my word.",
   "ro": "Vino încoace… Poți admira noua mea coafură… Și nu doar asta… Și braindance-ul. Mi-am ținut cuvântul."
  },
  {
   "key": "1922697660076662788",
   "en": "Five, yeah…? Fantastico… Better up your style game… You know – keep up with me…",
   "ro": "Cinci, da…? Fantastico… Mai bine-ți schimbi garderoba… Știi, ține-te după mine…"
  },
  {
   "key": "1922697660126994436",
   "en": "See you tomorrow!",
   "ro": "Ne vedem mâine!"
  },
  {
   "key": "1922697660345098244",
   "en": "We're all gonna die!",
   "ro": "O să murim cu toții!"
  },
  {
   "key": "1922697660378652676",
   "en": "Why me, why me?!",
   "ro": "De ce eu, de ce eu?!"
  },
  {
   "key": "1922697660479315972",
   "en": "Get away!",
   "ro": "Dă-te la o parte!"
  },
  {
   "key": "1922697660512870404",
   "en": "Not me, not me, not me!",
   "ro": "Nu eu, nu eu, nu eu!"
  },
  {
   "key": "1922697660596756484",
   "en": "What's this supposed to mean?",
   "ro": "Ce vrea să însemne asta?"
  },
  {
   "key": "1922697660630310916",
   "en": "Y-you tryin' to tell me something?",
   "ro": "Î-încerci să-mi spui ceva?"
  }
 ]
