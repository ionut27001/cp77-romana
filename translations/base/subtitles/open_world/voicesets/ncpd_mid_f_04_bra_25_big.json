{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_mid_f_04_bra_25_big.json",
 "entries": [
  {
   "key": "1856210452914642948",
   "en": "We got a problem?",
   "ro": "Avem o problemă?"
  },
  {
   "key": "1856210452931420164",
   "en": "Leave me alone, choom.",
   "ro": "Lasă-mă în pace, choom."
  },
  {
   "key": "1856210452981751812",
   "en": "Where you goin'?",
   "ro": "Unde te duci?"
  },
  {
   "key": "1856210452998529028",
   "en": "'Ey, 'ey, 'ey! What's this, huh? Back it up!",
   "ro": "Hei, hei, hei! Ce-i asta, ha? Dă-te înapoi!"
  },
  {
   "key": "1856210453048860676",
   "en": "I gotta take you out?",
   "ro": "Trebuie să te scot?"
  },
  {
   "key": "1856210453065637892",
   "en": "You don't stash that shit, I'ma stash you.",
   "ro": "Dacă nu ascunzi rahatul ăsta, te bag eu la depozit."
  },
  {
   "key": "1856210453115969540",
   "en": "'Bout to go too far.",
   "ro": "E pe cale să meargă prea departe."
  },
  {
   "key": "1856210453149523972",
   "en": "Quit clownin' around.",
   "ro": "Lasă prostiile."
  },
  {
   "key": "1856210453199855620",
   "en": "Don't like you anyways.",
   "ro": "Oricum nu te plac."
  },
  {
   "key": "1856210453216632836",
   "en": "Get your punk ass outta here.",
   "ro": "Cară-te de aici, golanule."
  },
  {
   "key": "1856210453266964484",
   "en": "What the--?",
   "ro": "Ce naiba--?"
  },
  {
   "key": "1856210453283741700",
   "en": "Ugh, what now?",
   "ro": "Ugh, ce mai e?"
  },
  {
   "key": "1856210453334073348",
   "en": "Yeah, fuck it.",
   "ro": "Da, dă-o dracu'."
  },
  {
   "key": "1856210453350850564",
   "en": "Enough for today.",
   "ro": "Ajunge pentru azi."
  },
  {
   "key": "1856210453417959428",
   "en": "Police! Come out!",
   "ro": "Poliția! Ieșiți afară!"
  },
  {
   "key": "1856210453434736644",
   "en": "Come the fuck out with your hands up!",
   "ro": "Ieși dracului afară cu mâinile sus!"
  },
  {
   "key": "1856210453485068292",
   "en": "Fuck!",
   "ro": "Futu-i!"
  },
  {
   "key": "1856210453518622724",
   "en": "I'll take care of it.",
   "ro": "Mă ocup eu."
  },
  {
   "key": "1856210453568954372",
   "en": "Shots fired!",
   "ro": "S-au tras focuri!"
  },
  {
   "key": "1856210453585731588",
   "en": "You bitch!",
   "en_m": "Motherfucker!",
   "ro": "Curvo!",
   "ro_m": "Futu-ți mama!"
  },
  {
   "key": "1856210453619286020",
   "en": "Hope it blasts you in your punk face!",
   "ro": "Sper să te facă praf în fața aia de golan!"
  },
  {
   "key": "1856210453669617668",
   "en": "Destroy the scopsuckers!",
   "ro": "Distrugeți jigodiile!"
  },
  {
   "key": "1856210453703172100",
   "en": "Fucking junkie!",
   "ro": "Junkie nenorocit!"
  },
  {
   "key": "1856210453770280960",
   "en": "Fucking disaster!",
   "ro": "Dezastru al dracului!"
  },
  {
   "key": "1856210453787058180",
   "en": "I'm fucking done!",
   "ro": "Gata, pula mea!"
  },
  {
   "key": "1856210453854167040",
   "en": "Where you goin'?",
   "ro": "Unde te duci?"
  },
  {
   "key": "1856210453870944260",
   "en": "Watch it!",
   "ro": "Ai grijă!"
  },
  {
   "key": "1856210453921275908",
   "en": "What's up?",
   "ro": "Ce faci?"
  },
  {
   "key": "1856210453971607556",
   "en": "Yep... dunno, boss... it's a big risk...",
   "ro": "Da... nu știu, șefu'... e un risc mare..."
  },
  {
   "key": "1856210453988384772",
   "en": "Mhm... mhm... two of 'em? Yeah I know 'em, brothers…",
   "ro": "Mhm... mhm... doi dintre ei? Da, îi știu, frați…"
  },
  {
   "key": "1856210454055493636",
   "en": "Get 'er from behind!",
   "en_m": "Get 'im from behind!",
   "ro": "Luați-o din spate!",
   "ro_m": "Luați-l din spate!"
  },
  {
   "key": "1856210454089048068",
   "en": "I'm on the fucker!",
   "ro": "Îl am în vizor pe nenorocit!"
  },
  {
   "key": "1856210454156156932",
   "en": "Y'all better haul ass!",
   "ro": "Mai bine o tăiați!"
  },
  {
   "key": "1856210454189711364",
   "en": "See ya.",
   "ro": "Ne vedem."
  },
  {
   "key": "1856210454206488580",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1856210454290374660",
   "en": "Let's get movin'.",
   "ro": "Hai să ne mișcăm."
  },
  {
   "key": "1856210454307151876",
   "en": "Looks like we got a new case.",
   "ro": "Se pare că avem un caz nou."
  },
  {
   "key": "1856210454340706308",
   "en": "One, two, march!",
   "ro": "Unu, doi, marș!"
  },
  {
   "key": "1856210454357483524",
   "en": "Yeah, go 'head, shoot at a fuckin' badge! Let's see how that goes!",
   "ro": "Da, hai, trage într-un polițist, pula mea! Să vedem cum o să-ți iasă!"
  },
  {
   "key": "1856210454407815172",
   "en": "Ech... ech... fuck... you...",
   "ro": "Ech... ech... futu... te..."
  },
  {
   "key": "1867688144520355840",
   "en": "Not our turf... yeah, well, not everyone thinks so... I'll ask around...",
   "ro": "Nu-i teritoriul nostru... da, păi, nu toți cred asta... o să întreb pe-acolo..."
  },
  {
   "key": "1867688654564499456",
   "en": "No, no... nah, they're soft... So, what? Get 'em off the street...? All right...",
   "ro": "Nu, nu... nu, sunt slabi... Și atunci? Îi scoatem de pe stradă...? Bine..."
  }
 ]
}
