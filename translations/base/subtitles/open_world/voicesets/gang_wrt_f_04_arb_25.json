{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_wrt_f_04_arb_25.json",
 "entries": [
  {
   "key": "1827046613930598404",
   "en": "Do I look like the conversational type?",
   "ro": "Arăt eu ca tipul conversațional?"
  },
  {
   "key": "1827046613947375620",
   "en": "Sit and do nothin' all day long...",
   "ro": "Stai și nu faci nimic toată ziua..."
  },
  {
   "key": "1827046613997707268",
   "en": "You wanna mess with me? Bring it!",
   "ro": "Vrei să te pui cu mine? Hai, dă-i drumul!"
  },
  {
   "key": "1827046614031261700",
   "en": "I could end you in seconds.",
   "ro": "Te-aș putea termina în câteva secunde."
  },
  {
   "key": "1827046614115147780",
   "en": "Ever gotten your jaw broken?",
   "ro": "Ți-ai rupt vreodată fălcile?"
  },
  {
   "key": "1827046614131924996",
   "en": "Fuck outta here with that!",
   "ro": "Cară-te dracu' de-aici cu asta!"
  },
  {
   "key": "1827046614199033860",
   "en": "I'll burn you like I burn rubber.",
   "ro": "Te ard cum ard cauciucul."
  },
  {
   "key": "1827046614232588292",
   "en": "I'll chain you up and drag you outta here!",
   "ro": "Te leg și te târăsc dracu' de-aici!"
  },
  {
   "key": "1827046614282919940",
   "en": "Not such a gonk after all.",
   "ro": "Nu ești chiar un fraier, până la urmă."
  },
  {
   "key": "1827046614316474372",
   "en": "Mwah. See ya around.",
   "ro": "Mwah. Ne vedem."
  },
  {
   "key": "1827046614350028804",
   "en": "The hell?",
   "ro": "Ce dracu'?"
  },
  {
   "key": "1827046614366806020",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1827046614433914880",
   "en": "Could really use a break....",
   "ro": "Mi-ar prinde bine o pauză...."
  },
  {
   "key": "1827046614450692100",
   "en": "Must be seeing things.",
   "ro": "Trebuie că văd lucruri."
  },
  {
   "key": "1827046614484246532",
   "en": "You have no idea who you're fuckin' with!",
   "ro": "N-ai nicio idee cu cine te pui, pula mea!"
  },
  {
   "key": "1827046614501023748",
   "en": "You ain't never gettin' outta here!",
   "ro": "Nu o să ieși niciodată de-aici!"
  },
  {
   "key": "1827046614534578180",
   "en": "We've got a problem!",
   "ro": "Avem o problemă!"
  },
  {
   "key": "1827046614568132612",
   "en": "Uh-uh.",
   "ro": "Nu-nu."
  },
  {
   "key": "1827046614601687044",
   "en": "Let's do this!",
   "ro": "Hai să facem asta!"
  },
  {
   "key": "1827046614635241476",
   "en": "Time's up, bitch!",
   "ro": "S-a terminat timpul, curvo!"
  },
  {
   "key": "1827046614668795904",
   "en": "Up yours!",
   "ro": "Să-ți bag pula!"
  },
  {
   "key": "1827046614702350340",
   "en": "It's killin' time!",
   "ro": "E timpul să omorâm!"
  },
  {
   "key": "1827046614719127556",
   "en": "Feel the rush!",
   "ro": "Simte impulsul!"
  },
  {
   "key": "1827046614769459204",
   "en": "Fuck this - I'm out!",
   "ro": "Bag pula-n asta - ies!"
  },
  {
   "key": "1827046614786236420",
   "en": "When this is over, I quit!",
   "ro": "Când se termină asta, mă las!"
  },
  {
   "key": "1827046614819790852",
   "en": "Bite me.",
   "ro": "Sugi pula."
  },
  {
   "key": "1827046614836568068",
   "en": "Fuckin' basic!",
   "ro": "De bază, pula mea!"
  },
  {
   "key": "1827046614870122500",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1827046614920454148",
   "en": "Nuh-uh, that ain't how this works…",
   "ro": "Nu-nu, nu merge așa…"
  },
  {
   "key": "1827046614937231364",
   "en": "Mh-hm.... mh-hm... 'course... the answer's no... then we're done here.",
   "ro": "Mh-hm... mh-hm... sigur... răspunsul e nu... deci gata, am terminat."
  },
  {
   "key": "1827046614987563012",
   "en": "Get 'er where she ain't lookin'!",
   "ro": "Ia-o de unde nu se așteaptă!"
  },
  {
   "key": "1827046615021117444",
   "en": "Gotta be kiddin' me!",
   "ro": "Fac mișto de mine?!"
  },
  {
   "key": "1827046615037894660",
   "en": "We're screwed!",
   "ro": "Am belit-o."
  },
  {
   "key": "1827046615071449088",
   "en": "Don't call me again.",
   "ro": "Nu mă mai suna."
  },
  {
   "key": "1827046615088226304",
   "en": "What the shit?!",
   "ro": "Ce căcat?!"
  },
  {
   "key": "1827046615121780740",
   "en": "Better than doin' nothin'.",
   "ro": "Mai bine decât să nu faci nimic."
  },
  {
   "key": "1827046615138557956",
   "en": "Am I the only one noticin' shit around here?! Come on...",
   "ro": "Doar eu văd rahatul ăsta pe aici?! Hai..."
  },
  {
   "key": "1827046615172112388",
   "en": "Stop bein' such a pussy and go.",
   "ro": "Nu mai fi pizdă și du-te."
  },
  {
   "key": "1827046615188889604",
   "en": "Music to my ears!",
   "ro": "Muzică pentru urechile mele!"
  },
  {
   "key": "1827046615222444036",
   "en": "Khe... kheeargh... arrghhh...",
   "ro": "Khe... kheeargh... arrghhh..."
  },
  {
   "key": "1867573382557999104",
   "en": "I'm tellin' ya... Just no... stop it already...!",
   "ro": "Îți spun... Nu... lasă-mă în pace...!"
  },
  {
   "key": "2235024598524633092",
   "en": "It's one of ours! Dead!",
   "ro": "E unul de-al nostru! Mort!"
  },
  {
   "key": "2235024598642073604",
   "en": "The hell...?",
   "ro": "Ce dracu'...?"
  },
  {
   "key": "2235024598860177412",
   "en": "What? No, I didn't call anyone.",
   "ro": "Ce? Nu, n-am sunat pe nimeni."
  },
  {
   "key": "2235024598944063492",
   "en": "Fuck! We need to regroup!",
   "ro": "Futu-i! Trebuie să ne regrupăm!"
  },
  {
   "key": "2235024599044726788",
   "en": "Someone just kill her already!",
   "en_m": "Someone just kill him already!",
   "ro": "Cineva să o omoare dracu' odată!",
   "ro_m": "Cineva să-l omoare dracu' odată!"
  },
  {
   "key": "2235024599145390084",
   "en": "Losin' people!",
   "ro": "Pierdem oameni!"
  },
  {
   "key": "2235024599212498948",
   "en": "You're making a mistake!",
   "ro": "Greșești!"
  },
  {
   "key": "2235024599296385024",
   "en": "You won't get away with this!",
   "ro": "Nu scapi cu asta!"
  },
  {
   "key": "2235024599447379972",
   "en": "Let's give this bitch a happy death day!",
   "en_m": "Let's give this fucker a happy death day!",
   "ro": "Hai s-o trimitem pe curvă cu zâmbetul pe buze!",
   "ro_m": "Hai să-l trimitem pe nenorocit cu zâmbetul pe buze!"
  },
  {
   "key": "2235024599648706564",
   "en": "Got a hit!",
   "ro": "Am lovit!"
  },
  {
   "key": "2235024600034582528",
   "en": "She's about to break! Keep shooting!",
   "en_m": "He's about to break! Keep shooting!",
   "ro": "E pe punctul să cedeze! Trageți în continuare!"
  },
  {
   "key": "2235024600101691396",
   "en": "Doin' the best I can!",
   "ro": "Fac tot ce pot!"
  },
  {
   "key": "2235024600202354692",
   "en": "You've gotta be kidding me! You're hiding now?!",
   "ro": "Fac mișto de mine?! Te ascunzi acum?!"
  },
  {
   "key": "2235024600286240772",
   "en": "Reloading!",
   "ro": "Reîncărcare!"
  },
  {
   "key": "2235024600370126852",
   "en": "Stop, for fuck's sake!",
   "ro": "Stai, pula mea!"
  },
  {
   "key": "2235024600504344580",
   "en": "Aaargh! I can't see!",
   "ro": "Aaargh! Nu văd!"
  },
  {
   "key": "2235024600588230660",
   "en": "Fuck you and your hacks!",
   "ro": "Du-te-n pula mea cu hack-urile tale!"
  },
  {
   "key": "2235024600655339524",
   "en": "Wooh! Shit's strong!",
   "ro": "Wooh! Bate tare porcăria asta!"
  },
  {
   "key": "2235024600705671172",
   "en": "Where's our fucking backup?!",
   "ro": "Unde pula mea sunt întăririle?!"
  },
  {
   "key": "2235024600772780036",
   "en": "You're going down!",
   "ro": "S-a zis cu tine!"
  },
  {
   "key": "2235024600839888900",
   "en": "Got a shotgun!",
   "ro": "Am un shotgun!"
  },
  {
   "key": "2235024600906997764",
   "en": "Covering fire!",
   "ro": "Foc de acoperire!"
  },
  {
   "key": "2235024600990883844",
   "en": "Droppin' like flies here!",
   "ro": "Cădem ca muștele aici!"
  },
  {
   "key": "2235024601276096516",
   "en": "Huh? The fuck is it this time...",
   "ro": "Huh? Ce dracu' e de data asta..."
  }
 ]
}
