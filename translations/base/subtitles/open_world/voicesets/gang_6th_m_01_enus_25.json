{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_6th_m_01_enus_25.json",
 "entries": [
  {
   "key": "1789946196615598084",
   "en": "Soldier!",
   "ro": "Soldat!"
  },
  {
   "key": "1789946196632375300",
   "en": "Better clean up this city.",
   "ro": "Mai bine curățăm orașul ăsta."
  },
  {
   "key": "1789946196699484164",
   "en": "Get back! Now!",
   "ro": "Înapoi! Acum!"
  },
  {
   "key": "1789946196716261380",
   "en": "Move back!",
   "ro": "Dă-te înapoi!"
  },
  {
   "key": "1789946196800147460",
   "en": "Weapon down!",
   "ro": "Arma jos!"
  },
  {
   "key": "1789946196816924676",
   "en": "Calm down, stash your iron!",
   "ro": "Calmează-te, pune-ți arma la loc!"
  },
  {
   "key": "1789946196900810752",
   "en": "Not gonna fuckin' repeat myself!",
   "ro": "Nu o să mă repet, pula mea!"
  },
  {
   "key": "1789946196917587972",
   "en": "Last warning!",
   "ro": "Ultimul avertisment!"
  },
  {
   "key": "1789946196984696836",
   "en": "Wise choice.",
   "ro": "Alegere înțeleaptă."
  },
  {
   "key": "1789946197001474052",
   "en": "Very good.",
   "ro": "Foarte bine."
  },
  {
   "key": "1789946197068582916",
   "en": "What the...?",
   "ro": "Ce dracu'...?"
  },
  {
   "key": "1789946197085360132",
   "en": "Something's not right.",
   "ro": "Ceva nu e în regulă."
  },
  {
   "key": "1789946197186023428",
   "en": "Ears're ringin' or something...",
   "ro": "Îmi țiuie urechile sau ceva..."
  },
  {
   "key": "1789946197202800644",
   "en": "Must be hearing things.",
   "ro": "Probabil aud lucruri."
  },
  {
   "key": "1789946197253132292",
   "en": "Just like training - hah!",
   "ro": "Ca la antrenament - ha!"
  },
  {
   "key": "1789946197286686724",
   "en": "Three years I was in recon, gonk!",
   "ro": "Trei ani am fost în recunoaștere, fraierule!"
  },
  {
   "key": "1789946197320241156",
   "en": "One of ours, down!",
   "ro": "Unul dintre ai noștri, jos!"
  },
  {
   "key": "1789946197370572804",
   "en": "Yes, sir!",
   "ro": "Da, domnule!"
  },
  {
   "key": "1789946197437681668",
   "en": "Attack!!!",
   "ro": "Atac!!!"
  },
  {
   "key": "1789946197454458884",
   "en": "Open fire!",
   "ro": "Deschideți focul!"
  },
  {
   "key": "1789946197504790532",
   "en": "Grenade!",
   "ro": "Granată!"
  },
  {
   "key": "1789946197571899396",
   "en": "Clean up Night City!",
   "ro": "Curățați Night City!"
  },
  {
   "key": "1789946197588676612",
   "en": "This is our city! Ours!",
   "ro": "Acesta e orașul nostru! Al nostru!"
  },
  {
   "key": "1789946197655785476",
   "en": "Don't give up!",
   "ro": "Nu renunțați!"
  },
  {
   "key": "1789946197672562692",
   "en": "Goddamnit!",
   "ro": "Mama dracului!"
  },
  {
   "key": "1789946197739671556",
   "en": "'Ey!",
   "ro": "Hei!"
  },
  {
   "key": "1789946197756448772",
   "en": "Don't you mess with me.",
   "ro": "Nu te pune cu mine."
  },
  {
   "key": "1789946197790003204",
   "en": "Hello.",
   "ro": "Salut."
  },
  {
   "key": "1789946197840334852",
   "en": "Sure... uh-huh... where exactly...?",
   "ro": "Sigur... uh-huh... unde exact...?"
  },
  {
   "key": "1789946197857112068",
   "en": "Uh-huh... Right... Yes... I know where it is...",
   "ro": "Uh-huh... Bine... Da... Știu unde e..."
  },
  {
   "key": "1789946197907443716",
   "en": "Flank attack!",
   "ro": "Atac pe flanc!"
  },
  {
   "key": "1789946197957775360",
   "en": "Got it! Attacking flank!",
   "ro": "Am înțeles! Atac flancul!"
  },
  {
   "key": "1789946197991329796",
   "en": "Grenade!",
   "ro": "Granată!"
  },
  {
   "key": "1789946198024884228",
   "en": "Over and out.",
   "ro": "Terminat."
  },
  {
   "key": "1789946198041661444",
   "en": "Ugh... Not again.",
   "ro": "Uf... Nu din nou."
  },
  {
   "key": "1789946198108770308",
   "en": "Hear that? Let's check it out.",
   "ro": "Auzi? Hai să verificăm."
  },
  {
   "key": "1789946198142324740",
   "en": "Better flick that safety off...",
   "ro": "Mai bine dezactivează siguranța..."
  },
  {
   "key": "1789946198175879172",
   "en": "Scout the area!",
   "ro": "Cercetează zona!"
  },
  {
   "key": "1789946198209433604",
   "en": "Die already!",
   "ro": "Mori odată!"
  },
  {
   "key": "1789946198242988036",
   "en": "Echh... you're... big mistake...",
   "ro": "Echh... ești... o mare greșeală..."
  },
  {
   "key": "1790077290761523200",
   "en": "I'll get it.",
   "ro": "Mă ocup eu."
  },
  {
   "key": "1790077459590647808",
   "en": "Anyone else know...? OK, understood, copy.",
   "ro": "Mai știe cineva...? OK, înțeles, copiat."
  },
  {
   "key": "1957766607721234436",
   "en": "You for real right now?",
   "ro": "Chiar ești serios acum?"
  },
  {
   "key": "1957766607788343300",
   "en": "Forgot what we were saying.",
   "ro": "Am uitat ce spuneam."
  },
  {
   "key": "1957766607805120516",
   "en": "C'mon, I don't have all day!",
   "ro": "Hai, nu am toată ziua!"
  },
  {
   "key": "3995616216234508288",
   "en": "Don't you mess with me.",
   "ro": "Nu te pune cu mine."
  },
  {
   "key": "4039122471221379072",
   "en": "Calm down, stash your iron!",
   "ro": "Calmează-te, pune-ți arma la loc!"
  }
 ]
