 "entries": [
  {
   "key": "1922860277739036676",
   "en": "Did it hurt when you fell from heaven?",
   "ro": "Te-a durut când ai căzut din cer?"
  },
  {
   "key": "1922860277755813892",
   "en": "Come here often?",
   "ro": "Vii des pe aici?"
  },
  {
   "key": "1922860277822922756",
   "en": "Hey now!",
   "ro": "Hei, stai așa!"
  },
  {
   "key": "1922860277856477188",
   "en": "Be gentle with me!",
   "ro": "Fii blând cu mine!"
  },
  {
   "key": "1922860277906808836",
   "en": "Hey, hey. What's up?",
   "ro": "Hei, hei. Ce faci?"
  },
  {
   "key": "1922860277973917696",
   "en": "Seriously…? New dolls, eh…? We gotta get in there…! Hmm… Tomorrow?",
   "ro": "Serios…? Păpuși noi, na…? Trebuie să intrăm acolo…! Hmm… Mâine?"
  },
  {
   "key": "1922860277990694916",
   "en": "No way…! Come on… Quality speaks for itself… Mmhmm… And not only once!",
   "ro": "Nici vorbă…! Hai… Calitatea se vede din prima… Mmhmm… Și nu doar o dată!"
  },
  {
   "key": "1922860278024249348",
   "en": "See ya tomorrow!",
   "ro": "Ne vedem mâine!"
  },
  {
   "key": "1922860278208798724",
   "en": "Do something!",
   "ro": "Fă ceva!"
  },
  {
   "key": "1922860278242353156",
   "en": "Psychopath!",
   "ro": "Psihopat!"
  },
  {
   "key": "1922860278343016452",
   "en": "What do you want?! Money?!",
   "ro": "Ce vrei?! Bani?!"
  },
  {
   "key": "1922860278376570884",
   "en": "I'll do anything! Anything!",
   "ro": "Fac orice! Orice!"
  },
  {
   "key": "1922860278460456964",
   "en": "This is getting awkward…",
   "ro": "Devine stânjenitor…"
  },
  {
   "key": "1922860278494011396",
   "en": "Maybe some other time…",
   "ro": "Poate altă dată…"
  },
  {
   "key": "1958899397445066756",
   "en": "'Kay, then, whatever...",
   "ro": "Bine, atunci, oricum..."
  },
  {
   "key": "1958899397495398404",
   "en": "We good?",
   "ro": "Suntem bine?"
  },
  {
   "key": "1958899397528952836",
   "en": "Clock's tickin'.",
   "ro": "Ceasul ticăie."
  }
 ]
