 "entries": [
  {
   "key": "1954487749695283200",
   "en": "'Time is it?",
   "ro": "Cât e ceasul?"
  },
  {
   "key": "1954487749712060420",
   "en": "Do I know you?",
   "ro": "Te cunosc?"
  },
  {
   "key": "1954487749762392068",
   "en": "Oh God…!",
   "ro": "Doamne…!"
  },
  {
   "key": "1954487749779169284",
   "en": "Slow down !",
   "ro": "Mai încet!"
  },
  {
   "key": "1954487749812723716",
   "en": "Hey… 's me.",
   "ro": "Hei… sunt eu."
  },
  {
   "key": "1954487749863055364",
   "en": "Uh, sorry… Not my fault… Shoulda been just one… Yeah… Well, maybe seven?",
   "ro": "Uh, scuze… Nu-i vina mea… Trebuia să fie doar unul… Da… Mă rog, poate șapte?"
  },
  {
   "key": "1954487749879832580",
   "en": "Don't yell, please… I'm coming… Yes, I'll stay… Anything, just don't yell.",
   "ro": "Nu țipa, te rog… Vin… Da, rămân… Orice, numai nu mai țipa."
  },
  {
   "key": "1954487749913387012",
   "en": "Gotta go. Bye.",
   "ro": "Trebuie să plec. Pa."
  },
  {
   "key": "1954487750064381956",
   "en": "Not that!",
   "ro": "Nu aia!"
  },
  {
   "key": "1954487750081159172",
   "en": "Fuckin' hell, again?",
   "ro": "Pula mea, iar?"
  },
  {
   "key": "1954487750148268036",
   "en": "But… why? I didn't do nothing!",
   "ro": "Dar… de ce? N-am făcut nimic!"
  },
  {
   "key": "1954487750181822464",
   "en": "Get away, get away, g-get away!",
   "ro": "Pleacă, pleacă, p-pleacă!"
  },
  {
   "key": "1954487750248931332",
   "en": "Fuck off, yeah?",
   "ro": "Cară-te, da?"
  },
  {
   "key": "1954487750282485760",
   "en": "Go stalk someone else.",
   "ro": "Du-te să urmărești pe altcineva."
  }
 ]
