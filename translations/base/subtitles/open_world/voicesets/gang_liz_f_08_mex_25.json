{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\gang_liz_f_08_mex_25.json",
 "entries": [
  {
   "key": "1822777766360768516",
   "en": "What's going on?",
   "ro": "Ce se întâmplă?"
  },
  {
   "key": "1822777766377545732",
   "en": "I'm just getting started.",
   "ro": "Abia am început."
  },
  {
   "key": "1822777766411100164",
   "en": "Nope, not allowed. Back you go.",
   "ro": "Nu, nu e permis. Înapoi cu tine."
  },
  {
   "key": "1822777766427877380",
   "en": "Leave. Please.",
   "ro": "Pleacă. Te rog."
  },
  {
   "key": "1822777766478209028",
   "en": "Holster it!",
   "ro": "Pune-o în toc!"
  },
  {
   "key": "1822777766494986244",
   "en": "I don't wanna see it.",
   "ro": "Nu vreau să văd asta."
  },
  {
   "key": "1822777766528540676",
   "en": "I don't like you.",
   "ro": "Nu-mi placi."
  },
  {
   "key": "1822777766545317892",
   "en": "I'm warning you. About to get mad for real.",
   "ro": "Te avertizez. Acum chiar mă supăr rău."
  },
  {
   "key": "1822777766595649540",
   "en": "C'mon. Just stop.",
   "ro": "Hai, oprește-te."
  },
  {
   "key": "1822777766612426756",
   "en": "I don't want any trouble.",
   "ro": "Nu vreau necazuri."
  },
  {
   "key": "1822777766645981188",
   "en": "What's that?!",
   "ro": "Ce-i asta?!"
  },
  {
   "key": "1822777766662758412",
   "en": "I don't like that.",
   "ro": "Nu-mi place asta."
  },
  {
   "key": "1822777766713090052",
   "en": "Ugh, I'm done.",
   "ro": "Uf, am terminat."
  },
  {
   "key": "1822777766729867268",
   "en": "I guess it's OK.",
   "ro": "Cred că e OK."
  },
  {
   "key": "1822777766763421700",
   "en": "Come on out. Let's talk.",
   "ro": "Ieși afară. Hai să vorbim."
  },
  {
   "key": "1822777766780198916",
   "en": "Come onnnn. I won't do anything to you.",
   "ro": "Haiiii. Nu-ți fac nimic."
  },
  {
   "key": "1822777766813753348",
   "en": "Oh my God! A body!",
   "ro": "Doamne! Un cadavru!"
  },
  {
   "key": "1822777766847307780",
   "en": "Of course!",
   "ro": "Bineînțeles!"
  },
  {
   "key": "1822777766880862212",
   "en": "Don't hit me!",
   "ro": "Nu mă lovi!"
  },
  {
   "key": "1822777766897639428",
   "en": "No! Not like that!",
   "ro": "Nu! Nu așa!"
  },
  {
   "key": "1822777766931193860",
   "en": "Launching one!",
   "ro": "Arunc una!"
  },
  {
   "key": "1822777766981525508",
   "en": "Doing my best here!",
   "ro": "Fac tot ce pot!"
  },
  {
   "key": "1822777766998302724",
   "en": "Opening fire!",
   "ro": "Deschid focul!"
  },
  {
   "key": "1822777767031857156",
   "en": "Fuck! It hurts!",
   "ro": "Futu-i! Mă doare!"
  },
  {
   "key": "1822777767048634372",
   "en": "I'm done! I can't!",
   "ro": "Am terminat! Nu mai pot!"
  },
  {
   "key": "1822777767098966020",
   "en": "Don't touch me!",
   "ro": "Nu mă atinge!"
  },
  {
   "key": "1822777767115743236",
   "en": "Leave me alone!",
   "ro": "Lasă-mă în pace!"
  },
  {
   "key": "1822777767132520452",
   "en": "Yeah? Hello?",
   "ro": "Da? Alo?"
  },
  {
   "key": "1822777767182852100",
   "en": "Mhm... 'course... it'll be just like you say... mhm…",
   "ro": "Mhm... sigur... o să fie exact cum zici... mhm…"
  },
  {
   "key": "1822777767199629316",
   "en": "I understand... mhm... yeah... I'm sorry... I didn't mean to...!",
   "ro": "Înțeleg... mhm... da... îmi pare rău... n-am vrut să...!"
  },
  {
   "key": "1822777767233183748",
   "en": "Gotta go flank.",
   "ro": "Trebuie să flanchez."
  },
  {
   "key": "1822777767266738180",
   "en": "Roger that!",
   "ro": "Am înțeles!"
  },
  {
   "key": "1822777767300292612",
   "en": "Jesus!",
   "ro": "Doamne!"
  },
  {
   "key": "1822777767317069828",
   "en": "OK. Bye.",
   "ro": "OK. Pa."
  },
  {
   "key": "1822777767333847044",
   "en": "Why's it like that...",
   "ro": "De ce e așa..."
  },
  {
   "key": "1822777767367401476",
   "en": "Come with me. Don't wanna go alone.",
   "ro": "Vino cu mine. Nu vreau să merg singură."
  },
  {
   "key": "1822777767384178696",
   "en": "All right. Let's go.",
   "ro": "Bine. Hai să mergem."
  },
  {
   "key": "1822777767417733124",
   "en": "You go. Pleeeease.",
   "ro": "Tu du-te. Te roooog."
  },
  {
   "key": "1822777767434510340",
   "en": "For my dolls!",
   "ro": "Pentru păpușile mele!"
  },
  {
   "key": "1822777767468064772",
   "en": "Acchhh... let... argh... go...",
   "ro": "Acchhh... lasă... argh... drumul..."
  },
  {
   "key": "1867661741428170752",
   "en": "Yeah, yeah, I'm ready...",
   "ro": "Da, da, sunt gata..."
  },
  {
   "key": "1867677356922626048",
   "en": "I'll do whatever I can to fix it.",
   "ro": "Fac tot ce pot să repar."
  }
 ]
}
