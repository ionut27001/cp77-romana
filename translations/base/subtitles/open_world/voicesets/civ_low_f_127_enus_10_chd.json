 "entries": [
  {
   "key": "1949200530482520068",
   "en": "What are you doing, y-you freak?",
   "ro": "Ce faci, c-ciudatule?"
  },
  {
   "key": "1949200530499297284",
   "en": "Hey, guess what? I don't talk to strangers.",
   "ro": "Hei, ghici ce? Nu vorbesc cu străinii."
  },
  {
   "key": "1949200530566406148",
   "en": "Ugh! Go to hell!",
   "ro": "Ugh! Du-te dracu'!"
  },
  {
   "key": "1949200530583183364",
   "en": "I'll call my brother!",
   "ro": "O să-l chem pe fratele meu!"
  },
  {
   "key": "1949200530616737796",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1949200530667069444",
   "en": "Yep…! Everyone was jealous… One of my friends even cried.",
   "ro": "Da…! Toți erau invidioși… Chiar și un prieten de-al meu a plâns."
  },
  {
   "key": "1949200530683846660",
   "en": "Oh, he always does… He's stupid.",
   "ro": "Oh, el mereu face asta… E prost."
  },
  {
   "key": "1949200530734178308",
   "en": "Kay, bye!",
   "ro": "Bine, pa!"
  },
  {
   "key": "1949200530868396036",
   "en": "She's gonna shoot us!",
   "en_m": "He's gonna shoot us!",
   "ro": "Ea o să ne împuște!",
   "ro_m": "El o să ne împuște!"
  },
  {
   "key": "1949200530885173252",
   "en": "I don't want to get shot!",
   "ro": "Nu vreau să fiu împușcată!"
  },
  {
   "key": "1949200530969059332",
   "en": "Please, no…!",
   "ro": "Te rog, nu…!"
  },
  {
   "key": "1949200530985836548",
   "en": "I want my dad!",
   "ro": "Îl vreau pe tata!"
  },
  {
   "key": "1949200531052945412",
   "en": "I don't know you… Weirdo...",
   "ro": "Nu te cunosc… Ciudatule..."
  },
  {
   "key": "1949200531069722628",
   "en": "Get outta here!",
   "ro": "Cară-te!"
  },
  {
