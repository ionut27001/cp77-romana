  {
   "key": "2231821700785381376",
   "en": "You want some one-on-one action, huh?!",
   "ro": "Vrei puțină acțiune unu-la-unu, ha?!"
  },
  {
   "key": "2231821701053816836",
   "en": "Hahaha! I got you! Eat it, bitch!",
   "en_m": "Hahaha! I got you! Eat it, asshole!",
