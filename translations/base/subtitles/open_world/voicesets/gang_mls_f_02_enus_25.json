  },
  {
   "key": "1822951008128065540",
   "en": "That's it! Just give up!",
   "ro": "Asta e! Renunță!"
  },
  {
   "key": "1822951008178397188",
   "en": "See you on the other side!",
   "ro": "Ne vedem dincolo!"
  },
  {
   "key": "1822951008195174404",
   "en": "Valhalla! Here I come!",
   "ro": "Valhalla! Iată-mă!"
  },
  {
   "key": "1822951008228728836",
   "en": "Hgrrr...",
   "ro": "Hgrrr..."
  },
  {
   "key": "1822951008262283268",
   "en": "Don't fucking touch me!",
   "ro": "Nu mă atinge, pula mea!"
  },
  {
   "key": "1822951008312614916",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1822951008362946564",
   "en": "Mh-hm... yes... I swapped out what I could...",
   "ro": "Mh-hm... da... am schimbat ce am putut..."
  },
  {
   "key": "1822951008379723780",
   "en": "Back over in that other place...? Yeah... yeah...",
   "ro": "Înapoi în locul ăla...? Da... da..."
  },
  {
   "key": "1822951008446832644",
   "en": "Put her on the backfoot!",
   "ro": "Pune-o în defensivă!"
  },
  {
   "key": "1822951008480387076",
   "en": "Path's clear!",
   "ro": "Cale liberă!"
  },
  {
   "key": "1822951008547495936",
   "en": "Shit's gonna blow!",
   "ro": "O să explodeze!"
  },
  {
   "key": "1822951008564273156",
   "en": "See you there.",
   "ro": "Ne vedem acolo."
  },
  {
   "key": "1822951008597827588",
   "en": "Helloooo? Is anybody there?",
   "ro": "Halloooo? E cineva acolo?"
  },
  {
   "key": "1822951008648159236",
   "en": "You, me – let's go.",
   "ro": "Tu, eu – hai să mergem."
  },
  {
   "key": "1822951008664936452",
   "en": "Somethin' isn't right.",
   "ro": "Ceva nu-i în regulă."
  },
  {
   "key": "1822951008681713668",
   "en": "You go, I'll cover.",
   "ro": "Tu mergi, eu acopăr."
  },
  {
   "key": "1822951008698490884",
   "en": "Save yourself the pain!",
   "ro": "Scutește-te de durere!"
  },
  {
   "key": "1822951008732045316",
   "en": "Khe... you're making... a mistake... khe...",
   "ro": "Khe... faci... o greșeală... khe..."
  },
  {
   "key": "1867551067719868416",
