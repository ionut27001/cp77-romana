  {
   "key": "2231821699946520576",
   "en": "Still breathing!",
   "ro": "Încă respiră!"
  },
  {
   "key": "2231821700013629444",
   "en": "The fuck is up with this shit...?!",
   "ro": "Ce dracu' e cu rahatul ăsta...?!"
