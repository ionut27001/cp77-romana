  {
   "key": "1822951007557640208",
   "en": "That's too fuckin' close!",
   "ro": "E prea aproape, pula mea!"
  },
  {
   "key": "1822951007624749060",
   "en": "Put that away before you regret it.",
   "ro": "Pune-o la loc înainte să regreți."
  },
  {
   "key": "1822951007641526276",
   "en": "You want me to take that away from you?!",
   "ro": "Vrei să ți-o iau?!"
  },
  {
   "key": "1822951007675080708",
   "en": "I'll wear your spine 'round my fucking neck!",
   "ro": "Îți port coloana pe gât, pula mea!"
  },
  {
   "key": "1822951007675080720",
   "en": "You think this is a fuckin' game?!",
   "ro": "Crezi că-i joc, pula mea?!"
  },
  {
   "key": "1822951007742189572",
   "en": "That's right, walk away.",
   "ro": "Așa, pleacă."
  },
  {
   "key": "1822951007742189584",
   "en": "Your chrome's so last gen.",
   "ro": "Chrome-ul tău e de generație veche."
  },
  {
   "key": "1822951007775744004",
   "en": "Swear I saw something!",
   "ro": "Jur că am văzut ceva!"
  },
  {
   "key": "1822951007792521220",
   "en": "Stay sharp.",
   "ro": "Fii pe fază."
  },
  {
   "key": "1822951007842852868",
   "en": "Fuckin' entropy.",
   "ro": "Entropie, pula mea."
  },
  {
   "key": "1822951007859630084",
   "en": "There – did my job.",
   "ro": "Gata – mi-am făcut treaba."
  },
  {
   "key": "1822951007893184516",
   "en": "Know what my favorite game is? Hide and kill!",
   "ro": "Știi care-i jocul meu preferat? Ascunde-te și ucide!"
  },
  {
   "key": "1822951007909961732",
   "en": "Don't make this any longer than it has to be!",
   "ro": "Nu lungi asta mai mult decât trebuie!"
  },
  {
   "key": "1822951007943516164",
   "en": "Someone's decomishin' us!",
   "ro": "Cineva ne lichidează!"
  },
  {
   "key": "1822951007977070596",
   "en": "I'm on it!",
   "ro": "Mă ocup!"
  },
  {
   "key": "1822951008010625028",
   "en": "It's showtiiiiime!",
   "ro": "E timpul spectacolului!"
  },
  {
   "key": "1822951008027402244",
   "en": "This is gonna be fun!",
   "ro": "O să fie distractiv!"
  },
  {
   "key": "1822951008060956676",
   "en": "Blow you back to the stone age!",
   "ro": "Te arunc înapoi în epoca de piatră!"
  },
  {
   "key": "1822951008111288324",
   "en": "You're in for a world of pain!",
