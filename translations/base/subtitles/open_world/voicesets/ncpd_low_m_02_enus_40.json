{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_low_m_02_enus_40.json",
 "entries": [
  {
   "key": "1863329466855055364",
   "en": "Ain't got time for this, man. Get lost.",
   "ro": "N-am timp de asta, frate. Cară-te."
  },
  {
   "key": "1863329466871832580",
   "en": "What now?",
   "ro": "Ce acum?"
  },
  {
   "key": "1863329466938941444",
   "en": "Keep back.",
   "ro": "Dă-te înapoi."
  },
  {
   "key": "1863329466955718660",
   "en": "Had enough of punks like you. Back it up.",
   "ro": "M-am săturat de golani ca tine. Dă-te înapoi."
  },
  {
   "key": "1863329466989273092",
   "en": "Chill. Right now.",
   "ro": "Calmează-te. Acum."
  },
  {
   "key": "1863329467006050308",
   "en": "You're a threat.",
   "ro": "Ești o amenințare."
  },
  {
   "key": "1863329467056381956",
   "en": "I really don't like you.",
   "ro": "Chiar nu-mi placi."
  },
  {
   "key": "1863329467073159172",
   "en": "I'm about to fuck up your whole day.",
   "ro": "Sunt pe cale să-ți fut ziua."
  },
  {
   "key": "1863329467123490820",
   "en": "Now move along. Nice and easy.",
   "ro": "Acum mișcă-te. Ușor, ușor."
  },
  {
   "key": "1863329467140268036",
   "en": "The hell was that for?",
   "ro": "Pentru ce dracu' a fost asta?"
  },
  {
   "key": "1863329467190599680",
   "en": "Hmm... what now...",
   "ro": "Hmm... și acum ce..."
  },
  {
   "key": "1863329467207376900",
   "en": "Shit...",
   "ro": "Căcat..."
  },
  {
   "key": "1863329467240931332",
   "en": "Phew... All right, least it was nothin'.",
   "ro": "Fiu... Bine, măcar n-a fost nimic."
  },
  {
   "key": "1863329467257708548",
   "en": "All right. Enough.",
   "ro": "Bine. Destul."
  },
  {
   "key": "1863329467308040196",
   "en": "You're just gonna sit there forever, ain't ya?",
   "ro": "O să stai acolo pentru totdeauna, nu?"
  },
  {
   "key": "1863329467324817412",
   "en": "Don't even wanna find you.",
   "ro": "Nici nu vreau să te găsesc."
  },
  {
   "key": "1863329467358371844",
   "en": "Ugh... Stiff here!",
   "ro": "Ugh... Un mort aici!"
  },
  {
   "key": "1863329467391926276",
   "en": "You got it.",
   "ro": "Ai înțeles."
  },
  {
   "key": "1863329467425480708",
   "en": "They're shooting at me!",
   "ro": "Trag în mine!"
  },
  {
   "key": "1863329467492589572",
   "en": "Shit!",
   "ro": "Căcat!"
  },
  {
   "key": "1863329467576475652",
   "en": "Watch out!",
   "ro": "Atenție!"
  },
  {
   "key": "1863329467693916164",
   "en": "Police! You're shooting at police!",
   "ro": "Poliția! Tragi în poliție!"
  },
  {
   "key": "1863329467710693380",
   "en": "NCPD! Stand down!",
   "ro": "NCPD! Predați-vă!"
  },
  {
   "key": "1863329467761025028",
   "en": "Goddamnit!",
   "ro": "Mama dracului!"
  },
  {
   "key": "1863329467777802244",
   "en": "No! Fuck! No!",
   "ro": "Nu! Futu-i! Nu!"
  },
  {
   "key": "1863329467844911108",
   "en": "'Ey!",
   "ro": "Hei!"
  },
  {
   "key": "1863329467861688324",
   "en": "Chill!",
   "ro": "Calmează-te!"
  },
  {
   "key": "1863329467878465540",
   "en": "Hello?",
   "ro": "Alo?"
  },
  {
   "key": "1863329467928797188",
   "en": "Yeah, I drank with 'em... Didn't know internal had their eye on 'em...",
   "ro": "Da, am băut cu ei... Nu știam că Afaceri Interne îi avea în vizor..."
  },
  {
   "key": "1863329467945574404",
   "en": "Huh...? Yeah I know some 6th Street... Mhm...",
   "ro": "Huh...? Da, cunosc niște 6th Street... Mhm..."
  },
  {
   "key": "1863329467995906052",
   "en": "Come on.",
   "ro": "Hai."
  },
  {
   "key": "1863329468029460484",
   "en": "All right. Flanking her.",
   "en_m": "All right. Flanking him.",
   "ro": "Bine. O flanchez.",
   "ro_m": "Bine. Îl flanchez."
  },
  {
   "key": "1863329468063014916",
   "en": "Get down!",
   "ro": "Jos!"
  },
  {
   "key": "1863329468079792132",
   "en": "Bye now.",
   "ro": "Pa acum."
  },
  {
   "key": "1863329468096569348",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1863329468146900996",
   "en": "I'm not the only one who noticed that...? Goddamnit.",
   "ro": "Nu sunt singurul care a observat asta...? Fir-ar al dracului."
  },
  {
   "key": "1863329468163678212",
   "en": "But keep your fuckin' head on, all right?",
   "ro": "Dar ține-ți capul pe umeri, pula mea, bine?"
  },
  {
   "key": "1863329468197232644",
   "en": "I'm covering you.",
   "ro": "Te acopăr."
  },
  {
   "key": "1863329468214009860",
   "en": "Had enough of this shit!",
   "ro": "M-am săturat de rahatul ăsta!"
  },
  {
   "key": "1863329468247564292",
   "en": "Ech... ech... cunt...",
   "en_m": "Ech... ech... fuckin'...",
   "ro": "Ech... ech... pizdă...",
   "ro_m": "Ech... ech... pula mea..."
  },
  {
   "key": "1867726206454587392",
   "en": "Shit, boss, I thought... Yeah, I'll tell you everything, sure...",
   "ro": "Căcat, șefu', credeam... Da, îți spun tot, sigur..."
  },
  {
   "key": "1867726500022312960",
   "en": "Yeah I could call 'em... Nah, they're reasonable... Mhm...",
   "ro": "Da, i-aș putea suna... Nu, sunt rezonabili... Mhm..."
  },
  {
   "key": "1959033055938125828",
   "en": "Hey, we're not done here.",
   "ro": "Hei, nu am terminat aici."
  },
  {
   "key": "1959033055988457476",
   "en": "Let's just finish this, OK?",
   "ro": "Hai să terminăm odată, OK?"
  },
  {
   "key": "1959033056022011904",
   "en": "Quit fucking with me.",
   "ro": "Nu te mai lua de mine."
  },
  {
   "key": "2235072465549271044",
   "en": "NCPD!",
   "ro": "NCPD!"
  },
  {
   "key": "2235072465649934340",
   "en": "Fuck, it's on of ours! Watch your six!",
   "ro": "Futu-i, e unul de-al nostru! Fii atent la spate!"
  },
  {
   "key": "2235072465717043204",
   "en": "Goddamn optics... That's what you get from scrimpin'...",
   "ro": "Opticile dracului... Asta primești când te zgârcești..."
  },
  {
   "key": "2235072465834483716",
   "en": "Yeah? What's up? Something the matter?",
   "ro": "Da? Ce-i? Ceva problemă?"
  },
  {
   "key": "2235072466069364740",
   "en": "Murderer!",
   "ro": "Ucigașo!",
   "ro_m": "Ucigașule!"
  },
  {
   "key": "2235072466153250820",
   "en": "You killed them!",
   "ro": "Tu i-ai ucis!"
  },
  {
   "key": "2235072466354577412",
   "en": "Got a hit!",
   "ro": "Am lovit!"
  },
  {
   "key": "2235072466438463492",
   "en": "Planted a hole in her!",
   "en_m": "Planted a hole in him!",
   "ro": "I-ai făcut o gaură în ea!",
   "ro_m": "I-ai făcut o gaură în el!"
  },
  {
   "key": "2235072466740453380",
   "en": "She's wounded!",
   "en_m": "He's wounded!",
   "ro": "E rănită!",
   "ro_m": "E rănit!"
  },
  {
   "key": "2235072466824339456",
   "en": "Understood!",
   "ro": "Înțeles!"
  },
  {
   "key": "2235072466891448324",
   "en": "Be a big girl and come on out!",
   "en_m": "Be a big boy and come on out!",
   "ro": "Hai, fată mare, ieși afară!",
   "ro_m": "Hai, băiat mare, ieși afară!"
  },
  {
   "key": "2235072466958557188",
   "en": "Reloading!",
   "ro": "Reîncărcare!"
  },
  {
   "key": "2235072467042443268",
   "en": "The fuck's wrong with you?!",
   "ro": "Ce pula mea ai?"
  },
  {
   "key": "2235072467176660996",
   "en": "Fuck! Can't see anything!",
   "ro": "Futu-i! Nu văd nimic!"
  },
  {
   "key": "2235072467226992644",
   "en": "Jesus Christ! She's hacking!",
   "en_m": "Jesus Christ! He's hacking!",
   "ro": "Doamne! Se hackuiește!"
  },
  {
   "key": "2235072467277324292",
   "en": "Ooof! I'm good to go!",
   "ro": "Ooof! Sunt gata!"
  },
  {
   "key": "2235072467361210372",
   "en": "Shots fired! Need backup!",
   "ro": "S-au tras focuri! Am nevoie de întăriri!"
  },
  {
   "key": "2235072467445096452",
   "en": "Goin' into close proximity!",
   "ro": "Mă apropii!"
  },
  {
   "key": "2235072467528982532",
   "en": "NCPD! Neutralizing the suspect! Moving in!",
   "ro": "NCPD! Neutralizez suspectul! Avansez!"
  },
  {
   "key": "2235072467596091396",
   "en": "Heads down! I'm coverin' you!",
   "ro": "Capetele jos! Te acopăr!"
  },
  {
   "key": "2235072467663200260",
   "en": "Shit! We're getting butchered!",
   "ro": "Căcat! Ne măcelăresc!"
  },
  {
   "key": "2235072467847749632",
   "en": "Officer under attack! I repeat, I'm under attack!",
   "ro": "Agent atacat! Repet, sunt atacat!"
  },
  {
   "key": "2235072467998744580",
   "en": "Something ain't right...",
   "ro": "Ceva nu-i în regulă..."
  }
 ]
}
