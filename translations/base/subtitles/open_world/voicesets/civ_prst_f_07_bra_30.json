 "entries": [
  {
   "key": "1955915401689866244",
   "en": "I don't swing your way.",
   "en_m": "Hi, handsome!",
   "ro": "Nu sunt genul tău.",
   "ro_m": "Salut, frumosule!"
  },
  {
   "key": "1955915401706643460",
   "en": "How's it going?",
   "en_m": "You look lonely.",
   "ro": "Ce mai faci?",
   "ro_m": "Pari singur."
  },
  {
   "key": "1955915401773752324",
   "en": "Eh, eh, eh!",
   "ro": "Eh, eh, eh!"
  },
  {
   "key": "1955915401790529540",
   "en": "Fucking rude!",
   "ro": "Nesimțit dracului!"
  },
  {
   "key": "1955915401840861188",
   "en": "How's it going?",
   "ro": "Ce mai faci?"
  },
  {
   "key": "1955915401941524484",
   "en": "Don't worry… That's how it is for newbies… They bugged me too… Mhm… Yep, her too… Seriously.",
   "ro": "Nu-ți face griji… Așa e pentru începători… Și pe mine m-au enervat… Mhm… Da, și pe ea… Serios."
  },
  {
   "key": "1955915401958301700",
   "en": "It'll be fine, you'll see… Matter of time… No worries… Mhm... Mhm… Ugh, bullshit.",
   "ro": "O să fie bine, o să vezi… Chestie de timp… Fără griji… Mhm... Mhm… Ugh, vrăjeală de căcat."
  },
  {
   "key": "1955915401991856132",
   "en": "Don't listen to those fools.",
   "ro": "Nu-i asculta pe proștii ăia."
  },
  {
   "key": "1955915402142851076",
   "en": "Oh my God!",
   "ro": "Doamne!"
  },
  {
   "key": "1955915402176405504",
   "en": "Help me!",
   "ro": "Ajută-mă!"
  },
  {
   "key": "1955915402243514372",
   "en": "Please! I beg you!",
   "ro": "Vă rog! Vă implor!"
  },
  {
   "key": "1955915402277068804",
   "en": "No! No, no, no, no!",
   "ro": "Nu! Nu, nu, nu, nu!"
  },
  {
   "key": "1955915402360954880",
   "en": "What're you playing at?",
   "ro": "Ce te dai?"
  },
  {
   "key": "1955915402377732100",
