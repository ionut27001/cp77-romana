{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\ncpd_low_f_03_enus_30.json",
 "entries": [
  {
   "key": "1863544515179700228",
   "en": "I AM the law. Got it?",
   "ro": "EU sunt legea. Ai înțeles?"
  },
  {
   "key": "1863544515196477444",
   "en": "Better not get too close to the long arm of the law.",
   "ro": "Mai bine nu te pui cu brațul lung al legii."
  },
  {
   "key": "1863544515230031876",
   "en": "One, two – back it up.",
   "ro": "Unu, doi – înapoi."
  },
  {
   "key": "1863544515263586308",
   "en": "The hell?! Move back.",
   "ro": "Ce dracu'?! Dați înapoi."
  },
  {
   "key": "1863544515313917952",
   "en": "Not allowed.",
   "ro": "Nu e permis."
  },
  {
   "key": "1863544515330695172",
   "en": "That's not a toy. Put it away.",
   "ro": "Asta nu e jucărie. Pune-o la loc."
  },
  {
   "key": "1863544515364249604",
   "en": "'Bout to teach you a real lesson.",
   "ro": "O să-ți dau o lecție pe cinste."
  },
  {
   "key": "1863544515381026820",
   "en": "Chill! Now!",
   "ro": "Calmează-te! Acum!"
  },
  {
   "key": "1863544515431358468",
   "en": "Outta my sight.",
   "ro": "Dispari din fața mea."
  },
  {
   "key": "1863544515448135684",
   "en": "Now, get out. Slow 'n' steady.",
   "ro": "Acum, ieși. Încet și sigur."
  },
  {
   "key": "1863544515498467332",
   "en": "Hmmm...",
   "ro": "Hmmm..."
  },
  {
   "key": "1863544515515244548",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1863544515565576196",
   "en": "Think that's enough.",
   "ro": "Cred că e destul."
  },
  {
   "key": "1863544515599130628",
   "en": "Ain't gonna find a thing.",
   "ro": "N-o să găsești nimic."
  },
  {
   "key": "1863544515649462276",
   "en": "We playin' fuckin' hide-and-seek?!",
   "ro": "Ne jucăm de-a v-ați ascunselea, pula mea?!"
  },
  {
   "key": "1863544515683016704",
   "en": "Come on out, shit-for-brains!",
   "ro": "Ieși afară, descreieratule!"
  },
  {
   "key": "1863544515716571140",
   "en": "Got a 187 here!",
   "ro": "Avem un 187 aici!"
  },
  {
   "key": "1863544515750125572",
   "en": "Uh-huh.",
   "ro": "Uh-huh."
  },
  {
   "key": "1863544515783680004",
   "en": "No! No fuckin' way!",
   "ro": "Nu! Nici în pula mea!"
  },
  {
   "key": "1863544515800457220",
   "en": "The fuck you doin'! Choom!",
   "ro": "Ce pula mea faci! Choom!"
  },
  {
   "key": "1863544515834011652",
   "en": "Go on, catch!",
   "ro": "Hai, prinde!"
  },
  {
   "key": "1863544515884343300",
   "en": "Shoot to fuckin' hit! You cross-eyed gonks!",
   "ro": "Trageți să nimeriți, pula mea! Voi, fraierilor cu ochii cruciși!"
  },
  {
   "key": "1863544515901120516",
   "en": "Hey! Look alive!",
   "ro": "Hei! Fii cu ochii în patru!"
  },
  {
   "key": "1863544515951452164",
   "en": "Don't like this!",
   "ro": "Nu-mi place asta!"
  },
  {
   "key": "1863544515985006596",
   "en": "Anyone call that backup?!",
   "ro": "A chemat cineva întăriri?!"
  },
  {
   "key": "1863544516052115460",
   "en": "You fuckin' nuts?!",
   "ro": "Ești nebun, pula mea?!"
  },
  {
   "key": "1863544516068892676",
   "en": "The fuck, choom!",
   "ro": "Ce pula mea, choom!"
  },
  {
   "key": "1863544516102447108",
   "en": "Yeah?",
   "ro": "Da?"
  },
  {
   "key": "1863544516152778756",
   "en": "Relax... Not yet... You'll be fine, sweetheart...",
   "ro": "Relaxează-te... Nu încă... O să fii bine, scumpo..."
  },
  {
   "key": "1863544516169555972",
   "en": "I don't understand... Calm down! I can't understand you when you're yelling...",
   "ro": "Nu înțeleg... Calmează-te! Nu te pot înțelege când țipi..."
  },
  {
   "key": "1863544516219887620",
   "en": "Fuckin' flank!",
   "ro": "Flanc, pula mea!"
  },
  {
   "key": "1863544516270219264",
   "en": "'Ey, 'ey, 'ey. Not good!",
   "ro": "Hei, hei, hei. Nu e bine!"
  },
  {
   "key": "1863544516303773700",
   "en": "Grenade! Grenade! Fuckin' hell!",
   "ro": "Granată! Granată! Pula mea!"
  },
  {
   "key": "1863544516320550916",
   "en": "Love you.",
   "ro": "Te iubesc."
  },
  {
   "key": "1863544516354105348",
   "en": "The hell's that?!",
   "ro": "Ce dracu' e aia?!"
  },
  {
   "key": "1863544516404436992",
   "en": "Ey, 'ey, 'ey. Just simmer down.",
   "ro": "Hei, hei, hei. Liniștește-te."
  },
  {
   "key": "1863544516421214212",
   "en": "Check that junk though, make sure it don't jam again.",
   "ro": "Verifică vechiturile alea, să nu se blocheze iar."
  },
  {
   "key": "1863544516454768644",
   "en": "Don't just stand there staring, move your ass!",
   "ro": "Nu sta acolo și holbează-te, mișcă-ți fundul!"
  },
  {
   "key": "1863544516471545860",
   "en": "Jesus Christ! Shoot!",
   "ro": "Doamne! Trage!"
  },
  {
   "key": "1863544516505100292",
   "en": "Ech... ech... you... bitch...",
   "ro": "Eh... eh... tu... curvo..."
  },
  {
   "key": "1867695340470788096",
   "en": "Did you heat up your dinner...? OK, watch some TV... I'll be there soon...",
   "ro": "Ți-ai încălzit cina...? OK, uită-te la TV... Ajung curând..."
  },
  {
   "key": "1867695844374470656",
   "en": "Yeah... Yeah... Tell him to let you play... Mhm... That's better...",
   "ro": "Da... Da... Spune-i să te lase să te joci... Mhm... Așa e mai bine..."
  },
  {
   "key": "1959030647954644996",
   "en": "Hey, where are you going?",
   "ro": "Hei, unde te duci?"
  },
  {
   "key": "1959030648004976644",
   "en": "I'm not your babysitter, OK? All right.",
   "ro": "Nu sunt bona ta, OK? Bine."
  },
  {
   "key": "1959030648021753860",
   "en": "Am I missing something?",
   "ro": "Îmi scapă ceva?"
  }
 ]
}
