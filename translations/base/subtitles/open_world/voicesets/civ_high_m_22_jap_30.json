{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_high_m_22_jap_30.json",
 "entries": [
  {
   "key": "1878094410497400836",
   "en": "You again...? Oh sorry, never mind.",
   "ro": "Tu din nou...? Ah, scuze, nu contează."
  },
  {
   "key": "1878094410514178052",
   "en": "Have I not seen you somewhere before...?",
   "ro": "Nu te-am mai văzut undeva...?"
  },
  {
   "key": "1878094410732281860",
   "en": "Wh-what did you just do?",
   "ro": "Ce-ce tocmai ai făcut?"
  },
  {
   "key": "1878094410765836292",
   "en": "Not to worry, I'm OK!",
   "ro": "Nu-ți face griji, sunt bine!"
  },
  {
   "key": "1878094410816167940",
   "en": "Hello? Is it really you?",
   "ro": "Alo? Chiar tu ești?"
  },
  {
   "key": "1878094410883276804",
   "en": "No, I... I think he is following me... Everywhere...!",
   "ro": "Nu, eu... Cred că mă urmărește... Peste tot...!"
  },
  {
   "key": "1878094410900054020",
   "en": "I am sure...! What...? You do not believe me...? I know what I saw!",
   "ro": "Sunt sigur...! Ce...? Nu mă crezi...? Știu ce am văzut!"
  },
  {
   "key": "1878094410950385668",
   "en": "Goodbye!",
   "ro": "La revedere!"
  },
  {
   "key": "1878094411101380612",
   "en": "I knew it... I just knew it...!",
   "ro": "Știam eu... știam eu...!"
  },
  {
   "key": "1878094411134935044",
   "en": "Help! Someone!",
   "ro": "Ajutor! Cineva!"
  },
  {
   "key": "1878094411235598340",
   "en": "No, no, no, no...!",
   "ro": "Nu, nu, nu, nu...!"
  },
  {
   "key": "1878094411269152768",
   "en": "This cannot be happening, please...",
   "ro": "Nu se poate întâmpla asta, te rog..."
  },
  {
   "key": "1878094411369816068",
   "en": "Are you watching me? Did she tell you to?",
   "ro": "Mă urmărești? Ți-a spus ea să faci asta?"
  },
  {
   "key": "1878094411403370496",
   "en": "Do not come any closer!",
   "ro": "Nu te apropia!"
  },
  {
   "key": "1878095877027405824",
   "en": "Precisely...! Just now, around the corner....",
   "ro": "Exact...! Chiar acum, după colț...."
  },
  {
   "key": "1958932075468857348",
   "en": "Did I say we were finished?",
   "ro": "Am spus că am terminat?"
  },
  {
   "key": "1958932075519188996",
   "en": "Let's not draw this out.",
   "ro": "Hai să nu lungim."
  },
  {
   "key": "1958932075552743424",
   "en": "What are you waiting for?",
   "ro": "Ce aștepți?"
  }
 ]
}
