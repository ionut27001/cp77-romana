  },
  {
   "key": "1896684889799401476",
   "en": "Hey! What do you need that for?",
   "ro": "Hei! La ce-ți trebuie aia?"
  },
  {
   "key": "1896684889832955908",
   "en": "Ey, 'ey, 'ey – can't have a gun here!",
   "ro": "Hei, hei, hei – cu arma nu e voie aici!"
  },
  {
   "key": "1896684889900064768",
   "en": "You can't be here!",
   "ro": "Nu poți fi aici!"
  },
  {
   "key": "1896684889916841988",
   "en": "They'll kill you!",
   "ro": "Te vor omorî!"
  },
  {
   "key": "1896684889967173636",
   "en": "Just like that… smart.",
   "ro": "Așa, dintr-o dată… deștept."
  },
  {
   "key": "1896684889983950852",
   "en": "Yeah! That's better.",
   "ro": "Da! Așa e mai bine."
  },
  {
   "key": "1896684890034282500",
   "en": "Again…?",
