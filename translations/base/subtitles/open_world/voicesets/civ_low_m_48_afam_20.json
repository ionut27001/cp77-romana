  },
  {
   "key": "1896684890051059716",
   "en": "Coincidence, or…?",
   "ro": "Coincidență, sau…?"
  },
  {
   "key": "1896684890101391364",
   "en": "Meh. False alarm.",
   "ro": "Meh. Alarmă falsă."
  },
  {
   "key": "1896684890134945796",
   "en": "Stupid me. Thought someone was here.",
   "ro": "Prostul de mine. Credeam că e cineva aici."
  },
  {
   "key": "1896684890185277444",
   "en": "Ey yo! Someone here?",
   "ro": "Hei, yo! E cineva aici?"
  },
  {
   "key": "1896684890218831876",
   "en": "Oof, goddamn horror movie-ass place!",
   "ro": "Oof, locul ăsta al naibii de film de groază!"
  },
  {
   "key": "1896684890285940736",
   "en": "What the--?",
   "ro": "Ce naiba--?"
  },
  {
   "key": "1896684890302717956",
   "en": "Hey go fuck yourself!",
   "ro": "Hei, du-te-n pula mea!"
  },
  {
   "key": "1896684890336272388",
   "en": "Hey.",
   "ro": "Hei."
  },
  {
   "key": "1896684890403381252",
   "en": "They musta seen me… Huh? Guess... Fuckin' cops! Heh, I bailed – they won't find me.",
   "ro": "Ma-s-au văzut… Ha? Cred… Polițaii dracului! Heh, i-am lăsat baltă – nu mă găsesc."
  },
  {
   "key": "1896684890420158468",
   "en": "I ain't goin to jail… Seriously…? Heh, him? You're nuts! Nah... For real?",
   "ro": "Nu mă duc la pușcărie… Serios…? Heh, el? Ești nebună! Nah... Pe bune?",
   "ro_m": "Nu mă duc la pușcărie… Serios…? Heh, el? Ești nebun! Nah... Pe bune?"
  },
  {
   "key": "1896684890453712900",
   "en": "Hey – catch you later!",
   "ro": "Hei – ne vedem mai târziu!"
  },
  {
   "key": "1896684890487267332",
   "en": "Huh... Am I goin' crazy?",
   "ro": "Ha… Înnebunesc?"
  },
  {
   "key": "1896684890906697732",
   "en": "Here! Here!",
   "ro": "Aici! Aici!"
  },
  {
   "key": "1896684890940252164",
   "en": "She gonna escape!",
   "en_m": "He's gonna escape!",
   "ro": "Ea o să scape!",
   "ro_m": "El o să scape!"
  },
  {
   "key": "1896684891057692676",
   "en": "Help me! Augh!",
   "ro": "Ajutor! Augh!"
  },
  {
   "key": "1896684891091247108",
   "en": "Cyberpsychosis!",
   "ro": "Cyberpsihoză!"
  },
  {
   "key": "1896684891191910404",
   "en": "Please, please, pleeeease!",
   "ro": "Te rog, te rog, te roooog!"
  },
  {
   "key": "1896684891208687620",
   "en": "Why me?",
   "ro": "De ce eu?"
  },
  {
   "key": "1896684891326128132",
   "en": "Me? Are you serious?",
   "ro": "Eu? Serios?"
  },
  {
   "key": "1896684891342905348",
   "en": "Girl, I don't know who the hell you are.",
   "en_m": "Dude, I don't know who the hell you are.",
   "ro": "Fată, nu știu cine naiba ești.",
   "ro_m": "Frate, nu știu cine naiba ești."
  },
  {
   "key": "1958900631912620032",
   "en": "S'a'ight, you do what you gotta do.",
   "ro": "Bine, fă ce trebuie să faci."
  },
  {
   "key": "1958900631962951684",
   "en": "We good to go?",
   "ro": "Putem pleca?"
  },
  {
   "key": "1958900631979728900",
   "en": "So what's it gonna be?",
   "ro": "Deci, ce-o să fie?"
  }
 ]
