  {
   "key": "1825813148144885764",
   "en": "Mh-hm... nah... nah it's happenin' tomorrow…",
   "ro": "Mh-hm... nu... nu, se întâmplă mâine…"
  },
  {
   "key": "1825813148178440196",
   "en": "Surround the bitch!",
