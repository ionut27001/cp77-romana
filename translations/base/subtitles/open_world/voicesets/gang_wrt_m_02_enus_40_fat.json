  {
   "key": "1825813148379766788",
   "en": "Ride or die!",
   "ro": "Până la capăt!"
  },
  {
   "key": "1825813148413321220",
   "en": "Arghh... Lemme go... Can't breathe...",
   "ro": "Arghh... Lasă-mă... Nu pot respira..."
  },
  {
   "key": "1867576773166243840",
   "en": "I don't give a fuck... I ain't fucking walking! I said tomorrow!",
