  },
  {
   "key": "1825813147759009796",
   "en": "Shit... ain't breathing!",
   "ro": "Rahat... nu mai respiră!"
  },
  {
   "key": "1825813147792564228",
   "en": "I'll look into it.",
   "ro": "Mă uit eu."
