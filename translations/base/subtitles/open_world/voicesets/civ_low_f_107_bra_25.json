{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\voicesets\\civ_low_f_107_bra_25.json",
 "entries": [
  {
   "key": "1908198034262990852",
   "en": "Hey.",
   "ro": "Hei."
  },
  {
   "key": "1908198034296545284",
   "en": "Do I know you?",
   "ro": "Te cunosc?"
  },
  {
   "key": "1908198034346876932",
   "en": "Someone say you could be here? Out, now!",
   "ro": "Cineva a zis că poți fi aici? Ieși, acum!"
  },
  {
   "key": "1908198034363654148",
   "en": "You go! Right fucking now!",
   "ro": "Pleacă! Chiar acum, pula mea!"
  },
  {
   "key": "1908198034430763012",
   "en": "Hey! Let's just stay calm, yes?",
   "ro": "Hei! Hai să ne calmăm, da?"
  },
  {
   "key": "1908198034447540228",
   "en": "Not here you don't. Pack it in.",
   "ro": "Aici nu. Las-o baltă."
  },
  {
   "key": "1908198034514649092",
   "en": "Fooling around won't end well for you.",
   "ro": "Prostii de-astea nu se termină bine pentru tine."
  },
  {
   "key": "1908198034531426308",
   "en": "If you don't go, they will kill you.",
   "ro": "Dacă nu pleci, te omoară."
  },
  {
   "key": "1908198034581757956",
   "en": "Let that be a lesson to you.",
   "ro": "Să-ți fie învățătură de minte."
  },
  {
   "key": "1908198034615312388",
   "en": "Smart girl.",
   "en_m": "Smart boy.",
   "ro": "Fată deșteaptă.",
   "ro_m": "Băiat deștept."
  },
  {
   "key": "1908198034799861764",
   "en": "What was that?",
   "ro": "Ce-a fost asta?"
  },
  {
   "key": "1908198034883747844",
   "en": "<kiroshi l=\"bra\" o=\"Malditos fantasmas?\" t=\"Damn ghosts?\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"bra\" o=\"Malditos fantasmas?\" t=\"Fantome dracului?\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1908198034950856708",
   "en": "Nothing – like I thought.",
   "ro": "Nimic – cum mă așteptam."
  },
  {
   "key": "1908198034984411140",
   "en": "I'm getting tired of this.",
   "ro": "Mă satur de asta."
  },
  {
   "key": "1908198035034742788",
   "en": "Did I hear footsteps?",
   "ro": "Am auzit pași?"
  },
  {
   "key": "1908198035051520004",
   "en": "I go take just a little peek...",
   "ro": "Mă duc să arunc o privire..."
  },
  {
   "key": "1908198035101851652",
   "en": "Try that again, hm? Go on!",
   "ro": "Mai încearcă o dată, hm? Hai!"
  },
  {
   "key": "1908198035118628868",
   "en": "You need help!",
   "ro": "Ai nevoie de ajutor!"
  },
  {
   "key": "1908198035168960516",
   "en": "<mothertongue l=\"bra\" m=\"gatinha\" b=\"Well hello, \" a=\".\"/>",
   "ro": "<mothertongue l=\"bra\" m=\"gatinha\" b=\"Salut, \" a=\".\"/>"
  },
  {
   "key": "1908198035236069380",
   "en": "No, don't have plans yet...",
   "ro": "Nu, nu am planuri încă..."
  },
  {
   "key": "1908198035252846596",
   "en": "Well, I don't know... Haha!",
   "ro": "Păi, nu știu... Haha!"
  },
  {
   "key": "1908198035303178244",
   "en": "No, you first! You! Haha! Bye.",
   "ro": "Nu, tu primul! Tu! Haha! Pa."
  },
  {
   "key": "1908198035336732676",
   "en": "What's this?",
   "ro": "Ce-i asta?"
  },
  {
   "key": "1908198035789717508",
   "en": "Need you over here!",
   "ro": "Am nevoie de tine aici!"
  },
  {
   "key": "1908198035806494724",
   "en": "Over here! Quick!",
   "ro": "Aici! Repede!"
  },
  {
   "key": "1908198035940712452",
   "en": "Oh, no! Ohhhh, no!",
   "ro": "Oh, nu! Ohhhh, nu!"
  },
  {
   "key": "1908198035957489668",
   "en": "<kiroshi l=\"bra\" o=\"Socorro!\" t=\"Help!\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"bra\" o=\"Socorro!\" t=\"Ajutor!\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1908198036074930180",
   "en": "Don't kill me!",
   "ro": "Nu mă omorî!"
  },
  {
   "key": "1908198036108484612",
   "en": "Please, just don't make it hurt!",
   "ro": "Te rog, nu mă face să sufăr!"
  },
  {
   "key": "1908198036242702340",
   "en": "Go on, or I'll crack your skull!",
   "ro": "Hai, sau îți sparg capul!"
  },
  {
   "key": "1908198036259479556",
   "en": "Will you just stop? Hm?",
   "ro": "Te oprești odată? Hm?"
  },
  {
   "key": "1958912440757428228",
   "en": "W-w-wait, I wasn't finished!",
   "ro": "A-a-așteaptă, nu terminasem!"
  },
  {
   "key": "1958912440807759876",
   "en": "Can you just let me, like...? OK...",
   "ro": "Poți să mă lași, gen...? OK..."
  },
  {
   "key": "1958912440824537092",
   "en": "Hey. Snap out of it!",
   "ro": "Hei. Revino-ți!"
  }
 ]
}
