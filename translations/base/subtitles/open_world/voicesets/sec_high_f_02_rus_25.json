  },
  {
   "key": "2236479807515926532",
   "en": "Neutralize the threat!",
   "ro": "Neutralizează amenințarea!"
  },
  {
   "key": "2236479807616589828",
   "en": "Lost visuals!",
   "ro": "Am pierdut vizualul!"
  },
  {
   "key": "2236479807666921476",
   "en": "She's hacking our cyberware!",
   "en_m": "He's hacking our cyberware!",
   "ro": "Ne hackuiește cyberware-ul!"
  },
  {
   "key": "2236479807717253124",
   "en": "Thaaat's the stuff!",
   "ro": "Așa da!"
  },
  {
   "key": "2236479807767584772",
   "en": "Calling reinforcements!",
   "ro": "Cer întăriri!"
  },
  {
   "key": "2236479807834693636",
   "en": "Leave her to me!",
   "en_m": "Leave him to me!",
   "ro": "Las-o pe ea pe mâna mea!",
   "ro_m": "Lasă-l pe el pe mâna mea!"
  },
  {
   "key": "2236479807918579712",
   "en": "Closing in on the target!",
   "ro": "Ne apropiem de țintă!"
  },
  {
   "key": "2236479807968911364",
   "en": "Heads down! Firing!",
   "ro": "Capetele jos! Trag!"
  },
  {
   "key": "2236479808019243012",
   "en": "Need to replace our losses!",
   "ro": "Trebuie să înlocuim pierderile!"
  },
  {
   "key": "2236479808270901252",
   "en": "Huh...? Securing the area.",
   "ro": "Huh...? Securizez zona."
