   "en": "You're dead!",
   "ro": "Ești moartă!",
   "ro_m": "Ești mort!"
  },
  {
   "key": "2236479807062941700",
   "en": "She's hit!",
   "en_m": "He's hit!",
   "ro": "A fost lovită!",
   "ro_m": "A fost lovit!"
  },
  {
   "key": "2236479807113273348",
   "en": "Target hit!",
   "ro": "Țintă lovită!"
  },
  {
   "key": "2236479807297822724",
   "en": "She's worn down! Finish her!",
   "en_m": "He's worn down! Finish him!",
   "ro": "E epuizată! Termin-o!",
   "ro_m": "E epuizat! Termină-l!"
  },
  {
   "key": "2236479807348154372",
   "en": "Understood!",
   "ro": "Înțeles!"
  },
  {
   "key": "2236479807415263236",
   "en": "Draw her out!",
