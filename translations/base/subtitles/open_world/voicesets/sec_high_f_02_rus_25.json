   "ro": "Aruncă arma!"
  },
  {
   "key": "1898023799632699396",
   "en": "You'll make me lose my temper.",
   "ro": "Mă faci să-mi pierd cumpătul."
  },
  {
   "key": "1898023799649476612",
   "en": "I won't go easy on you, understand?",
   "ro": "Nu o să mă port blând cu tine, înțelegi?"
  },
  {
   "key": "1898023799716585476",
   "en": "Easy now!",
   "ro": "Ușor acum!"
  },
  {
   "key": "1898023799750139908",
   "en": "That's what I'm talking about!",
   "ro": "Asta zic și eu!"
  },
  {
   "key": "1898023799800471556",
   "en": "Huh?",
   "ro": "Hm?"
  },
  {
   "key": "1898023799834025988",
   "en": "What the hell?",
   "ro": "Ce naiba?"
  },
  {
   "key": "1898023799917912068",
   "en": "Area secured.",
   "ro": "Zonă securizată."
  },
  {
   "key": "1898023799934689284",
   "en": "Didn't detect anything.",
   "ro": "N-am detectat nimic."
  },
  {
   "key": "1898023800001798148",
   "en": "We'll find you! It's just a matter of time!",
   "ro": "Te găsim! E doar o chestiune de timp!"
  },
  {
   "key": "1898023800035352580",
   "en": "Terrorist in the vicinity!",
   "ro": "Terrorist în zonă!"
  },
  {
   "key": "1898023800068907012",
   "en": "We have a body!",
   "ro": "Avem un cadavru!"
  },
  {
   "key": "1898023800119238660",
   "en": "Yessir.",
   "ro": "Da, domnule."
  },
  {
   "key": "1898023800203124740",
   "en": "Neutralize all threats!",
   "ro": "Neutralizează toate amenințările!"
  },
  {
   "key": "1898023800219901956",
   "en": "We're being attacked!",
   "ro": "Suntem atacați!"
  },
  {
   "key": "1898023800253456388",
   "en": "Heads up!",
   "ro": "Atenție!"
  },
  {
   "key": "1898023800320565248",
   "en": "Move! Move! Move!",
   "ro": "Mișcă! Mișcă! Mișcă!"
  },
  {
   "key": "1898023800337342468",
   "en": "Subject is resisting!",
   "ro": "Subiectul rezistă!"
  },
  {
   "key": "1898023800387674116",
   "en": "Stay focused!",
   "ro": "Rămâi concentrat!"
  },
  {
   "key": "1898023800404451332",
   "en": "I need cover!",
   "ro": "Am nevoie de acoperire!"
  },
  {
   "key": "1898023800471560196",
   "en": "Eyes on the ground.",
   "ro": "Ochi pe sol."
  },
  {
   "key": "1898023800505114624",
   "en": "Careful.",
   "ro": "Atenție."
  },
  {
   "key": "1898023800538669060",
   "en": "Speaking.",
   "ro": "La telefon."
  },
  {
   "key": "1898023800589000708",
   "en": "Yes... I'll send you the details... I know... It shouldn't be a problem...",
   "ro": "Da... Îți trimit detaliile... Știu... Nu ar trebui să fie o problemă..."
  },
  {
   "key": "1898023800605777924",
   "en": "Where...? I won't make it... Mhm... I'm telling, I just can't...",
   "ro": "Unde...? Nu o să reușesc... Mhm... Îți spun, pur și simplu nu pot..."
  },
  {
   "key": "1898023800672886788",
   "en": "Flank them!",
   "ro": "Înconjurați-i!"
  },
  {
   "key": "1898023800723218436",
   "en": "Understood!",
   "ro": "Înțeles!"
  },
  {
   "key": "1898023800773550084",
   "en": "Stay clear!",
   "ro": "Stai deoparte!"
  },
  {
   "key": "1898023800790327300",
   "en": "Roger that.",
   "ro": "Înțeles."
  },
  {
   "key": "1898023800807104516",
   "en": "Investigating.",
   "ro": "Investighez."
  },
  {
   "key": "1898023800874213380",
   "en": "Shhh... On me.",
   "ro": "Șșș... După mine."
  },
  {
   "key": "1898023800890990596",
   "en": "Psst... Form up.",
   "ro": "Psst... Formați!"
  },
  {
   "key": "1898023800941322244",
   "en": "Move out.",
   "ro": "Mișcare!"
  },
  {
   "key": "1898023800958099460",
   "en": "Stop her!",
   "en_m": "Stop him!",
   "ro": "Opriți-o!",
   "ro_m": "Opriți-l!"
  },
  {
   "key": "1898023801008431104",
   "en": "Argh… ekhh… You're... choking me...",
   "ro": "Argh… ekhh… Mă... sufoci..."
  },
  {
   "key": "1898044219350065152",
   "en": "Understood...",
   "ro": "Înțeles..."
  },
  {
   "key": "1898044479212363776",
   "en": "Mhm... Yes, I'll pass it on...",
   "ro": "Mhm... Da, o să transmit..."
  },
  {
   "key": "2236479806073085956",
   "en": "Attack dammit!",
   "ro": "Atacă, naiba!"
  },
  {
   "key": "2236479806391853060",
   "en": "Still breathing... Possible intruder!",
   "ro": "Încă respiră... Posibil intrus!"
  },
  {
   "key": "2236479806442184708",
   "en": "That's weird...",
   "ro": "Ciudat..."
  },
  {
   "key": "2236479806559625220",
   "en": "Didn't call anyone in. Fan out!",
   "ro": "N-am chemat pe nimeni. Dispersați-vă!"
