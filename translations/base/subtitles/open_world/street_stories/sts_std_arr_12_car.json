{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\street_stories\\sts_std_arr_12_car.json",
 "entries": [
  {
   "key": "1296672851646365712",
   "en": "I have control. I'll drive.",
   "ro": "Am controlul. Conduc eu."
  },
  {
   "key": "1298081826724003840",
   "en": "That's amazing! Nice work!",
   "ro": "Ce tare! Bună treabă!"
  },
  {
   "key": "1498246993147097088",
   "en": "Goddammit...",
   "ro": "Fir-ar al dracului..."
  },
  {
   "key": "1499442154434752512",
   "en": "They're here!",
   "ro": "Sunt aici!"
  },
  {
   "key": "1523160082195779584",
   "en": "One sec, one sec... Got it!",
   "ro": "Un sec, un sec... Am prins!"
  },
  {
   "key": "1523161471735140352",
   "en": "Eyes open, cocksuckers could show up any minute.",
   "ro": "Ochii în patru, nenorociții ăia pot apărea oricând."
  },
  {
   "key": "1527041451070164992",
   "en": "<kiroshi l=\"mex\" o=\"¡Mierda, mierda, mierda!\" t=\"Shit, shit, shit!\" b=\"\" a=\"\"/>",
   "ro": "<kiroshi l=\"mex\" o=\"¡Mierda, mierda, mierda!\" t=\"Căcat, căcat, căcat!\" b=\"\" a=\"\"/>"
  },
  {
   "key": "1537147626355863552",
   "en": "Take the wheel!",
   "ro": "Preia volanul!"
  },
  {
   "key": "1537173790742982656",
   "en": "Ugh, th-they-- Their runner's on me!",
   "ro": "Ugh, ei-- Runnerul lor e pe urma mea!"
  },
  {
   "key": "1538509153655689216",
   "en": "Got it!",
   "ro": "Am înțeles!"
  },
  {
   "key": "1601009342559391744",
   "en": "Easy, Pedro.",
   "ro": "Ușor, Pedro."
  },
  {
   "key": "1627545635694940160",
   "en": "Talk to me, Pedro.",
   "ro": "Zi ceva, Pedro."
  },
  {
   "key": "1647926574572736512",
   "en": "Done.",
   "ro": "Gata."
  },
  {
   "key": "1647932738471563264",
   "en": "So I just kick back, soak in the view?",
   "ro": "Deci doar stau cuminte și admir peisajul?"
  },
  {
   "key": "1649019405211111424",
   "en": "It worked! We did it! Holy shit!",
   "ro": "A funcționat! Am reușit! Băi, frate!"
  },
  {
   "key": "1649019872406245380",
   "en": "Fingers crossed for ya, Pedro.",
   "ro": "Țin pumnii pentru tine, Pedro."
  },
  {
   "key": "1649020364649762816",
   "en": "I gotta run.",
   "ro": "Trebuie să o șterg."
  },
  {
   "key": "1649021635389657088",
   "en": "Good luck. And if I were you, I'd disappear for a few days.",
   "ro": "Baftă. Dacă eram tu, dispăream câteva zile."
  },
  {
   "key": "1649021699008860160",
   "en": "OK, truck's in position. Gonna duck out quick to avoid attention.",
   "ro": "OK, camionul e pe poziție. Mă car repede, să nu atrag atenția."
  },
  {
   "key": "1649112982834483200",
   "en": "Thank you, thank you!",
   "ro": "Mulțumesc, mulțumesc!"
  },
  {
   "key": "1649113439292198912",
   "en": "Head straight, eyes up, ya hear?",
   "ro": "Drept înainte, ochii sus, auzi?"
  },
  {
   "key": "1649150770510401536",
   "en": "Thanks for doin' this.",
   "ro": "Mulțumesc că faci asta."
  },
  {
   "key": "1649151083841687552",
   "en": "Anytime.",
   "ro": "Oricând."
  },
  {
   "key": "1649157715774509056",
   "en": "Yes, absolutely. Again, thank you!",
   "ro": "Sigur. Mersi încă o dată!"
  },
  {
   "key": "1649158623556112384",
   "en": "See ya.",
   "ro": "Ne vedem."
  },
  {
   "key": "1655058028280778752",
   "en": "Safe travels.",
   "ro": "Drum bun."
  },
  {
   "key": "1655058663801720832",
   "en": "Safe travels.",
   "ro": "Drum bun."
  },
  {
   "key": "1655061091313881088",
   "en": "A thousand times thanks!",
   "ro": "Mii de mulțumiri!"
  },
  {
   "key": "1662342600945143808",
   "en": "The longer we chit-chat, the easier it is for Zetatech to track us. Again.",
   "ro": "Cu cât tot dăm din gură, cu atât ne găsește mai ușor Zetatech. Iar."
  },
  {
   "key": "1662363845195567104",
   "en": "Later, Pedro.",
   "ro": "Ne auzim, Pedro."
  },
  {
   "key": "1662387911927369728",
   "en": "Of-of course, over and out.",
   "ro": "D-sigur, terminat."
  },
  {
   "key": "1662388613282107392",
   "en": "Yeah, see ya.",
   "ro": "Da, ne vedem."
  },
  {
   "key": "1684937337395916800",
   "en": "I'm in.",
   "ro": "Intru."
  },
  {
   "key": "1684937876380758016",
   "en": "Slot the splinter. To the right of the wheel.",
   "ro": "Bagă splinterul. În dreapta volanului."
  },
  {
   "key": "1709771465602469888",
   "en": "You handle it?",
   "ro": "Te descurci?"
  },
  {
   "key": "1709776288934629376",
   "en": "Phew...",
   "ro": "Fiuu..."
  },
  {
   "key": "1709848468661833728",
   "en": "All right there?",
   "en_m": "You all right there?",
   "ro": "Ești bine?"
  },
  {
   "key": "1709848581119512576",
   "en": "Yeah, yeah... Close call...",
   "ro": "Da, da... Era cât p-aci."
  },
  {
   "key": "1709849279890558976",
   "en": "OK.",
   "ro": "OK."
  },
  {
   "key": "1741566171856343040",
   "en": "Keep goin'... 'til the end.",
   "ro": "Ține-o tot așa... până la capăt."
  }
 ]
}
