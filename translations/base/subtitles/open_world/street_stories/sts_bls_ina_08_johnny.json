{
 "depot": "base\\localization\\en-us\\subtitles\\open_world\\street_stories\\sts_bls_ina_08_johnny.json",
 "entries": [
  {
   "key": "1702386683464822784",
   "en": "Trevor's ride. Shot up pretty nicely.",
   "ro": "Mașina lui Trevor. Ciuruită zdravăn."
  },
  {
   "key": "1702388445626150912",
   "en": "See where this trail of blood leads.",
   "ro": "Hai să vedem unde ne duce dunga de sânge."
  },
  {
   "key": "1702393621044965376",
   "en": "All right, load him in the back.",
   "ro": "Bine, băgați-l în spate."
  },
  {
   "key": "1704330265184612352",
   "en": "Well, what do we have here.",
   "ro": "Ei, ce avem aici."
  },
  {
   "key": "1711318608166432768",
   "en": "Time to go home, Trevor.",
   "ro": "Hai acasă, Trevor."
  },
  {
   "key": "1721411666438434816",
   "en": "I see it, Johnny, thanks.",
   "ro": "O văd, Johnny, mulțumesc."
  },
  {
   "key": "1730240126418071552",
   "en": "Along with Trevor, too.",
   "ro": "Și pe Trevor."
  },
  {
   "key": "1928465244954054656",
   "en": "Don't need a sixth sense to follow some blood.",
   "ro": "Nu-ți trebuie al șaselea simț ca să urmărești un pic de sânge."
  },
  {
   "key": "2531468711088320512",
   "en": "Great... just great.",
   "ro": "Super... super tare."
  },
  {
   "key": "2531475028263792640",
   "en": "Let's have a look around.",
   "ro": "Hai să ne uităm în jur."
  }
 ]
}
